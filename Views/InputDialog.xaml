<Window x:Class="LinkPocket.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height" Width="360"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <!-- M3 Expressive 圆角填充文本域：SurfaceContainerHighest 填充、14px 全圆角，
             聚焦时 2px Primary 描边，校验错误时 2px Error 描边 -->
        <Style x:Key="M3TextField" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Primary}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Primary}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighest}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <!-- 错误态只用模板内的圆角 Error 描边，禁用 WPF 默认的红色矩形装饰层 -->
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" CornerRadius="14"
                                Background="{TemplateBinding Background}"
                                BorderThickness="2" BorderBrush="Transparent"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              Focusable="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceContainerHighest}"/>
                            </Trigger>
                            <!-- 聚焦只做填充变浅（Lowest 比弹窗底浅一档），不出现描边（用户明确不要紫色边） -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceContainerLowest}"/>
                            </Trigger>
                            <Trigger Property="Validation.HasError" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Error}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 无边框圆角窗口：去掉原生标题栏（M3 对话框形态），自带阴影与拖拽（WindowChrome 在 code-behind 配置）；
         内容完全由 InputDialogViewModel 数据驱动。 -->

    <!-- 外层留白承载投影 -->
    <Grid Margin="24">
        <Border CornerRadius="24" Background="{DynamicResource TintBg}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="3" Direction="270"
                                  Opacity="0.28" Color="#000000"/>
            </Border.Effect>

            <Grid Margin="24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 头部：色调圆底图标 + 标题（无右上角关闭按钮，取消走底部「取消」） -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="22"
                            Background="{DynamicResource PrimaryContainer}">
                        <m3:M3Icon Kind="{Binding IconKind}" Width="22" Height="22"
                                   Foreground="{DynamicResource OnPrimaryContainer}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="Medium"
                               VerticalAlignment="Center" Margin="14,0,0,0"
                               Foreground="{DynamicResource OnSurface}"/>
                </StackPanel>

                <!-- 输入框：M3 Expressive 圆角填充文本域（绑定校验）。
                     聚焦只做色彩形变（填充变浅），无描边——与搜索框/地址栏同一语言 -->
                <TextBox Grid.Row="1" x:Name="ValueBox" Margin="2,18,2,0"
                         Style="{StaticResource M3TextField}"
                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

                <!-- 校验错误 -->
                <TextBlock Grid.Row="2" Text="内容不能为空" FontSize="12" Margin="2,6,0,0"
                           Foreground="{DynamicResource Error}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 操作区：取消 = TonalButton 药丸，确定 = PrimaryPillButton 药丸（同高 32，与 ConfirmDialog 同语言），
                     空输入自动禁用 -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}"
                            IsCancel="True" Style="{StaticResource TonalButton}"
                            Height="32" MinWidth="96" Padding="20,6" FontSize="13"/>
                    <Button Command="{Binding ConfirmCommand}" IsDefault="True"
                            Style="{StaticResource PrimaryPillButton}"
                            Height="32" MinWidth="96" Padding="20,6" FontSize="13" Margin="10,0,0,0">
                        <TextBlock Text="{Binding ConfirmText}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
