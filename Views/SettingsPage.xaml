<UserControl x:Class="LinkPocket.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:views="clr-namespace:LinkPocket.Views">
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧栏 -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,0,1,0" Background="#FAFAFA">
            <StackPanel>
                <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold"
                           Margin="16,16,16,12" Foreground="#333333"/>
                <ListBox x:Name="SettingListBox" BorderThickness="0" Background="Transparent"
                         SelectionChanged="SettingListBox_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="Padding" Value="16,10"/>
                            <Setter Property="FontSize" Value="13"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Export" Width="18" Height="18"
                                                     VerticalAlignment="Center" Opacity="0.7"/>
                            <TextBlock Text="  导出书签" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Import" Width="18" Height="18"
                                                     VerticalAlignment="Center" Opacity="0.7"/>
                            <TextBlock Text="  导入书签" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteSweep" Width="18" Height="18"
                                                     VerticalAlignment="Center" Opacity="0.7"/>
                            <TextBlock Text="  数据维护" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BackupRestore" Width="18" Height="18"
                                                     VerticalAlignment="Center" Opacity="0.7"/>
                            <TextBlock Text="  备份与恢复" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </StackPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="1"
                      Background="{DynamicResource MaterialDesignDivider}"
                      HorizontalAlignment="Stretch"/>

        <!-- 右侧内容区 -->
        <Grid Grid.Column="2" x:Name="ContentPanel">
            <!-- 默认占位 -->
            <StackPanel x:Name="PlaceholderPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="Settings" Width="48" Height="48"
                                         HorizontalAlignment="Center" Opacity="0.15"/>
                <TextBlock Text="选择一个设置项" FontSize="14" Opacity="0.3"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>

            <!-- 导出界面 -->
            <StackPanel x:Name="ExportPanel" Visibility="Collapsed" Margin="32,24,32,24">
                <TextBlock Text="导出书签" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="将所有书签导出为 Netscape 书签格式（.html），可供 Chrome、Firefox、Edge 等浏览器导入"
                           FontSize="13" Opacity="0.55" Margin="0,0,0,28" TextWrapping="Wrap"/>

                <TextBlock Text="导出目录" FontSize="13" Opacity="0.6" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ExportDirTextBox" Grid.Column="0"
                             Text="{Binding SettingsViewModel.ExportDirectory, Mode=TwoWay,
                                    RelativeSource={RelativeSource AncestorType=Window}}"
                             IsReadOnly="True"
                             Padding="10,8" FontSize="13"
                             Foreground="#333333"
                             Background="#F5F5F5"
                             BorderBrush="#CCCCCC" BorderThickness="1.5"
                             materialDesign:HintAssist.Hint="选择导出目录..."/>
                    <Button Grid.Column="1" x:Name="BrowseDirButton"
                            Content="浏览" Margin="8,0,0,0" Padding="14,8"
                            Cursor="Hand" Click="BrowseDirButton_Click"
                            BorderThickness="1.5" BorderBrush="#CCCCCC" Background="#F5F5F5"
                            FontSize="13"/>
                </Grid>

                <Button x:Name="ExportButton" Margin="0,24,0,0"
                        Padding="20,10" HorizontalAlignment="Left" Cursor="Hand"
                        Click="ExportButton_Click" IsEnabled="False"
                        FontSize="14" FontWeight="SemiBold"
                        materialDesign:ButtonAssist.CornerRadius="6">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#6200EE"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#E0E0E0"/>
                                    <Setter Property="Foreground" Value="#999999"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#5000CC"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Export" Width="18" Height="18"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="  开始导出" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 导入界面 -->
            <StackPanel x:Name="ImportPanel" Visibility="Collapsed" Margin="32,24,32,24">
                <TextBlock Text="导入书签" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="从 Netscape 书签格式（.html）文件导入书签，支持 Chrome、Firefox、Edge 等浏览器导出的文件"
                           FontSize="13" Opacity="0.55" Margin="0,0,0,28" TextWrapping="Wrap"/>

                <TextBlock Text="选择导入文件" FontSize="13" Opacity="0.6" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ImportFileTextBox" Grid.Column="0"
                             IsReadOnly="True" Padding="10,8" FontSize="13"
                             Foreground="#333333" Background="#F5F5F5"
                             BorderBrush="#CCCCCC" BorderThickness="1.5"
                             materialDesign:HintAssist.Hint="选择 bookmarks.html 文件..."/>
                    <Button Grid.Column="1" x:Name="BrowseImportButton"
                            Content="浏览" Margin="8,0,0,0" Padding="14,8"
                            Cursor="Hand" Click="BrowseImportButton_Click"
                            BorderThickness="1.5" BorderBrush="#CCCCCC" Background="#F5F5F5"
                            FontSize="13"/>
                </Grid>

                <Button x:Name="ImportButton" Margin="0,24,0,0"
                        Padding="20,10" HorizontalAlignment="Left" Cursor="Hand"
                        Click="ImportButton_Click" IsEnabled="False"
                        FontSize="14" FontWeight="SemiBold"
                        materialDesign:ButtonAssist.CornerRadius="6">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#6200EE"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#E0E0E0"/>
                                    <Setter Property="Foreground" Value="#999999"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#5000CC"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Import" Width="18" Height="18"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="  开始导入" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 数据维护界面 -->
            <StackPanel x:Name="MaintenancePanel" Visibility="Collapsed" Margin="32,24,32,24">
                <TextBlock Text="数据维护" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="管理日志文件和应用数据"
                           FontSize="13" Opacity="0.55" Margin="0,0,0,28" TextWrapping="Wrap"/>

                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1"
                        Margin="0,0,0,16" Padding="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="清除日志" FontSize="14" Foreground="#333333"/>
                            <TextBlock x:Name="LogStatusText" Text="日志目录: 查看下方路径"
                                       FontSize="12" Foreground="#999999" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="ClearLogsButton"
                                Content="一键清除" Padding="16,8" VerticalAlignment="Center"
                                Cursor="Hand" Click="ClearLogsButton_Click"
                                Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1.5"
                                FontSize="13" Foreground="#333333"/>
                    </Grid>
                </Border>

                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1"
                        Margin="0,0,0,16" Padding="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="清空所有数据" FontSize="14" Foreground="#CC0000"/>
                            <TextBlock Text="清除数据库 + 图标缓存，此操作不可恢复"
                                       FontSize="12" Foreground="#CC0000" Opacity="0.7" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="ClearAllDataButton"
                                Content="清空数据" Padding="16,8" VerticalAlignment="Center"
                                Cursor="Hand" Click="ClearAllDataButton_Click"
                                Background="#FFE0E0" BorderBrush="#CC0000" BorderThickness="1.5"
                                FontSize="13" Foreground="#CC0000"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 备份与恢复界面 -->
            <views:BackupPanel x:Name="BackupPanelControl" Visibility="Collapsed"/>
        </Grid>

        <!-- 导出进度遮罩层 -->
        <Border Grid.ColumnSpan="3" x:Name="ExportOverlay" Visibility="Collapsed"
                Background="#AA000000" Panel.ZIndex="100">
            <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="White" CornerRadius="12"
                    Padding="32,24" Width="380">
                <StackPanel>
                    <TextBlock x:Name="ExportStatusText" Text="正在导出..."
                               FontSize="14" HorizontalAlignment="Center"
                               Foreground="#333333" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,0,0,12"/>
                    <ProgressBar x:Name="ExportProgressBar" Height="6"
                                 Minimum="0" Maximum="100" Value="0"
                                 Foreground="#6200EE" Background="#E0E0E0"/>
                    <TextBlock x:Name="ExportProgressText" Text="0 / 0"
                               FontSize="12" HorizontalAlignment="Center"
                               Foreground="#999999" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- 清空确认遮罩层 -->
        <Border Grid.ColumnSpan="3" x:Name="ConfirmOverlay" Visibility="Collapsed"
                Background="#AA000000" Panel.ZIndex="200">
            <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="White" CornerRadius="12"
                    Padding="32,24" Width="400">
                <StackPanel>
                    <TextBlock Text="确认清空所有数据" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="#CC0000"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="此操作将清除所有书签、文件夹和设置数据，且不可恢复。"
                               FontSize="13" HorizontalAlignment="Center"
                               Foreground="#666666" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="如需备份，请先使用导出功能。"
                               FontSize="13" HorizontalAlignment="Center"
                               Foreground="#666666" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,0,0,16"/>

                    <TextBlock Text="请输入以下文字确认操作："
                               FontSize="13" Foreground="#333333" Margin="0,0,0,6"/>
                    <TextBlock Text="我确认清除全部数据"
                               FontSize="14" FontWeight="Bold" Foreground="#CC0000"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <TextBox x:Name="ConfirmInputBox" Padding="10,8" FontSize="13"
                             HorizontalAlignment="Stretch"
                             Foreground="#333333" Background="#FFFFFF"
                             BorderBrush="#CCCCCC" BorderThickness="1.5"
                             materialDesign:HintAssist.Hint="在此输入确认文字..."/>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="ConfirmErrorText"
                                   Text="" FontSize="12" Foreground="#CC0000"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="CancelConfirmButton"
                                Content="取消" Padding="20,8" Margin="0,0,8,0"
                                Cursor="Hand" Click="CancelConfirmButton_Click"
                                Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1.5"
                                FontSize="13" Foreground="#333333"/>
                        <Button Grid.Column="2" x:Name="ExecuteClearButton"
                                Content="确认清空" Padding="20,8" IsEnabled="False"
                                Cursor="Hand" Click="ExecuteClearButton_Click"
                                Background="#CC0000" BorderThickness="0"
                                FontSize="13" Foreground="White"
                                materialDesign:ButtonAssist.CornerRadius="6"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>