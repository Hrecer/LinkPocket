<UserControl x:Class="LinkPocket.Views.Browser.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
             xmlns:vm="clr-namespace:LinkPocket.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{DynamicResource SurfaceContainerLowest}">

    <UserControl.Resources>
        <Style x:Key="NavIconButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="ToolTip" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
        </Style>
    </UserControl.Resources>

    <!-- 三段式：导航栏 / 内容区 / 状态栏 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 导航栏 ===== -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceContainer}"
                BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="0,0,0,1"
                Padding="10,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource NavIconButton}" Tag="后退 (Alt+←)"
                        Command="{Binding GoBackCommand}">
                    <m3:M3Icon Kind="arrow-left" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Style="{StaticResource NavIconButton}" Tag="前进 (Alt+→)"
                        Command="{Binding GoForwardCommand}">
                    <m3:M3Icon Kind="arrow-right" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Style="{StaticResource NavIconButton}" Tag="返回上级 (Backspace)"
                        Command="{Binding GoUpCommand}">
                    <m3:M3Icon Kind="arrow-up" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <!-- 面包屑：每一级可点击，当前级高亮 -->
                <ItemsControl ItemsSource="{Binding Breadcrumbs}" Margin="12,0,0,0" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding DataContext.CrumbClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="10,4" FontSize="13" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TextButton}">
                                            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
                                            <Setter Property="Padding" Value="10,4"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryContainer}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainer}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding Name}"/>
                                </Button>
                                <TextBlock Text="›" VerticalAlignment="Center" Foreground="{DynamicResource OnSurfaceMuted}" Margin="2,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ===== 内容区 ===== -->
        <Grid Grid.Row="1" MouseLeftButtonUp="ContentArea_MouseLeftButtonUp">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 列头 -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceContainerLow}" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="0,0,0,1" Padding="16,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="名称" FontSize="12" Foreground="{DynamicResource OnSurfaceVariant}"/>
                    <TextBlock Grid.Column="1" Text="书签数" FontSize="12" Foreground="{DynamicResource OnSurfaceVariant}"/>
                    <TextBlock Grid.Column="2" Text="修改时间" FontSize="12" Foreground="{DynamicResource OnSurfaceVariant}"/>
                </Grid>
            </Border>

            <!-- 行列表 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RowsControl" ItemsSource="{Binding Rows}" Padding="0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="RowBorder" Tag="BrowserRow" Padding="16,7" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick"
                                                  Command="{Binding DataContext.RowClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                    <MouseBinding Gesture="LeftDoubleClick"
                                                  Command="{Binding DataContext.RowOpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryContainer}"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceContainerHigh}"/>
                                            </Trigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="{DynamicResource PrimaryContainer}"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 名称（图标 + 文本） -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Grid Width="20" Height="20" VerticalAlignment="Center">
                                            <!-- 文件夹图标 -->
                                            <m3:M3Icon Kind="folder" Width="20" Height="20"
                                                                     Foreground="#FFB300" VerticalAlignment="Center">
                                                <m3:M3Icon.Style>
                                                    <Style TargetType="m3:M3Icon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </m3:M3Icon.Style>
                                            </m3:M3Icon>
                                            <!-- 书签 favicon -->
                                            <Image Source="{Binding Favicon}" Width="16" Height="16"
                                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <!-- 书签默认图标（favicon 为空时） -->
                                            <m3:M3Icon Kind="link-variant" Width="16" Height="16"
                                                                     Foreground="{DynamicResource OnSurfaceMuted}" VerticalAlignment="Center">
                                                <m3:M3Icon.Style>
                                                    <Style TargetType="m3:M3Icon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsFolder}" Value="False"/>
                                                                    <Condition Binding="{Binding Favicon}" Value="{x:Null}"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </m3:M3Icon.Style>
                                            </m3:M3Icon>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="14" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}"/>
                                    </StackPanel>

                                    <!-- 书签数（仅文件夹） -->
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource OnSurfaceVariant}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding LinkCount}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFolder}" Value="False">
                                                        <Setter Property="Text" Value="—"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- 修改时间 -->
                                    <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" VerticalAlignment="Center"
                                               FontSize="13" Foreground="{DynamicResource OnSurfaceVariant}"/>

                                    <!-- 收藏星标（仅书签） -->
                                    <m3:M3Icon Grid.Column="3" Kind="star" Width="16" Height="16"
                                                             Foreground="#FFC107" VerticalAlignment="Center">
                                        <m3:M3Icon.Style>
                                            <Style TargetType="m3:M3Icon">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsImportant}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </m3:M3Icon.Style>
                                    </m3:M3Icon>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空状态 -->
            <m3:EmptyState Grid.Row="1" IconKind="folder-open-outline"
                           Title="此文件夹为空"
                           Text="拖入书签或从浏览器导入"/>

            <!-- 加载遮罩 -->
            <Border Grid.Row="1" Background="#80FFFFFF">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <m3:CircularProgress IsIndeterminate="True"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 状态栏 ===== -->
        <Border Grid.Row="2" MinHeight="36" Background="{DynamicResource SurfaceContainerLow}"
                BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid>
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource OnSurfaceVariant}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="LinkPocket · Material 3" FontSize="11" Foreground="{DynamicResource OnSurfaceMuted}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.6"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
