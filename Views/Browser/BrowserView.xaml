<UserControl x:Class="LinkPocket.Views.Browser.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
             xmlns:vm="clr-namespace:LinkPocket.ViewModels"
             xmlns:views="clr-namespace:LinkPocket.Views"
             xmlns:local="clr-namespace:LinkPocket.Views.Browser"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Focusable="True"
             Background="{DynamicResource SurfaceContainerLow}">

    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="X" Command="{Binding CutCommand}"/>
        <KeyBinding Modifiers="Control" Key="C" Command="{Binding CopyCommand}"/>
        <KeyBinding Modifiers="Control" Key="V" Command="{Binding PasteCommand}"/>
        <KeyBinding Modifiers="Control" Key="A" Command="{Binding SelectAllCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectionCommand}"/>
        <KeyBinding Key="F2" Command="{Binding RenameSelectionCommand}"/>
        <KeyBinding Key="Enter" Command="{Binding OpenSelectionCommand}"/>
        <KeyBinding Key="Backspace" Command="{Binding GoUpCommand}"/>
        <KeyBinding Modifiers="Alt" Key="Left" Command="{Binding GoBackCommand}"/>
        <KeyBinding Modifiers="Alt" Key="Right" Command="{Binding GoForwardCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding ClearSelectionCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <vm:InvertedBoolToVisibilityConverter x:Key="InvBoolToVis"/>

        <!-- 详情栏卡片：M3 圆角容器（Expressive 大圆角 20），TintCard 浮起在 TintPanel 面板上 -->
        <Style x:Key="SideCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource TintCard}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <!-- 详情栏小节标签 -->
        <Style x:Key="SideLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
            <Setter Property="Margin" Value="4,0,0,4"/>
        </Style>
        <!-- 类型 / 统计小药丸 -->
        <Style x:Key="SideChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PrimaryContainer}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 列表行计数药丸（Material 3 Expressive 风格）：
             全圆角 pill + 次级容器色调 + 紧凑字重，尺寸克制，跟随名称显示而不抢视觉焦点。 -->
        <Style x:Key="CountPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SecondaryContainer}"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="MinHeight" Value="18"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 纯图标按钮：自带 ControlTemplate，绝对不能 BasedOn TextButton。
             Material3 的 TextButton 模板把 Padding 硬编码成 Padding="14,0"（不响应 Button.Padding，
             也不受本样式 Padding=4 影响），Width=34 的按钮内容区被压到 34-28=6，
             再被布局裁切 → 后退/前进箭头左右两端被切掉。
             这里用 TemplateBinding Padding，内容区 = 34-2*4 = 26 ≥ 图标 20，图标完整显示。
             同时避免继承 TextButton 的 MinHeight=40，Height 才真正等于 32。 -->
        <Style x:Key="NavIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ToolTip" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
            <Setter Property="ToolTipService.Placement" Value="Top"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="16" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- hover / pressed 状态层：沿用 TextButton 的 Primary 叠加（8% / 12%） -->
                                <Border x:Name="StateLayer" Background="{DynamicResource Primary}"
                                        Opacity="0" CornerRadius="16" Margin="-4"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.12"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceMuted}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FolderTreeStyle" TargetType="TreeView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <!-- 树展开箭头：chevron 放在圆形 hover 药丸里，IsChecked(=IsExpanded) 时旋转 90° 朝下 -->
        <Style x:Key="TreeExpanderToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <m3:M3Icon x:Name="Chevron" Kind="chevron-right" Width="14" Height="14"
                                       Foreground="{DynamicResource OnSurfaceVariant}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <m3:M3Icon.LayoutTransform>
                                    <RotateTransform Angle="0"/>
                                </m3:M3Icon.LayoutTransform>
                            </m3:M3Icon>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="LayoutTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceContainerHighest}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FolderTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <!-- 自绘 TreeViewItem 模板：替换掉默认的尖锐三角形展开箭头（MD3E：
                         圆形药丸 chevron，展开时旋转 90° 朝下；无子项时占位隐藏，子级整体缩进 20）。 -->
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="Expander" Grid.Column="0"
                                              Style="{StaticResource TreeExpanderToggle}"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                <ContentPresenter x:Name="PART_Header" Grid.Column="1"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Left"/>
                            </Grid>
                            <ItemsPresenter x:Name="ItemsHost"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="DragOver" Handler="TreeItem_DragOver"/>
            <EventSetter Event="Drop" Handler="TreeItem_Drop"/>
        </Style>

        <!-- 排序表头按钮已随共享数据表控件（views:SortableDataTable）统一：表头由控件按列定义生成，
             本页不再保留独立的 HeaderSortButton 样式。 -->

        <!-- 名称列可用宽度 = 列宽 - 图标/间距/计数药丸的固定占位 -->
        <local:SubtractConverter x:Key="NameCellTextWidth" Min="60"/>

        <!-- 右键菜单项：库默认模板行高过大、字号偏大、文字不垂直居中，这里给一套紧凑模板（M3 菜单形态：
             无分组分割线、行高小、字小、左右留白紧）。
             ⚠️ 两个坑：
             1) 菜单项若写了显式的 <MenuItem.Style>，会整体取代下面的隐式样式（不是叠加），
                必须写 BasedOn="{StaticResource LpMenuItem}"，否则退回库默认模板
                → 同一张菜单里"有显式样式的项"高而缩进、"没写的项"矮而左对齐，看起来就是没对齐。
             2) 隐式样式与具名样式要同时存在：具名的供 BasedOn 引用，隐式的负责兜底覆盖。 -->
        <Style x:Key="LpMenuItem" TargetType="MenuItem">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="3,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceContainerHighest}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}"/>
        <!-- M3 菜单不用分组分割线：本页菜单里的 <Separator/> 已全部移除。
             这条样式留着是为了万一以后有人加回分割线时不至于退回库默认的粗线。 -->
        <Style TargetType="Separator">
            <Setter Property="Margin" Value="8,3"/>
            <Setter Property="Background" Value="{DynamicResource OutlineVariant}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="{TemplateBinding Margin}"
                                Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 路径编辑框：M3 Expressive 圆角填充文本域（紧凑版，高度与导航按钮同为 32，保证切换时整行高度不变）。
             默认 Collapsed，IsPathEditing=True 才显示；路径无效时 2px Error 描边。
             注意：不能用库默认 TextBox 模板——那是直角 + 蓝色系统焦点描边，与 M3 割裂。 -->
        <Style x:Key="PathEditField" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Primary}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Primary}"/>
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
            <!-- 键盘焦点虚线框必须去掉：回车确认后这个 TextBox 会被折叠，但它仍是焦点元素，
                 WPF 会画出焦点虚线框 —— 塌成一条横跨整宽的黑色虚线，看起来像"奇怪的灰色样式"。 -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" CornerRadius="16"
                                Background="{DynamicResource SurfaceContainerHighest}"
                                BorderThickness="2" BorderBrush="Transparent"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Primary}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsPathInvalid}" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#E24B4A"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPathEditing}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 行内信息列文字（最后更新 / 最后查看 / 查看次数 / 创建时间）统一规格 -->
        <Style x:Key="RowCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </UserControl.Resources>

    <!-- 三段式：导航栏 / 内容区 / 状态栏 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 命令栏（悬浮式）：两枚新建命令收进一枚浮动胶囊组，不占整行 ===== -->
        <Border Grid.Row="1" Background="Transparent"
                Padding="12,0,12,8">
            <Border HorizontalAlignment="Left" Background="{DynamicResource SurfaceContainerHigh}"
                    CornerRadius="19" Padding="3" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <!-- 新建：Win11 命令栏首个命令，带 + 图标 + 文字 -->
                <Button Command="{Binding NewFolderCommand}" Cursor="Hand"
                        Style="{StaticResource TonalButton}" Padding="12,5" MinHeight="32">
                    <StackPanel Orientation="Horizontal">
                        <m3:M3Icon Kind="folder-plus" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="新建文件夹" FontSize="13" VerticalAlignment="Center" Margin="7,0,0,0"/>
                    </StackPanel>
                </Button>
                <!-- 新建链接：与新建文件夹并列，弹出 M3 链接编辑器（默认当前目录） -->
                <Button Command="{Binding NewLinkCommand}" Cursor="Hand"
                        Style="{StaticResource TonalButton}" Padding="12,5" MinHeight="32" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <m3:M3Icon Kind="link-plus" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="新建链接" FontSize="13" VerticalAlignment="Center" Margin="7,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            </Border>
        </Border>

        <!-- ===== 导航行（悬浮式）：无整行底带 —— 三枚导航键收进一枚圆胶囊，地址栏自成胶囊，编辑键独立圆胶囊 ===== -->
        <Border Grid.Row="0" Background="Transparent"
                Padding="12,0,12,8">
            <DockPanel VerticalAlignment="Center" LastChildFill="True">
                <Border DockPanel.Dock="Left" Background="{DynamicResource SurfaceContainerHigh}"
                        CornerRadius="17" Padding="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource NavIconButton}" Tag="后退 (Alt+←)"
                            Command="{Binding GoBackCommand}">
                        <m3:M3Icon Kind="arrow-left" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource NavIconButton}" Tag="前进 (Alt+→)"
                            Command="{Binding GoForwardCommand}">
                        <m3:M3Icon Kind="arrow-right" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource NavIconButton}" Tag="返回上级 (Backspace)"
                            Command="{Binding GoUpCommand}">
                        <m3:M3Icon Kind="arrow-up" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    </StackPanel>
                </Border>
                <!-- 路径编辑开关：独立圆胶囊（与左键组同语言） -->
                <Border DockPanel.Dock="Right" Background="{DynamicResource SurfaceContainerHigh}"
                        CornerRadius="17" Padding="2" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button Style="{StaticResource NavIconButton}"
                        ToolTip="编辑路径（Enter 导航，Esc 取消）" Focusable="False"
                        Command="{Binding TogglePathEditCommand}">
                        <m3:M3Icon Kind="{Binding PathEditIconKind}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Border>

                <!-- 地址栏（MD3 Expressive 胶囊）：与搜索页胶囊同语言。
                     编辑态只做颜色/描边形变（SurfaceContainerHighest + 2px Primary），圆角保持 20 —— 
                     40 高的胶囊全圆就是 20，比它小（如 14）会出现"方不方圆不圆"的怪框。
                     高度两态恒为 40 —— 重蹈"点开编辑整行变矮"的覆辙。
                     ⚠️ 基态值必须写在 Style.Setters 里：写在元素特性上是本地值，
                     本地值优先级高于样式触发器，触发器永远不会生效。 -->
                <Border x:Name="AddressBarShell" Margin="12,0,0,0" Height="40"
                        BorderThickness="2" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="CornerRadius" Value="20"/>
                            <Setter Property="Background" Value="{DynamicResource SurfaceContainerHigh}"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPathEditing}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighest}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid VerticalAlignment="Center">
                    <!-- 面包屑：每一级可点击，当前级高亮；路径编辑态时隐藏。
                         MinHeight 显式压到 32：面包屑按钮 BasedOn TextButton 会白拿 MinHeight=40，
                         而编辑态它们被折叠、只剩 32 高的编辑框 → 整行会在点开编辑时缩短。 -->
                    <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPathEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding DataContext.CrumbClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0"
                                        FontSize="13" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TextButton}">
                                            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
                                            <Setter Property="Padding" Value="12,0"/>
                                            <Setter Property="MinHeight" Value="32"/>
                                            <Setter Property="Height" Value="32"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryContainer}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainer}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding Name}"/>
                                </Button>
                                <TextBlock Text="›" VerticalAlignment="Center" Foreground="{DynamicResource OnSurfaceMuted}" Margin="2,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                    <!-- 路径编辑态：M3 圆角填充文本域 + 同级候选 Popup（高度与面包屑/导航按钮一致，整行不变高） -->
                    <TextBox x:Name="PathEditBox" Style="{StaticResource PathEditField}"
                             Text="{Binding PathEditText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" HorizontalAlignment="Stretch"
                             PreviewKeyDown="PathEditBox_PreviewKeyDown"
                             LostFocus="PathEditBox_LostFocus">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ConfirmPathCommand}"/>
                            <KeyBinding Key="Escape" Command="{Binding CancelPathEditCommand}"/>
                            <KeyBinding Key="Tab" Command="{Binding CompletePathCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <Popup IsOpen="{Binding HasPathCandidates, Mode=OneWay}"
                           PlacementTarget="{Binding ElementName=PathEditBox}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                           Closed="PathCandidatesPopup_Closed">
                        <Border Background="{DynamicResource SurfaceContainerHigh}"
                                BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1"
                                CornerRadius="12" MaxHeight="220" MinWidth="180" Padding="0,4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.18" Color="#000000"/>
                            </Border.Effect>
                            <ListBox x:Name="PathCandidatesList" Focusable="False"
                                     ItemsSource="{Binding PathCandidates}"
                                     SelectedIndex="{Binding SelectedCandidateIndex, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent"
                                     SelectionChanged="PathCandidates_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" Height="26" Margin="12,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource OnSurface}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
                </Border>
            </DockPanel>
        </Border>

        <!-- ===== 内容区：左侧文件夹树 / 右侧列表 / 详情栏 ===== -->
        <Grid Grid.Row="2" MouseLeftButtonUp="ContentArea_MouseLeftButtonUp">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="286" MinWidth="230" MaxWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧文件夹树：与中央列表卡同构 —— TintPanel 标题带 + SurfaceContainerHigh 内容卡
                 （左缘贴窗口边、右缘上下圆角朝沟槽；底部留背景余位与状态栏脱开） -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceContainerHigh}"
                    CornerRadius="0,24,24,0" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource TintPanel}"
                            CornerRadius="0,24,0,0" Padding="10,10,10,6">
                        <TextBlock Text="文件夹" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OnSurfaceVariant}"/>
                    </Border>
                    <TreeView Grid.Row="1" x:Name="FolderTreeControl"
                              Style="{StaticResource FolderTreeStyle}"
                              ItemContainerStyle="{StaticResource FolderTreeItemStyle}"
                              ItemsSource="{Binding FolderTree}"
                              SelectedItemChanged="FolderTree_SelectedItemChanged"
                              VirtualizingPanel.IsVirtualizing="True">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <!-- 选中态药丸：SecondaryContainer 圆角容器（MD3E 形状区分选中） -->
                                <Border CornerRadius="8" Padding="6,3" Margin="0,1" Background="Transparent">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SecondaryContainer}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <ContextMenu.Resources>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}"/>
                                            </ContextMenu.Resources>
                                            <!-- 根节点「全部书签」不是文件夹：重命名/删除只对真实文件夹显示 -->
                                            <MenuItem Header="重命名" Command="{Binding Host.RenameNodeCommand}" CommandParameter="{Binding}">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <MenuItem Header="{Binding DeleteMenuHeader}" Command="{Binding Host.DeleteNodeCommand}" CommandParameter="{Binding}">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <!-- 真实文件夹：与右侧列表统一的实心琥珀色；根节点「全部书签」用书签图标（它不是文件夹） -->
                                    <m3:M3Icon Width="16" Height="16" VerticalAlignment="Center">
                                        <m3:M3Icon.Style>
                                            <Style TargetType="m3:M3Icon">
                                                <Setter Property="Kind" Value="folder"/>
                                                <Setter Property="Foreground" Value="#FFB300"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                                        <Setter Property="Kind" Value="bookmark"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </m3:M3Icon.Style>
                                    </m3:M3Icon>
                                    <TextBlock Text="{Binding Name}" FontSize="13" Margin="6,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}"/>
                                    <!-- 链接数药丸：与右侧列表统一的 M3 Expressive 胶囊（递归计数，含子孙文件夹） -->
                                    <Border Style="{StaticResource CountPill}" Padding="7,0" MinHeight="16">
                                        <TextBlock Text="{Binding LinkCount}" FontSize="10.5" FontWeight="Medium"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource OnSecondaryContainer}"/>
                                    </Border>
                                </StackPanel>
                                </Border>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- 右侧：列头 + 行列表 + 空状态 + 加载遮罩。
                 列表区卡片化（MD3E shape separation）：大圆角 24 + 四周基面沟槽，
                 消除与两侧面板之间生硬的竖直色块边界。 -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceContainerHigh}"
                    CornerRadius="24" Margin="8,0,8,8" ClipToBounds="True">
            <Grid>
                <Grid.ContextMenu>
                    <ContextMenu>
                        <!-- 紧凑菜单样式的隐式兜底：ContextMenu 不在 UserControl 的可视树里，
                             拿不到 UserControl.Resources 的隐式样式，所以必须在每个菜单自己的 Resources 里再声明一次。 -->
                        <ContextMenu.Resources>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}"/>
                        </ContextMenu.Resources>
                        <MenuItem Header="新建文件夹" Command="{Binding NewFolderCommand}"/>
                        <MenuItem Header="粘贴" Command="{Binding PasteCommand}"/>
                        <MenuItem Header="全选" Command="{Binding SelectAllCommand}"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 列头 + 行列表：共享数据表控件（与搜索结果表同一份实现，数据驱动、独立 CS）。
                     列头/排序/列宽拖拽全部由控件按列定义生成；行 = 模板模式（ItemTemplate），
                     行悬停/选中/右键菜单/拖放仍归本页行模板所有。
                     排序经 SortChanged 事件转 VM（服务端排序），列宽单一数据源在控件 ColumnWidths。 -->
                <views:SortableDataTable x:Name="MainTable" Grid.Row="0"
                                         HeaderBandMargin="0" ItemsSource="{Binding Rows}">
                    <views:SortableDataTable.ItemTemplate>
                        <DataTemplate>
                            <!-- 外层 Border：承载事件/右键菜单/列宽对齐，透明无底色（宽度=视口，不产生横向溢出）；
                                 内层 RowSkin：MD3E 悬浮行容器 —— 大圆角 12 + 左右外距 10，hover/选中底色都在它上面 -->
                            <Border x:Name="RowBorder" Tag="BrowserRow" Cursor="Hand"
                                    MinWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                    PreviewMouseLeftButtonDown="RowBorder_PreviewMouseLeftButtonDown"
                                    MouseMove="RowBorder_MouseMove"
                                    MouseLeftButtonUp="RowBorder_MouseLeftButtonUp"
                                    ContextMenuOpening="RowBorder_ContextMenuOpening"
                                    AllowDrop="True" DragOver="RowBorder_DragOver" Drop="RowBorder_Drop">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <ContextMenu.Resources>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}"/>
                                        </ContextMenu.Resources>
                                        <MenuItem Header="打开" Command="{Binding Host.RowOpenCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="新建文件夹（在此文件夹内）" Command="{Binding Host.NewFolderCommand}"
                                                  CommandParameter="{Binding Id}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <MenuItem Header="复制链接" Command="{Binding Host.CopyUrlCommand}" CommandParameter="{Binding}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <!-- 链接没有「重命名」语义：编辑 = 打开整页编辑器（URL / 名称 / 描述 / 图标） -->
                                        <MenuItem Header="编辑" Command="{Binding Host.RenameRowCommand}" CommandParameter="{Binding}"
                                                  ToolTip="编辑链接（URL / 名称 / 描述 / 图标）">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsFolder}" Value="False"/>
                                                                <Condition Binding="{Binding Host.HasMultipleSelection}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <!-- 文件夹：本身只有名称，保留「重命名」 -->
                                        <MenuItem Header="重命名" Command="{Binding Host.RenameRowCommand}" CommandParameter="{Binding}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsFolder}" Value="True"/>
                                                                <Condition Binding="{Binding Host.HasMultipleSelection}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <MenuItem Header="详情" Command="{Binding Host.OpenDetailCommand}" CommandParameter="{Binding}"
                                                  ToolTip="打开链接详情页">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <MenuItem Header="{Binding Host.DeleteMenuHeader}" Command="{Binding Host.DeleteRowCommand}" CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick"
                                                  Command="{Binding DataContext.RowOpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <!-- 内层 RowSkin：MD3E 悬浮行容器（大圆角 12 + 左右外距 10）。
                                     底色触发器挂在这里：hover/选中底色是圆角的，且不会撑出横向滚动条。 -->
                                <Border Margin="0,1" CornerRadius="12" Padding="16,7" SnapsToDevicePixels="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryContainer}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighest}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsCut}" Value="True">
                                                    <Setter Property="Opacity" Value="0.45"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                <Grid>
                                    <!-- 与列头共用同一份列宽（拖拽列头即同步到每一行） -->
                                    <Grid.ColumnDefinitions>
                                        <!-- 与共享控件表头共用同一份列宽（ColumnWidths 单一数据源，拖拽即同步） -->
                                        <ColumnDefinition views:ColumnWidthBinding.Width="{Binding ColumnWidths[0], RelativeSource={RelativeSource AncestorType=views:SortableDataTable}}"/>
                                        <ColumnDefinition views:ColumnWidthBinding.Width="{Binding ColumnWidths[1], RelativeSource={RelativeSource AncestorType=views:SortableDataTable}}"/>
                                        <ColumnDefinition views:ColumnWidthBinding.Width="{Binding ColumnWidths[2], RelativeSource={RelativeSource AncestorType=views:SortableDataTable}}"/>
                                        <ColumnDefinition views:ColumnWidthBinding.Width="{Binding ColumnWidths[3], RelativeSource={RelativeSource AncestorType=views:SortableDataTable}}"/>
                                        <ColumnDefinition views:ColumnWidthBinding.Width="{Binding ColumnWidths[4], RelativeSource={RelativeSource AncestorType=views:SortableDataTable}}"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 名称（图标 + 文本 + 计数药丸）：名称 Auto 紧跟图标，药丸紧贴名称（与左侧树一致），尾部 * 空白吸收剩余宽度 -->
                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
                                            <!-- 文件夹图标 -->
                                            <m3:M3Icon Kind="folder" Width="20" Height="20"
                                                                     Foreground="#FFB300" VerticalAlignment="Center">
                                                <m3:M3Icon.Style>
                                                    <Style TargetType="m3:M3Icon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </m3:M3Icon.Style>
                                            </m3:M3Icon>
                                            <!-- 书签 favicon -->
                                            <Image Source="{Binding Favicon}" Width="16" Height="16"
                                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <!-- 书签默认图标（favicon 为空时） -->
                                            <m3:M3Icon Kind="link-variant" Width="16" Height="16"
                                                                     Foreground="{DynamicResource OnSurfaceMuted}" VerticalAlignment="Center">
                                                <m3:M3Icon.Style>
                                                    <Style TargetType="m3:M3Icon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsFolder}" Value="False"/>
                                                                    <Condition Binding="{Binding Favicon}" Value="{x:Null}"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </m3:M3Icon.Style>
                                            </m3:M3Icon>
                                        </Grid>
                                        <!-- 名称文本宽度跟随列宽，列变窄时省略号收窄，药丸不会被挤出到相邻列 -->
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="{Binding ColumnWidths[0].Value, RelativeSource={RelativeSource AncestorType=views:SortableDataTable}, Converter={StaticResource NameCellTextWidth}, ConverterParameter=78}"
                                                   ToolTip="{Binding Name}"/>
                                        <!-- 链接数药丸（仅文件夹）：紧贴名称，与左侧树完全一致（只显示数字） -->
                                        <Border Grid.Column="2" Padding="7,0" MinHeight="16" Margin="8,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource CountPill}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding LinkCount}" FontSize="10.5" FontWeight="Medium"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource OnSecondaryContainer}"/>
                                        </Border>
                                    </Grid>

                                    <!-- 最后更新（文件夹 = 内容含子孙最后变动时间；查看不算变动，内核维护） -->
                                    <TextBlock Grid.Column="1" Style="{StaticResource RowCellText}"
                                               Text="{Binding ModifiedText}" ToolTip="{Binding ModifiedText}"/>

                                    <!-- 最后查看（文件夹 = 子孙链接被查看时沿父链刷新；从未显示「从未」） -->
                                    <TextBlock Grid.Column="2" Style="{StaticResource RowCellText}"
                                               Text="{Binding LastViewedText}" ToolTip="{Binding LastViewedText}"/>

                                    <!-- 查看次数（文件夹 = 子树增量计数；链接 = 自身访问次数） -->
                                    <TextBlock Grid.Column="3" Style="{StaticResource RowCellText}"
                                               Text="{Binding ViewCountText}"/>

                                    <!-- 创建时间 -->
                                    <TextBlock Grid.Column="4" Style="{StaticResource RowCellText}"
                                               Text="{Binding CreatedText}" ToolTip="{Binding CreatedText}"/>
                                </Grid>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </views:SortableDataTable.ItemTemplate>
                </views:SortableDataTable>

            <!-- 空状态（MD3E）：大圆角色块徽章 + 引导性文案，替代生硬的系统提示 -->
            <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Rows.Count}" Value="0"/>
                                    <Condition Binding="{Binding IsLoading}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel>
                    <Border Width="96" Height="96" CornerRadius="32"
                            Background="{DynamicResource PrimaryContainer}"
                            HorizontalAlignment="Center">
                        <m3:M3Icon Kind="folder-open-outline" Width="40" Height="40"
                                   Foreground="{DynamicResource OnPrimaryContainer}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="这里还空空如也" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource OnSurface}"
                               HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    <TextBlock Text="新建文件夹或链接，也可以把浏览器里的网址导入进来" FontSize="12"
                               Foreground="{DynamicResource OnSurfaceVariant}" Opacity="0.85"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 加载遮罩 -->
            <Border Grid.Row="0" Background="#80FFFFFF">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <m3:CircularProgress IsIndeterminate="True"/>
                </StackPanel>
            </Border>
            </Grid>
            </Border>

            <!-- 详情栏可拖拽分隔线 -->
        <GridSplitter Grid.Column="2" x:Name="DetailSplitter" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="Transparent" Cursor="SizeWE"/>

        <!-- ===== 右侧详情栏：紫色叠层面板 —— 右缘贴窗口边、左缘上下圆角朝沟槽；底部留背景余位 ===== -->
        <Border Grid.Column="3" x:Name="DetailsPanel" Background="{DynamicResource TintPanel}"
                CornerRadius="24,0,0,24" Margin="0,0,0,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="12,12,12,16">

                    <!-- 空态占位（MD3E）：圆角色块徽章 + 引导文案 -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,110,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Details.HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="72" Height="72" CornerRadius="24" HorizontalAlignment="Center"
                                Background="{DynamicResource TintCard}">
                            <m3:M3Icon Kind="eye-outline" Width="30" Height="30"
                                       Foreground="{DynamicResource OnSurfaceVariant}" Opacity="0.5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="选中项目查看详情" FontSize="13" Foreground="{DynamicResource OnSurfaceVariant}" Opacity="0.8"
                                   HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock Text="链接或文件夹均可" FontSize="11" Foreground="{DynamicResource OnSurfaceVariant}" Opacity="0.55"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- ===== 单选：头部卡片（图标 + 名称 + 类型药丸） ===== -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SideCard}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Details.IsSingle}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <!-- 头部：图标居左，名称 + 类型药丸靠右排布，节省纵向空间 -->
                            <Grid Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="44" Height="44" VerticalAlignment="Center">
                                    <!-- 书签 favicon（无图时回退 earth 占位） -->
                                    <Border CornerRadius="10" Background="White" ClipToBounds="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Details.IsFolder}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Image Source="{Binding Details.Favicon}" Stretch="Uniform" Margin="6"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Details.HasFavicon}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <m3:M3Icon Kind="earth" Width="22" Height="22"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5">
                                                <m3:M3Icon.Style>
                                                    <Style TargetType="m3:M3Icon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Details.HasFavicon}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </m3:M3Icon.Style>
                                            </m3:M3Icon>
                                        </Grid>
                                    </Border>
                                    <!-- 文件夹大图标 -->
                                    <m3:M3Icon Kind="folder" Width="40" Height="40" Foreground="#FFB300"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <m3:M3Icon.Style>
                                            <Style TargetType="m3:M3Icon">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Details.IsFolder}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </m3:M3Icon.Style>
                                    </m3:M3Icon>
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Details.DisplayName}" FontSize="15" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Foreground="{DynamicResource OnSurface}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===== 单选书签：URL 卡片 ===== -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SideCard}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Details.IsLink}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Details.UrlText}" FontSize="12"
                                       FontFamily="Consolas" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{DynamicResource OnSurfaceVariant}"/>
                            <Button Grid.Column="1" Style="{StaticResource NavIconButton}" Tag="复制链接"
                                    Width="26" Height="24" Padding="4" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Command="{Binding Details.CopyUrlCommand}">
                                <m3:M3Icon Kind="content-copy" Width="13" Height="13"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ===== 单选：信息卡片（位置 / 时间 / 统计） ===== -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SideCard}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Details.IsSingle}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="信息" Style="{StaticResource SideLabel}"/>

                            <!-- 位置 -->
                            <Grid Margin="0,2,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <m3:M3Icon Kind="folder-outline" Width="13" Height="13" Opacity="0.55"
                                           Foreground="{DynamicResource OnSurfaceVariant}" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="位置" FontSize="12" Opacity="0.6"
                                           Foreground="{DynamicResource OnSurfaceVariant}" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="2" Text="{Binding Details.PathText}" FontSize="12"
                                           TextWrapping="Wrap" Foreground="{DynamicResource OnSurface}"/>
                            </Grid>

                            <!-- 文件夹：书签数 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Details.IsFolder}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <m3:M3Icon Kind="link-variant" Width="13" Height="13" Opacity="0.55"
                                           Foreground="{DynamicResource OnSurfaceVariant}"/>
                                <TextBlock Grid.Column="1" Text="链接数" FontSize="12" Opacity="0.6"
                                           Foreground="{DynamicResource OnSurfaceVariant}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Details.BookmarkCountText}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{DynamicResource Primary}"/>
                            </Grid>

                            <!-- 最后更新 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <m3:M3Icon Kind="refresh" Width="13" Height="13" Opacity="0.55"
                                           Foreground="{DynamicResource OnSurfaceVariant}"/>
                                <TextBlock Grid.Column="1" Text="最后更新" FontSize="12" Opacity="0.6"
                                           Foreground="{DynamicResource OnSurfaceVariant}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Details.UpdatedText}" FontSize="12"
                                           Foreground="{DynamicResource OnSurface}"/>
                            </Grid>

                            <!-- 最后查看（仅书签） -->
                            <Grid Margin="0,0,0,8">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Details.IsLink}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <m3:M3Icon Kind="history" Width="13" Height="13" Opacity="0.55"
                                           Foreground="{DynamicResource OnSurfaceVariant}"/>
                                <TextBlock Grid.Column="1" Text="最后查看" FontSize="12" Opacity="0.6"
                                           Foreground="{DynamicResource OnSurfaceVariant}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Details.LastVisitedText}" FontSize="12"
                                           Foreground="{DynamicResource OnSurface}"/>
                            </Grid>

                            <!-- 累计查看（仅书签） -->
                            <Grid Margin="0,0,0,8">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Details.IsLink}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <m3:M3Icon Kind="trending-up" Width="13" Height="13" Opacity="0.55"
                                           Foreground="{DynamicResource OnSurfaceVariant}"/>
                                <TextBlock Grid.Column="1" Text="查看次数" FontSize="12" Opacity="0.6"
                                           Foreground="{DynamicResource OnSurfaceVariant}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Details.VisitText}" FontSize="12"
                                           Foreground="{DynamicResource OnSurface}"/>
                            </Grid>

                            <!-- 最后查看（仅文件夹）：内核维护，子孙链接被查看时沿父链刷新 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Details.IsFolder}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <m3:M3Icon Kind="history" Width="13" Height="13" Opacity="0.55"
                                           Foreground="{DynamicResource OnSurfaceVariant}"/>
                                <TextBlock Grid.Column="1" Text="最后查看" FontSize="12" Opacity="0.6"
                                           Foreground="{DynamicResource OnSurfaceVariant}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Details.LastVisitedText}" FontSize="12"
                                           Foreground="{DynamicResource OnSurface}"/>
                            </Grid>

                            <!-- 查看次数（仅文件夹）：内核维护，子孙链接被查看时沿父链 +1（递归继承口径） -->
                            <Grid Margin="0,0,0,8">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Details.IsFolder}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <m3:M3Icon Kind="trending-up" Width="13" Height="13" Opacity="0.55"
                                           Foreground="{DynamicResource OnSurfaceVariant}"/>
                                <TextBlock Grid.Column="1" Text="查看次数" FontSize="12" Opacity="0.6"
                                           Foreground="{DynamicResource OnSurfaceVariant}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Details.ViewCountText}" FontSize="12"
                                           Foreground="{DynamicResource OnSurface}"/>
                            </Grid>

                            <!-- 创建时间（书签与文件夹均显示，文件夹时间由内核维护） -->
                            <Grid Margin="0,0,0,8">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Details.IsSingle}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <m3:M3Icon Kind="plus-circle-outline" Width="13" Height="13" Opacity="0.55"
                                           Foreground="{DynamicResource OnSurfaceVariant}"/>
                                <TextBlock Grid.Column="1" Text="创建时间" FontSize="12" Opacity="0.6"
                                           Foreground="{DynamicResource OnSurfaceVariant}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Details.CreatedText}" FontSize="12"
                                           Foreground="{DynamicResource OnSurface}"/>
                            </Grid>

                            <!-- ID（可复制）：与其他信息行共用 16/62 列宽，图标/标签/值三列严格对齐 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <m3:M3Icon Kind="fingerprint" Width="13" Height="13" Opacity="0.55"
                                           Foreground="{DynamicResource OnSurfaceVariant}"/>
                                <TextBlock Grid.Column="1" Text="ID" FontSize="12" Opacity="0.6"
                                           Foreground="{DynamicResource OnSurfaceVariant}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Details.IdText}" FontSize="11" FontFamily="Consolas"
                                           TextTrimming="CharacterEllipsis" Opacity="0.6" VerticalAlignment="Center"
                                           Foreground="{DynamicResource OnSurfaceVariant}"
                                           ToolTip="{Binding Details.IdText}"/>
                                <Button Grid.Column="3" Style="{StaticResource NavIconButton}" Tag="复制 ID"
                                        Width="24" Height="22" Padding="3" Margin="4,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding Details.CopyIdCommand}">
                                    <m3:M3Icon Kind="content-copy" Width="12" Height="12"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===== 单选书签：描述卡片（置于信息卡之后） ===== -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SideCard}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Details.HasDescription}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="描述" Style="{StaticResource SideLabel}"/>
                            <TextBlock Text="{Binding Details.DescriptionText}" FontSize="12.5" TextWrapping="Wrap"
                                       LineHeight="19" Foreground="{DynamicResource OnSurface}"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== 单选：快捷操作 ===== -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SideCard}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Details.IsSingle}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="操作" Style="{StaticResource SideLabel}"/>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource FilledButton}" Padding="10,7"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Command="{Binding Details.OpenCommand}"
                                        ToolTip="打开（链接进入详情页，文件夹进入目录）">
                                    <StackPanel Orientation="Horizontal">
                                        <m3:M3Icon Kind="open-in-new" Width="14" Height="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="打开" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!-- 链接：编辑（整页编辑器）；文件夹：重命名 -->
                                <Button Grid.Column="1" Style="{StaticResource NavIconButton}"
                                        Tag="{Binding Details.EditLabel}"
                                        Width="32" Height="32" Margin="6,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding Details.RenameCommand}">
                                    <m3:M3Icon Kind="pencil-outline" Width="15" Height="15"/>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource NavIconButton}" Tag="删除"
                                        Width="32" Height="32" VerticalAlignment="Center"
                                        Command="{Binding Details.DeleteCommand}">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="OverrideBrush" Color="#D32F2F"/>
                                    </Button.Resources>
                                    <m3:M3Icon Kind="delete-outline" Width="15" Height="15" Foreground="#D32F2F"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===== 多选：统计卡片 ===== -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SideCard}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Details.IsMulti}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <m3:M3Icon Kind="content-duplicate" Width="26" Height="26"
                                           Foreground="{DynamicResource Primary}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Details.SelectedTotal}" FontSize="22" FontWeight="SemiBold"
                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource OnSurface}"/>
                                <TextBlock Text="项已选中" FontSize="14" Margin="8,0,0,0" Opacity="0.7" VerticalAlignment="Center"
                                           Foreground="{DynamicResource OnSurfaceVariant}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Style="{StaticResource SideChip}">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource OnPrimaryContainer}">
                                        <Run Text="{Binding Details.SelectedFolders, Mode=OneWay}"/>
                                        <Run Text=" 个文件夹"/>
                                    </TextBlock>
                                </Border>
                                <Border Style="{StaticResource SideChip}">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource OnPrimaryContainer}">
                                        <Run Text="{Binding Details.SelectedLinks, Mode=OneWay}"/>
                                        <Run Text=" 个链接"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                            <!-- 多选态只提供「删除所选」：重命名只对单个条目有意义，多选不出现该按钮 -->
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ctrl+点击 可增减选择" FontSize="11" Opacity="0.45" VerticalAlignment="Center"
                                           Foreground="{DynamicResource OnSurfaceVariant}"/>
                                <Button Grid.Column="1" Style="{StaticResource NavIconButton}" Tag="删除所选"
                                        Width="32" Height="32" Margin="6,0,0,0" Command="{Binding Details.DeleteCommand}">
                                    <m3:M3Icon Kind="delete-outline" Width="15" Height="15" Foreground="#D32F2F"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
        </Grid>

        <!-- ===== 状态栏：左右贴边的通栏（无侧向圆角），顶部圆角仅在中央沟槽处与卡片衔接 ===== -->
        <Border Grid.Row="3" MinHeight="36" Background="{DynamicResource TintPanel}"
                CornerRadius="0" Margin="0"
                Padding="16,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource OnSurfaceVariant}"/>
                    <!-- 选中信息：PrimaryContainer 药丸强调（MD3E 关键状态用色彩点亮） -->
                    <Border CornerRadius="9" Background="{DynamicResource PrimaryContainer}"
                            Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding SelectionInfoText}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OnPrimaryContainer}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="LinkPocket · Material 3" FontSize="11" Foreground="{DynamicResource OnSurfaceMuted}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.6"/>
            </Grid>
        </Border>

        <!-- ===== 链接详情页覆盖层：打开时覆盖整个浏览模块（返回后回到浏览视图） ===== -->
        <Grid Grid.Row="0" Grid.RowSpan="3">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDetailPageOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <local:LinkDetailPage DataContext="{Binding DetailPage}"/>
        </Grid>

        <!-- ===== 链接编辑器覆盖层（新建/编辑整页）：位于详情页之上（从详情页点编辑时两层叠加） ===== -->
        <Grid Grid.Row="0" Grid.RowSpan="3">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditorPageOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <local:LinkEditorPage DataContext="{Binding EditorPage}"/>
        </Grid>
    </Grid>
</UserControl>
