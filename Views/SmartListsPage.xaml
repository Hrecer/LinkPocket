<UserControl x:Class="LinkPocket.Views.SmartListsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfaceContainerLowest}">
        <!-- ===== 主页：4个智能列表卡片 ===== -->
        <Grid x:Name="CardPanel">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="28,20,28,24">
                <ItemsControl ItemsSource="{Binding SmartListViewModel.Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="10" MouseLeftButtonUp="Card_MouseLeftButtonUp" Tag="{Binding Id}"
                                    Background="{DynamicResource SurfaceContainer}" CornerRadius="12" Cursor="Hand"
                                    BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.06" Color="Black"/>
                                </Border.Effect>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid MinHeight="120">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" CornerRadius="10" Margin="18,16,18,6"
                                            Background="{DynamicResource SurfaceContainerLow}"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Width="44" Height="44">
                                        <m3:M3Icon Kind="{Binding IconKind}"
                                                                   Width="22" Height="22"
                                                                   Foreground="{Binding Color}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Grid.Row="1" Text="{Binding Title}"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource OnSurface}"
                                               Margin="18,4,18,0"/>

                                    <TextBlock Grid.Row="2" Text="{Binding Subtitle}"
                                               FontSize="12" Foreground="{DynamicResource OnSurfaceMuted}"
                                               Margin="18,2,18,14"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ===== 结果面板：与搜索结果一致的布局 ===== -->
        <Grid x:Name="ResultPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SurfaceContainer}"
                    Padding="12,10" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="BackButton_Click" Cursor="Hand" Padding="10,6">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TextButton}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <m3:M3Icon Kind="arrow-left" Width="17" Height="17"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Primary}"/>
                            <TextBlock Text="返回" FontSize="13" Foreground="{DynamicResource Primary}"
                                       VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="{Binding ResultViewModel.Title}"
                               FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource OnSurface}"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>

                    <Button x:Name="JumpToLinkBtn" Padding="10,6" Margin="14,0,0,0"
                            Click="JumpToLink_Click" IsEnabled="False" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TextButton}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.35"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <m3:M3Icon Kind="open-in-new" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="跳转" FontSize="13" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="28,8,28,24" PreviewMouseLeftButtonDown="ResultArea_MouseLeftButtonDown">
                <StackPanel x:Name="ResultContentPanel" HorizontalAlignment="Center">

                    <StackPanel x:Name="LoadingIndicator" HorizontalAlignment="Center" Margin="0,70,0,0"
                                Visibility="{Binding ResultViewModel.IsLoading, Converter={StaticResource BoolToVis}}">
                        <ProgressBar IsIndeterminate="True" Width="100" Height="3" Foreground="{DynamicResource Primary}"/>
                        <TextBlock Text="加载中..." FontSize="12" Foreground="{DynamicResource OnSurfaceMuted}" HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="EmptyPlaceholder" HorizontalAlignment="Center" Margin="0,70,0,0"
                                Visibility="Collapsed">
                        <m3:M3Icon Kind="bookmark-off-outline" Width="42" Height="42"
                                                   HorizontalAlignment="Center" Opacity="0.12"/>
                        <TextBlock Text="{Binding ResultViewModel.EmptyMessage}" FontSize="13" Opacity="0.3"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="ResultCardsPanel" HorizontalAlignment="Center"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
