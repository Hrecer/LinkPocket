<UserControl x:Class="LinkPocket.Views.ToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Loaded="ToolsPage_Loaded" Unloaded="ToolsPage_Unloaded">
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0"
                Background="#FAFAFA">
            <StackPanel>
                <TextBlock Text="工具箱" FontSize="16" FontWeight="SemiBold" Margin="16,16,16,12"
                            Foreground="#333333"/>
                <ListBox x:Name="ToolListbox" BorderThickness="0" Background="Transparent"
                         DisplayMemberPath="Name"
                         SelectionChanged="ToolListbox_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="Padding" Value="16,10"/>
                            <Setter Property="FontSize" Value="13"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="1" Background="{DynamicResource MaterialDesignDivider}"
                      HorizontalAlignment="Stretch"/>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      Padding="20,16">
            <StackPanel x:Name="ToolContentPanel"/>
        </ScrollViewer>
    </Grid>
</UserControl>