<UserControl x:Class="LinkPocket.Views.TrashPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Focusable="True"
             PreviewKeyDown="TrashPage_PreviewKeyDown"
             PreviewMouseLeftButtonDown="TrashPage_PreviewMouseLeftButtonDown">
    <DockPanel Background="Transparent">
        <Separator DockPanel.Dock="Top" Background="{DynamicResource MaterialDesignDivider}" Margin="0,0,0,0"/>
        <StackPanel x:Name="TrashToolbar" DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="0,12,0,8">
                <Button x:Name="TrashRestoreBtn" Padding="12,6" Margin="0,0,8,0" Cursor="Hand"
                        Click="TrashRestore_Click" IsEnabled="False">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="#6200EE"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Restore" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="恢复" Margin="5,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TrashDeleteBtn" Padding="12,6" Cursor="Hand"
                        Click="TrashPermanentDelete_Click" IsEnabled="False">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="#E53935"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DeleteForever" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="永久删除" Margin="5,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        <ScrollViewer x:Name="TrashScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,12">
                <StackPanel x:Name="TrashContentPanel"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>