<Window x:Class="LinkPocket.Views.AddLinkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:LinkPocket.ViewModels"
        Title="添加新链接"
        Width="480"
        Height="360"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <materialDesign:PackIcon Kind="LinkPlus" Width="28" Height="28" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="添加新链接" FontSize="20" FontWeight="Medium" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
        
        <StackPanel Grid.Row="1" Margin="0,8">
            <TextBox materialDesign:HintAssist.Hint="URL地址 *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding Url, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     Margin="0,8"/>
            
            <TextBox materialDesign:HintAssist.Hint="标题 *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     Margin="0,12,0,0"/>
            
            <TextBox materialDesign:HintAssist.Hint="描述（可选）"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="80"
                     Margin="0,12,0,0"/>

            <ComboBox materialDesign:HintAssist.Hint="所属目录（可选）"
                      ItemsSource="{Binding Folders}"
                      SelectedValue="{Binding SelectedListId}"
                      DisplayMemberPath="DisplayText"
                      SelectedValuePath="Id"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Margin="0,12,0,0"/>
            
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ValidationErrorBrush}"
                       TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                       Margin="0,12,0,0"/>
        </StackPanel>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Command="{Binding CancelCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" MinWidth="80" Margin="0,0,12,0"/>
            <Button Command="{Binding SaveCommand}" IsDefault="true"
                    Style="{StaticResource MaterialDesignRaisedButton}" MinWidth="80">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                                 Style="{StaticResource MaterialDesignCircularProgressBar}"/>
                    <TextBlock Text="{Binding SaveButtonText}"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
