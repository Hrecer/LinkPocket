<UserControl x:Class="LinkPocket.Views.BackupPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <StackPanel Margin="32,24,32,24">

        <TextBlock Text="导出备份" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="将所有书签和文件夹导出为 LinkPocket 专用备份格式（.lpbackup），完整保留描述、访问统计、重要标记和图标文件"
                   FontSize="13" Opacity="0.55" Margin="0,0,0,28" TextWrapping="Wrap"/>

        <TextBlock Text="导出目录" FontSize="13" Opacity="0.6" Margin="0,0,0,6"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="BackupExportDirTextBox" Grid.Column="0"
                     IsReadOnly="True"
                     Padding="10,8" FontSize="13"
                     Foreground="#333333"
                     Background="#F5F5F5"
                     BorderBrush="#CCCCCC" BorderThickness="1.5"
                     materialDesign:HintAssist.Hint="选择导出目录..."/>
            <Button Grid.Column="1" x:Name="BrowseBackupExportDirButton"
                    Content="浏览" Margin="8,0,0,0" Padding="14,8"
                    Cursor="Hand" Click="BrowseBackupExportDirButton_Click"
                    BorderThickness="1.5" BorderBrush="#CCCCCC" Background="#F5F5F5"
                    FontSize="13"/>
        </Grid>

        <Button x:Name="BackupExportButton" Margin="0,24,0,0"
                Padding="20,10" HorizontalAlignment="Left" Cursor="Hand"
                Click="BackupExportButton_Click" IsEnabled="False"
                FontSize="14" FontWeight="SemiBold"
                materialDesign:ButtonAssist.CornerRadius="6">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#6200EE"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#E0E0E0"/>
                            <Setter Property="Foreground" Value="#999999"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#5000CC"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Export" Width="18" Height="18"
                                         VerticalAlignment="Center"/>
                <TextBlock Text="  开始导出" Margin="0,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Separator Margin="0,32,0,32"/>

        <TextBlock Text="导入备份" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="从 LinkPocket 备份文件（.lpbackup）恢复书签和文件夹数据，所有数据将完整添加到现有数据库中"
                   FontSize="13" Opacity="0.55" Margin="0,0,0,28" TextWrapping="Wrap"/>

        <TextBlock Text="选择导入文件" FontSize="13" Opacity="0.6" Margin="0,0,0,6"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="BackupImportFileTextBox" Grid.Column="0"
                     IsReadOnly="True" Padding="10,8" FontSize="13"
                     Foreground="#333333" Background="#F5F5F5"
                     BorderBrush="#CCCCCC" BorderThickness="1.5"
                     materialDesign:HintAssist.Hint="选择 .lpbackup 备份文件..."/>
            <Button Grid.Column="1" x:Name="BrowseBackupImportButton"
                    Content="浏览" Margin="8,0,0,0" Padding="14,8"
                    Cursor="Hand" Click="BrowseBackupImportButton_Click"
                    BorderThickness="1.5" BorderBrush="#CCCCCC" Background="#F5F5F5"
                    FontSize="13"/>
        </Grid>

        <Button x:Name="BackupImportButton" Margin="0,24,0,0"
                Padding="20,10" HorizontalAlignment="Left" Cursor="Hand"
                Click="BackupImportButton_Click" IsEnabled="False"
                FontSize="14" FontWeight="SemiBold"
                materialDesign:ButtonAssist.CornerRadius="6">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#6200EE"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#E0E0E0"/>
                            <Setter Property="Foreground" Value="#999999"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#5000CC"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Import" Width="18" Height="18"
                                         VerticalAlignment="Center"/>
                <TextBlock Text="  开始导入" Margin="0,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

    </StackPanel>
</UserControl>
