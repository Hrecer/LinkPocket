<Project>

  <!-- 中央包管理：所有 NuGet 版本号只在此处声明，各 csproj 用无版本 PackageReference 引用 -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageVersion Include="Material3.Wpf" Version="0.9.0" />
    <PackageVersion Include="MdXaml" Version="1.27.0" />
    <!-- 反爬兜底：curl-impersonate 的 .NET HttpMessageHandler（浏览器 TLS/HTTP2 指纹）——仅 Links 模块的元数据抓取在反爬拦截（403/503）时使用 -->
    <PackageVersion Include="CurlImpersonate.Http" Version="1.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <!-- 更新器直读库头纪元戳（user_version）用；版本与 EF Sqlite 同源 -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- 前端组合根：对象图由容器装配（只被 Shell/组合根引用，不进契约层与引擎层） -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <!-- AI 运行时：API Key 的 DPAPI 加密落盘（按 Windows 当前用户；官方包，仅 LinkPocket.Ai 引用） -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <!-- 测试栈：Test.Sdk 17.x 的 vstest 宿主不认识 net10 测试目标，必须 18.x（vstest 侧要求） -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
