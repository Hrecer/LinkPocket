<Window x:Class="LinkPocket.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LinkPocket"
        xmlns:vm="clr-namespace:LinkPocket.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mdxaml="clr-namespace:MdXaml;assembly=MdXaml"
        xmlns:views="clr-namespace:LinkPocket.Views"
        mc:Ignorable="d"
        Title="LinkPocket"
        Height="720" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#FFFFFF"
        TextElement.FontFamily="{DynamicResource MaterialDesignFont}"
        TextElement.Foreground="Black"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="8"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#BF0F1D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <local:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <vm:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVis"/>
        <vm:FaviconConverter x:Key="FaviconConverter"/>
    </Window.Resources>

    <Grid x:Name="RootGrid" PreviewMouseLeftButtonDown="RootGrid_PreviewMouseLeftButtonDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 全局标题栏（所有页面共享） ===== -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,10,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon Kind="LinkVariant" Width="24" Height="24" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="LinkPocket" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <ItemsControl Grid.Column="1" x:Name="NavigationTabs" ItemsSource="{Binding NavigationItems}" WindowChrome.IsHitTestVisibleInChrome="True">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInSecondaryPage}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ToolbarButton}"
                                    Command="{Binding DataContext.SelectNavCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Id}"
                                    FontWeight="{Binding IsSelected, Converter={StaticResource BoolToFontWeightConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="{Binding IconKind}" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Label}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click" ToolTip="最小化">
                        <Path Data="M0,6 L10,6" Stroke="#333333" StrokeThickness="1.2" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Width="10" Height="10"/>
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click" ToolTip="最大化">
                        <Path Data="M2,0 L8,0 A2,2 0 0 1 10,2 L10,8 A2,2 0 0 1 8,10 L2,10 A2,2 0 0 1 0,8 L0,2 A2,2 0 0 1 2,0 Z" Stroke="#333333" StrokeThickness="1.2" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Width="10" Height="10"/>
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="CloseButton_Click" ToolTip="关闭">
                        <Path Data="M2,2 L8,8 M8,2 L2,8" Stroke="#333333" StrokeThickness="1.3" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Width="10" Height="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 主界面（链接+回收站） ===== -->
        <Grid Grid.Row="1" x:Name="MainView">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentNavId}" Value="search">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentNavId}" Value="trash">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentNavId}" Value="smartlists">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentNavId}" Value="ai">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentNavId}" Value="vault">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentNavId}" Value="settings">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- 主内容区 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="160" MaxWidth="400"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220" MinWidth="160" MaxWidth="360"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧边栏 -->
                <Border Grid.Column="0" x:Name="LeftSidebarBorder">
                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentNavId, RelativeSource={RelativeSource AncestorType=Window}}" Value="trash"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FolderListPanel" Margin="4,8,4,8"/>
                    </ScrollViewer>
                </Border>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="{DynamicResource MaterialDesignDivider}" Cursor="SizeWE">
                    <GridSplitter.Style><Style TargetType="GridSplitter"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentNavId, RelativeSource={RelativeSource AncestorType=Window}}" Value="trash"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></GridSplitter.Style>
                </GridSplitter>

                <!-- 中间内容区域 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 操作栏 -->
                    <Border Grid.Row="0" x:Name="ActionBar" Background="{DynamicResource MaterialDesignCardBackground}" Padding="12,10" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentNavId, RelativeSource={RelativeSource AncestorType=Window}}" Value="trash"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Padding="12,8" Margin="4,0" Cursor="Hand"
                                    Command="{Binding DataContext.ShowAddLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="添加新链接">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="添加" Margin="6,0,0,0" FontSize="14" VerticalAlignment="Center" FontFamily="Microsoft YaHei UI"/>
                                </StackPanel>
                            </Button>
                            <Button Padding="12,8" Margin="4,0" Cursor="Hand"
                                    Command="{Binding DataContext.CreateFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="新建文件夹">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderPlus" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="新建文件夹" Margin="6,0,0,0" FontSize="14" VerticalAlignment="Center" FontFamily="Microsoft YaHei UI"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="DeleteButton" Padding="12,8" Margin="4,0"
                                    Content="🗑 删除" FontSize="14" FontFamily="Microsoft YaHei UI"
                                    Background="Transparent" BorderThickness="0" Foreground="#D32F2F" Cursor="Hand"
                                    Command="{Binding DataContext.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#FFEBEE"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#FFCDD2"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.4"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="LinkSortButton" Padding="10,8" Margin="16,0,0,0" Cursor="Hand" Click="LinkSortButton_Click"
                                    ToolTip="书签排序">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Sort" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LinkSortButtonText" Text="排序" Margin="6,0,4,0" FontSize="14" VerticalAlignment="Center" FontFamily="Microsoft YaHei UI"/>
                                    <TextBlock x:Name="LinkSortOrderText" Text="↑ 升序" FontSize="12" VerticalAlignment="Center" Foreground="#6200EE"/>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="LinkSortMenu">
                                        <MenuItem Header="按名称 ↑↓" Tag="title" Click="LinkSortMenuItem_Click"/>
                                        <MenuItem Header="最后更新 ↑↓" Tag="updated_at" Click="LinkSortMenuItem_Click"/>
                                        <MenuItem Header="最后查看 ↑↓" Tag="last_visited_at" Click="LinkSortMenuItem_Click"/>
                                        <MenuItem Header="累计查看次数 ↑↓" Tag="visit_count" Click="LinkSortMenuItem_Click"/>
                                        <MenuItem Header="创建时间 ↑↓" Tag="created_at" Click="LinkSortMenuItem_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Border Width="1" Background="{DynamicResource MaterialDesignDivider}" Margin="8,4,0,4" VerticalAlignment="Stretch"/>
                            <Button x:Name="FolderSortButton" Padding="10,8" Margin="0,0,0,0" Cursor="Hand"
                                    Click="FolderSortButton_Click" ToolTip="文件夹按名称排序（点击切换升降序）">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Folder" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="文件夹" Margin="6,0,4,0" FontSize="14" VerticalAlignment="Center" FontFamily="Microsoft YaHei UI"/>
                                    <TextBlock x:Name="FolderSortOrderText" Text="↑ 升序" FontSize="12" VerticalAlignment="Center" Foreground="#6200EE"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 链接列表 -->
                    <Grid Grid.Row="1" x:Name="LinksPage" DataContext="{Binding LinkViewModel}"
                          Background="Transparent"
                          PreviewMouseLeftButtonDown="LinksPage_MouseLeftButtonDown">
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentNavId, RelativeSource={RelativeSource AncestorType=Window}}" Value="links"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                            <ProgressBar IsIndeterminate="True" Width="60" Height="60" Style="{StaticResource MaterialDesignCircularProgressBar}"/>
                            <TextBlock Text="正在加载链接..." FontSize="14" Opacity="0.6" Margin="0,16,0,0"/>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="56" Height="56" HorizontalAlignment="Center" Opacity="0.4" Foreground="{DynamicResource ValidationErrorBrush}"/>
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="14" HorizontalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource ValidationErrorBrush}" MaxWidth="400" Margin="0,16,0,12"/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <StackPanel x:Name="MainListContentPanel" Margin="8"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- 其他页面占位 -->
                    <!-- 密码库页面已移至独立视图 -->
                    <!-- 智能列表页面已移至独立视图 -->
                    <!-- 搜索页面已移至独立视图 -->
                    <!-- 回收站页面已移至独立视图 -->
                    <!-- 设置页面已移至独立视图 -->
                </Grid>

                <!-- 右侧分隔线 -->
                <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="{DynamicResource MaterialDesignDivider}" Cursor="SizeWE">
                    <GridSplitter.Style><Style TargetType="GridSplitter"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentNavId, RelativeSource={RelativeSource AncestorType=Window}}" Value="trash"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></GridSplitter.Style>
                </GridSplitter>

                <!-- 右侧详情栏 -->
                <Border Grid.Column="4" x:Name="RightSidebarBorder" ContextMenu="{x:Null}" PreviewMouseRightButtonUp="SuppressContextMenu_PreviewMouseRightButtonUp">
                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentNavId, RelativeSource={RelativeSource AncestorType=Window}}" Value="trash"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="DetailPanel" Margin="16,8,16,16"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== 搜索视图（左侧结果 + 右侧常驻固定栏） ===== -->
        <Grid Grid.Row="1" x:Name="SearchView" Background="#FFFFFF">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentNavId}" Value="search">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220" MinWidth="160" MaxWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：搜索框 + 跳转工具栏 + 结果列表 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="28,20,28,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Grid.Column="0" Padding="12,10" FontSize="14"
                                 materialDesign:HintAssist.Hint="输入书签标题搜索..."
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 VerticalContentAlignment="Center"
                                 KeyDown="SearchBox_KeyDown"/>
                        <Button x:Name="SearchSortButton" Grid.Column="1" Padding="10,8" Margin="8,0,8,0" Cursor="Hand" Click="SearchSortButton_Click"
                                ToolTip="结果排序">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Sort" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SearchSortButtonText" Text="按名称" Margin="6,0,4,0" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SearchSortOrderText" Text="↑ 升序" FontSize="12" VerticalAlignment="Center" Foreground="#6200EE"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="SearchSortMenu">
                                    <MenuItem Header="按名称 ↑↓" Tag="title" Click="SearchSortMenuItem_Click"/>
                                    <MenuItem Header="最后更新 ↑↓" Tag="updated_at" Click="SearchSortMenuItem_Click"/>
                                    <MenuItem Header="最后查看 ↑↓" Tag="last_visited_at" Click="SearchSortMenuItem_Click"/>
                                    <MenuItem Header="累计查看次数 ↑↓" Tag="visit_count" Click="SearchSortMenuItem_Click"/>
                                    <MenuItem Header="创建时间 ↑↓" Tag="created_at" Click="SearchSortMenuItem_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Grid.Column="2" Content="搜索" Padding="18,8" FontSize="13"
                                Style="{StaticResource MaterialDesignRaisedButton}" Click="SearchButton_Click"
                                VerticalAlignment="Center" Margin="8,0,8,0"/>
                        <Button Grid.Column="3" Content="取消" Padding="18,8" FontSize="13"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Click="SearchCancelButton_Click"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 搜索框下方常驻工具栏（有分隔线） -->
                <Border x:Name="SearchToolbar" Grid.Row="1" Background="{DynamicResource MaterialDesignCardBackground}"
                        Padding="16,8,16,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MaterialDesignDivider}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="SearchJumpToLinkBtn"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Padding="20,6"
                                Click="SearchJumpToLinkBtn_Click" IsEnabled="False"
                                Cursor="Hand">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="OpenInNew" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="跳转到链接页" FontSize="12"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,8,28,24"
                              PreviewMouseLeftButtonDown="SearchResultsArea_MouseLeftButtonDown">
                    <StackPanel x:Name="SearchResultsPanel" HorizontalAlignment="Center">
                        <StackPanel x:Name="SearchEmptyPlaceholder" HorizontalAlignment="Center" Margin="0,80,0,0">
                            <materialDesign:PackIcon Kind="Magnify" Width="48" Height="48" HorizontalAlignment="Center" Opacity="0.15"/>
                            <TextBlock Text="输入关键词开始搜索" FontSize="14" Opacity="0.35"
                                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <TextBlock Text="单击结果卡片查看详情" FontSize="12" Opacity="0.25"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 分隔线 -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{DynamicResource MaterialDesignDivider}" Cursor="SizeWE">
                <GridSplitter.Style>
                    <Style TargetType="GridSplitter">
                        <Setter Property="Visibility" Value="Visible"/>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>

            <!-- 右侧常驻栏（与主界面DetailPanel结构和样式完全一致） -->
            <Border Grid.Column="2" x:Name="SearchRightSidebarBorder" ContextMenu="{x:Null}" PreviewMouseRightButtonUp="SuppressContextMenu_PreviewMouseRightButtonUp">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SearchFixedSidebar" Margin="16,8,16,16">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,80,0,0">
                            <materialDesign:PackIcon Kind="BookmarkOutline" Width="48" Height="48" HorizontalAlignment="Center" Opacity="0.15"/>
                            <TextBlock Text="选中书签查看详情" FontSize="13" Opacity="0.3" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== 回收站视图（独立页面） ===== -->
        <views:TrashPage Grid.Row="1" x:Name="TrashView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <views:TrashPage.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentNavId}" Value="trash">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:TrashPage.Style>
        </views:TrashPage>

        <!-- ===== 智能列表视图（独立页面） ===== -->
        <views:SmartListsPage Grid.Row="1" x:Name="SmartListsView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <views:SmartListsPage.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentNavId}" Value="smartlists">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:SmartListsPage.Style>
        </views:SmartListsPage>

        <!-- ===== AI 助手视图（独立页面） ===== -->
        <views:AIAssistantPage Grid.Row="1" x:Name="AIAssistantView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <views:AIAssistantPage.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentNavId}" Value="ai">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:AIAssistantPage.Style>
        </views:AIAssistantPage>

        <!-- ===== 密码库视图（独立页面） ===== -->
        <views:VaultPage Grid.Row="1" x:Name="VaultView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <views:VaultPage.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentNavId}" Value="vault">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:VaultPage.Style>
        </views:VaultPage>

        <!-- ===== 设置视图（独立页面） ===== -->
        <views:SettingsPage Grid.Row="1" x:Name="SettingsView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <views:SettingsPage.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentNavId}" Value="settings">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:SettingsPage.Style>
        </views:SettingsPage>

        <!-- ===== 详情视图页面 ===== -->
        <Grid Grid.Row="1" x:Name="DetailView" Visibility="Collapsed" WindowChrome.IsHitTestVisibleInChrome="True" ContextMenu="{x:Null}"
              PreviewMouseRightButtonUp="SuppressContextMenu_PreviewMouseRightButtonUp" Background="#FFFFFF">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 操作栏（返回 + 编辑按钮 + 页面标题） -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="12,8" Background="{DynamicResource MaterialDesignCardBackground}" WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Command="{Binding CancelDetailCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="8,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="返回" Margin="6,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DetailEditCommand}" Style="{StaticResource MaterialDesignRaisedButton}" MinWidth="70" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Pencil" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="编辑" Margin="5,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="EyeOutline" Width="20" Height="20" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="书签详情" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容区 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ContextMenu="{x:Null}">
                <StackPanel Margin="48,32,48,32">

                    <!-- 所属目录 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <materialDesign:PackIcon Kind="FolderOutline" Width="14" Height="14" VerticalAlignment="Center" Foreground="#888888"/>
                        <TextBlock Text="{Binding DetailFolderName}" FontSize="12" Opacity="0.7" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>

                    <!-- URL -->
                    <TextBlock Text="URL" FontSize="12" Opacity="0.5" Margin="0,0,0,4"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  MaxHeight="40" Margin="0,0,0,8">
                        <TextBox Text="{Binding DetailUrl}" FontSize="14" TextWrapping="NoWrap" IsReadOnly="True"
                                 Background="Transparent" BorderThickness="0" Padding="0" Focusable="True" Foreground="Black"
                                 VerticalAlignment="Center" ContextMenu="{x:Null}"/>
                    </ScrollViewer>
                    <Button Padding="6,3" Margin="0,0,0,20" Cursor="Hand" Background="Transparent" BorderThickness="0"
                            ToolTip="复制URL" Click="CopyDetailUrl_Click" HorizontalAlignment="Left">
                        <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" VerticalAlignment="Center" Foreground="#666666"/>
                    </Button>

                    <!-- 图标区域 -->
                    <Border Margin="0,16,0,16" Background="Transparent" CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="48" Height="48" CornerRadius="8" Background="White"
                                    ClipToBounds="True" VerticalAlignment="Center">
                                <Grid>
                                    <Image Source="{Binding DetailFaviconImage}" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DetailFaviconImage}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <materialDesign:PackIcon Kind="Earth" Width="26" Height="26"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DetailFaviconUrl}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 标题 -->
                    <TextBlock Text="标题" FontSize="12" Opacity="0.5" Margin="0,0,0,4"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  MaxHeight="50" Margin="0,0,0,20">
                        <TextBox Text="{Binding DetailTitle}" FontSize="24" FontWeight="SemiBold" TextWrapping="NoWrap"
                                 IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0" Focusable="True" Foreground="Black" ContextMenu="{x:Null}"/>
                    </ScrollViewer>

                    <!-- 描述 (Markdown) -->
                    <TextBlock Text="描述" FontSize="12" Opacity="0.5" Margin="0,0,0,4"/>
                    <mdxaml:MarkdownScrollViewer x:Name="DetailMarkdownViewer"
                                                  Markdown="{Binding DetailDescription}"
                                                  FontFamily="Microsoft YaHei UI"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  PreviewMouseWheel="DetailMarkdownViewer_PreviewMouseWheel"
                                                  RequestBringIntoView="DetailMarkdownViewer_RequestBringIntoView"
                                                  Margin="0,0,0,28">
                        <mdxaml:MarkdownScrollViewer.MarkdownStyle>
                            <Style TargetType="FlowDocument" BasedOn="{x:Static mdxaml:MarkdownStyle.GithubLike}">
                                <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Style.Resources>
                                    <Style TargetType="Paragraph">
                                        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
                                    </Style>
                                    <Style TargetType="Run">
                                        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
                                    </Style>
                                </Style.Resources>
                            </Style>
                        </mdxaml:MarkdownScrollViewer.MarkdownStyle>
                    </mdxaml:MarkdownScrollViewer>

                    <Separator Opacity="0.3" Margin="0,0,0,20"/>

                    <!-- 最后更新 -->
                    <TextBlock Text="最后更新" FontSize="11" Opacity="0.45" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DetailUpdatedAtDisplay}" FontSize="13" Opacity="0.65" Margin="0,0,0,12"
                             IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0" Focusable="True" Foreground="Black" ContextMenu="{x:Null}"/>

                    <!-- 最后查看 -->
                    <TextBlock Text="最后查看" FontSize="11" Opacity="0.45" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DetailLastVisitedAtDisplay}" FontSize="13" Opacity="0.65" Margin="0,0,0,12"
                             IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0" Focusable="True" Foreground="Black" ContextMenu="{x:Null}"/>

                    <!-- 累计查看次数 -->
                    <TextBlock Text="累计查看次数" FontSize="11" Opacity="0.45" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DetailVisitCountDisplay}" FontSize="13" Opacity="0.65" Margin="0,0,0,12"
                             IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0" Focusable="True" Foreground="Black" ContextMenu="{x:Null}"/>

                    <!-- 创建时间 -->
                    <TextBlock Text="创建时间" FontSize="11" Opacity="0.45" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DetailCreatedAtDisplay}" FontSize="13" Opacity="0.65" Margin="0,0,0,12"
                             IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0" Focusable="True" Foreground="Black" ContextMenu="{x:Null}"/>

                    <!-- ID -->
                    <TextBlock Text="ID" FontSize="11" Opacity="0.45" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <TextBox Text="{Binding DetailLinkIdDisplay}" FontSize="12" FontFamily="Consolas" Opacity="0.45" TextWrapping="Wrap"
                                 IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0" Focusable="True" Foreground="Black" ContextMenu="{x:Null}"/>
                        <Button Padding="6,2" Margin="8,0,0,0" Cursor="Hand" Background="Transparent" BorderThickness="0" ToolTip="复制ID"
                                Click="CopyDetailId_Click">
                            <materialDesign:PackIcon Kind="ContentCopy" Width="13" Height="13" VerticalAlignment="Center" Foreground="#666666"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== 添加/编辑链接页面 ===== -->
        <Grid Grid.Row="1" x:Name="EditLinkView" Visibility="Collapsed" WindowChrome.IsHitTestVisibleInChrome="True" Background="#FFFFFF">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 操作栏（返回 + 保存按钮 + 页面标题） -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="12,8" Background="{DynamicResource MaterialDesignCardBackground}" WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Command="{Binding CancelEditLinkCommand}" Padding="8,6" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFetchingMetadata}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="返回" Margin="6,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveEditLinkCommand}" MinWidth="70" Padding="12,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFetchingMetadata}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <ProgressBar IsIndeterminate="True" Width="14" Height="14" Margin="0,0,6,0"
                                             Visibility="{Binding EditLinkIsLoading, Converter={StaticResource BoolToVis}}"
                                             Style="{StaticResource MaterialDesignCircularProgressBar}"/>
                                <TextBlock Text="保存" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="{Binding EditLinkPageIcon}" Width="20" Height="20" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding EditLinkPageTitle}" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 表单（可滚动） -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid MinHeight="400" Margin="48,32,48,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="URL地址" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding EditLinkUrl, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="12,10"/>
                    <Button Grid.Column="1" Command="{Binding FetchMetadataCommand}" Margin="8,0,0,0"
                            VerticalAlignment="Stretch" HorizontalAlignment="Right"
                            ToolTip="自动解析标题和图标" FontSize="14" FontFamily="Microsoft YaHei UI"
                            BorderThickness="1.5" BorderBrush="#CCCCCC" Background="#F5F5F5"
                            MinWidth="80" Content="自动解析">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFetchingMetadata}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- 图标区域 -->
                <Border Grid.Row="1" Margin="0,16,0,8"
                        Background="Transparent" CornerRadius="6">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="48" Height="48" CornerRadius="8" Background="White"
                                ClipToBounds="True" VerticalAlignment="Center">
                            <Grid>
                                <Image Source="{Binding EditLinkFaviconImage}" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EditLinkFaviconImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <materialDesign:PackIcon Kind="Earth" Width="26" Height="26"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EditLinkFaviconImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </Grid>
                        </Border>
                        <Button Command="{Binding ClearFaviconCommand}" Margin="12,0,0,0" Padding="10,5"
                                ToolTip="清除已解析的图标" FontSize="12" FontFamily="Microsoft YaHei UI"
                                BorderThickness="1" BorderBrush="#CCCCCC" Background="#FFFFFF"
                                Content="✕ 清除图标" Cursor="Hand" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBox Grid.Row="2" materialDesign:HintAssist.Hint="标题" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding EditLinkTitle, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="12,10"/>

                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="描述" FontSize="13" Opacity="0.6" Margin="4,0,0,4"/>
                    <TextBox Grid.Row="1" Text="{Binding EditLinkDescription, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" FontSize="16"
                             MinHeight="80"
                             Foreground="{DynamicResource MaterialDesignBody}"
                             CaretBrush="{DynamicResource MaterialDesignBody}">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border x:Name="border" Background="Transparent"
                                        BorderBrush="#44000000"
                                        BorderThickness="1.5" CornerRadius="4"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Focusable="False"
                                                  Margin="14,12"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="BorderBrush" Value="#99000000"/>
                                        <Setter TargetName="border" Property="Background" Value="#08000000"/>
                                    </Trigger>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter TargetName="border" Property="BorderBrush" Value="Black"/>
                                        <Setter TargetName="border" Property="Background" Value="#0A000000"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Grid>

                <StackPanel Grid.Row="4" Margin="0,20,0,0"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="最后更新" FontSize="11" Opacity="0.5" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding EditLinkUpdatedAtDisplay}" FontSize="13" Opacity="0.6" Margin="0,0,0,12"/>
                    <TextBlock Text="最后查看" FontSize="11" Opacity="0.5" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding EditLinkLastVisitedAtDisplay}" FontSize="13" Opacity="0.6" Margin="0,0,0,12"/>
                    <TextBlock Text="累计查看次数" FontSize="11" Opacity="0.5" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding EditLinkVisitCountDisplay}" FontSize="13" Opacity="0.6" Margin="0,0,0,12"/>
                    <TextBlock Text="创建时间" FontSize="11" Opacity="0.5" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding EditLinkCreatedAtDisplay}" FontSize="13" Opacity="0.6" Margin="0,0,0,12"/>
                    <TextBlock Text="ID" FontSize="11" Opacity="0.5" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding EditLinkIdDisplay}" FontSize="11" FontFamily="Consolas" Opacity="0.4" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button Padding="4,2" Margin="6,0,0,0" Cursor="Hand" Background="Transparent" BorderThickness="0" ToolTip="复制ID"
                                Click="CopyEditId_Click">
                            <materialDesign:PackIcon Kind="ContentCopy" Width="11" Height="11" VerticalAlignment="Center" Opacity="0.35"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="8" Text="{Binding EditLinkErrorMessage}" Foreground="{DynamicResource ValidationErrorBrush}"
                           TextWrapping="Wrap" Visibility="{Binding EditLinkHasError, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0"/>
                </Grid>
            </ScrollViewer>

            <!-- 解析中遮罩层 -->
            <Border Visibility="{Binding IsFetchOverlayVisible, Converter={StaticResource BoolToVis}}"
                    Background="#AA000000" Panel.ZIndex="100"
                    Grid.RowSpan="3">
                <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="White" CornerRadius="12"
                        Padding="32,24" Width="280">
                    <StackPanel>
                        <ProgressBar IsIndeterminate="True" Height="4"
                                     Margin="0,0,0,16"
                                     Style="{StaticResource MaterialDesignCircularProgressBar}"/>
                        <TextBlock Text="{Binding FetchStatusMessage}" FontSize="14"
                                   HorizontalAlignment="Center"
                                   Foreground="#333333"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- ===== 新建文件夹内嵌对话框（遮罩+居中卡片） ===== -->
        <Border Grid.RowSpan="2" Visibility="{Binding IsNewFolderDialogVisible, Converter={StaticResource BoolToVis}}"
                Background="#60000000" Panel.ZIndex="100">
            <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="White" CornerRadius="12"
                    BorderBrush="#E0E0E0" BorderThickness="1"
                    Padding="32,28,32,24" Width="380">
                <StackPanel>
                    <TextBlock Text="新建文件夹" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,20"/>

                    <TextBox x:Name="NewFolderNameBox" Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Padding="12,10"
                             materialDesign:HintAssist.Hint="文件夹名称"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             PreviewKeyDown="NewFolderNameBox_PreviewKeyDown"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="取消" Padding="20,7" Margin="0,0,10,0" Cursor="Hand"
                                Command="{Binding CancelCreateFolderCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                materialDesign:ButtonAssist.CornerRadius="6"/>
                        <Button Content="创建" Padding="20,7" Cursor="Hand" FontWeight="SemiBold"
                                Command="{Binding ConfirmCreateFolderCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#6200EE" Foreground="White"
                                materialDesign:ButtonAssist.CornerRadius="6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>