<Window x:Class="LinkPocket.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LinkPocket"
        xmlns:vm="clr-namespace:LinkPocket.ViewModels"
        xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
        xmlns:mdxaml="clr-namespace:MdXaml;assembly=MdXaml"
        xmlns:views="clr-namespace:LinkPocket.Views"
        xmlns:browserviews="clr-namespace:LinkPocket.Views.Browser"
        mc:Ignorable="d"
        Title="LinkPocket"
        Height="720" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource Surface}"
        TextElement.FontFamily="{StaticResource AppFont}"
        TextElement.Foreground="{DynamicResource OnSurface}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="8"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="NavTabButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryContainer}"/>
                    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainer}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===== 搜索页（MD3 Expressive）专用样式 ===== -->
        <!-- 胶囊搜索栏内的透明输入框：视觉由外层 SearchBarShell 承担 -->
        <Style x:Key="SearchCapsuleBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <!-- 筛选 chip：药丸形，选中后变低圆角 + SecondaryContainer 强调（MD3E 形状区分状态） -->
        <Style x:Key="SearchChip" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" CornerRadius="14" Background="{DynamicResource SurfaceContainerHigh}"
                                Padding="14,6" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceContainerHighest}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryContainer}"/>
                                <Setter TargetName="Bd" Property="CornerRadius" Value="10"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#BF0F1D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <local:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <vm:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVis"/>
        <vm:FaviconConverter x:Key="FaviconConverter"/>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 全局标题栏（所有页面共享） ===== -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,10,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <m3:M3Icon Kind="link-variant" Width="24" Height="24" Foreground="{DynamicResource Primary}" VerticalAlignment="Center"/>
                    <TextBlock Text="LinkPocket" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <ItemsControl Grid.Column="1" x:Name="NavigationTabs" ItemsSource="{Binding NavigationItems}" WindowChrome.IsHitTestVisibleInChrome="True">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInSecondaryPage}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource NavTabButton}"
                                    Command="{Binding DataContext.SelectNavCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Id}">
                                <StackPanel Orientation="Horizontal">
                                    <m3:M3Icon Kind="{Binding IconKind}" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Label}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click" ToolTip="最小化">
                        <Path Data="M0,6 L10,6" Stroke="{DynamicResource OnSurface}" StrokeThickness="1.2" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Width="10" Height="10"/>
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click" ToolTip="最大化">
                        <Path Data="M2,0 L8,0 A2,2 0 0 1 10,2 L10,8 A2,2 0 0 1 8,10 L2,10 A2,2 0 0 1 0,8 L0,2 A2,2 0 0 1 2,0 Z" Stroke="{DynamicResource OnSurface}" StrokeThickness="1.2" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Width="10" Height="10"/>
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="CloseButton_Click" ToolTip="关闭">
                        <Path Data="M2,2 L8,8 M8,2 L2,8" Stroke="{DynamicResource OnSurface}" StrokeThickness="1.3" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Width="10" Height="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 搜索视图（左侧结果 + 右侧常驻固定栏） ===== -->
        <Grid Grid.Row="1" x:Name="SearchView" Background="{DynamicResource SurfaceContainerLow}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentNavId}" Value="search">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220" MinWidth="160" MaxWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：搜索框 + 跳转工具栏(含筛选项) + 结果列表 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="28,22,28,6">
                    <!-- 胶囊搜索栏（视觉重心）：聚焦时高度 52→62、圆角 26→20 形变，弹簧曲线。
                         ⚠️ 基态值必须写在 Style.Setters 里（本地值优先级高于样式触发器）。 -->
                    <Border x:Name="SearchBarShell" Height="52"
                            BorderThickness="2"
                            Padding="20,0,12,0" HorizontalAlignment="Stretch">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="26"/>
                                <Setter Property="Background" Value="{DynamicResource SurfaceContainerHigh}"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighest}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
                                        <Setter Property="CornerRadius" Value="20"/>
                                        <Setter Property="Height" Value="62"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <m3:M3Icon Grid.Column="0" Kind="magnify" Width="22" Height="22"
                                       Foreground="{DynamicResource Primary}" VerticalAlignment="Center"/>

                            <Grid Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="搜索书签、网址或描述…" FontSize="16" VerticalAlignment="Center"
                                           Foreground="{DynamicResource OnSurfaceVariant}" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox, FallbackValue=0}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="SearchBox" Style="{StaticResource SearchCapsuleBox}"
                                         Background="Transparent"
                                         KeyDown="SearchBox_KeyDown"/>
                            </Grid>

                            <Button x:Name="SearchSortButton" Grid.Column="2" Padding="10,8" Margin="8,0,4,0" Cursor="Hand" Click="SearchSortButton_Click"
                                    ToolTip="结果排序" VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TextButton}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <m3:M3Icon Kind="sort" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SearchSortButtonText" Text="按名称" Margin="6,0,4,0" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SearchSortOrderText" Text="↑ 升序" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Primary}"/>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="SearchSortMenu">
                                        <MenuItem Header="按名称 ↑↓" Tag="title" Click="SearchSortMenuItem_Click"/>
                                        <MenuItem Header="最后更新 ↑↓" Tag="updated_at" Click="SearchSortMenuItem_Click"/>
                                        <MenuItem Header="最后查看 ↑↓" Tag="last_visited_at" Click="SearchSortMenuItem_Click"/>
                                        <MenuItem Header="累计查看次数 ↑↓" Tag="visit_count" Click="SearchSortMenuItem_Click"/>
                                        <MenuItem Header="创建时间 ↑↓" Tag="created_at" Click="SearchSortMenuItem_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Grid.Column="3" Content="搜索" Padding="20,9" FontSize="13" FontWeight="SemiBold"
                                    Style="{StaticResource FilledButton}" Click="SearchButton_Click"
                                    VerticalAlignment="Center" Margin="4,0,4,0"/>
                            <Button Grid.Column="4" Content="取消" Padding="14,9" FontSize="13"
                                    Style="{StaticResource TextButton}" Click="SearchCancelButton_Click"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Border>

                <!-- 筛选 chip 行（药丸 chip：选中 → SecondaryContainer + 圆角变小） -->
                <StackPanel x:Name="SearchToolbar" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="28,4,28,10">
                    <Button x:Name="SearchJumpToLinkBtn" Click="SearchJumpToLinkBtn_Click" IsEnabled="False"
                            Cursor="Hand" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TextButton}">
                                <Setter Property="Background" Value="{DynamicResource SecondaryContainer}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="14,7"/>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <m3:M3Icon Kind="open-in-new" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="跳转" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="搜索范围" FontSize="12" Foreground="{DynamicResource OnSurfaceVariant}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="SearchPathCb" Content="路径" IsChecked="True" Style="{StaticResource SearchChip}"/>
                    <CheckBox x:Name="SearchUrlCb" Content="URL" IsChecked="True" Style="{StaticResource SearchChip}"/>
                    <CheckBox x:Name="SearchTitleCb" Content="标题" IsChecked="True" Style="{StaticResource SearchChip}"/>
                    <CheckBox x:Name="SearchDescCb" Content="描述" IsChecked="True" Style="{StaticResource SearchChip}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,8,28,24"
                              PreviewMouseLeftButtonDown="SearchResultsArea_MouseLeftButtonDown">
                    <StackPanel x:Name="SearchResultsPanel" HorizontalAlignment="Center">
                        <StackPanel x:Name="SearchEmptyPlaceholder" HorizontalAlignment="Center" Margin="0,72,0,0">
                            <!-- MD3E 空状态：大圆角色块徽章 + 引导性文案 -->
                            <Border Width="96" Height="96" CornerRadius="32"
                                    Background="{DynamicResource PrimaryContainer}"
                                    HorizontalAlignment="Center">
                                <m3:M3Icon Kind="magnify" Width="40" Height="40"
                                           Foreground="{DynamicResource OnPrimaryContainer}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="想找点什么？" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource OnSurface}"
                                       HorizontalAlignment="Center" Margin="0,18,0,0"/>
                            <TextBlock Text="输入关键词，回车即可搜索；也可以用上方标签扩大或缩小范围" FontSize="12"
                                       Foreground="{DynamicResource OnSurfaceVariant}" Opacity="0.85"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 分隔线：弱化为细窄的低对比条（色彩分层替代硬分隔） -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{DynamicResource SurfaceContainerHighest}" Cursor="SizeWE">
                <GridSplitter.Style>
                    <Style TargetType="GridSplitter">
                        <Setter Property="Visibility" Value="Visible"/>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>

            <!-- 右侧常驻栏（与主界面DetailPanel结构和样式完全一致） -->
            <Border Grid.Column="2" x:Name="SearchRightSidebarBorder" ContextMenu="{x:Null}" PreviewMouseRightButtonUp="SuppressContextMenu_PreviewMouseRightButtonUp">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SearchFixedSidebar" Margin="16,8,16,16">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,80,0,0">
                            <m3:M3Icon Kind="bookmark-outline" Width="48" Height="48" HorizontalAlignment="Center" Opacity="0.15"/>
                            <TextBlock Text="选中书签查看详情" FontSize="13" Opacity="0.3" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== 资源管理器式浏览页（P4 新页面，与旧界面并存，显隐由 IUiCoordinator 控制） ===== -->
        <!-- 显隐与其它页面统一走 CurrentNavId 触发器（老「链接」页删除后它成为默认首页） -->
        <browserviews:BrowserView Grid.Row="1" x:Name="BrowserPage"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <browserviews:BrowserView.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <!-- 注意：BrowserPage 的 DataContext 是 BrowserViewModel，必须显式取窗口的 CurrentNavId -->
                        <DataTrigger Binding="{Binding DataContext.CurrentNavId, RelativeSource={RelativeSource AncestorType=Window}}" Value="browser">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </browserviews:BrowserView.Style>
        </browserviews:BrowserView>

        <!-- ===== 回收站视图（独立页面） ===== -->
        <views:TrashPage Grid.Row="1" x:Name="TrashView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <views:TrashPage.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentNavId}" Value="trash">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:TrashPage.Style>
        </views:TrashPage>

        <!-- ===== 智能列表视图（独立页面） ===== -->
        <views:SmartListsPage Grid.Row="1" x:Name="SmartListsView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <views:SmartListsPage.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentNavId}" Value="smartlists">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:SmartListsPage.Style>
        </views:SmartListsPage>

        <!-- ===== 工具页面（空壳） ===== -->
        <views:ToolsPage Grid.Row="1" x:Name="ToolsView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <views:ToolsPage.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentNavId}" Value="tools">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:ToolsPage.Style>
        </views:ToolsPage>

        <!-- ===== 设置视图（独立页面） ===== -->
        <views:SettingsPage Grid.Row="1" x:Name="SettingsView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <views:SettingsPage.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentNavId}" Value="settings">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:SettingsPage.Style>
        </views:SettingsPage>

    </Grid>
</Window>
