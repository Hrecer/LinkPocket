<Window x:Class="LinkPocket.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LinkPocket"
        xmlns:vm="clr-namespace:LinkPocket.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mdxaml="clr-namespace:MdXaml;assembly=MdXaml"
        mc:Ignorable="d"
        Title="LinkPocket"
        Height="720" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="#FFFFFF"
        TextElement.FontFamily="{DynamicResource MaterialDesignFont}"
        TextElement.Foreground="Black">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="8"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#BF0F1D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <local:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <vm:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVis"/>
        <vm:FaviconConverter x:Key="FaviconConverter"/>
    </Window.Resources>

    <Grid x:Name="RootGrid" PreviewMouseLeftButtonDown="RootGrid_PreviewMouseLeftButtonDown">
        <!-- ===== 主界面 ===== -->
        <Grid x:Name="MainView">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部导航（兼标题栏） -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <materialDesign:PackIcon Kind="LinkVariant" Width="24" Height="24" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="LinkPocket" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding NavigationItems}" WindowChrome.IsHitTestVisibleInChrome="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ToolbarButton}"
                                        Command="{Binding DataContext.SelectNavCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Id}"
                                        FontWeight="{Binding IsSelected, Converter={StaticResource BoolToFontWeightConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="{Binding IconKind}" Width="18" Height="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Label}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click" ToolTip="最小化">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="14" Height="14" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click" ToolTip="最大化">
                            <materialDesign:PackIcon Kind="WindowMaximize" Width="14" Height="14" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource CloseButton}" Click="CloseButton_Click" ToolTip="关闭">
                            <materialDesign:PackIcon Kind="WindowClose" Width="14" Height="14" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 主内容区 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="160" MaxWidth="400"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220" MinWidth="160" MaxWidth="360"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧边栏 -->
                <Border Grid.Column="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FolderListPanel" Margin="4,8,4,8"/>
                    </ScrollViewer>
                </Border>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="{DynamicResource MaterialDesignDivider}" Cursor="SizeWE"/>

                <!-- 中间内容区域 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 操作栏 -->
                    <Border Grid.Row="0" Background="{DynamicResource MaterialDesignCardBackground}" Padding="12,10" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Padding="12,8" Margin="4,0" Cursor="Hand"
                                    Command="{Binding DataContext.ShowAddLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="添加新链接">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="添加" Margin="6,0,0,0" FontSize="14" VerticalAlignment="Center" FontFamily="Microsoft YaHei UI"/>
                                </StackPanel>
                            </Button>
                            <Button Padding="12,8" Margin="4,0" Cursor="Hand"
                                    Command="{Binding DataContext.CreateFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="新建文件夹">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderPlus" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="新建文件夹" Margin="6,0,0,0" FontSize="14" VerticalAlignment="Center" FontFamily="Microsoft YaHei UI"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="DeleteButton" Padding="12,8" Margin="4,0"
                                    Content="🗑 删除" FontSize="14" FontFamily="Microsoft YaHei UI"
                                    Background="Transparent" BorderThickness="0" Foreground="#D32F2F" Cursor="Hand"
                                    Command="{Binding LinkViewModel.DeleteSelectedCommand}"
                                    Visibility="{Binding LinkViewModel.HasSelectedItems, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#FFEBEE"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#FFCDD2"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.4"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 链接列表 -->
                    <Grid Grid.Row="1" x:Name="LinksPage" DataContext="{Binding LinkViewModel}"
                          Background="Transparent"
                          PreviewMouseLeftButtonDown="LinksPage_MouseLeftButtonDown">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                            <ProgressBar IsIndeterminate="True" Width="60" Height="60" Style="{StaticResource MaterialDesignCircularProgressBar}"/>
                            <TextBlock Text="正在加载链接..." FontSize="14" Opacity="0.6" Margin="0,16,0,0"/>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="56" Height="56" HorizontalAlignment="Center" Opacity="0.4" Foreground="{DynamicResource ValidationErrorBrush}"/>
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="14" HorizontalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource ValidationErrorBrush}" MaxWidth="400" Margin="0,16,0,12"/>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasData, Converter={StaticResource InvertedBoolToVis}}" Margin="0,-100,0,0">
                            <materialDesign:PackIcon Kind="BookmarkMultipleOutline" Width="72" Height="72" HorizontalAlignment="Center" Opacity="0.25"/>
                            <TextBlock Text="{Binding NoDataMessage}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Opacity="0.5" Margin="0,16,0,6" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"/>
                            <Button Style="{StaticResource MaterialDesignFlatButton}" Margin="0,24,0,0" Padding="24,12"
                                    Command="{Binding DataContext.ShowAddLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="20" Height="20"/>
                                    <TextBlock Text="添加第一个链接" Margin="8,0,0,0" FontSize="14"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="8">
                                <Border x:Name="RootFolderBorder" Margin="0" CornerRadius="0" Cursor="Hand"
                                        Background="Transparent"
                                        BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                                        Padding="12,5,12,5"
                                        Tag="FolderCard"
                                        MouseLeftButtonDown="RootFolderCard_MouseLeftButtonDown"
                                        MouseEnter="RootFolderBorder_MouseEnter" MouseLeave="RootFolderBorder_MouseLeave">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="RootFolderChevronBorder" Width="18" Height="18" CornerRadius="3"
                                                Background="Transparent" Cursor="Hand"
                                                PreviewMouseLeftButtonDown="RootFolderChevron_MouseLeftButtonDown">
                                            <materialDesign:PackIcon x:Name="RootFolderChevron" Kind="ChevronDown" Width="12" Height="12"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.45"/>
                                        </Border>
                                        <materialDesign:PackIcon Kind="BookmarkOutline" Width="14" Height="14"
                                                                 VerticalAlignment="Center" Margin="4,0,6,0" Opacity="0.5"/>
                                        <TextBlock Text="全部书签" FontSize="12" VerticalAlignment="Center" Foreground="#444444"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel x:Name="SubFolderPanel"/>

                                <ItemsControl x:Name="LinksItemsControl" ItemsSource="{Binding Links}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Tag="LinkCard" Margin="4,2" CornerRadius="10" Cursor="Hand"
                                                    Background="{DynamicResource MaterialDesignCardBackground}"
                                                    BorderThickness="2" Padding="16,12">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.08"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.15"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#FF424242"/>
                                                                <Setter Property="BorderBrush" Value="#FF424242"/>
                                                                <Setter Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Color="#FF000000" Opacity="0.3"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick"
                                                                  Command="{Binding DataContext.LinkViewModel.ToggleSelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"/>
                                                    <MouseBinding Gesture="LeftDoubleClick"
                                                                  Command="{Binding DataContext.ShowDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                    <Border Width="36" Height="36" CornerRadius="6" Background="#F0F0F0"
                                                            Margin="0,0,12,0" VerticalAlignment="Center"
                                                            ClipToBounds="True">
                                                        <Grid>
                                                            <Image Source="{Binding FaviconUrl}" Stretch="Uniform">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding FaviconUrl}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                            <materialDesign:PackIcon Kind="Earth" Width="20" Height="20"
                                                                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <materialDesign:PackIcon.Style>
                                                                    <Style TargetType="materialDesign:PackIcon">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding FaviconUrl}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </materialDesign:PackIcon.Style>
                                                            </materialDesign:PackIcon>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Url}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 其他页面占位 -->
                    <Grid Grid.Row="1" x:Name="VaultPage">
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentNavId, RelativeSource={RelativeSource AncestorType=Window}}" Value="vault"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <TextBlock Text="密码保险库 - 开发中..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Opacity="0.5"/>
                    </Grid>
                    <Grid Grid.Row="1" x:Name="SearchPage">
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentNavId, RelativeSource={RelativeSource AncestorType=Window}}" Value="search"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <TextBlock Text="搜索 - 开发中..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Opacity="0.5"/>
                    </Grid>
                    <Grid Grid.Row="1" x:Name="TrashPage">
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentNavId, RelativeSource={RelativeSource AncestorType=Window}}" Value="trash"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <TextBlock Text="回收站 - 开发中..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Opacity="0.5"/>
                    </Grid>
                    <Grid Grid.Row="1" x:Name="SettingsPage">
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentNavId, RelativeSource={RelativeSource AncestorType=Window}}" Value="settings"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <TextBlock Text="设置 - 开发中..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Opacity="0.5"/>
                    </Grid>
                </Grid>

                <!-- 右侧分隔线 -->
                <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="{DynamicResource MaterialDesignDivider}" Cursor="SizeWE"/>

                <!-- 右侧详情栏 -->
                <Border Grid.Column="4" x:Name="RightSidebarBorder" ContextMenu="{x:Null}" PreviewMouseRightButtonUp="SuppressContextMenu_PreviewMouseRightButtonUp">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="DetailPanel" Margin="16,8,16,16"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== 详情视图页面 ===== -->
        <Grid x:Name="DetailView" Visibility="Collapsed" WindowChrome.IsHitTestVisibleInChrome="True" ContextMenu="{x:Null}"
              PreviewMouseRightButtonUp="SuppressContextMenu_PreviewMouseRightButtonUp">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（Logo + 页面标题 + 窗口按钮） -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,0" Padding="16,10,0,10" WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <materialDesign:PackIcon Kind="LinkVariant" Width="24" Height="24" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="LinkPocket" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="EyeOutline" Width="22" Height="22" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="书签详情" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click" ToolTip="最小化">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="14" Height="14" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click" ToolTip="最大化">
                            <materialDesign:PackIcon Kind="WindowMaximize" Width="14" Height="14" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource CloseButton}" Click="CloseButton_Click" ToolTip="关闭">
                            <materialDesign:PackIcon Kind="WindowClose" Width="14" Height="14" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 操作栏（返回 + 编辑按钮） -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="12,8" Background="{DynamicResource MaterialDesignCardBackground}" WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding CancelDetailCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="8,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="返回" Margin="6,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DetailEditCommand}" Style="{StaticResource MaterialDesignRaisedButton}" MinWidth="70" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Pencil" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="编辑" Margin="5,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 内容区 -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource MaterialDesignPaper}" ContextMenu="{x:Null}">
                <StackPanel Margin="48,32,48,32">

                    <!-- URL -->
                    <TextBlock Text="URL" FontSize="12" Opacity="0.5" Margin="0,0,0,4"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  MaxHeight="40" Margin="0,0,0,8">
                        <TextBox Text="{Binding DetailUrl}" FontSize="14" TextWrapping="NoWrap" IsReadOnly="True"
                                 Background="Transparent" BorderThickness="0" Padding="0" Focusable="True" Foreground="Black"
                                 VerticalAlignment="Center" ContextMenu="{x:Null}"/>
                    </ScrollViewer>
                    <Button Padding="6,3" Margin="0,0,0,20" Cursor="Hand" Background="Transparent" BorderThickness="1" BorderBrush="#DDDDDD"
                            ToolTip="复制URL" Click="CopyDetailUrl_Click" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" VerticalAlignment="Center" Foreground="#666666"/>
                            <TextBlock Text="复制URL" FontSize="12" Foreground="#666666" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 图标区域 -->
                    <Border Margin="0,16,0,16" Background="Transparent" CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="48" Height="48" CornerRadius="8" Background="#F0F0F0"
                                    ClipToBounds="True" VerticalAlignment="Center">
                                <Grid>
                                    <Image Source="{Binding DetailFaviconUrl}" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DetailFaviconUrl}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <materialDesign:PackIcon Kind="Earth" Width="26" Height="26"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DetailFaviconUrl}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 标题 -->
                    <TextBlock Text="标题" FontSize="12" Opacity="0.5" Margin="0,0,0,4"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  MaxHeight="50" Margin="0,0,0,20">
                        <TextBox Text="{Binding DetailTitle}" FontSize="24" FontWeight="SemiBold" TextWrapping="NoWrap"
                                 IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0" Focusable="True" Foreground="Black" ContextMenu="{x:Null}"/>
                    </ScrollViewer>

                    <!-- 描述 (Markdown) -->
                    <TextBlock Text="描述" FontSize="12" Opacity="0.5" Margin="0,0,0,4"/>
                    <mdxaml:MarkdownScrollViewer x:Name="DetailMarkdownViewer"
                                                  Markdown="{Binding DetailDescription}"
                                                  FontFamily="Microsoft YaHei UI"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  PreviewMouseWheel="DetailMarkdownViewer_PreviewMouseWheel"
                                                  RequestBringIntoView="DetailMarkdownViewer_RequestBringIntoView"
                                                  Margin="0,0,0,28">
                        <mdxaml:MarkdownScrollViewer.MarkdownStyle>
                            <Style TargetType="FlowDocument" BasedOn="{x:Static mdxaml:MarkdownStyle.GithubLike}">
                                <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Style.Resources>
                                    <Style TargetType="Paragraph">
                                        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
                                    </Style>
                                    <Style TargetType="Run">
                                        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
                                    </Style>
                                </Style.Resources>
                            </Style>
                        </mdxaml:MarkdownScrollViewer.MarkdownStyle>
                    </mdxaml:MarkdownScrollViewer>

                    <Separator Opacity="0.3" Margin="0,0,0,20"/>

                    <!-- 最后更新 -->
                    <TextBlock Text="最后更新" FontSize="11" Opacity="0.45" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DetailUpdatedAtDisplay}" FontSize="13" Opacity="0.65" Margin="0,0,0,12"
                             IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0" Focusable="True" Foreground="Black" ContextMenu="{x:Null}"/>

                    <!-- 创建时间 -->
                    <TextBlock Text="创建时间" FontSize="11" Opacity="0.45" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DetailCreatedAtDisplay}" FontSize="13" Opacity="0.65" Margin="0,0,0,12"
                             IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0" Focusable="True" Foreground="Black" ContextMenu="{x:Null}"/>

                    <!-- ID -->
                    <TextBlock Text="ID" FontSize="11" Opacity="0.45" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <TextBox Text="{Binding DetailLinkIdDisplay}" FontSize="12" FontFamily="Consolas" Opacity="0.45" TextWrapping="Wrap"
                                 IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0" Focusable="True" Foreground="Black" ContextMenu="{x:Null}"/>
                        <Button Padding="6,2" Margin="8,0,0,0" Cursor="Hand" Background="Transparent" BorderThickness="0" ToolTip="复制ID"
                                Click="CopyDetailId_Click">
                            <materialDesign:PackIcon Kind="ContentCopy" Width="13" Height="13" VerticalAlignment="Center" Foreground="#666666"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== 添加/编辑链接页面 ===== -->
        <Grid x:Name="EditLinkView" Visibility="Collapsed" WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（Logo + 页面标题 + 窗口按钮） -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,0" Padding="16,10,0,10" WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <materialDesign:PackIcon Kind="LinkVariant" Width="24" Height="24" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="LinkPocket" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="{Binding EditLinkPageIcon}" Width="22" Height="22" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding EditLinkPageTitle}" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click" ToolTip="最小化">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="14" Height="14" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click" ToolTip="最大化">
                            <materialDesign:PackIcon Kind="WindowMaximize" Width="14" Height="14" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource CloseButton}" Click="CloseButton_Click" ToolTip="关闭">
                            <materialDesign:PackIcon Kind="WindowClose" Width="14" Height="14" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 操作栏（返回 + 保存按钮） -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="12,8" Background="{DynamicResource MaterialDesignCardBackground}" WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding CancelEditLinkCommand}" Padding="8,6" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFetchingMetadata}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="返回" Margin="6,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveEditLinkCommand}" MinWidth="70" Padding="12,6">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFetchingMetadata}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <ProgressBar IsIndeterminate="True" Width="14" Height="14" Margin="0,0,6,0"
                                         Visibility="{Binding EditLinkIsLoading, Converter={StaticResource BoolToVis}}"
                                         Style="{StaticResource MaterialDesignCircularProgressBar}"/>
                            <TextBlock Text="保存" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 表单（可滚动） -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource MaterialDesignPaper}">
                <Grid MinHeight="400" Margin="48,32,48,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="URL地址" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding EditLinkUrl, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="12,10"/>
                    <Button Grid.Column="1" Command="{Binding FetchMetadataCommand}" Margin="8,0,0,0"
                            VerticalAlignment="Stretch" HorizontalAlignment="Right"
                            ToolTip="自动解析标题和图标" FontSize="14" FontFamily="Microsoft YaHei UI"
                            BorderThickness="1.5" BorderBrush="#CCCCCC" Background="#F5F5F5"
                            MinWidth="80" Content="自动解析">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFetchingMetadata}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- 图标区域 -->
                <Border Grid.Row="1" Margin="0,16,0,8"
                        Background="Transparent" CornerRadius="6">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="48" Height="48" CornerRadius="8" Background="#F0F0F0"
                                ClipToBounds="True" VerticalAlignment="Center">
                            <Grid>
                                <Image Source="{Binding EditLinkFaviconUrl}" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EditLinkFaviconUrl}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <materialDesign:PackIcon Kind="Earth" Width="26" Height="26"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EditLinkFaviconUrl}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </Grid>
                        </Border>
                        <Button Command="{Binding ClearFaviconCommand}" Margin="12,0,0,0" Padding="10,5"
                                ToolTip="清除已解析的图标" FontSize="12" FontFamily="Microsoft YaHei UI"
                                BorderThickness="1" BorderBrush="#CCCCCC" Background="#FFFFFF"
                                Content="✕ 清除图标" Cursor="Hand" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBox Grid.Row="2" materialDesign:HintAssist.Hint="标题" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding EditLinkTitle, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="12,10"/>

                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="描述" FontSize="13" Opacity="0.6" Margin="4,0,0,4"/>
                    <TextBox Grid.Row="1" Text="{Binding EditLinkDescription, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" FontSize="16"
                             MinHeight="80"
                             Foreground="{DynamicResource MaterialDesignBody}"
                             CaretBrush="{DynamicResource MaterialDesignBody}">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border x:Name="border" Background="Transparent"
                                        BorderBrush="#44000000"
                                        BorderThickness="1.5" CornerRadius="4"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Focusable="False"
                                                  Margin="14,12"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="BorderBrush" Value="#99000000"/>
                                        <Setter TargetName="border" Property="Background" Value="#08000000"/>
                                    </Trigger>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter TargetName="border" Property="BorderBrush" Value="Black"/>
                                        <Setter TargetName="border" Property="Background" Value="#0A000000"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Grid>

                <StackPanel Grid.Row="4" Margin="0,20,0,0"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="最后更新" FontSize="11" Opacity="0.5" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding EditLinkUpdatedAtDisplay}" FontSize="13" Opacity="0.6" Margin="0,0,0,12"/>
                    <TextBlock Text="创建时间" FontSize="11" Opacity="0.5" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding EditLinkCreatedAtDisplay}" FontSize="13" Opacity="0.6" Margin="0,0,0,12"/>
                    <TextBlock Text="ID" FontSize="11" Opacity="0.5" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding EditLinkIdDisplay}" FontSize="11" FontFamily="Consolas" Opacity="0.4" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button Padding="4,2" Margin="6,0,0,0" Cursor="Hand" Background="Transparent" BorderThickness="0" ToolTip="复制ID"
                                Click="CopyEditId_Click">
                            <materialDesign:PackIcon Kind="ContentCopy" Width="11" Height="11" VerticalAlignment="Center" Opacity="0.35"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="8" Text="{Binding EditLinkErrorMessage}" Foreground="{DynamicResource ValidationErrorBrush}"
                           TextWrapping="Wrap" Visibility="{Binding EditLinkHasError, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0"/>
                </Grid>
            </ScrollViewer>

            <!-- 解析中遮罩层 -->
            <Border Visibility="{Binding IsFetchOverlayVisible, Converter={StaticResource BoolToVis}}"
                    Background="#AA000000" Panel.ZIndex="100"
                    Grid.RowSpan="3">
                <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="White" CornerRadius="12"
                        Padding="32,24" Width="280">
                    <StackPanel>
                        <ProgressBar IsIndeterminate="True" Height="4"
                                     Margin="0,0,0,16"
                                     Style="{StaticResource MaterialDesignCircularProgressBar}"/>
                        <TextBlock Text="{Binding FetchStatusMessage}" FontSize="14"
                                   HorizontalAlignment="Center"
                                   Foreground="#333333"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>