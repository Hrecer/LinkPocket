<Application x:Class="LinkPocket.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LinkPocket.Views"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Material3.Wpf;component/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="AppFont">Microsoft YaHei UI, 微软雅黑, SimSun, 宋体, Arial</FontFamily>

            <!-- 紫色调层（MD3E 色彩即层级的本地化实现）：比中性 Surface 角色带 Primary 染色的分层画刷。
                 TintSurface = 内容区（近白带紫）· TintCard = 卡片（比所在面板浅半档）
                 · TintPanel = 侧区面板（比基面深一档的紫色叠层）。 -->
            <SolidColorBrush x:Key="TintSurface" Color="#FAF8FD"/>
            <SolidColorBrush x:Key="TintCard" Color="#F5F1FB"/>
            <SolidColorBrush x:Key="TintPanel" Color="#E4DCF3"/>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="FontWeight" Value="Normal"/>
            </Style>

            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="FontWeight" Value="Normal"/>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource Primary}"/>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
            </Style>

            <!-- 列宽拖拽手柄（共享样式：浏览页主栏与 SortableDataTable 共用同一份）：
                 贴列右缘，hover/拖动显示 2px Primary 竖线 -->
            <Style x:Key="ColumnResizeThumb" TargetType="Thumb">
                <Setter Property="Width" Value="7"/>
                <Setter Property="Margin" Value="0,0,-4,0"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Cursor" Value="SizeWE"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent" Padding="2,0">
                                <Border x:Name="Line" Width="2" Background="Transparent" CornerRadius="1"
                                        HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Line" Property="Background" Value="{DynamicResource Primary}"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="Line" Property="Background" Value="{DynamicResource Primary}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 排序表头按钮（可复用组件）：数据驱动 —— Label/Field/Direction 三属性。
                 Direction 三态：null=未激活（无指示器）、True=升序▲、False=降序▼。 -->
            <Style TargetType="views:SortableHeaderButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
                <!-- ⚠️ 文字在药丸内水平+垂直居中（用户要求）；药丸两侧由使用方留对称空隙，
                     分隔线（列边界）恰好落在两个药丸的正中心 -->
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="views:SortableHeaderButton">
                            <!-- 悬停药丸 = Primary 12% 叠加（随旧 TextButton 的 state layer 语义：在 TintPanel 上变深） -->
                            <Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="14"
                                    MinHeight="28" SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Indicator" FontSize="10" Margin="4,0,0,0"
                                               Foreground="{DynamicResource Primary}" Visibility="Collapsed"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Pill" Property="Background" Value="#1F6750A4"/>
                                    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
                                </Trigger>
                                <Trigger Property="Direction" Value="True">
                                    <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Indicator" Property="Text" Value="▲"/>
                                </Trigger>
                                <Trigger Property="Direction" Value="False">
                                    <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Indicator" Property="Text" Value="▼"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- TonalButton：MD3 色调按钮（SecondaryContainer 底 + OnSecondaryContainer 文）。
                 浏览页命令栏浮动胶囊组内使用。注意：模板用 TemplateBinding Padding，
                 不落入库 TextButton「Padding 硬编码 14,0」的裁切坑。 -->
            <Style x:Key="TonalButton" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{DynamicResource SecondaryContainer}"
                                    CornerRadius="16" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceContainerHighest}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ToolTip：自绘 M3 模板。默认模板自带 SystemDropShadowChrome 投影，
                 与右键菜单（无阴影、纯圆角色块）的视觉语言冲突 → 统一改为圆角无阴影色块。 -->
            <Style TargetType="ToolTip">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Background" Value="{DynamicResource SurfaceContainerHigh}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="HasDropShadow" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
