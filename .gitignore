bin/
obj/
*.user
*.suo
linkpocket.db
# 运行期图标缓存（建在程序目录 = bin/<cfg>/<tfm>/favicons）：按落点限定，
# 不能写成裸 `favicons/` —— 那会把源码目录（如 Contracts/Favicons/）一起吞掉，
# 症状是"本地编译全绿、别人克隆下来少一个文件"。
bin/**/favicons/
*.lpbackup
*.zip
build/artifacts/
perf_report.json
.scratch/

# 测试运行期产物（挂起转储 / Sequence / trx）—— 调试用，不进版本控制
tests/**/TestResults/
*.dmp

# WPF 编译临时项目（编译中断的残留，绝不入档）
*_wpftmp.csproj
