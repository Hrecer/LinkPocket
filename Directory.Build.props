<Project>

  <!-- LinkPocket 全解决方案公共属性（ Directory.Build.props 对本目录及子目录所有项目生效 ） -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 产品版本：**备份的 `app_version` 字段直接取它**（`BackupIO.AppVersionOfThisBuild` 读程序集信息版本）——
         "这份包是哪个版本写出来的"是跨版本迁移的关键诊断信息，必须准确。 -->
    <Version>4.2.3</Version>
    <!-- 不要给信息版本追加 "+<commit>" 后缀：备份字段与展示处一律要干净的语义化版本号 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- 桌面构建不携带 browser-wasm 负载：SQLitePCLRaw.lib.e_sqlite3 的
       `runtimes\browser-wasm\nativeassets\netX.0\e_sqlite3.a` 只服务 RuntimeIdentifier=browser-wasm，
       但 NuGet 的 runtimeTargets 机制会把它拷进**每个**构建输出（每 bin 白拷 ~1.3MB，
       目录名 net8.0/net9.0 还会被误读成旧 TFM 残留）。
       wasm 构建不受影响：包自带的 buildTransitive 直接引用 NuGet 缓存里的同一份文件。 -->
  <Target Name="DropBrowserWasmRuntimeTargets" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)"
          Condition="'%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'browser-wasm'" />
    </ItemGroup>
  </Target>

</Project>
