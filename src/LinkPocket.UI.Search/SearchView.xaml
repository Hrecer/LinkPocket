<UserControl x:Class="LinkPocket.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LinkPocket.I18n;assembly=LinkPocket.I18n"
             xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
             xmlns:views="clr-namespace:LinkPocket.Views;assembly=LinkPocket.UIKit"
             xmlns:local="clr-namespace:LinkPocket.Views"
             Background="{DynamicResource App.Surface.Base}"
             Focusable="True" FocusVisualStyle="{x:Null}">

    <!-- ===== 搜索页：视图只负责装配与渲染，逻辑在 SearchViewModel ===== -->

    <UserControl.Resources>
        <!-- 位置列：ListId → 目录路径（解析器由 SearchViewModel 注入） -->
        <local:SearchPathConverter x:Key="SearchPathText"/>

        <!-- 占位行：日期 / 访问次数 / 图标是“尚未加载”，不是真实数据——隐藏但保留占位 -->
        <Style x:Key="SearchPlaceholderHidden" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                    <Setter Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 链接专属单元格：占位时隐藏（沿用上面的口径），文件夹行折叠 -->
        <!-- 时间/次数单元格：链接与文件夹**共用**（文件夹同样有创建/更新/访问/次数，库里都有值）。
             区别只在空值文案（链接"从未"、文件夹未访问同样是"从未"），由值投影自己给。 -->
        <Style x:Key="SearchLinkCell" TargetType="FrameworkElement" BasedOn="{StaticResource SearchPlaceholderHidden}"/>

        <!-- 首帧紧凑行：只画标题/URL（真实数据），与完整行同高。
             十万级结果集的首帧如果直接实例化完整行模板（地理路径 + 4 个日期 + 图标 + 高亮），
             WPF 首帧布局要 50–70ms；先付 10ms 把"真实标题 + 正确滚动范围"放上屏，
             下一帧再换回完整模板补全列——首屏可见时间与列完整时间分开计量。 -->
        <DataTemplate x:Key="SearchRowCompactTemplate">
            <Border x:Name="SearchRowCompact" Tag="DataRow" Cursor="Hand" HorizontalAlignment="Stretch" Height="57.9"
                    Margin="8,1" Padding="16,9" Background="Transparent" SnapsToDevicePixels="True"
                    PreviewMouseLeftButtonDown="SearchRow_PreviewMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- 只解析名称列宽：标题/URL 停在真实列内，下一帧补全其它列时不横向跳动 -->
                        <ColumnDefinition views:ColumnWidthBinding.Width="{Binding ColumnWidths[0], RelativeSource={RelativeSource AncestorType=views:SortableDataTable}}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="28,0,0,0">
                        <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Url}" FontSize="11.5" Margin="0,3,0,0"
                                   Foreground="{DynamicResource App.Text.Secondary}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 胶囊搜索栏内的透明输入框：视觉由外层 SearchBarShell 承担 -->
        <Style x:Key="SearchCapsuleBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- 「跳转」在本页 = 工具行药丸组里的一枚 **TonalButton 孪生药丸**（与「删除」同款同宽，
             见下方工具行注释；2026-10-15 按用户口径统一，不再用强调填充的共享 `JumpPillButton`——
             该样式仍由 **智能列表结果页头 / 查重明细 URL 组** 两页共用）。
             历史注记：原页面局部样式 `SearchJumpPillButton` 的"按压圆角 16→10 形变"已删除；
             图标由 `open-in-new`（外部打开语义）定为 `map-marker`（地图图钉 = "它在哪"）。 -->

        <!-- 搜索范围筛选 chip（M3E filter chip）：32 高与「跳转」药丸齐平、圆角 16（纯胶囊）。
             ⚠️ **选中 / 未选尺寸完全一致**——不加宽、不做形变，
             只以颜色 + 字重区分（未选透明 + 悬停 SurfaceContainerHighest；选中 SecondaryContainer + SemiBold）。
             ⚠️ 不放图标：LpIcons 字形表未注册「check」，M3Icon 会渲染成占位的空白。 -->
        <Style x:Key="SearchChip" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource App.Text.Secondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Height="32" CornerRadius="16"
                                Background="Transparent" Padding="15,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Surface.Hover}"/>
                            </Trigger>
                            <!-- ⚠️ 选中底曾经用 `App.Support.Container`（= 支撑槽**本色**）：本色深浅不定，
                                 青提那套的本色本身就近白 ⇒ 选中与未选**一个色**，用户实测"怎么点都看不出选了哪个"。
                                 改用**专门表示"选中"的那支**（`App.Surface.Selected`，对卡面 ≥1.22 的判据），
                                 墨 = 主文字，字重加粗（尺寸仍不变）。 -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Surface.Selected}"/>
                                <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 结果列表占剩余宽度；详情栏与浏览页同规格（286，可拖拽 230~400） -->
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="286" MinWidth="230" MaxWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：搜索框 + 跳转工具栏(含筛选项) + 结果列表。
             点空白清选中（BlankClick 唯一实现）：命中搜索框/chip/行等可交互元素
             不算空白；右栏（选中集合的投影）在范围之外、绝不反向取消选中。
             ⚠️ 必须补 Background="Transparent"：否则本层没有子元素覆盖的"边角空白"根本不产生命中，
             BlankClick 收不到点击，边角空白就无法取消选中 / 清焦点。
             命令在 code-behind 挂（"清选中 + 焦点收回页内"两件事一起做，与浏览页 ClearPageSelection 同口径）。 -->
        <Grid x:Name="ContentArea" Grid.Column="0" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="12,0,12,8">
                <!-- 胶囊搜索栏（视觉重心）：聚焦时高度 52→62、圆角 26→20 形变，弹簧曲线。
                     ⚠️ 基态值必须写在 Style.Setters 里（本地值优先级高于样式触发器）。 -->
                <Border x:Name="SearchBarShell" Height="52"
                        Padding="20,0,12,0" HorizontalAlignment="Stretch">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="26"/>
                            <Setter Property="Background" Value="{DynamicResource App.Surface.Card}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource App.Surface.Hover}"/>
                                    <!-- 高 62 的胶囊全圆 = 31：圆角若小于高度一半会出现"方不方圆不圆"的怪框 -->
                                    <Setter Property="CornerRadius" Value="31"/>
                                    <Setter Property="Height" Value="62"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <m3:M3Icon Grid.Column="0" Kind="magnify" Width="22" Height="22"
                                   Foreground="{DynamicResource App.Accent.Icon}" VerticalAlignment="Center"/>

                        <Grid Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="{loc:Loc search.placeholder}" FontSize="16" VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.Text.Secondary}" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox, FallbackValue=0}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="SearchBox" Style="{StaticResource SearchCapsuleBox}"
                                     Background="Transparent"
                                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <!-- Focusable=False：点击不抢走搜索框键盘焦点，避免聚焦胶囊态闪烁。
                             库 FilledButton 模板可能硬编码 Primary 底色 → 统一换 PrimaryPillButton（App.Accent.Fill） -->
                        <!-- 空态两枚按钮：宽度 = **冻结几何**，取值 = **中文基线**
                             （Width = 文字宽(中文 13pt) + 内距 28 + 描边 2 + 模板内部件 4（实测））：
                             「搜索」/「取消」各 2 字 = 26px ⇒ 60。英文 `Search` / `Cancel`（13pt 需 43 / 42px）
                             放不下时由 LocFit 缩英文字号让位 —— **绝不为英文把几何放大**（中文是第一体验）。
                             **高度两枚统一 40、显式钉死（Height + MinHeight 双写）**（2026-10-15 定稿）：
                             40 = **原「取消」的悬停尺寸**（它适配这枚更大的搜索框；用户实测"压成 32 看着不均衡"），
                             两枚都按这个尺寸对齐；库 `TextButton` 的 `MinHeight=40` 不再被压（取消不用改）。
                             40 高下的圆角 = **半高 20**（药丸类模板走 `HalfRadius` 自适应）——两枚都是真胶囊；
                             ⚠️ 别把圆角写死回 16：40 高下会退成圆角矩形（实测被指"搜索按钮方形"）。 -->
                        <!-- 搜索 = 本页**主操作**：口径 = 主操作走强调填充（深底白字）、次操作走次按钮底（淡而可见）。
                             它曾用「淡底深墨」压低视觉重量（"高频但不该抢戏"），用户实测"太浅，应该深一点" ⇒ 改回强调填充。 -->
                        <Button x:Name="SearchRunBtn" Grid.Column="3" Padding="14,0" Height="40" MinHeight="40" FontSize="13" FontWeight="SemiBold" Width="60"
                                Style="{StaticResource PrimaryPillButton}"
                                Command="{Binding SearchCommand}" Focusable="False"
                                VerticalAlignment="Center" Margin="4,0,4,0">
                            <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                                       views:LocFit.Text="{loc:Fit nav.item.search}" views:LocFit.Mode="Shrink"/>
                        </Button>
                        <Button x:Name="SearchCancelBtn" Grid.Column="4" Padding="14,0" Height="40" MinHeight="40" FontSize="13" Width="60"
                                Style="{StaticResource TextButton}" Command="{Binding CancelCommand}" Focusable="False"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                                       views:LocFit.Text="{loc:Fit common.cancel}" views:LocFit.Mode="Shrink"/>
                        </Button>
                    </Grid>
                </Border>
            </Border>

            <!-- 筛选工具行（M3E，**左对齐** = 与搜索胶囊左缘对齐）：
                 「跳转」+「删除」收进**一枚白底大药丸容器**（与回收站工具栏 / 浏览页命令栏同形态：
                 TintCard + 圆角 19 + 内距 3；容器内两钮间距 8）。
                 **两枚 = 孪生药丸**（2026-10-15 按用户口径统一）：同款 `TonalButton`、同宽 75、同高 32、
                 同图标尺寸 / 文字外边距 —— 内容同为「两字 + 一图标」的按钮不摆两套样式两种宽度
                 （原「跳转」= 86 宽的 JumpPillButton 强调填充，与 75 的删除并排时宽度与禁用态都不同款）。
                 「跳转」语义 = **进浏览页对应目录并选中该行**（定位组件 IContentLocator；不是"外部打开"）；
                 「搜索范围」+ 筛选 chip 归集进**另一枚 TintCard 近白胶囊容器**
                 （容器规格 = 内距 3 + 圆角 19，与工具页分段 / 浏览页命令栏同一语言；caption 与 chip 用细分割线分节）。
                 chip 32 高与药丸组齐平；未选透明、选中 SecondaryContainer + 加宽 + SemiBold，层级由色彩直接区分。 -->
            <StackPanel x:Name="SearchToolbar" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left"
                        Margin="12,0,12,8">
                <Border Background="{DynamicResource App.Surface.TintCard}" CornerRadius="19"
                        Padding="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SearchJumpToLinkBtn" Command="{Binding JumpCommand}" IsEnabled="{Binding JumpEnabled}"
                                Style="{StaticResource TonalButton}" VerticalAlignment="Center" Width="75"
                                Padding="12,5" MinHeight="32"
                                ToolTip="{loc:Loc common.jump}">
                            <StackPanel Orientation="Horizontal">
                                <m3:M3Icon Kind="map-marker" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                                           views:LocFit.Text="{loc:Fit common.jump}" views:LocFit.Mode="Shrink"
                                           FontSize="13" VerticalAlignment="Center" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 「删除」= 删除选中项（链接移入回收站，Windows 语义），紧贴「跳转」右侧、同收容器内。
                             破坏性动作**不设专门视觉**（与次操作共用同一套呈现）= 浏览页命令栏那枚删除钮的同一口径、同一几何
                             （`TonalButton` + `delete-outline` + `common.delete`，定宽 75 = 中文基线）。
                             命令 = 本页既有的 `DeleteSelectionCommand`（确认框 + 移入回收站 + 静默刷新结果），
                             无选中 / 删除在途时禁用。 -->
                        <Button x:Name="SearchDeleteBtn" Command="{Binding DeleteSelectionCommand}"
                                Style="{StaticResource TonalButton}" VerticalAlignment="Center" Width="75"
                                Padding="12,5" MinHeight="32" Margin="8,0,0,0"
                                ToolTip="{loc:Loc btn.delete.tip}">
                            <StackPanel Orientation="Horizontal">
                                <m3:M3Icon Kind="delete-outline" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                                           views:LocFit.Text="{loc:Fit common.delete}" views:LocFit.Mode="Shrink"
                                           FontSize="13" VerticalAlignment="Center" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 搜索范围分组：TintCard 近白胶囊容器（圆角 19 = 内距 3 + chip 圆角 16，同心圆角） -->
                <Border Background="{DynamicResource App.Surface.TintCard}" CornerRadius="19"
                        Padding="3" Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <!-- 「搜索范围」标签：宽度**冻在中文基线 68**（它是骨架标签，英文更长 ⇒ 缩字号） -->
                        <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                                   views:LocFit.Text="{loc:Fit search.scope}" views:LocFit.Mode="Shrink"
                                   FontSize="11.5" Foreground="{DynamicResource App.Text.Secondary}"
                                   Opacity="0.85" VerticalAlignment="Center" Margin="12,0,7,0" Width="68"/>
                        <Border Width="1" Height="14" Background="{DynamicResource App.Text.Secondary}"
                                Opacity="0.25" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <!-- 范围 chip：宽度**冻结**（约束 B）——chip 是界面骨架，不是内容。
                             68 = 英文 `Description`（12pt 需 65.6px）放得下的实测值：原 60 会把它缩到 4.0pt（屏幕上是一道横线）。
                             ⚠️ 别只钉中文基线：那样英文（比中文宽 30%~150%）只能靠缩字号硬挤。 -->
                        <CheckBox IsChecked="{Binding SearchPath}" Style="{StaticResource SearchChip}" Width="68">
                            <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                                       views:LocFit.Text="{loc:Fit ui.noun.path}" views:LocFit.Mode="Shrink"/>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding SearchUrl}" Style="{StaticResource SearchChip}" Width="68">
                            <TextBlock Text="URL"/>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding SearchTitle}" Style="{StaticResource SearchChip}" Width="68">
                            <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                                       views:LocFit.Text="{loc:Fit ui.noun.title}" views:LocFit.Mode="Shrink"/>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding SearchDesc}" Style="{StaticResource SearchChip}" Width="68">
                            <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                                       views:LocFit.Text="{loc:Fit ui.noun.description}" views:LocFit.Mode="Shrink"/>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- 后台补全进度（只说明“还在加载剩余命中”，不是截断）：加载完毕即空。
                     ⚠️ 绝不能在这里写“仅显示前 N 条”——全部命中都在同一张虚拟化表里，只是数据分块到达。 -->
                <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                           views:LocFit.Text="{loc:FitValue LoadingNotice}" views:LocFit.Mode="Shrink"
                           MaxWidth="380" FontSize="12.5" VerticalAlignment="Center" Margin="14,0,0,0"
                           Foreground="{DynamicResource App.Text.Secondary}"/>
            </StackPanel>

            <!-- 结果区：共享 SortableDataTable，**模板模式**（与浏览页同一种行虚拟化）：
                 结果集从首帧起就是**全部命中**（十万级也是一条连续列表）：总数条占位 + 视口预取真实行，
                 其余后台原位填充；视口只实例化约 11 个行容器（缓存 0 页），不存在“只显示前 N 条”。
                 列定义/表头/列宽仍由 code-behind 装配；选中由 VM 的 ListSelection 承载，
                 行底色绑定 LinkItem.IsSelected（覆盖式投影，多选 Ctrl/Shift 由 code-behind 路由）。 -->
            <!-- 结果卡：与浏览页主栏**同一张卡**（同底色 / 同圆角 24 / 同外距 8 / 同裁剪）。
                 少了这层卡，表头色带（24 圆角只在上沿）会浮在页面底上、行区与页面同色、
                 滚动条贴到页面边缘——表头/表底之间看不出"这是一张表"（现场：搜索页表格边框不明确、
                 颜色与浏览页不一致、滚动条位置也不对）。
                 HeaderBandMargin=0：嵌进卡片时表头色带贴满卡宽（默认 8 是给"浮动行区"用的）。 -->
            <Border Grid.Row="2" Background="{DynamicResource App.Surface.Card}"
                    CornerRadius="24" Margin="8,0,8,8" ClipToBounds="True">
            <views:SortableDataTable x:Name="ResultsTable" HeaderBandMargin="0"
                                     SelectionEnabled="False" RowCacheLength="0">
                <views:SortableDataTable.ItemTemplate>
                    <DataTemplate>
                        <!-- 行容器约定：Tag="DataRow" 供销测量与"点行不算点空白"识别；
                             固定高 57.9 + 上下 Margin 1 = 行距 59.9：extent 从首帧到全量恒定，
                             也避免 10 万行下内容驱动的逐行测量（首帧布局的成本大头在行模板实例化）。 -->
                        <Border Tag="DataRow" Cursor="Hand" HorizontalAlignment="Stretch" Height="57.9"
                                PreviewMouseLeftButtonDown="SearchRow_PreviewMouseLeftButtonDown">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource LpRowCard}">
                                    <Setter Property="Margin" Value="8,1"/>
                                    <Setter Property="Padding" Value="16,9"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                                    <Style.Triggers>
                                        <!-- 派生触发器优先于基样式悬停：选中行悬停不换色 -->
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource App.Surface.Selected}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition views:ColumnWidthBinding.Width="{Binding ColumnWidths[0], RelativeSource={RelativeSource AncestorType=views:SortableDataTable}}"/>
                                    <ColumnDefinition views:ColumnWidthBinding.Width="{Binding ColumnWidths[1], RelativeSource={RelativeSource AncestorType=views:SortableDataTable}}"/>
                                    <ColumnDefinition views:ColumnWidthBinding.Width="{Binding ColumnWidths[2], RelativeSource={RelativeSource AncestorType=views:SortableDataTable}}"/>
                                    <ColumnDefinition views:ColumnWidthBinding.Width="{Binding ColumnWidths[3], RelativeSource={RelativeSource AncestorType=views:SortableDataTable}}"/>
                                    <ColumnDefinition views:ColumnWidthBinding.Width="{Binding ColumnWidths[4], RelativeSource={RelativeSource AncestorType=views:SortableDataTable}}"/>
                                    <ColumnDefinition views:ColumnWidthBinding.Width="{Binding ColumnWidths[5], RelativeSource={RelativeSource AncestorType=views:SortableDataTable}}"/>
                                </Grid.ColumnDefinitions>

                                <!-- 名称：favicon（缓存命中直接画、未命中异步补）+ 标题 + URL 副行；
                                     标题/URL 的高亮区间与引擎同源（TextMatch）。 -->
                                <Grid Grid.Column="0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="18" Height="18" Margin="0,0,10,0"
                                          VerticalAlignment="Center">
                                        <Grid.Style>
                                            <Style TargetType="FrameworkElement"
                                                   BasedOn="{StaticResource SearchPlaceholderHidden}"/>
                                        </Grid.Style>
                                        <views:LpFaviconImage Url="{Binding FaviconUrl}"
                                                             Visibility="{Binding IsFolder, Converter={StaticResource InvBoolToVis}}"/>
                                        <m3:M3Icon Kind="folder-outline" Width="18" Height="18"
                                                   Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <local:HighlightTextBlock RowText="{Binding DisplayTitle}"
                                                                  HighlightQuery="{Binding HighlightQuery}"
                                                                  FontSize="14" FontWeight="SemiBold"
                                                                  TextTrimming="CharacterEllipsis"/>
                                        <local:HighlightTextBlock RowText="{Binding Url}"
                                                                  HighlightQuery="{Binding HighlightQuery}"
                                                                  NormalBrushKey="App.Text.Secondary"
                                                                  FontSize="11.5" Margin="0,3,0,0"
                                                                  Visibility="{Binding IsFolder, Converter={StaticResource InvBoolToVis}}"
                                                                  TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 位置：目录路径（用户数据，不翻译；根 token 随语言变） -->
                                <TextBlock Grid.Column="1" FontSize="12.5" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource App.Text.Secondary}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource SearchPathText}">
                                            <Binding Path="Version" Source="{x:Static loc:Loc.Table}"/>
                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            <Binding Path="ListId"/>
                                            <Binding Path="IsPlaceholder"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <!-- 时间/次数列：轻量文案单元格（日期英文已用短式，不做宽度探测、不截断） -->
                                <local:LocalizedTextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12.5"
                                                          TextTrimming="CharacterEllipsis"
                                                          Foreground="{DynamicResource App.Text.Secondary}"
                                                          Style="{StaticResource SearchLinkCell}"
                                                          TextValue="{Binding UpdatedValue}"/>
                                <local:LocalizedTextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12.5"
                                                          TextTrimming="CharacterEllipsis"
                                                          Foreground="{DynamicResource App.Text.Secondary}"
                                                          Style="{StaticResource SearchLinkCell}"
                                                          TextValue="{Binding LastVisitedValue}"/>
                                <local:LocalizedTextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="12.5"
                                                          TextTrimming="CharacterEllipsis"
                                                          Foreground="{DynamicResource App.Text.Secondary}"
                                                          Style="{StaticResource SearchLinkCell}"
                                                          TextValue="{Binding VisitCountValue}"/>
                                <local:LocalizedTextBlock Grid.Column="5" VerticalAlignment="Center" FontSize="12.5"
                                                          TextTrimming="CharacterEllipsis"
                                                          Foreground="{DynamicResource App.Text.Secondary}"
                                                          Style="{StaticResource SearchLinkCell}"
                                                          TextValue="{Binding CreatedValue}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </views:SortableDataTable.ItemTemplate>
            </views:SortableDataTable>
            </Border>

            <!-- 加载遮罩（唯一实现 = UIKit ListBusyOverlay）：只在 F5 这类**用户发起**的刷新时亮；
                 事件驱动的静默刷新不亮。放在表格之后 = z 序在上；外距与结果卡对齐。 -->
            <views:ListBusyOverlay Grid.Row="2" Margin="8,0,8,8" IsBusy="{Binding IsNavigating}"/>
        </Grid>

        <!-- 详情栏可拖拽分隔线（与浏览页同款交互） -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="Transparent" Cursor="SizeWE"/>

        <!-- ===== 右侧详情栏：复用 DetailSidebar 控件，大小与浏览页右侧栏一致 ===== -->
        <Border Grid.Column="2" Background="{DynamicResource App.Surface.Panel}"
                CornerRadius="24,0,0,24" Margin="0,0,0,8">
            <views:DetailSidebar x:Name="Sidebar" DataContext="{Binding Details}"/>
        </Border>

    </Grid>
</UserControl>
