<UserControl x:Class="LinkPocket.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
             xmlns:views="clr-namespace:LinkPocket.Views;assembly=LinkPocket.UIKit"
             Background="{DynamicResource SurfaceContainerLow}">

    <!-- ===== 搜索页：视图只负责装配与渲染，逻辑在 SearchViewModel ===== -->

    <UserControl.Resources>
        <!-- 胶囊搜索栏内的透明输入框：视觉由外层 SearchBarShell 承担 -->
        <Style x:Key="SearchCapsuleBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- 跳转按钮（M3E Filled 药丸）：搜索工具行唯一的关键动作，Primary 填色锚定注意力（色彩即层级）；
             禁用态 = SurfaceContainerHighest + OnSurfaceMuted（MD3 规范禁用色，不再用透明度 hack）；
             按压圆角形变 16→10（M3E 交互化作形变）。 -->
        <Style x:Key="SearchJumpPillButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBtn}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnPrimary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="StateLayer" Background="{DynamicResource OnPrimary}"
                                        Opacity="0" CornerRadius="16"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.12"/>
                                <Setter TargetName="Bd" Property="CornerRadius" Value="10"/>
                                <Setter TargetName="StateLayer" Property="CornerRadius" Value="10"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceContainerHighest}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceMuted}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 搜索范围筛选 chip（M3E filter chip）：32 高与「跳转」药丸齐平、圆角 16（纯胶囊）。
             ⚠️ 用户令 2026-09-19：**选中 / 未选尺寸完全一致**——不再加宽、不做形变，
             只以颜色 + 字重区分（未选透明 + 悬停 SurfaceContainerHighest；选中 SecondaryContainer + SemiBold）。
             ⚠️ 不放图标：LpIcons 字形表未注册「check」，M3Icon 会渲染成占位的空白（见 2026-09-16 教训）。 -->
        <Style x:Key="SearchChip" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Height="32" CornerRadius="16"
                                Background="Transparent" Padding="15,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceContainerHighest}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryContainer}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 结果列表占剩余宽度；详情栏与浏览页同规格（286，可拖拽 230~400） -->
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="286" MinWidth="230" MaxWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：搜索框 + 跳转工具栏(含筛选项) + 结果列表。
             点空白清选中（BlankClick 唯一实现，用户令 2026-09-19）：命中搜索框/chip/行等可交互元素
             不算空白；右栏（选中集合的投影）在范围之外、绝不反向取消选中。 -->
        <Grid Grid.Column="0" views:BlankClick.Command="{Binding ClearSelectionCommand}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="12,0,12,8">
                <!-- 胶囊搜索栏（视觉重心）：聚焦时高度 52→62、圆角 26→20 形变，弹簧曲线。
                     ⚠️ 基态值必须写在 Style.Setters 里（本地值优先级高于样式触发器）。 -->
                <Border x:Name="SearchBarShell" Height="52"
                        Padding="20,0,12,0" HorizontalAlignment="Stretch">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="26"/>
                            <Setter Property="Background" Value="{DynamicResource SurfaceContainerHigh}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighest}"/>
                                    <!-- 高 62 的胶囊全圆 = 31：圆角若小于高度一半会出现"方不方圆不圆"的怪框 -->
                                    <Setter Property="CornerRadius" Value="31"/>
                                    <Setter Property="Height" Value="62"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <m3:M3Icon Grid.Column="0" Kind="magnify" Width="22" Height="22"
                                   Foreground="{DynamicResource Primary}" VerticalAlignment="Center"/>

                        <Grid Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="搜索书签、网址或描述…" FontSize="16" VerticalAlignment="Center"
                                       Foreground="{DynamicResource OnSurfaceVariant}" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox, FallbackValue=0}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="SearchBox" Style="{StaticResource SearchCapsuleBox}"
                                     Background="Transparent"
                                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <!-- Focusable=False：点击不抢走搜索框键盘焦点，避免聚焦胶囊态闪烁。
                             库 FilledButton 模板可能硬编码 Primary 底色 → 统一换 PrimaryPillButton（AccentBtn #A18EB0） -->
                        <Button Grid.Column="3" Content="搜索" Padding="20,9" FontSize="13" FontWeight="SemiBold"
                                Style="{StaticResource PrimaryPillButton}"
                                Command="{Binding SearchCommand}" Focusable="False"
                                VerticalAlignment="Center" Margin="4,0,4,0"/>
                        <Button Grid.Column="4" Content="取消" Padding="14,9" FontSize="13"
                                Style="{StaticResource TextButton}" Command="{Binding CancelCommand}" Focusable="False"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Border>

            <!-- 筛选工具行（M3E，**左对齐** = 与搜索胶囊左缘对齐）：
                 跳转 = Filled 药丸（关键操作，色彩锚定）；「搜索范围」+ 筛选 chip 归集进 **TintCard 近白胶囊容器**
                 （容器规格 = 内距 3 + 圆角 19，与工具页分段 / 浏览页命令栏同一语言；caption 与 chip 用细分割线分节）。
                 chip 32 高与跳转药丸齐平；未选透明、选中 SecondaryContainer + 加宽 + SemiBold，层级由色彩直接区分。 -->
            <StackPanel x:Name="SearchToolbar" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left"
                        Margin="12,0,12,8">
                <Button x:Name="SearchJumpToLinkBtn" Command="{Binding JumpCommand}" IsEnabled="{Binding JumpEnabled}"
                        Style="{StaticResource SearchJumpPillButton}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <m3:M3Icon Kind="open-in-new" Width="15" Height="15" VerticalAlignment="Center"/>
                        <TextBlock Text="跳转" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 搜索范围分组：TintCard 近白胶囊容器（圆角 19 = 内距 3 + chip 圆角 16，同心圆角） -->
                <Border Background="{DynamicResource TintCard}" CornerRadius="19"
                        Padding="3" Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="搜索范围" FontSize="11.5" Foreground="{DynamicResource OnSurfaceVariant}"
                                   Opacity="0.85" VerticalAlignment="Center" Margin="12,0,7,0"/>
                        <Border Width="1" Height="14" Background="{DynamicResource OnSurfaceVariant}"
                                Opacity="0.25" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <CheckBox Content="路径" IsChecked="{Binding SearchPath}" Style="{StaticResource SearchChip}"/>
                        <CheckBox Content="URL" IsChecked="{Binding SearchUrl}" Style="{StaticResource SearchChip}"/>
                        <CheckBox Content="标题" IsChecked="{Binding SearchTitle}" Style="{StaticResource SearchChip}"/>
                        <CheckBox Content="描述" IsChecked="{Binding SearchDesc}" Style="{StaticResource SearchChip}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 结果区：完全可复用、数据驱动的 SortableDataTable（表头排序/表格化行/空态一体）；
                 列定义/行交互/空态渲染由 code-behind 按 SearchViewModel 装配。
                 SelectionEnabled=False = **外部托管**：选中由 VM 的 ListSelection 承载，
                 绘制经 ApplySelectionPaint 投影（多选 Ctrl/Shift 由 code-behind 按修饰键路由）。 -->
            <views:SortableDataTable x:Name="ResultsTable" Grid.Row="2" Margin="12,0,12,8"
                                     SelectionEnabled="False"/>
        </Grid>

        <!-- 详情栏可拖拽分隔线（与浏览页同款交互） -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="Transparent" Cursor="SizeWE"/>

        <!-- ===== 右侧详情栏：复用 DetailSidebar 控件，大小与浏览页右侧栏一致 ===== -->
        <Border Grid.Column="2" Background="{DynamicResource TintPanel}"
                CornerRadius="24,0,0,24" Margin="0,0,0,8">
            <views:DetailSidebar x:Name="Sidebar" DataContext="{Binding Details}"/>
        </Border>

    </Grid>
</UserControl>
