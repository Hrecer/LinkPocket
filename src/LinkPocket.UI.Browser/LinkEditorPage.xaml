<UserControl x:Class="LinkPocket.Views.Browser.LinkEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LinkPocket.I18n;assembly=LinkPocket.I18n"
             xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
             xmlns:local="clr-namespace:LinkPocket.Views.Browser">

    <!-- 浏览模块「新建/编辑链接」整页编辑器：与链接详情页同版式（顶栏 + 居中内容列 + 统一卡片规格）。
         新建固定当前目录，无所属目录选择；数据由 LinkEditorViewModel 驱动。 -->

    <UserControl.Resources>
        <!-- BoolToVis / InvBoolToVis / ScrollGutterMargin 已上收 UIKit.xaml -->

        <!-- M3 Expressive 圆角填充文本域（单行） -->
        <Style x:Key="PageTextField" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource App.Accent.Fill}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource App.Accent.Fill}"/>
            <Setter Property="Background" Value="{DynamicResource App.Surface.Hover}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderThickness="2" BorderBrush="Transparent"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource App.Accent.Fill}"/>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.Surface.Base}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 大号标题字段（头部卡片内，保持填充底色保证可见） -->
        <Style x:Key="HeroTitleField" TargetType="TextBox" BasedOn="{StaticResource PageTextField}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderThickness="2" BorderBrush="Transparent">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource App.Accent.Fill}"/>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.Surface.Base}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 小图标按钮（URL 卡片右上角工具位） -->
        <Style x:Key="MiniIconButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="{DynamicResource App.Text.Secondary}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="13" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- 按钮组摆在近白胶囊容器（= 卡面）上 ⇒ 悬停取卡面那一支（本层压深一档） -->
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource App.Surface.CardHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource App.Accent.Icon}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 图标位上的"单独解析图标"徽标钮（20 圆形）：叠在 44 图标方块右下角，视觉上属于图标本身 -->
        <Style x:Key="IconBadgeButton" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Foreground" Value="{DynamicResource App.Text.Secondary}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource App.Surface.CardHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource App.Accent.Icon}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 多行描述文本域 -->
        <Style x:Key="PageMultilineField" TargetType="TextBox" BasedOn="{StaticResource PageTextField}">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="120"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderThickness="2" BorderBrush="Transparent"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Auto"
                                          Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource App.Accent.Fill}"/>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.Surface.Base}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource App.Surface.Base}">
        <!-- ===== 沉浸式 hero 头部（与详情页同骨架）：
         无传统顶栏 —— 编辑/新建页没有独立返回按钮：取消即返回（左上返回与取消使命重复，已彻底删除），
         取消/保存收进右上浮动胶囊组；页面标题由 hero 头部卡的小字幕承担。 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 正文：居中内容列 ===== -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- 定宽居中列：外边距经滚动条补偿，保证与详情页左边界严格一致（切换整页不横移） -->
            <Grid Width="760" HorizontalAlignment="Center">
                <Grid.Margin>
                    <Binding Path="ComputedVerticalScrollBarVisibility"
                             RelativeSource="{RelativeSource AncestorType=ScrollViewer}"
                             Converter="{StaticResource ScrollGutterMargin}"
                             ConverterParameter="36,84,36,28"/>
                </Grid.Margin>
                <StackPanel>

                <!-- 头部卡片：页面字幕 + 图标位 + 大号标题字段 -->
                <Border Background="{DynamicResource App.Surface.TintCard}"
                        CornerRadius="20" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{loc:Value TitleText}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Accent.Icon}" Opacity="0.9" Margin="2,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- 图标位：与右侧栏同款（白底圆角方块，非圆形；有 favicon 时替换默认图标）；
                             右下角叠一枚「单独解析图标」徽标钮（作用域只有图标，与一键解析共用同一枚魔法棒语义） -->
                        <Grid Width="44" Height="44" VerticalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="10" Background="White" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding Favicon}" Stretch="Uniform" Margin="6"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasFavicon}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <!-- 无 favicon 时统一回落小地球（与右侧栏/详情页一致），不用「编辑/新建」符号 -->
                                    <m3:M3Icon Kind="earth" Width="22" Height="22"
                                               Foreground="{DynamicResource App.Text.Secondary}" Opacity="0.5"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <m3:M3Icon.Style>
                                            <Style TargetType="m3:M3Icon">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasFavicon}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </m3:M3Icon.Style>
                                    </m3:M3Icon>
                                </Grid>
                            </Border>
                            <Button Style="{StaticResource IconBadgeButton}" Command="{Binding FetchIconCommand}"
                                    ToolTip="{loc:Loc editor.fetchIcon.tip}"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4">
                                <Grid>
                                    <m3:M3Icon Kind="auto-fix" Width="12" Height="12"
                                               Visibility="{Binding IsFetchingIcon, Converter={StaticResource InvBoolToVis}}"/>
                                    <m3:CircularProgress IsIndeterminate="True" Width="12" Height="12"
                                                         Visibility="{Binding IsFetchingIcon, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Button>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Grid Margin="2,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc ui.noun.name}" FontSize="12" Opacity="0.55"
                                           VerticalAlignment="Center" Foreground="{DynamicResource App.Text.Secondary}"/>
                                <!-- 单独解析标题（作用域只有标题；「一键解析」保持只补缺，这枚按钮是明确覆盖） -->
                                <Button Grid.Column="1" Style="{StaticResource MiniIconButton}"
                                        Command="{Binding FetchTitleCommand}" ToolTip="{loc:Loc editor.fetchTitle.tip}">
                                    <Grid>
                                        <m3:M3Icon Kind="auto-fix" Width="14" Height="14"
                                                   Visibility="{Binding IsFetchingTitle, Converter={StaticResource InvBoolToVis}}"/>
                                        <m3:CircularProgress IsIndeterminate="True" Width="13" Height="13"
                                                             Visibility="{Binding IsFetchingTitle, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Button>
                            </Grid>
                            <TextBox Style="{StaticResource HeroTitleField}"
                                     Text="{Binding LinkTitle, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    </StackPanel>
                </Border>

                <!-- 错误横幅 -->
                <Border Background="{DynamicResource App.Support.Container}" CornerRadius="12" Padding="14,10" Margin="0,14,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <m3:M3Icon Kind="alert-circle-outline" Width="16" Height="16" VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.Text.OnContainer}"/>
                        <TextBlock Text="{loc:Value Error}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Foreground="{DynamicResource App.Text.OnContainer}"/>
                    </StackPanel>
                </Border>

                <!-- URL 卡片 -->
                <Border Background="{DynamicResource App.Surface.TintCard}"
                        CornerRadius="16" Padding="20,16" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid Margin="2,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <m3:M3Icon Kind="link-variant" Width="13" Height="13" Opacity="0.6" VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.Text.Secondary}"/>
                                <TextBlock Text="URL" FontSize="12" Opacity="0.6" Margin="5,0,0,0"
                                           Foreground="{DynamicResource App.Text.Secondary}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 一键解析：抓取标题/描述/图标，空缺字段自动填充（不覆盖已填内容）；
                                     单字段抓取 = 标题/图标/描述三个板块各自那枚按钮 -->
                                <Button Style="{StaticResource MiniIconButton}" Command="{Binding FetchMetadataCommand}"
                                        ToolTip="{loc:Loc editor.autofetch.tip}">
                                    <Button.Content>
                                        <Grid>
                                            <m3:M3Icon Kind="auto-fix" Width="15" Height="15"
                                                       Visibility="{Binding IsFetchingAll, Converter={StaticResource InvBoolToVis}}"/>
                                            <m3:CircularProgress IsIndeterminate="True" Width="13" Height="13"
                                                                 Visibility="{Binding IsFetchingAll, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </Button.Content>
                                </Button>
                                <!-- 清除图标：仅编辑模式显示，保存时写入空图标 -->
                                <Button Style="{StaticResource MiniIconButton}" Command="{Binding ClearFaviconCommand}"
                                        ToolTip="{loc:Loc detail.clearIcon}" Margin="2,0,0,0">
                                    <Button.Visibility>
                                        <Binding Path="CanClearFavicon" Converter="{StaticResource BoolToVis}"/>
                                    </Button.Visibility>
                                    <m3:M3Icon Kind="close-circle-outline" Width="15" Height="15"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBox Style="{StaticResource PageTextField}"
                                 Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>

                <!-- 描述卡片 -->
                <Border Background="{DynamicResource App.Surface.TintCard}"
                        CornerRadius="16" Padding="20,16" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid Margin="2,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc ui.noun.description}" FontSize="12" Opacity="0.6"
                                           Foreground="{DynamicResource App.Text.Secondary}"/>
                                <TextBlock Text="{loc:Loc editor.markdown.tip}" FontSize="11" Opacity="0.5" Margin="10,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource App.Text.Secondary}"/>
                            </StackPanel>
                            <!-- 单独解析描述（站点 meta description；抓到即覆盖当前描述） -->
                            <Button Grid.Column="1" Style="{StaticResource MiniIconButton}"
                                    Command="{Binding FetchDescriptionCommand}" ToolTip="{loc:Loc editor.fetchDescription.tip}">
                                <Grid>
                                    <m3:M3Icon Kind="auto-fix" Width="14" Height="14"
                                               Visibility="{Binding IsFetchingDescription, Converter={StaticResource InvBoolToVis}}"/>
                                    <m3:CircularProgress IsIndeterminate="True" Width="13" Height="13"
                                                         Visibility="{Binding IsFetchingDescription, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Button>
                        </Grid>
                        <TextBox Style="{StaticResource PageMultilineField}"
                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- 浮动控制层：右上 取消/保存 胶囊组（编辑/新建页无返回按钮——取消即返回）。
             ⚠️ 必须声明在整页 ScrollViewer 之后（= z 序在上层）：
             Material3.Wpf 0.9.0 的 ScrollViewer 模板铺了一块与底色同色的不透明 Rectangle，
             悬浮层若在它下面，顶部按钮的鼠标命中会被整页 ScrollViewer 吃掉（同 LinkDetailPage）。 -->
        <Grid Grid.Row="0">
            <!-- 大药丸容器（内含 取消/保存 两个紫色小药丸），居右；容器底色 = TintCard
                 （同浏览页命令栏胶囊组口径）。返回语义收敛到「取消」（与详情页返回钮不重复）。 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,20,0">
                <Border Background="{DynamicResource App.Surface.TintCard}" CornerRadius="20" Padding="4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <!-- 成对规范：同为药丸（TonalButton / PrimaryPillButton 16），同高 32，仅颜色不同 -->
                        <Button Command="{Binding CancelCommand}" Style="{StaticResource TonalButton}"
                                Height="32" VerticalAlignment="Center" Padding="14,0">
                            <TextBlock Text="{loc:Loc common.cancel}" FontSize="12"/>
                        </Button>
                        <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryPillButton}"
                                Height="32" VerticalAlignment="Center" Padding="14,0" Margin="4,0,0,0"
                                HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!-- 边距挂在转圈右侧：隐藏时不占位，文字保持居中 -->
                                <m3:CircularProgress IsIndeterminate="True" Width="13" Height="13" Margin="0,0,5,0"
                                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{loc:Loc common.save}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
