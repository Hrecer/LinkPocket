       只依赖 UIKit/Contracts；对外无 internal 之外契约。 -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>LinkPocket.UI.Browser</RootNamespace>
