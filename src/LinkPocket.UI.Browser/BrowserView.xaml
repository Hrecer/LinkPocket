<UserControl x:Class="LinkPocket.Views.Browser.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LinkPocket.I18n;assembly=LinkPocket.I18n"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
             xmlns:vm="clr-namespace:LinkPocket.ViewModels"
             xmlns:views="clr-namespace:LinkPocket.Views;assembly=LinkPocket.UIKit"
             xmlns:local="clr-namespace:LinkPocket.Views.Browser"
             xmlns:uikit="clr-namespace:LinkPocket.Views.Browser;assembly=LinkPocket.UIKit"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             Background="{DynamicResource App.Surface.Base}">

    <!-- 快捷键不再用 XAML InputBindings 声明：键位唯一事实源 = BrowserShortcuts（LinkPocket.Input 子系统），
         由 ShortcutHost 按"栏作用域"统一分发（点击主栏/左栏即切换活跃作用域，见 BrowserView.xaml.cs）。 -->

    <UserControl.Resources>
        <!-- BoolToVis / InvBoolToVis / CountPill / NavIconButton / LpMenuItem 已上收 UIKit.xaml；
             SideCard / SideLabel / SideChip 已随详情栏抽为 Views/DetailSidebar 控件（样式控件自包含） -->

        <!-- 排序表头按钮已随共享数据表控件（views:SortableDataTable）统一：表头由控件按列定义生成，
             本页不再保留独立的 HeaderSortButton 样式。 -->

        <!-- 名称列文本可用宽度 = 名称列实宽（Star 按权重换算成像素）- 图标/间距/计数药丸的固定占位。
             ⚠️ 不能直接拿 ColumnWidths[0].Value：Star 列上它是权重(1) 而非像素，会让 MaxWidth 恒等于下限。 -->
        <uikit:NameColumnWidthConverter x:Key="NameCellTextWidth" Reserved="78" Min="60"/>

        <!-- 右键菜单项已上收 UIKit.xaml（LpMenuItem + 隐式兜底）。
             ⚠️ 两个坑（仍适用）：
             1) 菜单项若写了显式的 <MenuItem.Style>，会整体取代隐式样式（不是叠加），
                必须写 BasedOn="{StaticResource LpMenuItem}"，否则退回库默认模板
                → 同一张菜单里"有显式样式的项"高而缩进、"没写的项"矮而左对齐，看起来就是没对齐。
             2) 隐式样式与具名样式同时存在：具名的供 BasedOn 引用，隐式的负责兜底覆盖。 -->

        <!-- 行内信息列文字（最后更新 / 最后查看 / 查看次数 / 创建时间）统一规格 -->
        <Style x:Key="RowCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource App.Text.Secondary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </UserControl.Resources>

    <!-- 三段式：导航栏 / 内容区 / 状态栏 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 命令栏（悬浮式）：两枚新建命令收进一枚浮动胶囊组，不占整行 ===== -->
        <Border Grid.Row="1" Background="Transparent"
                Padding="12,0,12,8"
                views:BlankClick.Command="{Binding ClearPageSelectionCommand}">
            <Border HorizontalAlignment="Left" Background="{DynamicResource App.Surface.Card}"
                    CornerRadius="19" Padding="3" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <!-- 新建：Win11 命令栏首个命令，带 + 图标 + 文字。
                     ⚠️ **命令栏四枚药丸的宽度是冻结几何**（Width 逐枚钉死）：内容自适应宽度会把整条命令栏
                      撑宽，连带把后面的药丸一起推走。
                     取值口径 = **中文基线**（几何按中文定稿；英文放不下时缩英文字号让位，绝不为英文放大几何）：
                       壳宽 = 文字宽(中文 13pt) + 内距 24 + 描边 2 + 图标 16 + 文字外边距 7：
                         新建文件夹「新建文件夹」需 65px ⇒ 114；新建链接「新建链接」需 52px ⇒ 101；
                         重命名「重命名」需 39px ⇒ 88；删除「删除」需 26px ⇒ 75。
                     中文永不缩字号（`Loc.AllowsFontShrink` 只对英文为真）：中文放不下 = 这一格宽度定错了，
                     逐条加宽；英文放不下时由 LocFit 缩英文字号（只缩字号、绝不截断）。 -->
                <Button Command="{Binding NewFolderCommand}" Cursor="Hand" Width="114"
                        Style="{StaticResource TonalButton}" Padding="12,5" MinHeight="32">
                    <StackPanel Orientation="Horizontal">
                        <m3:M3Icon Kind="folder-plus" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                                   views:LocFit.Text="{loc:Fit browser.newFolder}" views:LocFit.Mode="Shrink"
                                   FontSize="13" VerticalAlignment="Center" Margin="7,0,0,0"/>
                    </StackPanel>
                </Button>
                <!-- 新建链接：与新建文件夹并列，弹出 M3 链接编辑器（默认当前目录） -->
                <Button x:Name="NewLinkButton" Command="{Binding NewLinkCommand}" Cursor="Hand" Width="101"
                        Style="{StaticResource TonalButton}" Padding="12,5" MinHeight="32" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <m3:M3Icon Kind="link-plus" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                                   views:LocFit.Text="{loc:Fit browser.newLink}" views:LocFit.Mode="Shrink"
                                   FontSize="13" VerticalAlignment="Center" Margin="7,0,0,0"/>
                    </StackPanel>
                </Button>
                <!-- 重命名：与 F2 / 右键「重命名」**同一条命令**（就地编辑；文件夹改名称、链接改标题）。
                     未选中或非单选时自动禁用（CanExecute 与 F2 同源）。 -->
                <Button Command="{Binding RenameSelectionCommand}" Cursor="Hand" Width="88"
                        Style="{StaticResource TonalButton}" Padding="12,5" MinHeight="32" Margin="8,0,0,0"
                        ToolTip="{loc:Loc btn.rename.tip}">
                    <StackPanel Orientation="Horizontal">
                        <m3:M3Icon Kind="pencil" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                                   views:LocFit.Text="{loc:Fit common.rename}" views:LocFit.Mode="Shrink"
                                   FontSize="13" VerticalAlignment="Center" Margin="7,0,0,0"/>
                    </StackPanel>
                </Button>
                <!-- 删除：删除选中项（文件夹/链接一律移入回收站，Windows 语义），未选中时禁用。
                     破坏性动作不设专门视觉（与次操作共用同一套呈现）。 -->
                <Button Command="{Binding DeleteSelectionCommand}" Cursor="Hand" Width="75"
                        Style="{StaticResource TonalButton}" Padding="12,5" MinHeight="32" Margin="8,0,0,0"
                        ToolTip="{loc:Loc btn.delete.tip}">
                    <StackPanel Orientation="Horizontal">
                        <m3:M3Icon Kind="delete-outline" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                                   views:LocFit.Text="{loc:Fit common.delete}" views:LocFit.Mode="Shrink"
                                   FontSize="13" VerticalAlignment="Center" Margin="7,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            </Border>
        </Border>

        <!-- ===== 导航行（悬浮式）：无整行底带 —— 三枚导航键收进一枚圆胶囊，地址栏自成胶囊，编辑键独立圆胶囊 =====
             导航行 / 命令栏 / 内容区 / 状态栏的空白都可清选中（BlankClick 附加行为，按区域挂载；
             判定 = 命中链归属：命中行、按钮、可拖选文本、滚动条或地址栏胶囊一律不算空白）。 -->
        <Border Grid.Row="0" Background="Transparent"
                Padding="12,0,12,8"
                views:BlankClick.Command="{Binding ClearPageSelectionCommand}">
            <DockPanel VerticalAlignment="Center" LastChildFill="True">
                <Border DockPanel.Dock="Left" Background="{DynamicResource App.Surface.Card}"
                        CornerRadius="17" Padding="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource NavIconButton}" Tag="{loc:Loc nav.backAlt.tip}"
                            Command="{Binding GoBackCommand}">
                        <m3:M3Icon Kind="arrow-left" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource NavIconButton}" Tag="{loc:Loc nav.forward.tip}"
                            Command="{Binding GoForwardCommand}">
                        <m3:M3Icon Kind="arrow-right" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource NavIconButton}" Tag="{loc:Loc nav.up.tip}"
                            Command="{Binding GoUpCommand}">
                        <m3:M3Icon Kind="arrow-up" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    </StackPanel>
                </Border>
                <!-- 地址栏（MD3 Expressive 胶囊）：已抽为 Views/BreadcrumbBar 可复用控件
                     （面包屑 + 路径编辑态 + 候选 Popup 内聚在控件内，宿主经事件转接 VM）。
                     编辑态只做颜色/描边形变，高度两态恒为 40 —— 基态值都在控件 Style.Setters 里。
                     Windows 11 口径：点胶囊空白即进入路径编辑（无编辑按钮），Enter 导航、Esc 取消。
                     根段宽 = **冻结几何**，取值 = **中文基线**：「全部书签」4 字 × 13pt（52px）+ 段内距 24 ⇒ 76
                     （英文 `Bookmarks` 放不下时缩英文字号让位）。 -->
                <views:BreadcrumbBar x:Name="Breadcrumb" Margin="12,0,0,0"
                                     RootSegmentWidth="76"
                                     Breadcrumbs="{Binding Breadcrumbs}"
                                     IsPathEditing="{Binding IsPathEditing, Mode=OneWay}"
                                     PathEditText="{Binding PathEditText, Mode=TwoWay}"
                                     PathCandidates="{Binding PathCandidates}"
                                     SelectedCandidateIndex="{Binding SelectedCandidateIndex, Mode=TwoWay}"
                                     HasPathCandidates="{Binding HasPathCandidates}"
                                     IsPathInvalid="{Binding IsPathInvalid}"
                                     CrumbClickCommand="{Binding CrumbClickCommand}"
                                     ConfirmPathCommand="{Binding ConfirmPathCommand}"
                                     CancelPathCommand="{Binding CancelPathEditCommand}"
                                     CompletePathCommand="{Binding CompletePathCommand}"
                                     EditRequested="Breadcrumb_EditRequested"
                                     CrumbDragOver="Breadcrumb_CrumbDragOver"
                                     CrumbDragLeave="Breadcrumb_CrumbDragLeave"
                                     CrumbDrop="Breadcrumb_CrumbDrop"
                                     CandidateMoveRequested="Breadcrumb_CandidateMoveRequested"
                                     EditFocusLost="Breadcrumb_EditFocusLost"
                                     EditPopupClosed="Breadcrumb_EditPopupClosed"
                                     CandidateChosen="Breadcrumb_CandidateChosen"/>
            </DockPanel>
        </Border>

        <!-- ===== 内容区：左侧文件夹树 / 右侧列表 / 详情栏 =====
             本层也挂"点空白清选中"：空白判定 = **命中链归属**（UIKit BlankClick）——
             命中树节点/列表行/按钮/可拖选文本一律不算空白，因此不会吞掉子区域的点击语义
             （旧实现按"祖先层级"判定才必须禁挂本层，见 docs/WARNINGS 第 30 条）。
             列表卡自身的空白由卡上那份同一实现处理（更内层先命中，外层自动让位）。 -->
        <Grid Grid.Row="2" Background="Transparent"
              views:BlankClick.Command="{Binding ClearPageSelectionCommand}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="286" MinWidth="230" MaxWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧文件夹树：已抽为 Views/FolderTreePanel 可复用控件（回收站同款布局）。
                 与中央列表卡同构 —— SurfaceContainerHigh 内容卡（左缘贴窗口边、底部留背景余位）；
                 拖放/右键菜单经控件事件转发（订阅即启用）。 -->
            <views:FolderTreePanel Grid.Column="0" x:Name="FolderTreePanelCtl"
                                   HeaderKey="nav.panel.title"
                                   ItemsSource="{Binding FolderTree}"
                                   NodeSelected="FolderTreePanel_NodeSelected"
                                   TreeBackgroundClicked="FolderTreePanel_BackgroundClicked"
                                   NodeDragOver="FolderTreePanel_NodeDragOver"
                                   NodeDragLeave="FolderTreePanel_NodeDragLeave"
                                   NodeDrop="FolderTreePanel_NodeDrop"
                                   NodeDragStartRequested="FolderTreePanel_NodeDragStartRequested"/>

            <!-- 右侧：列头 + 行列表 + 空状态 + 加载遮罩。
                 列表区卡片化（MD3E shape separation）：大圆角 24 + 四周基面沟槽，
                 消除与两侧面板之间生硬的竖直色块边界。 -->
            <!-- 列表卡自管"点空白清选中"（与其它区域同一实现 UIKit BlankClick；命中行不算空白）。
                 详情栏/分隔线在别的列，不经过这里。 -->
            <Border Grid.Column="1" Background="{DynamicResource App.Surface.Card}"
                    CornerRadius="24" Margin="8,0,8,8" ClipToBounds="True"
                    views:BlankClick.Command="{Binding ClearMainPaneSelectionCommand}"
                    AllowDrop="True" DragOver="ListCard_DragOver" DragLeave="ListCard_DragLeave" Drop="ListCard_Drop">
            <Grid>
                <Grid.ContextMenu>
                    <ContextMenu>
                        <!-- 紧凑菜单样式的隐式兜底：ContextMenu 不在 UserControl 的可视树里，
                             拿不到 UserControl.Resources 的隐式样式，所以必须在每个菜单自己的 Resources 里再声明一次。 -->
                        <ContextMenu.Resources>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}"/>
                        </ContextMenu.Resources>
                        <MenuItem Header="{loc:Loc browser.newFolder}" Command="{Binding NewFolderCommand}"/>
                        <MenuItem Header="{loc:Loc common.paste}" Command="{Binding PasteCommand}"/>
                        <MenuItem Header="{loc:Loc menu.selectAll}" Command="{Binding SelectAllCommand}"/>
                        <!-- 刷新（Windows 空白菜单同款）：与 F5 完全同一条命令（真刷新 = 置尾归位 + 遮罩 + 入场动画） -->
                        <MenuItem Header="{loc:Loc common.refresh}" Command="{Binding RefreshCommand}"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 列头 + 行列表：共享数据表控件（与搜索结果表同一份实现，数据驱动、独立 CS）。
                     列头/排序/列宽拖拽全部由控件按列定义生成；行 = 模板模式（ItemTemplate），
                     行悬停/选中/右键菜单/拖放仍归本页行模板所有。
                     排序经 SortChanged 事件转 VM（服务端排序），列宽单一数据源在控件 ColumnWidths。 -->
                <views:SortableDataTable x:Name="MainTable" Grid.Row="0"
                                         HeaderBandMargin="0" ItemsSource="{Binding Rows}">
                    <views:SortableDataTable.ItemTemplate>
                        <DataTemplate>
                            <!-- 外层 Border：承载事件/右键菜单/列宽对齐，透明无底色（宽度=视口，不产生横向溢出）；
                                 内层 RowSkin：MD3E 悬浮行容器 —— 大圆角 12 + 左右外距 10，hover/选中底色都在它上面 -->
                            <Border x:Name="RowBorder" Tag="BrowserRow" Cursor="Hand"
                                    MinWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                    PreviewMouseLeftButtonDown="RowBorder_PreviewMouseLeftButtonDown"
                                    PreviewMouseRightButtonDown="RowBorder_PreviewMouseRightButtonDown"
                                    MouseMove="RowBorder_MouseMove"
                                    MouseLeftButtonUp="RowBorder_MouseLeftButtonUp"
                                    ContextMenuOpening="RowBorder_ContextMenuOpening"
                                    AllowDrop="True" DragOver="RowBorder_DragOver" DragLeave="RowBorder_DragLeave" Drop="RowBorder_Drop">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <ContextMenu.Resources>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}"/>
                                        </ContextMenu.Resources>
                                        <MenuItem Header="{loc:Loc common.open}" Command="{Binding Host.RowOpenCommand}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="{loc:Loc browser.newFolderIn.tip}" Command="{Binding Host.NewFolderCommand}"
                                                  CommandParameter="{Binding Id}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <MenuItem Header="{loc:Loc common.copyLink}" Command="{Binding Host.CopyUrlCommand}" CommandParameter="{Binding}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <!-- 编辑 = 打开整页编辑器（URL / 名称 / 描述 / 图标）；仅链接有，且单选时显示。
                                             只想改标题请用下面的「重命名」（就地编辑，与 Windows F2 同效）。 -->
                                        <MenuItem Header="{loc:Loc common.edit}" Command="{Binding Host.EditRowCommand}" CommandParameter="{Binding}"
                                                  ToolTip="{loc:Loc editor.edit.tip}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsFolder}" Value="False"/>
                                                                <Condition Binding="{Binding Host.HasMultipleSelection}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <!-- 重命名（就地编辑，F2 同效）：文件夹改名称、链接改标题；单选时显示 -->
                                        <MenuItem Header="{loc:Loc common.rename}" Command="{Binding Host.RenameRowCommand}" CommandParameter="{Binding}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Host.HasMultipleSelection}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <MenuItem Header="{loc:Loc common.details}" Command="{Binding Host.OpenDetailCommand}" CommandParameter="{Binding}"
                                                  ToolTip="{loc:Loc crumb.openDetail.tip}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <MenuItem Header="{loc:Value Host.DeleteMenuHeader}" Command="{Binding Host.DeleteRowCommand}" CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick"
                                                  Command="{Binding DataContext.RowOpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <!-- 内层 RowSkin：MD3E 悬浮行容器（大圆角 12 + 左右外距 10）。
                                     底色触发器挂在这里：hover/选中底色是圆角的，且不会撑出横向滚动条。
                                     视觉单一来源 = UIKit LpRowCard（几何 + 悬停）；本层只挂选中/剪切态，
                                     派生触发器优先于基样式悬停 = 选中行悬停不换色（与文件夹树一致）。 -->
                                <Border Padding="16,7">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource LpRowCard}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource App.Accent.Container}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCut}" Value="True">
                                                    <Setter Property="Opacity" Value="0.45"/>
                                                </DataTrigger>
                                                <!-- 拖拽悬停落点（Windows 口径：指针下的落点整体高亮）。
                                                     与"选中"同键但语义不同；成环落点（拖到自己/自己的子文件夹）
                                                     可能与选中行重合——同键同色，因此不会出现"两种底色打架"。 -->
                                                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource App.Accent.Container}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                <Grid x:Name="RowColumns">
                                    <!-- 与列头共用同一份列宽（拖拽列头即同步到每一行） -->
                                    <Grid.ColumnDefinitions>
                                        <!-- 与共享控件表头共用同一份列宽（ColumnWidths 单一数据源，拖拽即同步） -->
                                        <ColumnDefinition views:ColumnWidthBinding.Width="{Binding ColumnWidths[0], RelativeSource={RelativeSource AncestorType=views:SortableDataTable}}"/>
                                        <ColumnDefinition views:ColumnWidthBinding.Width="{Binding ColumnWidths[1], RelativeSource={RelativeSource AncestorType=views:SortableDataTable}}"/>
                                        <ColumnDefinition views:ColumnWidthBinding.Width="{Binding ColumnWidths[2], RelativeSource={RelativeSource AncestorType=views:SortableDataTable}}"/>
                                        <ColumnDefinition views:ColumnWidthBinding.Width="{Binding ColumnWidths[3], RelativeSource={RelativeSource AncestorType=views:SortableDataTable}}"/>
                                        <ColumnDefinition views:ColumnWidthBinding.Width="{Binding ColumnWidths[4], RelativeSource={RelativeSource AncestorType=views:SortableDataTable}}"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 名称（图标 + 文本 + 计数药丸）：名称 Auto 紧跟图标，药丸紧贴名称（与左侧树一致），尾部 * 空白吸收剩余宽度 -->
                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
                                            <!-- 文件夹图标 -->
                                            <m3:M3Icon Kind="folder" Width="20" Height="20"
                                                                     Foreground="{DynamicResource App.Type.Folder}" VerticalAlignment="Center">
                                                <m3:M3Icon.Style>
                                                    <Style TargetType="m3:M3Icon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </m3:M3Icon.Style>
                                            </m3:M3Icon>
                                            <!-- 书签 favicon -->
                                            <Image Source="{Binding Favicon}" Width="16" Height="16"
                                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <!-- 书签默认图标（favicon 为空时） -->
                                            <m3:M3Icon Kind="link-variant" Width="16" Height="16"
                                                                     Foreground="{DynamicResource App.Text.Muted}" VerticalAlignment="Center">
                                                <m3:M3Icon.Style>
                                                    <Style TargetType="m3:M3Icon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsFolder}" Value="False"/>
                                                                    <Condition Binding="{Binding Favicon}" Value="{x:Null}"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </m3:M3Icon.Style>
                                            </m3:M3Icon>
                                        </Grid>
                                        <!-- 名称文本宽度跟随**名称列实宽**：列变窄时省略号收窄（药丸不会被挤出到相邻列），
                                             列够宽时不再无端截断（见 NameColumnWidthConverter 类型注释） -->
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}">
                                            <TextBlock.MaxWidth>
                                                <MultiBinding Converter="{StaticResource NameCellTextWidth}">
                                                    <Binding Path="ColumnWidths[0]" RelativeSource="{RelativeSource AncestorType=views:SortableDataTable}"/>
                                                    <Binding Path="ColumnWidths" RelativeSource="{RelativeSource AncestorType=views:SortableDataTable}"/>
                                                    <Binding Path="ActualWidth" ElementName="RowColumns"/>
                                                </MultiBinding>
                                            </TextBlock.MaxWidth>
                                        </TextBlock>
                                        <!-- 链接数药丸（仅文件夹）：紧贴名称，与左侧树完全一致（只显示数字） -->
                                        <Border Grid.Column="2" Padding="7,0" MinHeight="16" Margin="8,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource CountPill}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding LinkCount}" FontSize="10.5" FontWeight="Medium"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource App.Text.OnContainer}"/>
                                        </Border>
                                        <!-- 就地改名编辑框（Windows 口径）：覆盖在名称文本与计数药丸之上，
                                             宽度 = 名称列剩余整宽（跨 文本/药丸/余白 三列，由 * 列吸收剩余）；
                                             数据驱动（IsRenaming 是 VM 重命名会话的投影）+ 自持 Enter/Esc/失焦语义 -->
                                        <views:InlineNameEditor Grid.Column="1" Grid.ColumnSpan="3"
                                                                HorizontalAlignment="Stretch"
                                                                IsEditing="{Binding IsRenaming}"
                                                                Text="{Binding Host.EditingName, Mode=TwoWay}"
                                                                CommitCommand="{Binding Host.CommitRenameCommand}"
                                                                CancelCommand="{Binding Host.CancelRenameCommand}"/>
                                    </Grid>

                                    <!-- 最后更新（文件夹 = 内容含子孙最后变动时间；查看不算变动，内核维护）
                                         ⚠️ 日期列是**结构化数据**：走 LocFit 但只换短式 + 截断，不缩字号
                                         （见 UI-SPEC §3 的适用范围表）。ToolTip 由 LocFit 在真截断时补全文。 -->
                                    <TextBlock Grid.Column="1" Style="{StaticResource RowCellText}"
                                               Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}" views:LocFit.Text="{loc:FitValue ModifiedText}" views:LocFit.Mode="Shrink" TextTrimming="None" />

                                    <!-- 最后查看（文件夹 = 子孙链接被查看时沿父链刷新；从未显示「从未」） -->
                                    <TextBlock Grid.Column="2" Style="{StaticResource RowCellText}"
                                               Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}" views:LocFit.Text="{loc:FitValue LastViewedAdaptive}" views:LocFit.Mode="Shrink" TextTrimming="None" />

                                    <!-- 查看次数（文件夹 = 子树增量计数；链接 = 自身访问次数） -->
                                    <TextBlock Grid.Column="3" Style="{StaticResource RowCellText}"
                                               Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}" views:LocFit.Text="{loc:FitValue ViewCountText}" views:LocFit.Mode="Shrink" TextTrimming="None" />

                                    <!-- 创建时间 -->
                                    <TextBlock Grid.Column="4" Style="{StaticResource RowCellText}"
                                               Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}" views:LocFit.Text="{loc:FitValue CreatedText}" views:LocFit.Mode="Shrink" TextTrimming="None" />
                                </Grid>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </views:SortableDataTable.ItemTemplate>
                </views:SortableDataTable>

            <!-- 空状态（MD3E）：大圆角色块徽章 + 引导性文案，替代生硬的系统提示 -->
            <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Rows.Count}" Value="0"/>
                                    <Condition Binding="{Binding IsNavigating}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <!-- ⚠️ 宽度必须钉死（420）：这是**内容自适应**的占位组，里面的 96×96 徽标是居中的
                     ⇒ 组宽度一变（英文文案更长），徽标就跟着横移（实测 +24.53px，几何不变式当场红）。
                     钉宽后组宽不再随语言变，徽标位置由组宽 + 居中决定 = 恒定。 -->
                <StackPanel Width="420" HorizontalAlignment="Center">
                    <Border Width="96" Height="96" CornerRadius="32"
                            Background="{DynamicResource App.Accent.Container}"
                            HorizontalAlignment="Center">
                        <m3:M3Icon Kind="folder-open-outline" Width="40" Height="40"
                                   Foreground="{DynamicResource App.Text.OnContainer}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- ⚠️ 两行文字必须**钉宽 + 允许换行**（`MaxWidth` 360）：它们不钉宽时，
                         英文（比中文长得多）会把这张空态卡片**撑宽**，卡里的 96×96 徽标是居中的
                         ⇒ 整枚徽标右移（实测 +24.53px，几何不变式当场红）。钉宽后卡片宽度不再随语言变。 -->
                    <TextBlock Text="{loc:Loc sidebar.emptyHere}" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Text.Primary}"
                               HorizontalAlignment="Center" Margin="0,18,0,0"
                               TextWrapping="Wrap" MaxWidth="360"/>
                    <TextBlock Text="{loc:Loc tools.create.desc}" FontSize="12"
                               Foreground="{DynamicResource App.Text.Secondary}" Opacity="0.85"
                               HorizontalAlignment="Center" Margin="0,6,0,0"
                               TextWrapping="Wrap" MaxWidth="360"/>
                </StackPanel>
            </Grid>

            <!-- 加载遮罩：只在**导航加载**（用户发起：打开文件夹/跳转/返回/F5）时显示；
                     事件驱动的后台刷新（300ms 防抖）不闪动画——那些刷新没有可见的加载语义。
                     **唯一实现** = UIKit 控件 ListBusyOverlay（与回收站/搜索页/智能列表/去重明细共用同一份，
                     原先每页各写一份 Border+CircularProgress）。 -->
            <views:ListBusyOverlay Grid.Row="0" IsBusy="{Binding IsNavigating}"/>
            </Grid>
            </Border>

            <!-- 详情栏可拖拽分隔线 -->
        <GridSplitter Grid.Column="2" x:Name="DetailSplitter" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="Transparent" Cursor="SizeWE"/>

        <!-- ===== 右侧详情栏：紫色叠层面板 —— 右缘贴窗口边、左缘上下圆角朝沟槽；底部留背景余位。
             内容 = 可复用 DetailSidebar 控件（数据驱动，DataContext = Details，样式控件自包含）。
             ⚠️ 右栏整体声明 IsInteractive：点它**绝不清空列表选中**（右栏是"选中集合的投影"，
             在它上面点空白 / 拖选文本都属于查看行为，不该反过来取消选中）。 -->
        <Border Grid.Column="3" x:Name="DetailsPanel" Background="{DynamicResource App.Surface.Panel}"
                CornerRadius="24,0,0,24" Margin="0,0,0,8"
                views:BlankClick.IsInteractive="True">
            <views:DetailSidebar DataContext="{Binding Details}"/>
        </Border>
        </Grid>

        <!-- ===== 状态栏：左右贴边的通栏（无侧向圆角），顶部圆角仅在中央沟槽处与卡片衔接 ===== -->
        <Border Grid.Row="3" MinHeight="36" Background="{DynamicResource App.Surface.Panel}"
                CornerRadius="0" Margin="0"
                Padding="16,0"
                views:BlankClick.Command="{Binding ClearPageSelectionCommand}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Value StatusText}" FontSize="12" Foreground="{DynamicResource App.Text.Secondary}"/>
                    <!-- 选中信息：PrimaryContainer 药丸强调（MD3E 关键状态用色彩点亮） -->
                    <Border CornerRadius="9" Background="{DynamicResource App.Accent.Container}"
                            Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{loc:Value SelectionInfoText}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Text.OnContainer}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="LinkPocket · Material 3" FontSize="11" Foreground="{DynamicResource App.Text.Muted}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.6"/>
            </Grid>
        </Border>

        <!-- ===== 链接详情页覆盖层：打开时覆盖整个浏览模块（返回后回到浏览视图） ===== -->
        <Grid Grid.Row="0" Grid.RowSpan="3">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDetailPageOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <local:LinkDetailPage DataContext="{Binding DetailPage}"/>
        </Grid>

        <!-- ===== 链接编辑器覆盖层（新建/编辑整页）：位于详情页之上（从详情页点编辑时两层叠加） ===== -->
        <Grid Grid.Row="0" Grid.RowSpan="3">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditorPageOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <local:LinkEditorPage DataContext="{Binding EditorPage}"/>
        </Grid>
    </Grid>
</UserControl>
