<UserControl x:Class="LinkPocket.Views.TrashPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
             xmlns:views="clr-namespace:LinkPocket.Views;assembly=LinkPocket.UIKit"
             xmlns:loc="clr-namespace:LinkPocket.I18n;assembly=LinkPocket.I18n"
             xmlns:uikit="clr-namespace:LinkPocket.Views.Browser;assembly=LinkPocket.UIKit"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             Background="{DynamicResource App.Surface.Base}">
    <!-- 回收站页（与浏览页同构的"回收站浏览器"）：
         导航行（后退/前进/返回上级 + 面包屑地址栏 + 右侧「永久删除」）+ 左栏导航树（含链接叶子）
         + 中栏共享数据表（模板行 + 同一套行皮肤/多选）+ 右栏只读详情栏 + 状态栏。
         ⚠️ 只读语义：无撤销/重做、无新建/重命名/编辑、无剪贴板；**站内不可搬移**（条目只能被打开查看或永久删除）。
         快捷键 = TrashShortcuts（唯一事实源，按栏作用域分发）。 -->
    <UserControl.Resources>
        <!-- BoolToVis 已上收 UIKit.xaml -->

        <!-- 名称列文本可用宽度（与浏览页同口径；基准取名称列实宽） -->
        <uikit:NameColumnWidthConverter x:Key="NameCellTextWidth" Reserved="78" Min="60"/>

        <!-- 行内信息列文字（类型 / 原位置 / 删除时间）统一规格 -->
        <Style x:Key="RowCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource App.Text.Secondary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- 左栏节点菜单（控件级插槽：FolderTreePanel.NodeMenu；链接叶子由面板置空） -->
        <ContextMenu x:Key="TrashNodeMenu">
            <ContextMenu.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}"/>
            </ContextMenu.Resources>
            <MenuItem Header="{loc:Loc trash.menu.open}" Command="{Binding Host.OpenNodeCommand}" CommandParameter="{Binding}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="{loc:Loc trash.menu.restore}" Command="{Binding Host.RestoreNodeCommand}" CommandParameter="{Binding}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="{loc:Loc trash.menu.restoreToRoot}" Command="{Binding Host.RestoreNodeToRootCommand}" CommandParameter="{Binding}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="{loc:Loc trash.menu.purge}" Command="{Binding Host.PurgeNodeCommand}" CommandParameter="{Binding}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 导航行：三枚导航键圆胶囊 + 面包屑地址栏（点空白即编辑）+ 右侧处置按钮组 =====
             本行空白 / 内容区空白 / 状态栏空白都可清选中（BlankClick 附加行为，按区域挂载；
             判定 = 命中链归属：命中地址栏胶囊、按钮、行、可拖选文本一律不算空白）。 -->
        <Border Grid.Row="0" Background="Transparent" Padding="12,0,12,8"
                views:BlankClick.Command="{Binding ClearPageSelectionCommand}">
            <DockPanel VerticalAlignment="Center" LastChildFill="True">
                <!-- 处置按钮组（与浏览页命令栏同一形态：TintCard 白底大药丸容器 + 三枚**同规格**药丸——
                     同高 32 / 同圆角 16 / 同内距，仅长度不同；顺序 = 还原 · 还原到根目录 · 永久删除） -->
                <Border DockPanel.Dock="Right" Background="{DynamicResource App.Surface.TintCard}"
                        CornerRadius="19" Padding="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <!-- ⚠️ 三枚药丸的宽度是**冻结几何**（约束 B：切语言宽高逐像素不变）：
                             内容自适应宽度会让英文文案把整组撑宽（实测 PurgeButton 98→168.77），
                             连带把面包屑挤窄。文案放不下时由 LocFit 让位（短式 → 缩字号），几何不动。
                             96 = 中文基线 72 + 「Restore」在基准字号下的余量（实测 13pt 下约 45px）。 -->
                        <Button x:Name="RestoreButton" Cursor="Hand" Click="TrashRestore_Click"
                                IsEnabled="{Binding HasSelection}" Width="96"
                                Style="{StaticResource PrimaryPillButton}" Height="32" MinHeight="32" Padding="12,0"
                                ToolTip="{loc:Loc trash.btn.restore.tip}">
                            <StackPanel Orientation="Horizontal">
                                <m3:M3Icon Kind="restore" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                                           views:LocFit.Text="{loc:Fit trash.menu.restore}" views:LocFit.Mode="ShrinkThenEllipsis"
                                           FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="RestoreToRootButton" Cursor="Hand" Click="TrashRestoreToRoot_Click"
                                IsEnabled="{Binding HasSelection}" Width="124"
                                Style="{StaticResource TonalButton}" Height="32" MinHeight="32" Padding="12,0" Margin="6,0,0,0"
                                ToolTip="{loc:Loc trash.btn.restoreToRoot.tip}">
                            <StackPanel Orientation="Horizontal">
                                <m3:M3Icon Kind="backup-restore" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                                           views:LocFit.Text="{loc:Fit trash.menu.restoreToRoot}" views:LocFit.Mode="ShrinkThenEllipsis"
                                           FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="PurgeButton" Cursor="Hand" Click="TrashPurge_Click"
                                IsEnabled="{Binding HasSelection}" Width="98"
                                Style="{StaticResource TonalButton}" Height="32" MinHeight="32" Padding="12,0" Margin="6,0,0,0"
                                ToolTip="{loc:Loc trash.btn.purge.tip}">
                            <StackPanel Orientation="Horizontal">
                                <m3:M3Icon Kind="delete-forever" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                                           views:LocFit.Text="{loc:Fit trash.menu.purge}" views:LocFit.Mode="ShrinkThenEllipsis"
                                           FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <Border DockPanel.Dock="Left" Background="{DynamicResource App.Surface.Card}"
                        CornerRadius="17" Padding="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource NavIconButton}" Tag="{loc:Loc nav.back.tip}"
                                Command="{Binding GoBackCommand}">
                            <m3:M3Icon Kind="arrow-left" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource NavIconButton}" Tag="{loc:Loc nav.forward.tip}"
                                Command="{Binding GoForwardCommand}">
                            <m3:M3Icon Kind="arrow-right" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource NavIconButton}" Tag="{loc:Loc nav.up.tip}"
                                Command="{Binding GoUpCommand}">
                            <m3:M3Icon Kind="arrow-up" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Border>
                <!-- 面包屑地址栏：根 = 「回收站」；段可点导航、点空白即编辑（一次点击就绪，控件自持聚焦）；
                     只读页：段不接拖放（CrumbDropEnabled=False） -->
                <views:BreadcrumbBar x:Name="Breadcrumb" Margin="12,0,0,0"
                                     RootSegmentWidth="67"
                                     CrumbDropEnabled="False"
                                     Breadcrumbs="{Binding Breadcrumbs}"
                                     IsPathEditing="{Binding IsPathEditing, Mode=TwoWay}"
                                     PathEditText="{Binding PathEditText, Mode=TwoWay}"
                                     PathCandidates="{Binding PathCandidates}"
                                     SelectedCandidateIndex="{Binding SelectedCandidateIndex, Mode=TwoWay}"
                                     HasPathCandidates="{Binding HasPathCandidates}"
                                     IsPathInvalid="{Binding IsPathInvalid}"
                                     CrumbClickCommand="{Binding CrumbClickCommand}"
                                     ConfirmPathCommand="{Binding ConfirmPathCommand}"
                                     CancelPathCommand="{Binding CancelPathEditCommand}"
                                     CompletePathCommand="{Binding CompletePathCommand}"
                                     EditRequested="Breadcrumb_EditRequested"
                                     CandidateMoveRequested="Breadcrumb_CandidateMoveRequested"
                                     EditFocusLost="Breadcrumb_EditFocusLost"
                                     EditPopupClosed="Breadcrumb_EditPopupClosed"
                                     CandidateChosen="Breadcrumb_CandidateChosen"/>
            </DockPanel>
        </Border>

        <!-- ===== 内容区：左栏导航树 / 中栏列表卡 / 右栏只读详情栏 =====
             本层也挂"点空白清选中"：空白判定 = **命中链归属**（UIKit BlankClick）——
             命中树节点/列表行/按钮/可拖选文本一律不算空白，不会吞掉子区域的点击语义
             （旧实现按"祖先层级"判定才必须禁挂本层，见 docs/WARNINGS 第 30 条）。 -->
        <Grid Grid.Row="1" Background="Transparent"
              views:BlankClick.Command="{Binding ClearPageSelectionCommand}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="286"/>
            </Grid.ColumnDefinitions>

            <!-- 左栏：回收站导航树（虚根「回收站」+ 单元 + 链接叶子；节点不可改名的只读树） -->
            <views:FolderTreePanel Grid.Column="0" x:Name="FolderTreePanelCtl"
                                   HeaderKey="nav.panel.title"
                                   DragEnabled="False"
                                   NodeMenu="{StaticResource TrashNodeMenu}"
                                   ItemsSource="{Binding Tree}"
                                   NodeSelected="FolderTreePanel_NodeSelected"
                                   TreeBackgroundClicked="FolderTreePanel_BackgroundClicked"/>

            <!-- 中栏：列表卡（自管空白点击清选中 = 同一实现 BlankClick；命中行不算空白） -->
            <Border Grid.Column="1" Background="{DynamicResource App.Surface.Card}"
                    CornerRadius="24" Margin="8,0,8,8" ClipToBounds="True"
                    views:BlankClick.Command="{Binding ClearMainPaneSelectionCommand}">
                <Grid>
                    <Grid.ContextMenu>
                        <ContextMenu>
                            <ContextMenu.Resources>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}"/>
                            </ContextMenu.Resources>
                            <!-- 回收站列表空白菜单：只保留"选择/刷新"类（无新建/粘贴——只读语义） -->
                            <MenuItem Header="{loc:Loc menu.selectAll}" Command="{Binding SelectAllCommand}"/>
                            <MenuItem Header="{loc:Loc menu.refresh}" Command="{Binding RefreshCommand}"/>
                        </ContextMenu>
                    </Grid.ContextMenu>

                    <views:SortableDataTable x:Name="TrashTable" Grid.Row="0"
                                             HeaderBandMargin="0" ItemsSource="{Binding Rows}">
                        <views:SortableDataTable.ItemTemplate>
                            <DataTemplate>
                                <!-- 外层 Border：事件/右键菜单/列宽对齐；内层 RowSkin：共享行皮肤（与浏览页同款） -->
                                <Border x:Name="RowBorder" Tag="TrashRow" Cursor="Hand"
                                        MinWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                        PreviewMouseLeftButtonDown="RowBorder_PreviewMouseLeftButtonDown"
                                        MouseLeftButtonUp="RowBorder_MouseLeftButtonUp"
                                        ContextMenuOpening="RowBorder_ContextMenuOpening">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <ContextMenu.Resources>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}"/>
                                            </ContextMenu.Resources>
                                            <MenuItem Header="{loc:Loc trash.menu.open}" Command="{Binding Host.OpenRowCommand}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="{loc:Loc trash.menu.copyLink}" Command="{Binding Host.CopyLinkAddressCommand}" CommandParameter="{Binding}">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <MenuItem Header="{loc:Loc trash.menu.restore}" Command="{Binding Host.RestoreSelectionCommand}"/>
                                            <MenuItem Header="{loc:Loc trash.menu.restoreToRoot}" Command="{Binding Host.RestoreSelectionToRootCommand}"/>
                                            <MenuItem Header="{loc:Loc trash.menu.purge}" Command="{Binding Host.PurgeSelectionCommand}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick"
                                                      Command="{Binding DataContext.OpenRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <!-- 内层 RowSkin：与浏览页同一套（LpRowCard 基样式 + 选中触发器） -->
                                    <Border Padding="16,7">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource LpRowCard}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource App.Accent.Container}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid x:Name="RowColumns">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition views:ColumnWidthBinding.Width="{Binding ColumnWidths[0], RelativeSource={RelativeSource AncestorType=views:SortableDataTable}}"/>
                                                <ColumnDefinition views:ColumnWidthBinding.Width="{Binding ColumnWidths[1], RelativeSource={RelativeSource AncestorType=views:SortableDataTable}}"/>
                                                <ColumnDefinition views:ColumnWidthBinding.Width="{Binding ColumnWidths[2], RelativeSource={RelativeSource AncestorType=views:SortableDataTable}}"/>
                                                <ColumnDefinition views:ColumnWidthBinding.Width="{Binding ColumnWidths[3], RelativeSource={RelativeSource AncestorType=views:SortableDataTable}}"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 名称（图标 + 文本 + 单元计数药丸） -->
                                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
                                                    <!-- 单元图标（灰化，回收站语义） -->
                                                    <m3:M3Icon Kind="folder" Width="20" Height="20"
                                                               Foreground="{DynamicResource App.Text.Secondary}" Opacity="0.55"
                                                               VerticalAlignment="Center">
                                                        <m3:M3Icon.Style>
                                                            <Style TargetType="m3:M3Icon">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </m3:M3Icon.Style>
                                                    </m3:M3Icon>
                                                    <!-- 书签 favicon -->
                                                    <Image Source="{Binding Favicon}" Width="16" Height="16"
                                                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                    <!-- 书签默认图标（favicon 为空时；灰化） -->
                                                    <m3:M3Icon Kind="link-variant" Width="16" Height="16"
                                                               Foreground="{DynamicResource App.Text.Secondary}" Opacity="0.55"
                                                               VerticalAlignment="Center">
                                                        <m3:M3Icon.Style>
                                                            <Style TargetType="m3:M3Icon">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsFolder}" Value="False"/>
                                                                            <Condition Binding="{Binding Favicon}" Value="{x:Null}"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </m3:M3Icon.Style>
                                                    </m3:M3Icon>
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" Margin="10,0,0,0"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}">
                                                    <TextBlock.MaxWidth>
                                                        <MultiBinding Converter="{StaticResource NameCellTextWidth}">
                                                            <Binding Path="ColumnWidths[0]" RelativeSource="{RelativeSource AncestorType=views:SortableDataTable}"/>
                                                            <Binding Path="ColumnWidths" RelativeSource="{RelativeSource AncestorType=views:SortableDataTable}"/>
                                                            <Binding Path="ActualWidth" ElementName="RowColumns"/>
                                                        </MultiBinding>
                                                    </TextBlock.MaxWidth>
                                                </TextBlock>
                                                <!-- 单元计数药丸（子树链接数；链接行不显示） -->
                                                <Border Grid.Column="2" Padding="7,0" MinHeight="16" Margin="8,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource CountPill}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding LinkCount}" FontSize="10.5" FontWeight="Medium"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource App.Text.OnContainer}"/>
                                                </Border>
                                            </Grid>

                                            <!-- 类型 -->
                                            <TextBlock Grid.Column="1" Style="{StaticResource RowCellText}"
                                                       Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}" views:LocFit.Text="{loc:FitValue TypeText}" views:LocFit.Mode="ShrinkThenEllipsis"/>
                                            <!-- 原位置 -->
                                            <TextBlock Grid.Column="2" Style="{StaticResource RowCellText}"
                                                       Text="{loc:Value OriginText}" views:LocFit.Mode="ShrinkThenEllipsis"/>
                                            <!-- 删除时间（结构化数据：只换短式 + 截断，不缩字号；
                                                 ToolTip 由 LocFit 在真截断时补全文） -->
                                            <TextBlock Grid.Column="3" Style="{StaticResource RowCellText}"
                                                       Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}" views:LocFit.Text="{loc:FitValue DeletedText}" views:LocFit.Mode="ShrinkThenEllipsis"/>
                                        </Grid>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </views:SortableDataTable.ItemTemplate>
                    </views:SortableDataTable>

                    <!-- 空状态（独立宿主：绝不与 ItemsSource 混用 Items） -->
                    <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Rows.Count}" Value="0"/>
                                            <Condition Binding="{Binding IsNavigating}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel>
                            <Border Width="96" Height="96" CornerRadius="32"
                                    Background="{DynamicResource App.Support.Container}"
                                    HorizontalAlignment="Center">
                                <m3:M3Icon Kind="delete-outline" Width="40" Height="40"
                                           Foreground="{DynamicResource App.Text.OnContainer}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{loc:Loc trash.empty.title}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.Text.Primary}"
                                       HorizontalAlignment="Center" Margin="0,18,0,0"/>
                            <TextBlock Text="{loc:Loc trash.empty.hint}"
                                       FontSize="12" Foreground="{DynamicResource App.Text.Secondary}" Opacity="0.85"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 加载遮罩：只在导航加载（切页进入 / F5）出现；事件驱动的后台刷新静默。
                         **唯一实现** = UIKit 控件 ListBusyOverlay（与浏览页/搜索页/智能列表/去重明细共用同一份）。 -->
                    <views:ListBusyOverlay Grid.Row="0" IsBusy="{Binding IsNavigating}"/>
                </Grid>
            </Border>

            <!-- 右栏：只读详情栏（DetailSidebar；数据源 = VM 的 Details —— 选中集合的投影，随选中自动刷新）
                 ⚠️ 右栏整体声明 IsInteractive：点它**绝不清空列表选中**（在它上面点空白 / 拖选文本都属于
                 查看行为，不该反过来取消选中）。 -->
            <Border Grid.Column="2" Background="{DynamicResource App.Surface.Panel}"
                    CornerRadius="24" Margin="0,0,8,8"
                    views:BlankClick.IsInteractive="True">
                <views:DetailSidebar x:Name="TrashSidebar" DataContext="{Binding Details}"/>
            </Border>
        </Grid>

        <!-- ===== 状态栏：左右贴边通栏（状态文案 + 选中药丸 + 右侧提示） ===== -->
        <Border Grid.Row="2" MinHeight="36" Background="{DynamicResource App.Surface.Panel}" Padding="16,0"
                views:BlankClick.Command="{Binding ClearPageSelectionCommand}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Value StatusText}" FontSize="12" Foreground="{DynamicResource App.Text.Secondary}"/>
                    <Border CornerRadius="9" Background="{DynamicResource App.Accent.Container}"
                            Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <TextBlock FontSize="11.5" FontWeight="SemiBold" Text="{loc:Value SelectionInfoText}"
                                       Foreground="{DynamicResource App.Text.OnContainer}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <!-- 单选有名字时画名字（用户数据），项数句让位 -->
                                            <DataTrigger Binding="{Binding ShowsSelectionName}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding SelectionInfoName}" FontSize="11.5" FontWeight="SemiBold"
                                       Visibility="{Binding ShowsSelectionName, Converter={StaticResource BoolToVis}}"
                                       Foreground="{DynamicResource App.Text.OnContainer}"/>
                        </Grid>
                    </Border>
                </StackPanel>
                <TextBlock Text="{loc:Loc trash.footnote}"
                           FontSize="11" Foreground="{DynamicResource App.Text.Muted}" Opacity="0.6"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ===== 只读详情覆盖层 = **共享详情页**（UIKit `LinkDetailPane`，与浏览页详情页同一份界面） =====
             可见性由 VM 的 IsDetailOverlayOpen 驱动（状态在 VM、视图不持）；条目消失即关（VM 刷新收尾）。 -->
        <Grid x:Name="LinkDetailOverlay" Grid.Row="0" Grid.RowSpan="3"
              Background="{DynamicResource App.Surface.Base}"
              Visibility="{Binding IsDetailOverlayOpen, Converter={StaticResource BoolToVis}}">
            <views:LinkDetailPane DataContext="{Binding DetailPane}"/>
        </Grid>

    </Grid>
</UserControl>
