<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF Shell：组合根 + 窗口壳 + 区域装配 + 端口实现 + UiEventHub。
       UI 已模块化为 UIKit + UI.* 六项目（视图注册/路由装配见 Services/ViewRegistry）。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- EXE 图标 = 标题栏品牌 chip 的矢量复原（Assets/linkpocket.ico，多尺寸 16–256）。 -->
    <ApplicationIcon>Assets\linkpocket.ico</ApplicationIcon>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinkPocket.Composition\LinkPocket.Composition.csproj" />
    <ProjectReference Include="..\LinkPocket.Contracts\LinkPocket.Contracts.csproj" />
    <ProjectReference Include="..\LinkPocket.I18n\LinkPocket.I18n.csproj" />
    <ProjectReference Include="..\LinkPocket.UIKit\LinkPocket.UIKit.csproj" />
    <ProjectReference Include="..\LinkPocket.Theming\LinkPocket.Theming.csproj" />
    <ProjectReference Include="..\LinkPocket.UI.Browser\LinkPocket.UI.Browser.csproj" />
    <ProjectReference Include="..\LinkPocket.UI.Search\LinkPocket.UI.Search.csproj" />
    <ProjectReference Include="..\LinkPocket.UI.Trash\LinkPocket.UI.Trash.csproj" />
    <ProjectReference Include="..\LinkPocket.UI.SmartLists\LinkPocket.UI.SmartLists.csproj" />
    <ProjectReference Include="..\LinkPocket.UI.Tools\LinkPocket.UI.Tools.csproj" />
    <ProjectReference Include="..\LinkPocket.UI.Settings\LinkPocket.UI.Settings.csproj" />
    <ProjectReference Include="..\LinkPocket.UI.Ai\LinkPocket.UI.Ai.csproj" />
    <ProjectReference Include="..\LinkPocket.Ai\LinkPocket.Ai.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 同一份 .ico 也作为 WPF 资源：Window.Icon 走包资源，任务栏/Alt+Tab 不依赖 EXE 图标缓存。 -->
    <Resource Include="Assets\linkpocket.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Material3.Wpf" />
    <PackageReference Include="MdXaml" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- 元数据抓取的浏览器渲染兜底（PageRenderer）：JS 人机校验页只有真浏览器内核能过 -->
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

</Project>
