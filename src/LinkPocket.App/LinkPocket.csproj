<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF Shell：组合根 + 窗口壳 + 区域 + 端口实现（工程目录内只有应用自身源码，无任何排除 hack） -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinkPocket.Contracts\LinkPocket.Contracts.csproj" />
    <ProjectReference Include="..\LinkPocket.Infrastructure\LinkPocket.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Material3.Wpf" />
    <PackageReference Include="MdXaml" />
  </ItemGroup>

</Project>
