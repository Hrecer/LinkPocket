<Window x:Class="LinkPocket.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LinkPocket"
        xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
        xmlns:uibr="clr-namespace:LinkPocket.Views.Browser;assembly=LinkPocket.UI.Browser"
        xmlns:uisearch="clr-namespace:LinkPocket.Views;assembly=LinkPocket.UI.Search"
        xmlns:uitrash="clr-namespace:LinkPocket.Views;assembly=LinkPocket.UI.Trash"
        xmlns:uisl="clr-namespace:LinkPocket.Views;assembly=LinkPocket.UI.SmartLists"
        xmlns:uitools="clr-namespace:LinkPocket.Views;assembly=LinkPocket.UI.Tools"
        xmlns:uisettings="clr-namespace:LinkPocket.Views;assembly=LinkPocket.UI.Settings"
        mc:Ignorable="d"
        Title="LinkPocket"
        Height="860" Width="1400"
        MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        TextElement.FontFamily="{StaticResource AppFont}"
        TextElement.Foreground="{DynamicResource OnSurface}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="8"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="NavTabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainer}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 搜索页样式已随页面迁往 Views/SearchView.xaml -->

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="18"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="18"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource WarnBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EDDFA6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
                </Setter>
            </Style>
    </Window.Resources>

    <!-- 无边框大圆角悬浮窗壳：外圆角 22 + 柔和阴影。
         ⚠️ Border 的 CornerRadius 不会圆角裁切子内容，圆角裁切由 code-behind 在 SizeChanged 上
         设置 RectangleGeometry（WindowShell_SizeChanged）；最大化时由 Window_StateChanged 收圆角、收外距。 -->
    <Grid Background="Transparent">
        <Border x:Name="WindowShell" Margin="18" CornerRadius="22"
                Background="{DynamicResource SurfaceContainerLow}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.32" Color="#000000"/>
            </Border.Effect>
            <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 全局标题栏（所有页面共享）：Brand chip + 分段胶囊导航 + 圆角窗口键 ===== -->
        <Border Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="12,8,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 品牌：PrimaryContainer 圆角 chip + 粗字标 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Width="30" Height="30" CornerRadius="10"
                            Background="{DynamicResource PrimaryContainer}">
                        <m3:M3Icon Kind="link-variant" Width="17" Height="17"
                                   Foreground="{DynamicResource OnPrimaryContainer}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="LinkPocket" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- 分段胶囊导航：整体一个胶囊容器，选中项是滑动的 PrimaryContainer 药丸（动画由 code-behind 驱动）。
                     ⚠️ 全局导航常驻：任何页面（含二级视图）都不得隐藏它——历史上曾绑 IsInSecondaryPage
                     导致进智能列表/工具详情时导航消失，已彻底移除该状态（2026-09-16 用户明令）。 -->
                <Border Grid.Column="1" x:Name="NavCapsule" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceContainerHighest}" CornerRadius="17" Padding="3">
                    <Grid x:Name="NavHost">
                        <Border x:Name="NavPill" CornerRadius="14" Background="{DynamicResource PrimaryContainer}"
                                HorizontalAlignment="Left" Width="0" Height="30" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="NavPillTransform"/>
                            </Border.RenderTransform>
                        </Border>
                        <ItemsControl x:Name="NavigationTabs" ItemsSource="{Binding NavigationItems}" WindowChrome.IsHitTestVisibleInChrome="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource NavTabButton}"
                                            Command="{Binding DataContext.SelectNavCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}">
                                        <StackPanel Orientation="Horizontal">
                                            <m3:M3Icon Kind="{Binding IconKind}" Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Label}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click" ToolTip="最小化">
                        <Path Data="M0,6 L10,6" Stroke="{DynamicResource OnSurface}" StrokeThickness="1.2" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Width="10" Height="10"/>
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click" ToolTip="最大化">
                        <Path Data="M2,0 L8,0 A2,2 0 0 1 10,2 L10,8 A2,2 0 0 1 8,10 L2,10 A2,2 0 0 1 0,8 L0,2 A2,2 0 0 1 2,0 Z" Stroke="{DynamicResource OnSurface}" StrokeThickness="1.2" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Width="10" Height="10"/>
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="CloseButton_Click" ToolTip="关闭">
                        <Path Data="M2,2 L8,8 M8,2 L2,8" Stroke="{DynamicResource OnSurface}" StrokeThickness="1.3" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Width="10" Height="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 搜索页：视图/逻辑在 Views/SearchView + SearchViewModel，
             显隐与其它页面统一走 CurrentNavId 触发器；DataContext 由 Shell 下发为 SearchViewModel ===== -->
        <uisearch:SearchView Grid.Row="1" x:Name="SearchView"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <uisearch:SearchView.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.CurrentNavId, RelativeSource={RelativeSource AncestorType=Window}}" Value="search">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </uisearch:SearchView.Style>
        </uisearch:SearchView>

        <!-- ===== 资源管理器式浏览页（P4 新页面，与旧界面并存，显隐由 CurrentNavId 数据触发器控制） ===== -->
        <!-- 显隐与其它页面统一走 CurrentNavId 触发器（老「链接」页删除后它成为默认首页） -->
        <uibr:BrowserView Grid.Row="1" x:Name="BrowserPage"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <uibr:BrowserView.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <!-- 注意：BrowserPage 的 DataContext 是 BrowserViewModel，必须显式取窗口的 CurrentNavId -->
                        <DataTrigger Binding="{Binding DataContext.CurrentNavId, RelativeSource={RelativeSource AncestorType=Window}}" Value="browser">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </uibr:BrowserView.Style>
        </uibr:BrowserView>

        <!-- ===== 回收站视图（独立页面） ===== -->
        <uitrash:TrashPage Grid.Row="1" x:Name="TrashView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <uitrash:TrashPage.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.CurrentNavId, RelativeSource={RelativeSource AncestorType=Window}}" Value="trash">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </uitrash:TrashPage.Style>
        </uitrash:TrashPage>

        <!-- ===== 智能列表视图（独立页面） ===== -->
        <uisl:SmartListsPage Grid.Row="1" x:Name="SmartListsView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <uisl:SmartListsPage.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.CurrentNavId, RelativeSource={RelativeSource AncestorType=Window}}" Value="smartlists">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </uisl:SmartListsPage.Style>
        </uisl:SmartListsPage>

        <!-- ===== 工具页面（空壳） ===== -->
        <uitools:ToolsPage Grid.Row="1" x:Name="ToolsView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <uitools:ToolsPage.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.CurrentNavId, RelativeSource={RelativeSource AncestorType=Window}}" Value="tools">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </uitools:ToolsPage.Style>
        </uitools:ToolsPage>

        <!-- ===== 设置视图（独立页面） ===== -->
        <uisettings:SettingsPage Grid.Row="1" x:Name="SettingsView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <uisettings:SettingsPage.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.CurrentNavId, RelativeSource={RelativeSource AncestorType=Window}}" Value="settings">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </uisettings:SettingsPage.Style>
        </uisettings:SettingsPage>

            </Grid>
        </Border>
    </Grid>
</Window>
