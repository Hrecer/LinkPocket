<Window x:Class="LinkPocket.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LinkPocket"
        xmlns:vm="clr-namespace:LinkPocket.ViewModels"
        xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
        xmlns:mdxaml="clr-namespace:MdXaml;assembly=MdXaml"
        xmlns:views="clr-namespace:LinkPocket.Views"
        xmlns:browserviews="clr-namespace:LinkPocket.Views.Browser"
        mc:Ignorable="d"
        Title="LinkPocket"
        Height="860" Width="1400"
        MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        TextElement.FontFamily="{StaticResource AppFont}"
        TextElement.Foreground="{DynamicResource OnSurface}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="8"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="NavTabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainer}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===== 搜索页（MD3 Expressive）专用样式 ===== -->
        <!-- 胶囊搜索栏内的透明输入框：视觉由外层 SearchBarShell 承担 -->
        <Style x:Key="SearchCapsuleBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <!-- 筛选 chip：药丸形，选中后变低圆角 + SecondaryContainer 强调（MD3E 形状区分状态） -->
        <!-- 跳转按钮（M3E Filled 药丸）：搜索工具行唯一的关键动作，Primary 填色锚定注意力（色彩即层级）；
             禁用态 = SurfaceContainerHighest + OnSurfaceMuted（MD3 规范禁用色，不再用透明度 hack）；
             按压圆角形变 16→10（M3E 交互化作形变）。 -->
        <Style x:Key="SearchJumpPillButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBtn}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnPrimary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="StateLayer" Background="{DynamicResource OnPrimary}"
                                        Opacity="0" CornerRadius="16"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.12"/>
                                <Setter TargetName="Bd" Property="CornerRadius" Value="10"/>
                                <Setter TargetName="StateLayer" Property="CornerRadius" Value="10"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceContainerHighest}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceMuted}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 搜索范围筛选 chip（M3E：色彩 + 形变表达选中态）：
             未选 = 透明（浮在分组容器 SurfaceContainerHigh 上）+ 悬停浮起；
             选中 = SecondaryContainer 填色 + 内边距加宽 13→24（用户要求：选中看得见变宽）
                    + 圆角形变 15→10 + SemiBold。
             ⚠️ 不放图标：LpIcons 字形表未注册「check」，M3Icon 会渲染成占位的空白（见 2026-09-16 教训）。 -->
        <Style x:Key="SearchChip" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Height="30" CornerRadius="15"
                                Background="Transparent" Padding="13,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceContainerHighest}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryContainer}"/>
                                <Setter TargetName="Bd" Property="Padding" Value="24,0"/>
                                <Setter TargetName="Bd" Property="CornerRadius" Value="10"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="18"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="18"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource WarnBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EDDFA6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
                </Setter>
            </Style>
        <local:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <vm:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVis"/>
        <vm:FaviconConverter x:Key="FaviconConverter"/>
    </Window.Resources>

    <!-- 无边框大圆角悬浮窗壳：外圆角 22 + 柔和阴影。
         ⚠️ Border 的 CornerRadius 不会圆角裁切子内容，圆角裁切由 code-behind 在 SizeChanged 上
         设置 RectangleGeometry（WindowShell_SizeChanged）；最大化时由 Window_StateChanged 收圆角、收外距。 -->
    <Grid Background="Transparent">
        <Border x:Name="WindowShell" Margin="18" CornerRadius="22"
                Background="{DynamicResource SurfaceContainerLow}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.32" Color="#000000"/>
            </Border.Effect>
            <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 全局标题栏（所有页面共享）：Brand chip + 分段胶囊导航 + 圆角窗口键 ===== -->
        <Border Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="12,8,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 品牌：PrimaryContainer 圆角 chip + 粗字标 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Width="30" Height="30" CornerRadius="10"
                            Background="{DynamicResource PrimaryContainer}">
                        <m3:M3Icon Kind="link-variant" Width="17" Height="17"
                                   Foreground="{DynamicResource OnPrimaryContainer}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="LinkPocket" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- 分段胶囊导航：整体一个胶囊容器，选中项是滑动的 PrimaryContainer 药丸（动画由 code-behind 驱动）。
                     ⚠️ 全局导航常驻：任何页面（含二级视图）都不得隐藏它——历史上曾绑 IsInSecondaryPage
                     导致进智能列表/工具详情时导航消失，已彻底移除该状态（2026-09-16 用户明令）。 -->
                <Border Grid.Column="1" x:Name="NavCapsule" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceContainerHighest}" CornerRadius="17" Padding="3">
                    <Grid x:Name="NavHost">
                        <Border x:Name="NavPill" CornerRadius="14" Background="{DynamicResource PrimaryContainer}"
                                HorizontalAlignment="Left" Width="0" Height="30" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="NavPillTransform"/>
                            </Border.RenderTransform>
                        </Border>
                        <ItemsControl x:Name="NavigationTabs" ItemsSource="{Binding NavigationItems}" WindowChrome.IsHitTestVisibleInChrome="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource NavTabButton}"
                                            Command="{Binding DataContext.SelectNavCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}">
                                        <StackPanel Orientation="Horizontal">
                                            <m3:M3Icon Kind="{Binding IconKind}" Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Label}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click" ToolTip="最小化">
                        <Path Data="M0,6 L10,6" Stroke="{DynamicResource OnSurface}" StrokeThickness="1.2" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Width="10" Height="10"/>
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click" ToolTip="最大化">
                        <Path Data="M2,0 L8,0 A2,2 0 0 1 10,2 L10,8 A2,2 0 0 1 8,10 L2,10 A2,2 0 0 1 0,8 L0,2 A2,2 0 0 1 2,0 Z" Stroke="{DynamicResource OnSurface}" StrokeThickness="1.2" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Width="10" Height="10"/>
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="CloseButton_Click" ToolTip="关闭">
                        <Path Data="M2,2 L8,8 M8,2 L2,8" Stroke="{DynamicResource OnSurface}" StrokeThickness="1.3" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Width="10" Height="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 搜索视图（左侧结果 + 右侧常驻固定栏） ===== -->
        <Grid Grid.Row="1" x:Name="SearchView" Background="{DynamicResource SurfaceContainerLow}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentNavId}" Value="search">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <!-- 结果列表占剩余宽度；详情栏与浏览页同规格（286，可拖拽 230~400） -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="286" MinWidth="230" MaxWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：搜索框 + 跳转工具栏(含筛选项) + 结果列表 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="12,0,12,8">
                    <!-- 胶囊搜索栏（视觉重心）：聚焦时高度 52→62、圆角 26→20 形变，弹簧曲线。
                         ⚠️ 基态值必须写在 Style.Setters 里（本地值优先级高于样式触发器）。 -->
                    <Border x:Name="SearchBarShell" Height="52"
                            Padding="20,0,12,0" HorizontalAlignment="Stretch">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="26"/>
                                <Setter Property="Background" Value="{DynamicResource SurfaceContainerHigh}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighest}"/>
                                        <!-- 高 62 的胶囊全圆 = 31：圆角若小于高度一半会出现"方不方圆不圆"的怪框 -->
                                        <Setter Property="CornerRadius" Value="31"/>
                                        <Setter Property="Height" Value="62"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <m3:M3Icon Grid.Column="0" Kind="magnify" Width="22" Height="22"
                                       Foreground="{DynamicResource Primary}" VerticalAlignment="Center"/>

                            <Grid Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="搜索书签、网址或描述…" FontSize="16" VerticalAlignment="Center"
                                           Foreground="{DynamicResource OnSurfaceVariant}" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox, FallbackValue=0}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="SearchBox" Style="{StaticResource SearchCapsuleBox}"
                                         Background="Transparent"
                                         KeyDown="SearchBox_KeyDown"/>
                            </Grid>

                            <!-- Focusable=False：点击不抢走搜索框键盘焦点，避免聚焦胶囊态闪烁。
                                 库 FilledButton 模板可能硬编码 Primary 底色 → 统一换 PrimaryPillButton（AccentBtn #A18EB0） -->
                            <Button Grid.Column="3" Content="搜索" Padding="20,9" FontSize="13" FontWeight="SemiBold"
                                    Style="{StaticResource PrimaryPillButton}"
                                    Click="SearchButton_Click" Focusable="False"
                                    VerticalAlignment="Center" Margin="4,0,4,0"/>
                            <Button Grid.Column="4" Content="取消" Padding="14,9" FontSize="13"
                                    Style="{StaticResource TextButton}" Click="SearchCancelButton_Click" Focusable="False"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Border>

                <!-- 筛选工具行（M3E）：跳转 = Filled 药丸（关键操作，色彩锚定）；
                     「搜索范围」+ 筛选 chip 归集进同一个圆角分组容器（M3E 重拾边界与框线：分组体现视觉重心）。
                     chip 未选透明、选中 SecondaryContainer + 形变 + 对勾，层级由色彩直接区分。 -->
                <StackPanel x:Name="SearchToolbar" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,0,0,8">
                    <Button x:Name="SearchJumpToLinkBtn" Click="SearchJumpToLinkBtn_Click" IsEnabled="False"
                            Style="{StaticResource SearchJumpPillButton}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <m3:M3Icon Kind="open-in-new" Width="15" Height="15" VerticalAlignment="Center"/>
                            <TextBlock Text="跳转" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 筛选分组容器：与搜索胶囊同色调（SurfaceContainerHigh），全圆角 16 包 30 高 chip -->
                    <Border Background="{DynamicResource SurfaceContainerHigh}" CornerRadius="16"
                            Padding="5,1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="搜索范围" FontSize="12" Foreground="{DynamicResource OnSurfaceVariant}"
                                       VerticalAlignment="Center" Margin="9,0,3,0"/>
                            <CheckBox x:Name="SearchPathCb" Content="路径" IsChecked="True" Style="{StaticResource SearchChip}"
                                      Checked="SearchScope_Changed" Unchecked="SearchScope_Changed"/>
                            <CheckBox x:Name="SearchUrlCb" Content="URL" IsChecked="True" Style="{StaticResource SearchChip}"
                                      Checked="SearchScope_Changed" Unchecked="SearchScope_Changed"/>
                            <CheckBox x:Name="SearchTitleCb" Content="标题" IsChecked="True" Style="{StaticResource SearchChip}"
                                      Checked="SearchScope_Changed" Unchecked="SearchScope_Changed"/>
                            <CheckBox x:Name="SearchDescCb" Content="描述" IsChecked="True" Style="{StaticResource SearchChip}"
                                      Checked="SearchScope_Changed" Unchecked="SearchScope_Changed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 结果区：完全可复用、数据驱动的 SortableDataTable（表头排序/表格化行/空态一体） -->
                <views:SortableDataTable x:Name="SearchResultsTable" Grid.Row="2" Margin="12,0,12,8"/>
            </Grid>

            <!-- 详情栏可拖拽分隔线（与浏览页同款交互） -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE"/>

            <!-- ===== 右侧详情栏：复用 DetailSidebar 控件，大小与浏览页右侧栏一致 ===== -->
            <Border Grid.Column="2" Background="{DynamicResource TintPanel}"
                    CornerRadius="24,0,0,24" Margin="0,0,0,8">
                <views:DetailSidebar x:Name="SearchSidebar"/>
            </Border>

        </Grid>

        <!-- ===== 资源管理器式浏览页（P4 新页面，与旧界面并存，显隐由 CurrentNavId 数据触发器控制） ===== -->
        <!-- 显隐与其它页面统一走 CurrentNavId 触发器（老「链接」页删除后它成为默认首页） -->
        <browserviews:BrowserView Grid.Row="1" x:Name="BrowserPage"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <browserviews:BrowserView.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <!-- 注意：BrowserPage 的 DataContext 是 BrowserViewModel，必须显式取窗口的 CurrentNavId -->
                        <DataTrigger Binding="{Binding DataContext.CurrentNavId, RelativeSource={RelativeSource AncestorType=Window}}" Value="browser">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </browserviews:BrowserView.Style>
        </browserviews:BrowserView>

        <!-- ===== 回收站视图（独立页面） ===== -->
        <views:TrashPage Grid.Row="1" x:Name="TrashView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <views:TrashPage.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentNavId}" Value="trash">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:TrashPage.Style>
        </views:TrashPage>

        <!-- ===== 智能列表视图（独立页面） ===== -->
        <views:SmartListsPage Grid.Row="1" x:Name="SmartListsView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <views:SmartListsPage.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentNavId}" Value="smartlists">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:SmartListsPage.Style>
        </views:SmartListsPage>

        <!-- ===== 工具页面（空壳） ===== -->
        <views:ToolsPage Grid.Row="1" x:Name="ToolsView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <views:ToolsPage.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentNavId}" Value="tools">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:ToolsPage.Style>
        </views:ToolsPage>

        <!-- ===== 设置视图（独立页面） ===== -->
        <views:SettingsPage Grid.Row="1" x:Name="SettingsView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <views:SettingsPage.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentNavId}" Value="settings">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:SettingsPage.Style>
        </views:SettingsPage>

            </Grid>
        </Border>
    </Grid>
</Window>
