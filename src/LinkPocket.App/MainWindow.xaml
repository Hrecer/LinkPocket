<Window x:Class="LinkPocket.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LinkPocket.I18n;assembly=LinkPocket.I18n"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LinkPocket"
        xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
        xmlns:uibr="clr-namespace:LinkPocket.Views.Browser;assembly=LinkPocket.UI.Browser"
        xmlns:uisearch="clr-namespace:LinkPocket.Views;assembly=LinkPocket.UI.Search"
        xmlns:uitrash="clr-namespace:LinkPocket.Views;assembly=LinkPocket.UI.Trash"
        xmlns:uisl="clr-namespace:LinkPocket.Views;assembly=LinkPocket.UI.SmartLists"
        xmlns:uitools="clr-namespace:LinkPocket.Views;assembly=LinkPocket.UI.Tools"
        xmlns:uisettings="clr-namespace:LinkPocket.Views;assembly=LinkPocket.UI.Settings"
        xmlns:views="clr-namespace:LinkPocket.Views;assembly=LinkPocket.UIKit"
        mc:Ignorable="d"
        Title="LinkPocket"
        Height="860" Width="1400"
        MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        TextElement.FontFamily="{DynamicResource App.Font.Ui}"
        TextElement.Foreground="{DynamicResource App.Text.Primary}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="8"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 搜索页样式已随页面迁往 Views/SearchView.xaml -->
        <!-- 顶部导航药丸条样式已随组件迁往 UIKit.xaml（SlidingNavStripStyle / SlidingNavStripItemStyle） -->

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="18"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource App.State.TitleBar.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource App.State.TitleBar.Pressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="18"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- 关闭键原先是奶油黄悬停（全窗口最刺眼的一处黄）→ 改用与最小化/最大化
                                     完全相同的中性状态层（决策 3：破坏性动作不设专门视觉）。 -->
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource App.State.TitleBar.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource App.State.TitleBar.Pressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
                </Setter>
            </Style>
    </Window.Resources>

    <!-- 无边框大圆角悬浮窗壳：外圆角 22 + 柔和阴影。
         ⚠️ Border 的 CornerRadius 不会圆角裁切子内容，圆角裁切由 code-behind 在 SizeChanged 上
         设置 RectangleGeometry（WindowShell_SizeChanged）；最大化时由 Window_StateChanged 收圆角、收外距。 -->
    <Grid Background="Transparent">
        <Border x:Name="WindowShell" Margin="18" CornerRadius="22"
                Background="{DynamicResource App.Surface.Base}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.32" Color="{DynamicResource App.Color.Shadow}"/>
            </Border.Effect>
            <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 全局标题栏（所有页面共享）：Brand chip + 分段胶囊导航 + 圆角窗口键 ===== -->
        <Border Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="12,8,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 品牌：PrimaryContainer 圆角 chip + 粗字标 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Width="30" Height="30" CornerRadius="10"
                            Background="{DynamicResource App.Accent.Container}">
                        <m3:M3Icon Kind="link-variant" Width="17" Height="17"
                                   Foreground="{DynamicResource App.Text.OnContainer}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="LinkPocket" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- 分段胶囊导航 = 可复用组件 SlidingNavStrip（ListBox 基座 + 组件内部的滑动指示器）——
                     几何贴齐与滑动动画由组件自持，本窗口不再有任何导航动画 code-behind（同 SideNavList 模式）。
                     ⚠️ 全局导航常驻：任何页面（含二级视图）都不得隐藏它——历史上曾绑 IsInSecondaryPage
                     导致进智能列表/工具详情时导航消失，该状态已彻底移除。 -->
                <views:SlidingNavStrip Grid.Column="1" x:Name="NavigationStrip"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Style="{StaticResource SlidingNavStripStyle}"
                                       ItemContainerStyle="{StaticResource SlidingNavStripItemStyle}"
                                       ItemsSource="{Binding NavigationItems}"
                                       SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                                       WindowChrome.IsHitTestVisibleInChrome="True">
                    <views:SlidingNavStrip.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <m3:M3Icon Kind="{Binding IconKind}" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:LocKey LabelKey}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </views:SlidingNavStrip.ItemTemplate>
                </views:SlidingNavStrip>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click" ToolTip="{loc:Loc window.minimize}">
                        <Path Data="M0,6 L10,6" Stroke="{DynamicResource App.Text.Primary}" StrokeThickness="1.2" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Width="10" Height="10"/>
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click" ToolTip="{loc:Loc window.maximize}">
                        <Path Data="M2,0 L8,0 A2,2 0 0 1 10,2 L10,8 A2,2 0 0 1 8,10 L2,10 A2,2 0 0 1 0,8 L0,2 A2,2 0 0 1 2,0 Z" Stroke="{DynamicResource App.Text.Primary}" StrokeThickness="1.2" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Width="10" Height="10"/>
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="CloseButton_Click" ToolTip="{loc:Loc common.close}">
                        <Path Data="M2,2 L8,8 M8,2 L2,8" Stroke="{DynamicResource App.Text.Primary}" StrokeThickness="1.3" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Width="10" Height="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 搜索页：视图/逻辑在 Views/SearchView + SearchViewModel，
             显隐由 Shell 按「视图注册表」重投影（唯一登记点）；DataContext 由 Shell 下发为 SearchViewModel ===== -->
        <uisearch:SearchView Grid.Row="1" x:Name="SearchView"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed">
        </uisearch:SearchView>

        <!-- ===== 资源管理器式浏览页（P4 新页面，与旧界面并存；显隐由 Shell 按注册表重投影） ===== -->
        <!-- 老「链接」页删除后它成为默认首页 -->
        <uibr:BrowserView Grid.Row="1" x:Name="BrowserPage"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed">
        </uibr:BrowserView>

        <!-- ===== 回收站视图（独立页面） ===== -->
        <uitrash:TrashPage Grid.Row="1" x:Name="TrashView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed">
        </uitrash:TrashPage>

        <!-- ===== 智能列表视图（独立页面） ===== -->
        <uisl:SmartListsPage Grid.Row="1" x:Name="SmartListsView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed">
        </uisl:SmartListsPage>

        <!-- ===== 工具页面（空壳） ===== -->
        <uitools:ToolsPage Grid.Row="1" x:Name="ToolsView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed">
        </uitools:ToolsPage>

        <!-- ===== 设置视图（独立页面） ===== -->
        <uisettings:SettingsPage Grid.Row="1" x:Name="SettingsView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed">
        </uisettings:SettingsPage>

            </Grid>
        </Border>
    </Grid>
</Window>
