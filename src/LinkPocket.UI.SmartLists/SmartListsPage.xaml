<UserControl x:Class="LinkPocket.Views.SmartListsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
             xmlns:views="clr-namespace:LinkPocket.Views;assembly=LinkPocket.UIKit"
             Focusable="True">
    <!-- 智能列表页（v2 完全重做）：与搜索页/回收站页同构 ——
         入口：MD3E 页头 + 卡片网格（卡面 SurfaceContainerHigh、悬停 SurfaceContainerHighest）；
         结果：左 = 工具行 + 圆角 24 表格容器内嵌共享 SortableDataTable（工厂模式 6 列），
               右 = TintPanel 详情栏 + 可复用 DetailSidebar（搜索页同款 286 可拖拽）。
         页面自包含：所有交互逻辑在本页 code-behind，不依赖 MainWindow 注入。 -->

    <UserControl.Resources>
        <!-- BoolToVis 已上收 UIKit.xaml -->
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfaceContainerLow}">

        <!-- ============================================================ -->
        <!-- ===== 面板 A：入口（纵向卡片流 + 底部锚点 + 微渐变纵深） ===== -->
        <!-- ============================================================ -->
        <!-- 负空间管理：四个卡片是唯一内容主体 → 由 2×2 顶部悬浮改为纵向堆叠自然下延；
             底部署名锚点 + 顶部透明→底部 6% 淡紫的线性渐变让剩余空白有起点、纵深与终点。 -->
        <Grid x:Name="CardPanel">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#006750A4" Offset="0"/>
                    <GradientStop Color="#0F6750A4" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="28,18,28,44">
                <!-- Stretch：卡片流撑满内容宽度（MaxWidth 880 收口，宽视口下自动居中） -->
                <StackPanel MaxWidth="880" HorizontalAlignment="Stretch">

                    <!-- 页头（与卡片左缘同一条水平对齐线） -->
                    <TextBlock Text="智能列表" FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource OnSurface}" Margin="2,4,0,0"/>
                    <TextBlock Text="按访问与编辑行为自动汇集的动态集合，数据实时更新"
                               FontSize="12.5" Foreground="{DynamicResource OnSurfaceVariant}"
                               Margin="2,5,0,20"/>

                    <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 纵向卡片：内边距 24（8pt 网格），**药丸（胶囊）形**——圆角 = 高度一半
                                     （内容高度变化仍保持胶囊；写死圆角会在内容变高时退化成圆角矩形），
                                     微投影增强体积感。⚠️ 基态视觉值必须写在 Style.Setters（本地值优先级高于触发器） -->
                                <Border Margin="0,0,0,12" Padding="24,20" Cursor="Hand"
                                        Tag="{Binding Id}" MouseLeftButtonUp="Card_Click"
                                        CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource HalfRadius}}"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270"
                                                          Opacity="0.07" Color="#000000"/>
                                    </Border.Effect>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceContainerHigh}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighest}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 图标徽章：56px 大容器 + 品牌紫图标 -->
                                        <Border Grid.Column="0" Width="56" Height="56" CornerRadius="16"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource PrimaryContainer}">
                                            <m3:M3Icon Kind="{Binding IconKind}" Width="26" Height="26"
                                                       Foreground="{DynamicResource Primary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="16,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource OnSurface}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource OnSurfaceVariant}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <m3:M3Icon Grid.Column="2" Kind="chevron-right" Width="20" Height="20"
                                                   VerticalAlignment="Center" Opacity="0.4"
                                                   Foreground="{DynamicResource OnSurfaceVariant}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部视觉锚点：低对比度署名，给空白一个"终点"（纯视觉元素，非功能模块） -->
            <TextBlock Text="LinkPocket v2.0.0" FontSize="11" HorizontalAlignment="Center"
                       VerticalAlignment="Bottom" Margin="0,0,0,14" Opacity="0.45"
                       Foreground="{DynamicResource OnSurfaceVariant}"/>
        </Grid>

        <!-- ============================================================ -->
        <!-- ===== 面板 B：结果（左表 + 可拖拽分隔 + 右详情栏，搜索页同构） ===== -->
        <!-- ============================================================ -->
        <Grid x:Name="ResultPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <!-- 结果列表占剩余宽度；详情栏与浏览页/搜索页同规格（286，可拖拽 230~400） -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="286" MinWidth="230" MaxWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：工具行 + 表格。
                 点空白清选中（BlankClick 唯一实现，与浏览/搜索同口径）：命中行/按钮/文本不算空白；
                 右栏（选中集合的投影）在范围之外、绝不反向取消选中。
                 ⚠️ 必须补 Background="Transparent"：否则没有子元素覆盖的"边角空白"根本不产生命中 →
                 用户报障"点边边角角的空白不能取消选中/焦点"（用户令 2026-09-20）。
                 命令在 code-behind 挂（"清选中 + 焦点收回页内"，与浏览页 ClearPageSelection 同口径）。 -->
            <Grid x:Name="ResultContentArea" Grid.Column="0" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="12,0,12,8">
                    <DockPanel VerticalAlignment="Center" LastChildFill="True">
                        <!-- 返回圆钮：与详情页顶部返回钮同款（40px 圆、TintCard 底、Primary 状态层；编辑页无返回钮，取消即返回） -->
                        <Button DockPanel.Dock="Left" Click="BackButton_Click" Focusable="False"
                                ToolTip="返回卡片页（Esc）" Width="40" Height="40" VerticalAlignment="Center"
                                Foreground="{DynamicResource OnSurface}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{DynamicResource TintCard}" CornerRadius="20">
                                        <Grid>
                                            <Border x:Name="StateLayer" Background="{DynamicResource Primary}"
                                                    Opacity="0" CornerRadius="20"/>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="StateLayer" Property="Opacity" Value="0.12"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="StateLayer" Property="Opacity" Value="0.16"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <m3:M3Icon Kind="arrow-left" Width="18" Height="18"/>
                        </Button>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="0,0,2,0">
                            <TextBlock Text="共" FontSize="12" Foreground="{DynamicResource OnSurfaceVariant}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ResultViewModel.TotalCount, Mode=OneWay}" FontSize="12"
                                       Foreground="{DynamicResource OnSurfaceVariant}" Margin="3,0,3,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="项" FontSize="12" Foreground="{DynamicResource OnSurfaceVariant}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="{Binding ResultViewModel.Title}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource OnSurface}" VerticalAlignment="Center"/>
                            <!-- 灰色提示：列表语义说明（与入口卡片副标题同一数据源） -->
                            <TextBlock Text="{Binding ResultViewModel.Subtitle}" FontSize="12.5"
                                       Foreground="{DynamicResource OnSurfaceVariant}" VerticalAlignment="Center"
                                       Margin="12,1,0,0" TextTrimming="CharacterEllipsis"/>
                            <!-- 当前排序（默认排序可见化：列头箭头之外再给一句文字，避免"像没排序"） -->
                            <TextBlock x:Name="SortHintText" FontSize="12.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource OnSurfaceVariant}" Opacity="0.75"
                                       Margin="10,1,12,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 表格容器：与回收站页同款圆角 24 卡片，表头色带边距归零。
                     SelectionEnabled=False = 外部托管：单选中由结果 VM 的 ListSelection 承载，
                     绘制经 code-behind 投影（↑/↓/End/Esc/点空白 = 全站共享选择机械）。 -->
                <Border Grid.Row="1" Background="{DynamicResource SurfaceContainerHigh}"
                        CornerRadius="24" Margin="8,0,8,8" ClipToBounds="True">
                    <views:SortableDataTable x:Name="SmartTable" HeaderBandMargin="0"
                                             SelectionEnabled="False"/>
                </Border>

                <!-- 加载遮罩（唯一实现 = UIKit ListBusyOverlay）：只在 F5 这类**用户发起**的重查时亮；
                     放在表格之后 = z 序在上。 -->
                <views:ListBusyOverlay Grid.Row="1" Margin="8,0,8,8"
                                       IsBusy="{Binding ResultViewModel.IsNavigating}"/>
            </Grid>

            <!-- 详情栏可拖拽分隔线（与浏览页/搜索页同款交互） -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE"/>

            <!-- 右侧详情栏：复用 DetailSidebar，DataContext 在 code-behind 装配 -->
            <Border Grid.Column="2" Background="{DynamicResource TintPanel}"
                    CornerRadius="24,0,0,24" Margin="0,0,0,8">
                <views:DetailSidebar x:Name="SmartSidebar"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
