<UserControl x:Class="LinkPocket.Views.AiPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LinkPocket.I18n;assembly=LinkPocket.I18n"
             xmlns:local="clr-namespace:LinkPocket.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,24" MaxWidth="760" HorizontalAlignment="Left">

            <!-- 服务商 -->
            <Border Background="{DynamicResource App.Surface.Card}" CornerRadius="24" Padding="22,20">
                <StackPanel>
                    <TextBlock Text="{loc:Loc ai.settings.providers}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Text.Primary}"/>
                    <TextBlock Text="{loc:Loc ai.settings.providers.desc}" FontSize="12" Margin="0,4,0,14"
                               TextWrapping="Wrap" Foreground="{DynamicResource App.Text.Secondary}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="ProviderList" Grid.Column="0" MinHeight="220" Background="Transparent"
                                 BorderThickness="0" ItemsSource="{Binding Providers}"
                                 SelectedItem="{Binding SelectedProvider, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource App.Text.Primary}"/>
                                        <TextBlock Text="{loc:LocKey StatusKey}" FontSize="11"
                                                   Foreground="{DynamicResource App.Text.Muted}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="{loc:Loc ai.settings.displayName}" FontSize="12" Foreground="{DynamicResource App.Text.Secondary}"/>
                            <TextBox x:Name="DisplayNameBox" Height="32" Margin="0,4,0,10"
                                     Text="{Binding DisplayNameInput, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource App.Surface.TintCard}" BorderBrush="{DynamicResource App.Line.Variant}"
                                     Foreground="{DynamicResource App.Text.Primary}"/>
                            <TextBlock Text="{loc:Loc ai.settings.baseUrl}" FontSize="12" Foreground="{DynamicResource App.Text.Secondary}"/>
                            <TextBox x:Name="BaseUrlBox" Height="32" Margin="0,4,0,10"
                                     Text="{Binding BaseUrlInput, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource App.Surface.TintCard}" BorderBrush="{DynamicResource App.Line.Variant}"
                                     Foreground="{DynamicResource App.Text.Primary}"/>

                            <TextBlock Text="{loc:Loc ai.settings.apiKey}" FontSize="12" Foreground="{DynamicResource App.Text.Secondary}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                                <PasswordBox x:Name="KeyBox" Width="240" Height="32"/>
                                <Button Style="{StaticResource TonalButton}" Height="32" Margin="8,0,0,0"
                                        Content="{loc:Loc ai.settings.apiKeySave}" Click="OnSaveKey"/>
                                <Button Style="{StaticResource TonalButton}" Height="32" Margin="8,0,0,0"
                                        Content="{loc:Loc ai.settings.apiKeyRemove}" Click="OnRemoveKey"/>
                                <TextBlock Text="{Binding ApiKeyMasked}" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Foreground="{DynamicResource App.Text.Muted}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource TonalButton}" Height="32"
                                        Content="{loc:Loc ai.settings.save}" Click="OnSaveProvider"/>
                                <Button Style="{StaticResource TonalButton}" Height="32" Margin="8,0,0,0"
                                        Content="{loc:Loc ai.settings.test}" Click="OnTest"/>
                                <Button Style="{StaticResource TonalButton}" Height="32" Margin="8,0,0,0"
                                        Content="{loc:Loc ai.settings.delete}" Click="OnDeleteProvider"/>
                            </StackPanel>
                            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource App.Accent.Text}">
                                <Run Text="{loc:LocKey TestStatusKey}"/>
                                <Run Text="{Binding TestDetail, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 模型 -->
            <Border Background="{DynamicResource App.Surface.Card}" CornerRadius="24" Padding="22,20" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc ai.settings.models}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Text.Primary}"/>
                    <TextBlock Text="{loc:Loc ai.settings.models.desc}" FontSize="12" Margin="0,4,0,14"
                               TextWrapping="Wrap" Foreground="{DynamicResource App.Text.Secondary}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource TonalButton}" Height="32"
                                Content="{loc:Loc ai.settings.fetch}" Click="OnFetchModels"/>
                        <TextBox x:Name="NewModelBox" Width="220" Height="32" Margin="8,0,0,0"
                                 Text="{Binding NewModelId, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource App.Surface.TintCard}" BorderBrush="{DynamicResource App.Line.Variant}"
                                 Foreground="{DynamicResource App.Text.Primary}"/>
                        <Button Style="{StaticResource TonalButton}" Height="32" Margin="8,0,0,0"
                                Content="{loc:Loc ai.settings.add}" Click="OnAddModel"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Models}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton IsChecked="{Binding Model.Enabled, Mode=OneWay}" Click="OnToggleModel"
                                                      VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Model.Id}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource App.Text.Primary}"/>
                                        <TextBlock Text="{Binding Hint}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   FontSize="11" Foreground="{DynamicResource App.Text.Muted}"/>
                                        <Button Style="{StaticResource TonalButton}" Height="32" Margin="10,0,0,0"
                                                Content="{loc:LocKey EditKey}" Click="OnToggleModelEdit"/>
                                    </StackPanel>
                                    <!-- 能力编辑行（功能书 §4.5：上下文窗口 / 最大输出 / 工具调用 / 流式；显式保存） -->
                                    <StackPanel Margin="34,4,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{loc:Loc ai.settings.model.contextWindow}" FontSize="12"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource App.Text.Secondary}"/>
                                            <TextBox Width="100" Height="32" Margin="8,0,16,0"
                                                     Text="{Binding ContextWindowInput, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{DynamicResource App.Surface.TintCard}"
                                                     BorderBrush="{DynamicResource App.Line.Variant}"
                                                     Foreground="{DynamicResource App.Text.Primary}"/>
                                            <TextBlock Text="{loc:Loc ai.settings.model.maxOutputTokens}" FontSize="12"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource App.Text.Secondary}"/>
                                            <TextBox Width="100" Height="32" Margin="8,0,0,0"
                                                     Text="{Binding MaxOutputTokensInput, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{DynamicResource App.Surface.TintCard}"
                                                     BorderBrush="{DynamicResource App.Line.Variant}"
                                                     Foreground="{DynamicResource App.Text.Primary}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <ToggleButton IsChecked="{Binding SupportsTools, Mode=TwoWay}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Loc ai.settings.model.supportsTools}" FontSize="12" Margin="8,0,16,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource App.Text.Primary}"/>
                                            <ToggleButton IsChecked="{Binding SupportsStreaming, Mode=TwoWay}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Loc ai.settings.model.supportsStreaming}" FontSize="12" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource App.Text.Primary}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Style="{StaticResource TonalButton}" Height="32"
                                                    Content="{loc:Loc ai.settings.save}" Click="OnSaveModelCapabilities"/>
                                            <TextBlock Text="{loc:LocKey ErrorKey}" FontSize="11" Margin="10,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource App.Accent.Text}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 助手偏好 -->
            <Border Background="{DynamicResource App.Surface.Card}" CornerRadius="24" Padding="22,20" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc ai.settings.preferences}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Text.Primary}"/>
                    <TextBlock Text="{loc:Loc ai.settings.defaultModel}" FontSize="12" Margin="0,10,0,4"
                               Foreground="{DynamicResource App.Text.Secondary}"/>
                    <ComboBox x:Name="DefaultModelBox" Height="32" Width="320" HorizontalAlignment="Left"
                              ItemsSource="{Binding ModelChoices}" DisplayMemberPath="Label"
                              SelectedItem="{Binding DefaultModelChoice, Mode=TwoWay}"/>
                    <TextBlock Text="{loc:Loc ai.settings.mode}" FontSize="12" Margin="0,12,0,4"
                               Foreground="{DynamicResource App.Text.Secondary}"/>
                    <ComboBox x:Name="ModeBox" Height="32" Width="200" HorizontalAlignment="Left"
                              SelectedIndex="{Binding ModeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{loc:Loc ai.mode.readonly}"/>
                        <ComboBoxItem Content="{loc:Loc ai.mode.confirmEach}"/>
                        <ComboBoxItem Content="{loc:Loc ai.mode.autoApply}"/>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ToggleButton IsChecked="{Binding AdvancedTools, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc ai.settings.advancedTools}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.Text.Primary}"/>
                    </StackPanel>
                    <TextBlock Text="{loc:Loc ai.settings.advancedTools.desc}" FontSize="12" Margin="0,4,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource App.Text.Secondary}"/>
                    <Button Style="{StaticResource PrimaryPillButton}" Height="32" HorizontalAlignment="Left" Margin="0,12,0,0"
                            Content="{loc:Loc ai.settings.save}" Click="OnSavePreferences"/>
                </StackPanel>
            </Border>

            <!-- 数据与隐私 -->
            <Border Background="{DynamicResource App.Surface.Card}" CornerRadius="24" Padding="22,20" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc ai.settings.data}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Text.Primary}"/>
                    <TextBlock Text="{loc:Loc ai.settings.data.desc}" FontSize="12" Margin="0,4,0,14"
                               TextWrapping="Wrap" Foreground="{DynamicResource App.Text.Secondary}"/>
                    <Button Style="{StaticResource TonalButton}" Height="32" HorizontalAlignment="Left"
                            Content="{loc:Loc ai.settings.clearData}" Click="OnClearSessions"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
