<UserControl x:Class="LinkPocket.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
             xmlns:views="clr-namespace:LinkPocket.Views;assembly=LinkPocket.UIKit"
             xmlns:local="clr-namespace:LinkPocket.Views">
    <Grid Background="{DynamicResource SurfaceContainerLow}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧栏：与工具页左栏同一套 SideNavList 可复用组件（滑动指示器 + 无悬停底色） -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceContainerLow}">
            <StackPanel>
                <TextBlock Text="设置" FontSize="17" FontWeight="SemiBold" Margin="20,18,20,10"
                           Foreground="{DynamicResource OnSurface}"/>
                <views:SideNavList x:Name="SettingListBox" Style="{StaticResource SideNavListStyle}"
                                   ItemContainerStyle="{StaticResource SideNavItemStyle}"
                                   SelectionChanged="SettingListBox_SelectionChanged">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <m3:M3Icon Kind="delete-sweep" Width="17" Height="17" VerticalAlignment="Center"/>
                            <TextBlock Text="存储管理" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <m3:M3Icon Kind="backup-restore" Width="17" Height="17" VerticalAlignment="Center"/>
                            <TextBlock Text="备份与恢复" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </views:SideNavList>
            </StackPanel>
        </Border>

        <!-- 右侧内容区 -->
        <Grid Grid.Column="1" x:Name="ContentPanel">
            <!-- 存储管理界面：与工具页同语言的圆角卡片（危险区 = WarnBg 奶油黄，项目铁律禁红色） -->
            <ScrollViewer x:Name="MaintenancePanel" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="32,24,32,24">
                    <TextBlock Text="存储管理" FontSize="20" FontWeight="SemiBold" Margin="4,0,0,4"
                               Foreground="{DynamicResource OnSurface}"/>
                    <TextBlock Text="清理日志与本地数据；清空操作不可恢复，请先备份"
                               FontSize="13" Foreground="{DynamicResource OnSurfaceVariant}"
                               Margin="4,0,0,20" TextWrapping="Wrap"/>

                    <!-- 日志清理卡 -->
                    <Border Background="{DynamicResource SurfaceContainerHigh}" CornerRadius="24" Padding="22,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="日志清理" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource OnSurface}"/>
                                <TextBlock x:Name="LogStatusText" Text="删除应用运行产生的日志文件（logs 目录）"
                                           FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource OnSurfaceVariant}"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="ClearLogsButton"
                                    Content="一键清除" VerticalAlignment="Center"
                                    Style="{StaticResource TonalButton}" Height="36" Padding="20,0"
                                    Cursor="Hand" Click="ClearLogsButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- 清空数据卡（危险区：奶油黄警示） -->
                    <Border Background="{DynamicResource SurfaceContainerHigh}" CornerRadius="24"
                            Padding="22,20" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="24" Height="24" CornerRadius="12"
                                            Background="{StaticResource WarnBg}">
                                        <m3:M3Icon Kind="delete-outline" Width="13" Height="13"
                                                   Foreground="{DynamicResource OnSurface}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="清空所有数据" FontSize="15" FontWeight="SemiBold"
                                               Margin="10,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource OnSurface}"/>
                                </StackPanel>
                                <TextBlock Text="清除数据库（含回收站）与图标缓存，此操作不可恢复"
                                           FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource OnSurfaceVariant}"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="ClearAllDataButton"
                                    Content="清空数据" VerticalAlignment="Center"
                                    Style="{StaticResource WarnPillButton}" Height="36" Padding="20,0"
                                    Cursor="Hand" Click="ClearAllDataButton_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 备份与恢复界面 -->
            <local:BackupPanel x:Name="BackupPanelControl" Visibility="Collapsed"/>
        </Grid>

        <!-- 导出进度遮罩层 -->
        <Border Grid.ColumnSpan="2" x:Name="ExportOverlay" Visibility="Collapsed"
                Background="#AA000000" Panel.ZIndex="100">
            <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource TintBg}" CornerRadius="24"
                    Padding="32,24" Width="380">
                <StackPanel>
                    <TextBlock x:Name="ExportStatusText" Text="正在导出..."
                               FontSize="14" HorizontalAlignment="Center"
                               Foreground="{DynamicResource OnSurface}" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,0,0,12"/>
                    <!-- MD3E 波浪进度条（已走 = 起伏波浪线，剩余 = 直线轨道，进度点 = 竖向滑标）；深紫 = AccentBtn 定稿色 -->
                    <views:WavyProgressBar x:Name="ExportProgressBar" Height="22"
                                           Minimum="0" Maximum="100" Value="0"
                                           ActiveBrush="{DynamicResource AccentBtn}"
                                           TrackBrush="{DynamicResource OutlineVariant}"/>
                    <TextBlock x:Name="ExportProgressText" Text="0 / 0"
                               FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource OnSurfaceVariant}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- 清空确认遮罩层（与 ConfirmDialog 同语言：WarnBg 图标 chip + 药丸按钮，禁红色） -->
        <Border Grid.ColumnSpan="2" x:Name="ConfirmOverlay" Visibility="Collapsed"
                Background="#AA000000" Panel.ZIndex="200">
            <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource TintBg}" CornerRadius="24"
                    Padding="28,24" Width="420">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="22"
                                Background="{StaticResource WarnBg}">
                            <m3:M3Icon Kind="delete-outline" Width="22" Height="22"
                                       Foreground="{DynamicResource OnSurface}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="确认清空所有数据" FontSize="18" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="14,0,0,0"
                                   Foreground="{DynamicResource OnSurface}"/>
                    </StackPanel>

                    <TextBlock Text="此操作将清除所有书签、文件夹与回收站数据（含图标缓存），且不可恢复。"
                               FontSize="13" Margin="2,16,2,0" TextWrapping="Wrap" LineHeight="21"
                               Foreground="{DynamicResource OnSurfaceVariant}"/>
                    <TextBlock Text="如需保留数据，请先在「备份与恢复」中导出备份。"
                               FontSize="13" Margin="2,6,2,0" TextWrapping="Wrap" LineHeight="21"
                               Foreground="{DynamicResource OnSurfaceVariant}"/>

                    <TextBlock Text="请输入以下文字确认操作：" FontSize="13"
                               Foreground="{DynamicResource OnSurface}" Margin="2,18,0,6"/>
                    <TextBlock Text="我确认清除全部数据" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource OnSurface}" Margin="2,0,0,10"/>

                    <Border CornerRadius="12" Background="{DynamicResource SurfaceContainerHighest}">
                        <TextBox x:Name="ConfirmInputBox" Height="40" FontSize="13"
                                 HorizontalAlignment="Stretch"
                                 Foreground="{DynamicResource OnSurface}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="14,0" VerticalContentAlignment="Center"
                                 Tag="在此输入确认文字..."/>
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="ConfirmErrorText"
                                   Text="" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OnSurfaceVariant}"/>
                        <Button Grid.Column="1" x:Name="CancelConfirmButton"
                                Content="取消" Style="{StaticResource TonalButton}"
                                Height="32" MinWidth="96" Padding="20,6" Margin="0,0,10,0"
                                Cursor="Hand" Click="CancelConfirmButton_Click" FontSize="13"/>
                        <Button Grid.Column="2" x:Name="ExecuteClearButton"
                                Content="确认清空" Style="{StaticResource WarnPillButton}"
                                Height="32" MinWidth="96" Padding="20,6" IsEnabled="False"
                                Cursor="Hand" Click="ExecuteClearButton_Click" FontSize="13"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>