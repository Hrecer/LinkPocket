<UserControl x:Class="LinkPocket.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LinkPocket.I18n;assembly=LinkPocket.I18n"
             xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
             xmlns:views="clr-namespace:LinkPocket.Views;assembly=LinkPocket.UIKit"
             xmlns:local="clr-namespace:LinkPocket.Views">
    <Grid Background="{DynamicResource App.Surface.Base}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧栏：与工具页左栏同一套 SideNavList 可复用组件（滑动指示器 + 无悬停底色） -->
        <Border Grid.Column="0" Background="{DynamicResource App.Surface.Base}">
            <StackPanel>
                <TextBlock Text="{loc:Loc nav.item.settings}" FontSize="17" FontWeight="SemiBold" Margin="20,18,20,10"
                           Foreground="{DynamicResource App.Text.Primary}"/>
                <views:SideNavList x:Name="SettingListBox" Style="{StaticResource SideNavListStyle}"
                                   ItemContainerStyle="{StaticResource SideNavItemStyle}"
                                   SelectionChanged="SettingListBox_SelectionChanged">
                    <!-- 顺序 = 外观 / 存储管理 / 备份与恢复；「外观」排第一（决策 6），
                         故"默认选中第一项"的契约落点随之改为外观。 -->
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <m3:M3Icon Kind="palette-outline" Width="17" Height="17" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc nav.panel.appearance}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <m3:M3Icon Kind="delete-sweep" Width="17" Height="17" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc tools.storage.title}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <m3:M3Icon Kind="backup-restore" Width="17" Height="17" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc nav.item.backup}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <m3:M3Icon Kind="auto-fix" Width="17" Height="17" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc nav.panel.ai}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </views:SideNavList>
            </StackPanel>
        </Border>

        <!-- 右侧内容区 -->
        <Grid Grid.Column="1" x:Name="ContentPanel">
            <!-- 外观（排第一）：主题卡 / 自选配色 / 字体 -->
            <local:AppearancePanel x:Name="AppearancePanelControl" Visibility="Collapsed"/>

            <!-- 存储管理界面：与工具页同语言的圆角卡片（破坏性动作与次操作同一套呈现，项目铁律禁红色） -->
            <ScrollViewer x:Name="MaintenancePanel" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="32,24,32,24">
                    <TextBlock Text="{loc:Loc tools.storage.title}" FontSize="20" FontWeight="SemiBold" Margin="4,0,0,4"
                               Foreground="{DynamicResource App.Text.Primary}"/>
                    <TextBlock Text="{loc:Loc tools.storage.desc}"
                               FontSize="13" Foreground="{DynamicResource App.Text.Secondary}"
                               Margin="4,0,0,20" TextWrapping="Wrap"/>

                    <!-- 日志清理卡 -->
                    <Border Background="{DynamicResource App.Surface.Card}" CornerRadius="24" Padding="22,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc tools.storage.purgeLogs}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource App.Text.Primary}"/>
                                <TextBlock x:Name="LogStatusText" Text="{loc:Loc tools.storage.purgeLogs.desc}"
                                           FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource App.Text.Secondary}"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="ClearLogsButton"
                                    Content="{loc:Loc storage.oneClickClear}" VerticalAlignment="Center"
                                    Style="{StaticResource TonalButton}" Height="36" Padding="20,0"
                                    Cursor="Hand" Click="ClearLogsButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- 清空数据卡（危险区：奶油黄警示） -->
                    <Border Background="{DynamicResource App.Surface.Card}" CornerRadius="24"
                            Padding="22,20" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="24" Height="24" CornerRadius="12"
                                            Background="{DynamicResource App.Support.Container}">
                                        <m3:M3Icon Kind="delete-outline" Width="13" Height="13"
                                                   Foreground="{DynamicResource App.Text.Primary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{loc:Loc tools.storage.wipe}" FontSize="15" FontWeight="SemiBold"
                                               Margin="10,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource App.Text.Primary}"/>
                                </StackPanel>
                                <TextBlock Text="{loc:Loc tools.storage.wipe.desc}"
                                           FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource App.Text.Secondary}"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="ClearAllDataButton"
                                    Content="{loc:Loc storage.clearData}" VerticalAlignment="Center"
                                    Style="{StaticResource TonalButton}" Height="36" Padding="20,0"
                                    Cursor="Hand" Click="ClearAllDataButton_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 备份与恢复界面 -->
            <local:BackupPanel x:Name="BackupPanelControl" Visibility="Collapsed"/>
            <local:AiPanel x:Name="AiPanelControl" Visibility="Collapsed"/>
        </Grid>

        <!-- 导出进度遮罩层 -->
        <Border Grid.ColumnSpan="2" x:Name="ExportOverlay" Visibility="Collapsed"
                Background="{DynamicResource App.Overlay.Scrim}" Panel.ZIndex="100">
            <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource App.Surface.Dialog}" CornerRadius="24"
                    Padding="32,24" Width="380">
                <StackPanel>
                    <TextBlock x:Name="ExportStatusText" Text="{loc:Loc backup.export.running}"
                               FontSize="14" HorizontalAlignment="Center"
                               Foreground="{DynamicResource App.Text.Primary}" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,0,0,12"/>
                    <!-- MD3E 波浪进度条（已走 = 起伏波浪线，剩余 = 直线轨道，进度点 = 竖向滑标）；深紫 = AccentBtn 定稿色 -->
                    <views:WavyProgressBar x:Name="ExportProgressBar" Height="22"
                                           Minimum="0" Maximum="100" Value="0"
                                           ActiveBrush="{DynamicResource App.Accent.Fill}"
                                           TrackBrush="{DynamicResource App.Line.Variant}"/>
                    <TextBlock x:Name="ExportProgressText" Text="0 / 0"
                               FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource App.Text.Secondary}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- 清空确认遮罩层（与 ConfirmDialog 同语言：WarnBg 图标 chip + 药丸按钮，禁红色） -->
        <Border Grid.ColumnSpan="2" x:Name="ConfirmOverlay" Visibility="Collapsed"
                Background="{DynamicResource App.Overlay.Scrim}" Panel.ZIndex="200">
            <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource App.Surface.Dialog}" CornerRadius="24"
                    Padding="28,24" Width="420">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="22"
                                Background="{DynamicResource App.Support.Container}">
                            <m3:M3Icon Kind="delete-outline" Width="22" Height="22"
                                       Foreground="{DynamicResource App.Text.Primary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{loc:Loc backup.wipe.confirmTitle}" FontSize="18" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="14,0,0,0"
                                   Foreground="{DynamicResource App.Text.Primary}"/>
                    </StackPanel>

                    <TextBlock Text="{loc:Loc storage.wipe.warning}"
                               FontSize="13" Margin="2,16,2,0" TextWrapping="Wrap" LineHeight="21"
                               Foreground="{DynamicResource App.Text.Secondary}"/>
                    <TextBlock Text="{loc:Loc tools.storage.wipe.warn}"
                               FontSize="13" Margin="2,6,2,0" TextWrapping="Wrap" LineHeight="21"
                               Foreground="{DynamicResource App.Text.Secondary}"/>

                    <TextBlock Text="{loc:Loc common.confirm.typePrompt}" FontSize="13"
                               Foreground="{DynamicResource App.Text.Primary}" Margin="2,18,0,6"/>
                    <TextBlock Text="{loc:Loc backup.wipe.confirm}" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource App.Text.Primary}" Margin="2,0,0,10"/>

                    <Border CornerRadius="12" Background="{DynamicResource App.Surface.Hover}">
                        <TextBox x:Name="ConfirmInputBox" Height="40" FontSize="13"
                                 HorizontalAlignment="Stretch"
                                 Foreground="{DynamicResource App.Text.Primary}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="14,0" VerticalContentAlignment="Center"
                                 Tag="{loc:Loc common.confirm.placeholder}"/>
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="ConfirmErrorText"
                                   Text="" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                        <Button Grid.Column="1" x:Name="CancelConfirmButton"
                                Content="{loc:Loc common.cancel}" Style="{StaticResource TonalButton}"
                                Height="32" MinWidth="96" Padding="20,6" Margin="0,0,10,0"
                                Cursor="Hand" Click="CancelConfirmButton_Click" FontSize="13"/>
                        <Button Grid.Column="2" x:Name="ExecuteClearButton"
                                Content="{loc:Loc backup.replace.confirm}" Style="{StaticResource TonalButton}"
                                Height="32" MinWidth="96" Padding="20,6" IsEnabled="False"
                                Cursor="Hand" Click="ExecuteClearButton_Click" FontSize="13"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>