<UserControl x:Class="LinkPocket.Views.AboutPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LinkPocket.I18n;assembly=LinkPocket.I18n"
             xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
             xmlns:views="clr-namespace:LinkPocket.Views;assembly=LinkPocket.UIKit">
    <!-- 「关于」面板（设置页左栏最末项）：应用名称与版本（版本号 = 组合根传入的产品版本，与更新面板同源）
         + 简介 / 技术 / 许可 + 主要能力 + 项目仓库（GitHub 地址 + 「打开仓库」）。沿用存储管理 / 更新面板的卡语言
         （MaxWidth 760 / 圆角 24 / 卡距 16 / 标题 15 SemiBold / 说明 12）。
         标志与窗口顶部品牌 chip 同款（link-variant + Accent.Container / OnContainer）。
         「打开仓库」= 打开动作经唯一出口 LinkLauncher（本面板不自己起进程）。 -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="32,24,32,32">
                <TextBlock Text="{loc:Loc nav.panel.about}" FontSize="20" FontWeight="SemiBold" Margin="4,0,0,4"
                           Foreground="{DynamicResource App.Text.Primary}"/>
                <TextBlock Text="{loc:Loc about.panel.desc}" FontSize="13" Margin="4,0,0,20" TextWrapping="Wrap"
                           Foreground="{DynamicResource App.Text.Secondary}"/>

                <!-- 卡 1：应用（名称 + 版本 + 简介 / 技术 / 许可） -->
                <Border Background="{DynamicResource App.Surface.Card}" CornerRadius="24" Padding="22,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="15"
                                    Background="{DynamicResource App.Accent.Container}">
                                <m3:M3Icon Kind="link-variant" Width="22" Height="22"
                                           Foreground="{DynamicResource App.Text.OnContainer}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <!-- 产品名 = 品牌字面量（ASCII、不翻译；与窗口标题同一写法） -->
                                <TextBlock Text="LinkPocket" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource App.Text.Primary}"/>
                                <TextBlock x:Name="VersionText" FontSize="12" Margin="0,4,0,0"
                                           Foreground="{DynamicResource App.Text.Secondary}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{loc:Loc about.intro}" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                        <TextBlock Text="{loc:Loc about.tech}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                        <TextBlock Text="{loc:Loc about.license}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                    </StackPanel>
                </Border>

                <!-- 卡 2：主要能力（行 = Auto/* 两列：圆点 + 换行文本，长句悬挂缩进） -->
                <Border Background="{DynamicResource App.Surface.Card}" CornerRadius="24"
                        Padding="22,20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc about.features.title}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Text.Primary}"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#x2022;" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource App.Text.Secondary}"/>
                            <TextBlock Grid.Column="1" Text="{loc:Loc about.features.manage}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource App.Text.Secondary}"/>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#x2022;" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource App.Text.Secondary}"/>
                            <TextBlock Grid.Column="1" Text="{loc:Loc about.features.entry}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource App.Text.Secondary}"/>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#x2022;" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource App.Text.Secondary}"/>
                            <TextBlock Grid.Column="1" Text="{loc:Loc about.features.backup}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource App.Text.Secondary}"/>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#x2022;" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource App.Text.Secondary}"/>
                            <TextBlock Grid.Column="1" Text="{loc:Loc about.features.update}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource App.Text.Secondary}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 卡 3：项目仓库（GitHub 地址 + 打开；地址 = 身份字面量，在 code-behind 填充） -->
                <Border Background="{DynamicResource App.Surface.Card}" CornerRadius="24"
                        Padding="22,20" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc about.repo.title}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.Text.Primary}"/>
                            <TextBlock Text="{loc:Loc about.repo.desc}" FontSize="12" Margin="0,4,20,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource App.Text.Secondary}"/>
                            <views:SelectableText x:Name="RepoUrlText" FontSize="12" Foreground="{DynamicResource App.Text.Primary}"
                                                  Margin="0,6,20,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="OpenRepoButton" Content="{loc:Loc about.repo.open}"
                                Style="{StaticResource TonalButton}" Height="36" Padding="20,0"
                                VerticalAlignment="Center" Cursor="Hand" Click="OpenRepoButton_Click"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
