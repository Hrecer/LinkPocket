<UserControl x:Class="LinkPocket.Views.UpdatePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LinkPocket.I18n;assembly=LinkPocket.I18n"
             xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
             xmlns:views="clr-namespace:LinkPocket.Views;assembly=LinkPocket.UIKit"
             xmlns:local="clr-namespace:LinkPocket.Views">
    <!-- 「更新」面板（UPDATE.md §6）：当前版本 / 检查更新（启动延迟自动 + 手动 + 可关）/ 重启并更新 /
         从本地 zip 更新（兜底）。沿用「存储管理」的卡语言（MaxWidth 760 / 圆角 24 / 卡距 16 / 标题 15 SemiBold / 说明 12）。 -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="32,24,32,32">
                <TextBlock Text="{loc:Loc nav.panel.update}" FontSize="20" FontWeight="SemiBold" Margin="4,0,0,4"
                           Foreground="{DynamicResource App.Text.Primary}"/>
                <TextBlock Text="{loc:Loc update.panel.desc}"
                           FontSize="13" Margin="4,0,0,20" TextWrapping="Wrap"
                           Foreground="{DynamicResource App.Text.Secondary}"/>

                <!-- 卡 1：版本与检查 -->
                <Border Background="{DynamicResource App.Surface.Card}" CornerRadius="24" Padding="22,20">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc update.current.title}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource App.Text.Primary}"/>
                                <TextBlock x:Name="VersionText" FontSize="13" Margin="0,4,0,0"
                                           Foreground="{DynamicResource App.Text.Primary}"/>
                                <TextBlock x:Name="StatusText" FontSize="12" Margin="0,4,20,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource App.Text.Secondary}"/>
                                <!-- 失败时的指路行（静态取词绑定：语言切换自动重算；随失败态显隐） -->
                                <TextBlock x:Name="FailHintText" Text="{loc:Loc update.failed.hint}"
                                           FontSize="12" Margin="0,4,20,0" TextWrapping="Wrap" Visibility="Collapsed"
                                           Foreground="{DynamicResource App.Text.Secondary}"/>
                                <TextBlock x:Name="LastUpdateText" FontSize="12" Margin="0,6,20,0" TextWrapping="Wrap"
                                           Visibility="Collapsed"
                                           Foreground="{DynamicResource App.Text.Secondary}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="CheckButton" Content="{loc:Loc update.check.button}"
                                        Style="{StaticResource TonalButton}" Height="36" Padding="20,0"
                                        Cursor="Hand" Click="CheckButton_Click"/>
                                <Button x:Name="RestartButton" Content="{loc:Loc update.restart.button}"
                                        Style="{StaticResource PrimaryPillButton}" Height="36" Padding="20,0"
                                        Margin="10,0,0,0" Visibility="Collapsed"
                                        Cursor="Hand" Click="RestartButton_Click"/>
                            </StackPanel>
                        </Grid>
                        <!-- 下载 / 解包进度（MD3E 波浪进度条，与设置页导出遮罩同一组件与配色口径） -->
                        <views:WavyProgressBar x:Name="DownloadProgress" Height="22" Margin="0,14,0,0"
                                               Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"
                                               ActiveBrush="{DynamicResource App.Accent.Fill}"
                                               TrackBrush="{DynamicResource App.Line.Variant}"/>
                    </StackPanel>
                </Border>

                <!-- 卡 2：启动时自动检查开关（M3 ToggleSwitch，与「自动调整颜色」同一控件语言） -->
                <Border Background="{DynamicResource App.Surface.Card}" CornerRadius="24"
                        Padding="22,20" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton Grid.Column="0" x:Name="AutoCheckSwitch"
                                      VerticalAlignment="Top" Margin="0,2,0,0"
                                      IsChecked="{Binding AutoCheckOnStartup, Mode=TwoWay}"
                                      ToolTip="{loc:Loc update.auto.desc}"/>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="{loc:Loc update.auto.title}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.Text.Primary}"/>
                            <TextBlock Text="{loc:Loc update.auto.desc}" FontSize="12" Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource App.Text.Secondary}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 卡 3：从本地 zip 更新（网络不通的兜底通道） -->
                <Border Background="{DynamicResource App.Surface.Card}" CornerRadius="24"
                        Padding="22,20" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc update.local.title}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.Text.Primary}"/>
                            <TextBlock Text="{loc:Loc update.local.desc}" FontSize="12" Margin="0,4,20,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource App.Text.Secondary}"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="LocalZipButton" Content="{loc:Loc update.local.button}"
                                Style="{StaticResource TonalButton}" Height="36" Padding="20,0"
                                VerticalAlignment="Center" Cursor="Hand" Click="LocalZipButton_Click"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
