<UserControl x:Class="LinkPocket.Views.AppearancePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
             xmlns:views="clr-namespace:LinkPocket.Views;assembly=LinkPocket.UIKit"
             xmlns:local="clr-namespace:LinkPocket.Views">
    <!-- 「4 色 / 5 色」分段的段项样式：**复用** UIKit 共享的滑动指示器语言
         （SlidingNavStripItemStyle 的模板与选中语义），只把段高对齐本面板的 32 药丸口径。
         这不是第二套分段实现——模板、指示器几何、滑动动画全在共享组件里。 -->
    <UserControl.Resources>
        <Style x:Key="AppearanceSegmentItem" TargetType="ListBoxItem"
               BasedOn="{StaticResource SlidingNavStripItemStyle}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="64"/>
        </Style>
    </UserControl.Resources>

    <!-- 「外观」面板（方案 §7.1）：三张卡 = 主题 / 自选配色 / 字体。
         沿用「存储管理」的卡语言（MaxWidth 760 / 圆角 24 / 卡距 16 / 标题 15 SemiBold / 说明 12）。 -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="32,24,32,32">
                <TextBlock Text="外观" FontSize="20" FontWeight="SemiBold" Margin="4,0,0,4"
                           Foreground="{DynamicResource App.Text.Primary}"/>
                <TextBlock Text="主题与字体独立选择；主题立即生效并记住，重启后保持"
                           FontSize="13" Margin="4,0,0,20" TextWrapping="Wrap"
                           Foreground="{DynamicResource App.Text.Secondary}"/>

                <!-- ===== 全局操作（面板级，不属于任何一张卡）=====
                     用户令 2026-09-20："这个应用这套外观、恢复这套外观，不能在自选配色这里，这些是全局操作"。
                     它们作用于**整套外观**（配色 + 字体），所以放在两张卡之外；又因为改完颜色就要立刻点，
                     所以放在面板顶部（常驻可见，不必滚过字体卡）。 -->
                <StackPanel Orientation="Horizontal" Margin="4,0,0,18">
                    <Button x:Name="ApplyDraftBtn" Content="应用这套外观"
                            Style="{StaticResource PrimaryPillButton}" Height="32" Padding="16,0"
                            Cursor="Hand" Click="ApplyDraftBtn_Click"
                            ToolTip="把下面色槽里的配色应用为整套外观（字体请用「应用字体」）"/>
                    <Button x:Name="ResetAppearanceBtn" Content="恢复默认外观"
                            Style="{StaticResource TonalButton}" Height="32" Padding="16,0"
                            Margin="10,0,0,0" Cursor="Hand" Click="ResetAppearanceBtn_Click"
                            ToolTip="主题与字体一起回出厂默认，并清掉偏好文件"/>
                </StackPanel>

                <!-- ===== 卡 1：主题（出厂默认 + 内置预设）===== -->
                <Border Background="{DynamicResource App.Surface.Card}" CornerRadius="24" Padding="22,20">
                    <StackPanel>
                        <TextBlock Text="主题" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Text.Primary}"/>
                        <TextBlock Text="单击即应用。每套主题由一组颜色派生全套界面色（背景、文字、按钮、图标）；想微调就在下面的色槽里改这套主题的颜色"
                                   FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                        <!-- 互斥投影：正在用自选配色时明说"预设都没选中"（用户报障"两块都亮着、分不清谁在生效"） -->
                        <Border CornerRadius="8" Padding="8,4" Margin="0,0,0,12"
                                Background="{DynamicResource App.Surface.Hover}"
                                Visibility="{Binding IsCustomActive, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="当前使用：自选配色 —— 预设主题均未选中"
                                       FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource App.Text.Secondary}"/>
                        </Border>

                        <ItemsControl x:Name="ThemeCardList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 主题卡：圆角 16 + 身份色圆点 + 派生示意条 -->
                                    <Button Width="164" Height="92" Margin="0,0,12,12"
                                            Cursor="Hand" FocusVisualStyle="{x:Null}"
                                            Click="ThemeCard_Click" Tag="{Binding}"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Shell" CornerRadius="16" Padding="12,10"
                                                        Background="{DynamicResource App.Surface.Hover}"
                                                        BorderThickness="2" BorderBrush="Transparent">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Shell" Property="BorderBrush"
                                                                Value="{DynamicResource App.Line.Outline}"/>
                                                    </Trigger>
                                                    <!-- 选中态 = 从 VM 的 IsSelected 投影（唯一事实来源；
                                                         绝不在 code-behind 里"点了哪张记哪张"——那是第二份状态） -->
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Shell" Property="BorderBrush"
                                                                Value="{DynamicResource App.Accent.Fill}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Shell" Property="Background"
                                                                Value="{DynamicResource App.Accent.Container}"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource App.Text.Primary}"/>
                                                <!-- 「默认」徽标只在出厂默认卡上出现（直接绑能力位，不走 code-behind 找元素） -->
                                                <Border Grid.Column="1" CornerRadius="7" Padding="6,1"
                                                        Background="{DynamicResource App.Accent.Container}"
                                                        Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="默认" FontSize="10"
                                                               Foreground="{DynamicResource App.Text.OnContainer}"/>
                                                </Border>
                                            </Grid>

                                            <!-- 身份色圆点＝"主题就是这些颜色" -->
                                            <ItemsControl ItemsSource="{Binding Swatches}" Margin="0,8,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Ellipse Width="16" Height="16" Margin="0,0,5,0"
                                                                 Fill="{Binding Converter={StaticResource ColorToBrush}}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- 派生示意条：强调填充 / 页面底 / 正文 -->
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Border Width="26" Height="8" CornerRadius="4"
                                                        Background="{Binding Accent, Converter={StaticResource ColorToBrush}}"/>
                                                <Border Width="26" Height="8" CornerRadius="4" Margin="4,0,0,0"
                                                        Background="{Binding Base, Converter={StaticResource ColorToBrush}}"/>
                                                <Border Width="26" Height="8" CornerRadius="4" Margin="4,0,0,0"
                                                        Background="{Binding Text, Converter={StaticResource ColorToBrush}}"/>
                                                <TextBlock Text="{Binding Summary}" FontSize="10" Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource App.Text.Muted}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ===== 卡 2：自选配色 ===== -->
                <Border Background="{DynamicResource App.Surface.Card}" CornerRadius="24"
                        Padding="22,20" Margin="0,16,0,0">
                    <!-- 自选配色区 = 与主题卡**同一个选择组**的另一半（二选一）：
                         边框三态 = 当前使用（Accent.Fill）/ 编辑中未应用（Line.Outline）/ 未选中（Line.Variant），
                         全部由 VM 的 IsCustomActive / IsDraftEditing 投影——视图不持"选了哪边"的状态。 -->
                    <Border x:Name="CustomShell" CornerRadius="18" BorderThickness="2" Padding="14,12"
                            Background="{DynamicResource App.Surface.Tint}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource App.Line.Variant}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDraftEditing}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource App.Line.Outline}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCustomActive}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource App.Accent.Fill}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="自选配色" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource App.Text.Primary}"/>
                                <!-- 徽标 = 「当前使用」/「编辑中（未应用）」二选一（两个布尔互斥，故可同格叠放） -->
                                <Border Grid.Column="1" CornerRadius="7" Padding="6,1"
                                        Background="{DynamicResource App.Accent.Container}"
                                        Visibility="{Binding IsCustomActive, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="当前使用" FontSize="10"
                                               Foreground="{DynamicResource App.Text.OnContainer}"/>
                                </Border>
                                <Border Grid.Column="1" CornerRadius="7" Padding="6,1"
                                        Background="{DynamicResource App.Surface.Hover}"
                                        Visibility="{Binding IsDraftEditing, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="编辑中（未应用）" FontSize="10"
                                               Foreground="{DynamicResource App.Text.Secondary}"/>
                                </Border>
                            </Grid>
                            <TextBlock FontSize="12" Margin="0,4,0,14" TextWrapping="Wrap"
                                       Foreground="{DynamicResource App.Text.Secondary}">
                                <Run Text="下面这些是当前主题「"/>
                                <Run Text="{Binding AppliedThemeName, Mode=OneWay}"/>
                                <Run Text="」的颜色：点任意一格就能用取色盘微调（4 或 5 个颜色即可生成一套主题，系统自动派生并保证可读性）；改完点页面顶部（面板级操作行）的「应用这套外观」，它就变成你的自选配色。"/>
                            </TextBlock>

                            <!-- 4 色 / 5 色：**复用 UIKit 共享的滑动指示器分段控件**
                                 （SlidingNavStrip = ListBox + PART_Indicator，几何贴齐与滑动动画全在组件内）。
                                 原先手写两枚 Button 靠换 Style 表达"选中"——用户报障"根本分不清在选哪个"：
                                 填充色的差别不是选择语义，滑动指示器才是本仓既有的选择语言。
                                 选中索引双向绑到 VM 的 SlotCountIndex（唯一事实来源 = 草稿槽数）。 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <views:SlidingNavStrip x:Name="SlotCountStrip"
                                                       Style="{StaticResource SlidingNavStripStyle}"
                                                       ItemContainerStyle="{StaticResource AppearanceSegmentItem}"
                                                       SelectedIndex="{Binding SlotCountIndex, Mode=TwoWay}">
                                    <ListBoxItem Content="4 色"/>
                                    <ListBoxItem Content="5 色"/>
                                </views:SlidingNavStrip>
                            </StackPanel>

                            <!-- 色槽：**居中**排列（用户令 2026-09-20："自选配色这里根本没有居中"）。
                                 每格 = 一个可编辑槽位（点一下开取色盘），所以标「颜色 N」而不是只报色值。 -->
                            <ItemsControl x:Name="SlotList" Margin="0,14,0,0" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,14,12" HorizontalAlignment="Center">
                                            <Button Cursor="Hand" FocusVisualStyle="{x:Null}"
                                                    Click="Slot_Click" Tag="{Binding}"
                                                    ToolTip="{Binding Hex}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Ring" Width="40" Height="40" CornerRadius="20"
                                                                BorderThickness="2"
                                                                BorderBrush="{DynamicResource App.Line.Variant}">
                                                            <Border x:Name="Fill" CornerRadius="18" Margin="3"
                                                                    Background="{Binding Color, Converter={StaticResource ColorToBrush}}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Ring" Property="BorderBrush"
                                                                        Value="{DynamicResource App.Accent.Fill}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <!-- 标记 = "这是第几个槽位"（原来是裸色值，看起来像示例图而不是可编辑控件） -->
                                            <TextBlock Text="{Binding Label}" FontSize="10.5" Margin="0,6,0,0"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource App.Text.Secondary}"/>
                                            <TextBlock Text="{Binding Hex}" FontSize="10" Margin="0,1,0,0"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource App.Text.Muted}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 派生诊断（绑 VM 的唯一投影：诊断文案与"有没有诊断"都由 VM 给，视图不再择时刷新） -->
                            <Border x:Name="DiagnosticsBox" CornerRadius="12"
                                    Visibility="{Binding HasDiagnostics, Converter={StaticResource BoolToVis}}"
                                    Background="{DynamicResource App.Surface.Hover}" Padding="12,10" Margin="0,2,0,0">
                                <TextBlock x:Name="DiagnosticsText" FontSize="12" TextWrapping="Wrap"
                                           Text="{Binding Diagnostics}"
                                           Foreground="{DynamicResource App.Text.Secondary}"/>
                            </Border>

                            <!-- 应用/恢复**不属于这张卡**（用户令 2026-09-20：它们是全局操作，见页面底部的操作行） -->
                        </StackPanel>
                    </Border>
                </Border>

                <!-- ===== 卡 3：字体 ===== -->
                <Border Background="{DynamicResource App.Surface.Card}" CornerRadius="24"
                        Padding="22,20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="字体" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Text.Primary}"/>
                        <TextBlock Text="可选系统已装字体，或导入自己的字体文件（.ttf / .otf / .ttc）"
                                   FontSize="12" Margin="0,4,0,14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>

                        <!-- 界面字体 -->
                        <TextBlock Text="界面字体" FontSize="12" Margin="2,0,0,6"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="UiFontCombo" Grid.Column="0" Height="34"
                                      DisplayMemberPath="Display"
                                      DropDownOpened="UiFontCombo_DropDownOpened"
                                      SelectionChanged="UiFontCombo_SelectionChanged"/>
                            <Button Grid.Column="1" x:Name="ImportFontBtn" Content="导入字体…"
                                    Style="{StaticResource TonalButton}" Height="32" Padding="14,0"
                                    Margin="10,0,0,0" Cursor="Hand" Click="ImportFontBtn_Click"/>
                            <Button Grid.Column="2" x:Name="DeleteFontBtn" Content="删除"
                                    Style="{StaticResource TonalButton}" Height="32" Padding="14,0"
                                    Margin="8,0,0,0" Cursor="Hand" Click="DeleteFontBtn_Click"/>
                        </Grid>

                        <!-- 等宽字体 -->
                        <TextBlock Text="等宽字体（ID / 网址）" FontSize="12" Margin="2,14,0,6"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                        <ComboBox x:Name="MonoFontCombo" Height="34" DisplayMemberPath="Display"
                                  DropDownOpened="MonoFontCombo_DropDownOpened"
                                  SelectionChanged="MonoFontCombo_SelectionChanged"/>

                        <!-- 字号影响提示（度量自检结果） -->
                        <Border x:Name="FontWarnBox" Visibility="Collapsed" CornerRadius="12"
                                Background="{DynamicResource App.Surface.Hover}" Padding="12,10" Margin="0,12,0,0">
                            <TextBlock x:Name="FontWarnText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource App.Text.Secondary}"/>
                        </Border>

                        <!-- 实时样例（走令牌 → 与真实界面同源，不是手画的假预览） -->
                        <TextBlock Text="样例" FontSize="12" Margin="2,16,0,6"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                        <Border Background="{DynamicResource App.Surface.Base}" CornerRadius="16" Padding="16,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="主按钮" Style="{StaticResource PrimaryPillButton}"
                                            Height="32" Padding="14,0" IsHitTestVisible="False"/>
                                    <Button Content="次操作" Style="{StaticResource TonalButton}"
                                            Height="32" Padding="14,0" Margin="8,0,0,0" IsHitTestVisible="False"/>
                                    <m3:M3Icon Kind="folder" Width="18" Height="18" Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource App.Type.Folder}"/>
                                    <m3:M3Icon Kind="link-variant" Width="18" Height="18" Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource App.Type.Link}"/>
                                </StackPanel>
                                <TextBlock Text="正文示例 LinkPocket 书签管理" FontSize="13" Margin="0,12,0,0"
                                           Foreground="{DynamicResource App.Text.Primary}"/>
                                <TextBlock Text="次要说明文字 12px" FontSize="12" Margin="0,4,0,0"
                                           Foreground="{DynamicResource App.Text.Secondary}"/>
                                <TextBlock Text="弱化提示文字" FontSize="11.5" Margin="0,4,0,0"
                                           Foreground="{DynamicResource App.Text.Muted}"/>
                                <TextBlock Text="BOOKMARK-ID-0123456789ABCDEF" FontSize="12" Margin="0,8,0,0"
                                           FontFamily="{DynamicResource App.Font.Mono}"
                                           Foreground="{DynamicResource App.Text.Secondary}"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="ApplyFontsBtn" Content="应用字体"
                                Style="{StaticResource PrimaryPillButton}" Height="32" Padding="16,0"
                                Margin="0,14,0,0" HorizontalAlignment="Left" Cursor="Hand"
                                Click="ApplyFontsBtn_Click"/>
                    </StackPanel>
                </Border>

                <!-- ===== 全局操作已上移到面板顶部（用户令：它们是全局操作，不属于任何一张卡） ===== -->

                <!-- 结果播报（状态栏口径；绑 VM.Status —— 视图不择时刷新） -->
                <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="12" Margin="4,14,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource App.Text.Secondary}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 取色盘浮层（单击色槽打开；点遮罩或 Esc 取消。
             Esc 走**键位总表**（settings.escape → 本面板 ClosePicker），面板不自持 KeyDown） -->
        <Grid x:Name="PickerOverlay" Visibility="Collapsed"
              Background="{DynamicResource App.Overlay.Scrim}" Panel.ZIndex="50">
            <views:ColorPickerPopup x:Name="Picker" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
