<UserControl x:Class="LinkPocket.Views.AppearancePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LinkPocket.I18n;assembly=LinkPocket.I18n"
             xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
             xmlns:views="clr-namespace:LinkPocket.Views;assembly=LinkPocket.UIKit"
             xmlns:local="clr-namespace:LinkPocket.Views">
    <!-- 「4 色 / 5 色」分段的段项样式：**复用** UIKit 共享的滑动指示器语言
         （SlidingNavStripItemStyle 的模板与选中语义），只把段高对齐本面板的 32 药丸口径。
         这不是第二套分段实现——模板、指示器几何、滑动动画全在共享组件里。 -->
    <UserControl.Resources>
        <Style x:Key="AppearanceSegmentItem" TargetType="ListBoxItem"
               BasedOn="{StaticResource SlidingNavStripItemStyle}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="64"/>
        </Style>
    </UserControl.Resources>

    <!-- 「外观」面板（方案 §7.1）：四张卡 = 颜色应用方式 / 主题 / 调色台 / 字体。
         沿用「存储管理」的卡语言（MaxWidth 760 / 圆角 24 / 卡距 16 / 标题 15 SemiBold / 说明 12）。 -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="32,24,32,32">
                <TextBlock Text="{loc:Loc nav.panel.appearance}" FontSize="20" FontWeight="SemiBold" Margin="4,0,0,4"
                           Foreground="{DynamicResource App.Text.Primary}"/>
                <TextBlock Text="{loc:Loc appearance.card.fontNote}"
                           FontSize="13" Margin="4,0,0,20" TextWrapping="Wrap"
                           Foreground="{DynamicResource App.Text.Secondary}"/>

                <!-- ===== 全局操作（面板级，不属于任何一张卡）=====
                     它们作用于**整套外观**（配色 + 字体），所以放在卡片之外、面板顶部（常驻可见，不必滚过字体卡）。
                     不设「应用这套外观」：跨卡的"应用"与面板内"点一下即生效"
                     的既有语言（主题卡单击即应用 / 起点复制即应用）自相矛盾；自选配色的应用入口只剩
                     **第 12 张「自选颜色」卡**（与点主题卡同一手势），故全局行只剩这一枚。 -->
                <StackPanel Orientation="Horizontal" Margin="4,0,0,12">
                    <Button x:Name="ResetAppearanceBtn" Content="{loc:Loc appearance.btn.resetAll}"
                            Style="{StaticResource TonalButton}" Height="32" Padding="16,0"
                            Cursor="Hand" Click="ResetAppearanceBtn_Click"
                            ToolTip="{loc:Loc appearance.btn.resetAll.tip}"/>
                </StackPanel>

                <!-- 「自动调整颜色」开关**独立成一张卡**（Material 3 Expressive 的 ToggleSwitch，不是勾选框）。
                     开关本体 = UIKit 的 `ToggleButton` 隐式样式（轨道 52×32 胶囊 + 24 圆形滑块，
                     开 = 强调填充 / 关 = 悬停底 + 描边，全部走 App.* 令牌）。
                     它作用于**整套配色**，切换即当场重排并落盘；主题卡色点随之重投影（VM 的 RepojectAllThemeCards）。 -->
                <Border Background="{DynamicResource App.Surface.Card}" CornerRadius="24"
                        Padding="22,20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc appearance.mode.title}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Text.Primary}"/>
                        <TextBlock Text="{loc:Loc appearance.mode.desc}"
                                   FontSize="12" Margin="0,4,0,14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Grid.Column="0" x:Name="AutoAdjustColorsSwitch"
                                          VerticalAlignment="Top" Margin="0,2,0,0"
                                          IsChecked="{Binding AutoAdjustColors, Mode=TwoWay}"
                                          ToolTip="{loc:Loc appearance.mode.hint}"/>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <TextBlock Text="{loc:Loc appearance.mode.auto}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource App.Text.Primary}"/>
                                <TextBlock Text="{Binding PaletteModeHint}" FontSize="12" Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource App.Text.Secondary}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== 卡 1：主题（出厂默认 + 内置预设 + 最后一张「自选颜色」）===== -->
                <Border Background="{DynamicResource App.Surface.Card}" CornerRadius="24" Padding="22,20"
                        Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc appearance.theme.title}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Text.Primary}"/>
                        <TextBlock Text="{loc:Loc appearance.theme.hint}"
                                   FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                        <!-- 互斥投影**不配说明条**：
                             「当前使用」由第 12 张卡的高亮 + 面板里的徽标表达，不需要再占一行文字。 -->

                        <ItemsControl x:Name="ThemeCardList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 主题卡：圆角 16 + 身份色圆点 + 派生示意条 -->
                                    <Button Width="164" Height="92" Margin="0,0,12,12"
                                            Cursor="Hand" FocusVisualStyle="{x:Null}"
                                            Click="ThemeCard_Click" Tag="{Binding}"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <!-- 卡面底色 = **当前生效主题的页面底**（VM 的 CardBackground，所有卡一致）：
                                                     未选中卡同样用当前主题的页面底；只有"已应用"的那张卡，
                                                     它色点里的"背景色成员"才与卡面同色 → 融合。 -->
                                                <Border x:Name="Shell" CornerRadius="16" Padding="12,10"
                                                        Background="{Binding CardBackground, Converter={StaticResource ColorToBrush}}"
                                                        BorderThickness="2" BorderBrush="Transparent">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Shell" Property="BorderBrush"
                                                                Value="{DynamicResource App.Line.Outline}"/>
                                                    </Trigger>
                                                    <!-- 选中态 = 从 VM 的 IsSelected 投影（唯一事实来源；
                                                         绝不在 code-behind 里"点了哪张记哪张"——那是第二份状态）。
                                                         ⚠️ **只换描边、不换底色**：换底色会把"融合"那枚圆点重新显形
                                                         （卡底一变，与它同色的圆点就不再融合）。 -->
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Shell" Property="BorderBrush"
                                                                Value="{DynamicResource App.Accent.Fill}"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource App.Text.Primary}"/>
                                                <!-- 「默认」徽标只在出厂默认卡上出现（直接绑能力位，不走 code-behind 找元素） -->
                                                <Border Grid.Column="1" CornerRadius="7" Padding="6,1"
                                                        Background="{DynamicResource App.Accent.Container}"
                                                        Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{loc:Loc appearance.card.default}" FontSize="10"
                                                               Foreground="{DynamicResource App.Text.OnContainer}"/>
                                                </Border>
                                            </Grid>

                                            <!-- 身份色圆点＝"主题就是这些颜色"；第 12 张「自选颜色」卡的圆点
                                                 = 调色台草稿里**已选**的颜色（没选 → 空，走下面的占位态） -->
                                            <ItemsControl ItemsSource="{Binding Swatches}" Margin="0,8,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- ⚠️ **色点不描边**：配色里的背景色成员与它所在的那块底色
                                                             **本来就该是同一个颜色**（融合 = 设计效果，肉眼不可见是预期而非缺陷）。
                                                             真正的问题不是"看不见"，而是表面族被中性色相钉值带离了背景色成员
                                                             （见 `ThemeCatalog.Presets` 的注释）—— 该问题已从根上修掉，不靠描边补偿。 -->
                                                        <Ellipse Width="16" Height="16" Margin="0,0,5,0"
                                                                 Fill="{Binding Converter={StaticResource ColorToBrush}}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- 「自选颜色」的空态 = 4 个**空心占位圆**：
                                                 只画描边、不填任何颜色 —— 空就是空，不拿假色冒充"已选"。 -->
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                                                <Ellipse Width="16" Height="16" Margin="0,0,5,0" StrokeThickness="1.5"
                                                         Stroke="{DynamicResource App.Line.Variant}"/>
                                                <Ellipse Width="16" Height="16" Margin="0,0,5,0" StrokeThickness="1.5"
                                                         Stroke="{DynamicResource App.Line.Variant}"/>
                                                <Ellipse Width="16" Height="16" Margin="0,0,5,0" StrokeThickness="1.5"
                                                         Stroke="{DynamicResource App.Line.Variant}"/>
                                                <Ellipse Width="16" Height="16" StrokeThickness="1.5"
                                                         Stroke="{DynamicResource App.Line.Variant}"/>
                                            </StackPanel>

                                            <!-- 派生示意条：强调填充 / 页面底 / 正文（只对预设卡 ——
                                                 自选颜色卡的颜色由调色台决定，不在这里假装派生） -->
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                        Visibility="{Binding ShowDerivedStrip, Converter={StaticResource BoolToVis}}">
                                                <Border Width="26" Height="8" CornerRadius="4"
                                                        Background="{Binding Accent, Converter={StaticResource ColorToBrush}}"/>
                                                <Border Width="26" Height="8" CornerRadius="4" Margin="4,0,0,0"
                                                        Background="{Binding Base, Converter={StaticResource ColorToBrush}}"/>
                                                <Border Width="26" Height="8" CornerRadius="4" Margin="4,0,0,0"
                                                        Background="{Binding Text, Converter={StaticResource ColorToBrush}}"/>
                                                <TextBlock Text="{Binding Summary}" FontSize="10" Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource App.Text.Muted}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ===== 卡 2：调色台（= "仪表盘"；只编辑自己的配色，上面的主题只读）===== -->
                <Border Background="{DynamicResource App.Surface.Card}" CornerRadius="24"
                        Padding="22,20" Margin="0,16,0,0">
                    <!-- 调色台 = 与主题卡**同一个选择组**的另一半（二选一）：
                         边框三态 = 当前使用（Accent.Fill）/ 编辑中未应用（Line.Outline）/ 未选中（Line.Variant），
                         全部由 VM 的 IsCustomActive / IsDraftEditing 投影——视图不持"选了哪边"的状态。 -->
                    <Border x:Name="CustomShell" CornerRadius="18" BorderThickness="2" Padding="14,12"
                            Background="{DynamicResource App.Surface.Tint}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource App.Line.Variant}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDraftEditing}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource App.Line.Outline}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCustomActive}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource App.Accent.Fill}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc appearance.studio.title}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource App.Text.Primary}"/>
                                <!-- 徽标 = 「当前使用」/「编辑中（未应用）」二选一（两个布尔互斥，故可同格叠放） -->
                                <Border Grid.Column="1" CornerRadius="7" Padding="6,1"
                                        Background="{DynamicResource App.Accent.Container}"
                                        Visibility="{Binding IsCustomActive, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{loc:Loc appearance.badge.inUse}" FontSize="10"
                                               Foreground="{DynamicResource App.Text.OnContainer}"/>
                                </Border>
                                <Border Grid.Column="1" CornerRadius="7" Padding="6,1"
                                        Background="{DynamicResource App.Surface.Hover}"
                                        Visibility="{Binding IsDraftEditing, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{loc:Loc appearance.badge.editing}" FontSize="10"
                                               Foreground="{DynamicResource App.Text.Secondary}"/>
                                </Border>
                            </Grid>
                            <!-- 整句由 VM 给（`DraftIntro`）：**不把一句话拆成"Run 字面量 + 绑定 Run + 字面量"**
                                 三段 —— 那样"这句里写的是哪套外观"就散在两处，运行期没有任何一处能被守住。 -->
                            <TextBlock FontSize="12" Margin="0,4,0,14" TextWrapping="Wrap"
                                       Text="{Binding DraftIntro, Mode=OneWay}"
                                       Foreground="{DynamicResource App.Text.Secondary}"/>

                            <!-- 4 色 / 5 色：**复用 UIKit 共享的滑动指示器分段控件**
                                 （SlidingNavStrip = ListBox + PART_Indicator，几何贴齐与滑动动画全在组件内）。
                                 不手写两枚 Button 靠换 Style 表达"选中"：填充色的差别不是选择语义，
                                 滑动指示器才是本仓既有的选择语言。
                                 选中索引双向绑到 VM 的 SlotCountIndex（唯一事实来源 = 草稿槽数）。 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <views:SlidingNavStrip x:Name="SlotCountStrip"
                                                       Style="{StaticResource SlidingNavStripStyle}"
                                                       ItemContainerStyle="{StaticResource AppearanceSegmentItem}"
                                                       SelectedIndex="{Binding SlotCountIndex, Mode=TwoWay}">
                                    <ListBoxItem Content="{loc:Loc appearance.slots.four}"/>
                                    <ListBoxItem Content="{loc:Loc appearance.slots.five}"/>
                                </views:SlidingNavStrip>
                            </StackPanel>

                            <!-- 「以当前主题为起点」= **复制**当前主题的颜色进色槽（预设主题本身只读，
                                 复制品作为自选配色方案的起点）。
                                 文案带主题名，样式复用既有 TonalButton，高度显式 32（与本面板其它药丸同高）。
                                 「清空颜色」= 把整个草稿清回空槽 **并回到出厂默认（紫罗兰）主题**
                                 ——只清草稿不动已应用外观会让"清空"变成界面一点没变的半截动作——
                                 **唯一一条"清空"路径**（取色盘里的单槽「清除」只清那一格，两件事不重叠）。 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Button x:Name="StartFromThemeBtn"
                                        Content="{Binding StartFromCurrentThemeLabel}"
                                        Style="{StaticResource TonalButton}" Height="32" Padding="14,0"
                                        Cursor="Hand" Click="StartFromThemeBtn_Click"
                                        ToolTip="{loc:Loc appearance.draft.startFrom.tip}"/>
                                <Button x:Name="ClearDraftBtn" Content="{loc:Loc appearance.draft.clear}"
                                        Style="{StaticResource TonalButton}" Height="32" Padding="14,0"
                                        Margin="10,0,0,0" Cursor="Hand" Click="ClearDraftBtn_Click"
                                        ToolTip="{loc:Loc appearance.clearColors.tip}"/>
                            </StackPanel>

                            <!-- 色槽：**居中**排列。
                                 每格 = 一个可编辑槽位（点一下开取色盘）：有颜色 = 实心色圆 + 描边；
                                 空槽 = 虚线空心环 + 中心「+」。 -->
                            <ItemsControl x:Name="SlotList" Margin="0,14,0,0" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,14,12" HorizontalAlignment="Center">
                                            <Button Cursor="Hand" FocusVisualStyle="{x:Null}"
                                                    Click="Slot_Click" Tag="{Binding}"
                                                    ToolTip="{Binding ValueText}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <!-- Background="Transparent"：空槽只有描边/虚线时也要**能接住点击**
                                                             （无背景的 Border 不参与命中测试） -->
                                                        <Border x:Name="Ring" Width="40" Height="40" CornerRadius="20"
                                                                BorderThickness="2" Background="Transparent"
                                                                BorderBrush="{DynamicResource App.Line.Variant}">
                                                            <Grid>
                                                                <Border x:Name="Fill" CornerRadius="18" Margin="3"
                                                                        Background="{Binding Color, Converter={StaticResource ColorToBrush}}"/>
                                                                <Ellipse x:Name="EmptyRing" Margin="4" Visibility="Collapsed"
                                                                         StrokeThickness="1.5" StrokeDashArray="2 2"
                                                                         Stroke="{DynamicResource App.Line.Variant}"/>
                                                                <TextBlock x:Name="EmptyPlus" Text="+" FontSize="16"
                                                                           Visibility="Collapsed"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource App.Text.Muted}"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Ring" Property="BorderBrush"
                                                                        Value="{DynamicResource App.Accent.Fill}"/>
                                                            </Trigger>
                                                            <!-- 空槽（能力位来自 VM，不在视图里推"颜色是不是默认值"） -->
                                                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                <Setter TargetName="Fill" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="EmptyRing" Property="Visibility" Value="Visible"/>
                                                                <Setter TargetName="EmptyPlus" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <!-- 标记 = "这是第几个槽位"（原来是裸色值，看起来像示例图而不是可编辑控件） -->
                                            <TextBlock Text="{Binding Label}" FontSize="10.5" Margin="0,6,0,0"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource App.Text.Secondary}"/>
                                            <!-- 数值文案：空槽显示「未选」，**不显示 #000000 这类假值** -->
                                            <TextBlock Text="{Binding ValueText}" FontSize="10" Margin="0,1,0,0"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource App.Text.Muted}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 派生诊断（绑 VM 的唯一投影：诊断文案与"有没有诊断"都由 VM 给，视图不再择时刷新） -->
                            <Border x:Name="DiagnosticsBox" CornerRadius="12"
                                    Visibility="{Binding HasDiagnostics, Converter={StaticResource BoolToVis}}"
                                    Background="{DynamicResource App.Surface.Hover}" Padding="12,10" Margin="0,2,0,0">
                                <TextBlock x:Name="DiagnosticsText" FontSize="12" TextWrapping="Wrap"
                                           Text="{Binding Diagnostics}"
                                           Foreground="{DynamicResource App.Text.Secondary}"/>
                            </Border>

                            <!-- 应用/恢复**不属于这张卡**（它们是全局操作，见面板顶部） -->
                        </StackPanel>
                    </Border>
                </Border>

                <!-- ===== 卡 3：字体 ===== -->
                <Border Background="{DynamicResource App.Surface.Card}" CornerRadius="24"
                        Padding="22,20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc appearance.font.card.title}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Text.Primary}"/>
                        <TextBlock Text="{loc:Loc appearance.font.hint}"
                                   FontSize="12" Margin="0,4,0,14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>

                        <!-- 字体来源：**先选来源，再在来源里选字体**（系统字体与导入字体二选一）。
                             与颜色那边的 4/5 色一样复用共享滑动分段组件，不手写第二套分段。 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,8">
                            <views:SlidingNavStrip x:Name="FontSourceStrip"
                                                   Style="{StaticResource SlidingNavStripStyle}"
                                                   ItemContainerStyle="{StaticResource AppearanceSegmentItem}"
                                                   SelectedIndex="{Binding FontSourceIndex, Mode=TwoWay}">
                                <ListBoxItem Content="{loc:Loc appearance.font.source.system}"/>
                                <ListBoxItem Content="{loc:Loc appearance.font.source.custom}"/>
                            </views:SlidingNavStrip>
                        </StackPanel>
                        <TextBlock Text="{Binding FontSourceHint}" FontSize="11.5" Margin="2,0,0,10"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.Text.Muted}"/>

                        <!-- 界面字体 -->
                        <TextBlock Text="{loc:Loc appearance.font.ui}" FontSize="12" Margin="2,0,0,6"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="UiFontCombo" Grid.Column="0" Height="34"
                                      DisplayMemberPath="Display"
                                      SelectedItem="{Binding SelectedUiFont, Mode=TwoWay}"
                                      DropDownOpened="UiFontCombo_DropDownOpened"
                                      SelectionChanged="UiFontCombo_SelectionChanged"/>
                            <!-- 导入 / 删除**只在「自定义字体」这一侧出现**：
                                 系统字体是只读的（属于系统，本应用不修改、也删不掉），
                                 摆在那里只会让用户点了才发现不给删。 -->
                            <Button Grid.Column="1" x:Name="ImportFontBtn" Content="{loc:Loc appearance.font.import}"
                                    Style="{StaticResource TonalButton}" Height="32" Padding="14,0"
                                    Margin="10,0,0,0" Cursor="Hand" Click="ImportFontBtn_Click"
                                    Visibility="{Binding IsCustomFontSource, Converter={StaticResource BoolToVis}}"/>
                            <Button Grid.Column="2" x:Name="DeleteFontBtn" Content="{loc:Loc appearance.font.delete}"
                                    Style="{StaticResource TonalButton}" Height="32" Padding="14,0"
                                    Margin="8,0,0,0" Cursor="Hand" Click="DeleteFontBtn_Click"
                                    Visibility="{Binding IsCustomFontSource, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{loc:Loc appearance.font.delete.tip}"/>
                        </Grid>

                        <!-- 不提供等宽字体入口：ID / 网址显示用的等宽字体固定为默认族（Consolas）。
                             样例里那行等宽示例文字保留 —— 它走 `App.Font.Mono` 令牌，与真实界面同源。 -->

                        <!-- 字号影响提示（度量自检结果） -->
                        <Border x:Name="FontWarnBox" Visibility="Collapsed" CornerRadius="12"
                                Background="{DynamicResource App.Surface.Hover}" Padding="12,10" Margin="0,12,0,0">
                            <TextBlock x:Name="FontWarnText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource App.Text.Secondary}"/>
                        </Border>

                        <!-- 实时样例（走令牌 → 与真实界面同源，不是手画的假预览） -->
                        <TextBlock Text="{loc:Loc appearance.sample.title}" FontSize="12" Margin="2,16,0,6"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                        <Border Background="{DynamicResource App.Surface.Base}" CornerRadius="16" Padding="16,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{loc:Loc appearance.sample.primaryButton}" Style="{StaticResource PrimaryPillButton}"
                                            Height="32" Padding="14,0" IsHitTestVisible="False"/>
                                    <Button Content="{loc:Loc appearance.sample.actions}" Style="{StaticResource TonalButton}"
                                            Height="32" Padding="14,0" Margin="8,0,0,0" IsHitTestVisible="False"/>
                                    <m3:M3Icon Kind="folder" Width="18" Height="18" Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource App.Type.Folder}"/>
                                    <m3:M3Icon Kind="link-variant" Width="18" Height="18" Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource App.Type.Link}"/>
                                </StackPanel>
                                <TextBlock Text="{loc:Loc appearance.sample.body}" FontSize="13" Margin="0,12,0,0"
                                           Foreground="{DynamicResource App.Text.Primary}"/>
                                <TextBlock Text="{loc:Loc appearance.sample.secondary}" FontSize="12" Margin="0,4,0,0"
                                           Foreground="{DynamicResource App.Text.Secondary}"/>
                                <TextBlock Text="{loc:Loc appearance.sample.muted}" FontSize="11.5" Margin="0,4,0,0"
                                           Foreground="{DynamicResource App.Text.Muted}"/>
                                <TextBlock Text="BOOKMARK-ID-0123456789ABCDEF" FontSize="12" Margin="0,8,0,0"
                                           FontFamily="{DynamicResource App.Font.Mono}"
                                           Foreground="{DynamicResource App.Text.Secondary}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="ApplyFontsBtn" Content="{loc:Loc appearance.font.apply}"
                                    Style="{StaticResource PrimaryPillButton}" Height="32" Padding="16,0"
                                    Cursor="Hand" Click="ApplyFontsBtn_Click"/>
                            <!-- 「恢复默认字体」= 不读下拉选中项，直接把界面字体回默认族并落盘。
                                 与「恢复默认外观」的区别：这里不动主题与配色。 -->
                            <Button x:Name="ResetFontsBtn" Content="{loc:Loc appearance.font.reset}"
                                    Style="{StaticResource TonalButton}" Height="32" Padding="14,0"
                                    Margin="10,0,0,0" Cursor="Hand" Click="ResetFontsBtn_Click"
                                    ToolTip="{loc:Loc appearance.font.reset.tip}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== 全局操作在面板顶部（它们是全局操作，不属于任何一张卡） ===== -->

                <!-- 结果播报（状态栏口径；绑 VM.Status —— 视图不择时刷新）。
                     **只在失败 / 用户必须知道的事实时才有字**——成功路径不写"已应用主题「X」"这类重复信息，
                     当前生效的外观由主题卡高亮 + 「当前使用」徽标表达。 -->
                <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="12" Margin="4,14,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource App.Text.Secondary}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 取色盘浮层（单击色槽打开；点遮罩或 Esc 取消。
             Esc 走**键位总表**（settings.escape → 本面板 ClosePicker），面板不自持 KeyDown） -->
        <Grid x:Name="PickerOverlay" Visibility="Collapsed"
              Background="{DynamicResource App.Overlay.Scrim}" Panel.ZIndex="50">
            <views:ColorPickerPopup x:Name="Picker" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
