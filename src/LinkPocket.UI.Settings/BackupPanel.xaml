<UserControl x:Class="LinkPocket.Views.BackupPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LinkPocket.I18n;assembly=LinkPocket.I18n"
             xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf">

    <!-- 备份与恢复：与工具页同语言的圆角卡片 + 药丸按钮。
         导出卡：目录选择（回收站不备份，卡内有提示）；成功后清空保存位防手滑。
         导入卡：文件选择 → 点「开始导入」弹出 ImportModeDialog 模态弹窗（新增导入 / 清空后导入）。
         进度展示复用设置页根部的 ExportOverlay；所有结果提示走统一 ConfirmDialog 弹窗（禁原生 MessageBox）。 -->

    <UserControl.Resources>
        <!-- 输入域（卡片内变体，与 ToolsPage.CardField 同款，样式自包含） -->
        <Style x:Key="CardField" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource App.Accent.Fill}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="16"
                                Background="{DynamicResource App.Surface.Hover}">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                                <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}"
                                           Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.Text.Secondary}" Opacity="0.7"
                                           IsHitTestVisible="False" Visibility="Collapsed"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Surface.Panel}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="32,24,32,24">

                <!-- ===== 导出备份卡 ===== -->
                <Border Background="{DynamicResource App.Surface.Card}" CornerRadius="24"
                        Padding="22,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="46" Height="46" CornerRadius="16" Background="{DynamicResource App.Surface.Panel}">
                                <m3:M3Icon Kind="export" Width="22" Height="22"
                                           Foreground="{DynamicResource App.Text.Primary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc backup.export}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource App.Text.Primary}"/>
                                <TextBlock Text="{loc:Loc backup.desc}"
                                           FontSize="12" Margin="0,3,0,0"
                                           Foreground="{DynamicResource App.Text.Secondary}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{loc:Loc backup.saveTo}" FontSize="11.5" Margin="4,20,0,6"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BackupExportDirTextBox" Grid.Column="0"
                                     Style="{StaticResource CardField}"
                                     Tag="{loc:Loc backup.pickDir.hint}"/>
                            <Button Grid.Column="1" x:Name="BrowseBackupExportDirButton"
                                    Content="{loc:Loc nav.item.browser}" Margin="10,0,0,0"
                                    Style="{StaticResource TonalButton}" Height="44" Padding="18,0"
                                    Click="BrowseBackupExportDirButton_Click"/>
                        </Grid>

                        <TextBlock Text="{loc:Loc backup.trash.note}"
                                   FontSize="11.5" Margin="4,16,0,0"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>

                        <Button x:Name="BackupExportButton" Margin="0,16,0,0" HorizontalAlignment="Left"
                                Style="{StaticResource PrimaryPillButton}" Height="36" Padding="20,0"
                                IsEnabled="False" Click="BackupExportButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <m3:M3Icon Kind="export" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc backup.export.start}" FontSize="13" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ===== 导入备份卡 ===== -->
                <Border Background="{DynamicResource App.Surface.Card}" CornerRadius="24"
                        Padding="22,20" Margin="0,16,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="46" Height="46" CornerRadius="16" Background="{DynamicResource App.Surface.Panel}">
                                <m3:M3Icon Kind="import" Width="22" Height="22"
                                           Foreground="{DynamicResource App.Text.Primary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc backup.import}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource App.Text.Primary}"/>
                                <TextBlock Text="{loc:Loc backup.ids.note}"
                                           FontSize="12" Margin="0,3,0,0"
                                           Foreground="{DynamicResource App.Text.Secondary}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{loc:Loc tools.io.format.backup}" FontSize="11.5" Margin="4,20,0,6"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BackupImportFileTextBox" Grid.Column="0"
                                     Style="{StaticResource CardField}"
                                     Tag="{loc:Loc tools.io.pickBackup.hint}"/>
                            <Button Grid.Column="1" x:Name="BrowseBackupImportButton"
                                    Content="{loc:Loc nav.item.browser}" Margin="10,0,0,0"
                                    Style="{StaticResource TonalButton}" Height="44" Padding="18,0"
                                    Click="BrowseBackupImportButton_Click"/>
                        </Grid>

                        <Button x:Name="BackupImportButton" Margin="0,20,0,0" HorizontalAlignment="Left"
                                Style="{StaticResource PrimaryPillButton}" Height="36" Padding="20,0"
                                IsEnabled="False" Click="BackupImportButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <m3:M3Icon Kind="import" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc backup.import.start}" FontSize="13" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
