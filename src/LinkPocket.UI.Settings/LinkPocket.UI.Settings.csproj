<Project Sdk="Microsoft.NET.Sdk">

  <!-- UI.Settings：设置页（存储管理 + 备份与恢复 BackupPanel）。 -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>LinkPocket.UI.Settings</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinkPocket.Contracts\LinkPocket.Contracts.csproj" />
    <ProjectReference Include="..\LinkPocket.UIKit\LinkPocket.UIKit.csproj" />
    <!-- 外观面板（主题 / 调色台 / 字体 / 语言卡）就是 Theming 的编辑面：显式声明，
         不再靠 UIKit 的传递引用"摸到"（声明与实际依赖一致，越界才看得出）。 -->
    <ProjectReference Include="..\LinkPocket.Theming\LinkPocket.Theming.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Material3.Wpf" />
  </ItemGroup>

</Project>
