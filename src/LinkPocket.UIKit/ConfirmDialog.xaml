<Window x:Class="LinkPocket.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height" Width="400"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <!-- 统一确认弹窗（MD3 Expressive）：
         色调分层（TintCard 圆角卡，无硬边框）+ 色圆图标 chip + 药丸按钮组（TonalButton/PrimaryPillButton）。
         与浏览页卡片/命令栏同一套语言：8px 节距、24 圆角、全幅状态层药丸。 -->

    <!-- 外层留白承载投影 -->
    <Grid Margin="24">
        <Border CornerRadius="24" Background="{DynamicResource App.Surface.Dialog}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="3" Direction="270"
                                  Opacity="0.28" Color="{DynamicResource App.Color.Shadow}"/>
            </Border.Effect>

            <Grid Margin="28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 头部：图标 chip（删除/警告 = WarnBg 奶油黄；信息/成功 = TintPanel 中性紫面板）+ 标题 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border x:Name="ChipBorder" Width="44" Height="44" CornerRadius="22"
                            Background="{DynamicResource App.Support.Container}">
                        <m3:M3Icon x:Name="IconGlyph" Kind="delete-outline" Width="22" Height="22"
                                   Foreground="{DynamicResource OnSurface}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TitleText" FontSize="19" FontWeight="Medium"
                               VerticalAlignment="Center" Margin="14,0,0,0"
                               Foreground="{DynamicResource OnSurface}"/>
                </StackPanel>

                <!-- 正文 -->
                <TextBlock Grid.Row="1" x:Name="MessageText" TextWrapping="Wrap" FontSize="13.5"
                           LineHeight="21" Margin="2,16,2,0"
                           Foreground="{DynamicResource OnSurfaceVariant}"/>

                <!-- 操作区：取消 = TonalButton 药丸，确认 = PrimaryPillButton 药丸（同高 32） -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button x:Name="CancelBtn" Content="取消" IsCancel="True"
                            Style="{StaticResource TonalButton}"
                            Height="32" MinWidth="96" Padding="20,6" FontSize="13"/>
                    <Button x:Name="ConfirmBtn" IsDefault="True"
                            Style="{StaticResource PrimaryPillButton}"
                            Height="32" MinWidth="96" Padding="20,6" FontSize="13" Margin="10,0,0,0">
                        <TextBlock x:Name="ConfirmLabel" Text="确定"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
