<UserControl x:Class="LinkPocket.Views.DetailSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="286">

    <!-- 可复用详情栏（数据驱动，与 SortableDataTable 同思路）：
         DataContext = ViewModels.DetailSidebarModel（或其子类）。
         信息卡内容按 Rows 集合渲染 —— 行由使用方按选中对象构建，
         控件不含任何「链接/文件夹」字段硬编码。样式自带（SideCard/SideLabel/SideChip），
         放进任何页面都成立，不依赖宿主资源。 -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 详情栏卡片：M3 圆角容器（Expressive 大圆角 20），TintCard 浮起在 TintPanel 面板上 -->
        <Style x:Key="SideCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource TintCard}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <!-- 详情栏小节标签 -->
        <Style x:Key="SideLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
            <Setter Property="Margin" Value="4,0,0,4"/>
        </Style>
        <!-- 类型 / 统计小药丸 -->
        <Style x:Key="SideChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PrimaryContainer}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 纯图标按钮：自带 ControlTemplate，绝对不能 BasedOn TextButton
             （TextButton 硬编码 Padding="14,0" + MinHeight=40 → 小按钮内容被裁切）。
             与 BrowserView 同一套规格；控件自包含，宿主页面无需提供该资源。 -->
        <Style x:Key="NavIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ToolTip" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
            <Setter Property="ToolTipService.Placement" Value="Top"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="16" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="StateLayer" Background="{DynamicResource Primary}"
                                        Opacity="0" CornerRadius="16" Margin="-4"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.12"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceMuted}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,12,12,16">

            <!-- 空态占位（MD3E）：圆角色块徽章 + 引导文案 -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,110,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Width="72" Height="72" CornerRadius="24" HorizontalAlignment="Center"
                        Background="{DynamicResource TintCard}">
                    <m3:M3Icon Kind="eye-outline" Width="30" Height="30"
                               Foreground="{DynamicResource OnSurfaceVariant}" Opacity="0.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="选中项目查看详情" FontSize="13" Foreground="{DynamicResource OnSurfaceVariant}" Opacity="0.8"
                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
                <TextBlock Text="链接或文件夹均可" FontSize="11" Foreground="{DynamicResource OnSurfaceVariant}" Opacity="0.55"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- ===== 单选：头部卡片（图标 + 名称） ===== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SideCard}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSingle}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="44" Height="44" VerticalAlignment="Center">
                        <!-- 书签 favicon（无图时回退 earth 占位） -->
                        <Border CornerRadius="10" Background="White" ClipToBounds="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Image Source="{Binding Favicon}" Stretch="Uniform" Margin="6"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasFavicon}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <m3:M3Icon Kind="earth" Width="22" Height="22"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5">
                                    <m3:M3Icon.Style>
                                        <Style TargetType="m3:M3Icon">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasFavicon}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </m3:M3Icon.Style>
                                </m3:M3Icon>
                            </Grid>
                        </Border>
                        <!-- 文件夹大图标 -->
                        <m3:M3Icon Kind="folder" Width="40" Height="40" Foreground="#FFB300"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <m3:M3Icon.Style>
                                <Style TargetType="m3:M3Icon">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </m3:M3Icon.Style>
                        </m3:M3Icon>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Foreground="{DynamicResource OnSurface}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 单选书签：URL 卡片 ===== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SideCard}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLink}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding UrlText}" FontSize="12"
                               FontFamily="Consolas" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource OnSurfaceVariant}"/>
                    <Button Grid.Column="1" Style="{StaticResource NavIconButton}" Tag="复制链接"
                            Width="26" Height="24" Padding="4" Margin="6,0,0,0" VerticalAlignment="Center"
                            Command="{Binding CopyUrlCommand}">
                        <m3:M3Icon Kind="content-copy" Width="13" Height="13"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== 单选：信息卡片（行 = Rows 集合，数据驱动） ===== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SideCard}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSingle}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="信息" Style="{StaticResource SideLabel}"/>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 图标 / 标签 / 值 三列严格对齐（16/62/* 与旧版一致） -->
                                <Grid Margin="0,2,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <m3:M3Icon Kind="{Binding IconKind}" Width="13" Height="13" Opacity="0.55"
                                               Foreground="{DynamicResource OnSurfaceVariant}" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" Opacity="0.6"
                                               Foreground="{DynamicResource OnSurfaceVariant}" VerticalAlignment="Top"/>
                                    <!-- ⚠️ 基态视觉值必须写在 Style.Setters：本地值优先级高于触发器 -->
                                    <TextBlock Grid.Column="2" Text="{Binding Value}" VerticalAlignment="Top">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAccent}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMono}" Value="True">
                                                        <Setter Property="FontFamily" Value="Consolas"/>
                                                        <Setter Property="FontSize" Value="11"/>
                                                        <Setter Property="Opacity" Value="0.6"/>
                                                        <Setter Property="TextWrapping" Value="NoWrap"/>
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="3" Style="{StaticResource NavIconButton}" Tag="{Binding CopyToolTip}"
                                            Width="24" Height="22" Padding="3" Margin="4,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding CopyCommand}"
                                            Visibility="{Binding HasCopy, Converter={StaticResource BoolToVis}}">
                                        <m3:M3Icon Kind="content-copy" Width="12" Height="12"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== 单选书签：描述卡片（置于信息卡之后） ===== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SideCard}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDescription}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="描述" Style="{StaticResource SideLabel}"/>
                    <TextBlock Text="{Binding DescriptionText}" FontSize="12.5" TextWrapping="Wrap"
                               LineHeight="19" Foreground="{DynamicResource OnSurface}"/>
                </StackPanel>
            </Border>

            <!-- ===== 单选：快捷操作 =====
                 只读模式（IsReadOnly，如回收站详情栏）下整卡隐藏：只展示信息，不提供动作入口 -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SideCard}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSingle}" Value="True"/>
                                    <Condition Binding="{Binding IsReadOnly}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="操作" Style="{StaticResource SideLabel}"/>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- 文件夹=「打开」（进入目录，跨两列占满整行）；链接=「详情」+「打开」两列等宽。
                             成对规范：同为药丸（PrimaryPillButton / TonalButton 16），同高 32，仅颜色不同 -->
                        <Button Grid.Column="0" Height="32"
                                VerticalAlignment="Center" Padding="12,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding OpenCommand}"
                                ToolTip="{Binding OpenToolTip}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                            <Setter Property="Grid.ColumnSpan" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <m3:M3Icon Kind="eye-outline" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding OpenLabel}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- 打开：仅链接（系统默认浏览器打开并记录一次访问） -->
                        <Button Grid.Column="1" Style="{StaticResource TonalButton}" Height="32" Padding="12,0" Margin="6,0,0,0"
                                VerticalAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch"
                                Command="{Binding OpenWebsiteCommand}"
                                ToolTip="在浏览器中打开"
                                Visibility="{Binding IsLink, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <m3:M3Icon Kind="open-in-new" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="打开" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- 链接：编辑（整页编辑器）；文件夹：重命名 -->
                        <Button Grid.Column="2" Style="{StaticResource NavIconButton}"
                                Tag="{Binding EditLabel}"
                                Width="32" Height="32" Margin="6,0,0,0" VerticalAlignment="Center"
                                Command="{Binding RenameCommand}">
                            <m3:M3Icon Kind="pencil-outline" Width="15" Height="15"/>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource NavIconButton}" Tag="删除"
                                Width="32" Height="32" VerticalAlignment="Center"
                                Command="{Binding DeleteCommand}">
                            <!-- 删除/警告提醒色规范：图标本身 = WarnBg 奶油黄，无底圈，与编辑按钮同构 -->
                            <m3:M3Icon Kind="delete-outline" Width="15" Height="15"
                                       Foreground="{StaticResource WarnBg}"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== 多选：统计卡片 ===== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SideCard}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMulti}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <m3:M3Icon Kind="content-duplicate" Width="26" Height="26"
                                   Foreground="{DynamicResource Primary}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedTotal}" FontSize="22" FontWeight="SemiBold"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OnSurface}"/>
                        <TextBlock Text="项已选中" FontSize="14" Margin="8,0,0,0" Opacity="0.7" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OnSurfaceVariant}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Style="{StaticResource SideChip}">
                            <TextBlock FontSize="11" Foreground="{DynamicResource OnPrimaryContainer}">
                                <Run Text="{Binding SelectedFolders, Mode=OneWay}"/>
                                <Run Text=" 个文件夹"/>
                            </TextBlock>
                        </Border>
                        <Border Style="{StaticResource SideChip}">
                            <TextBlock FontSize="11" Foreground="{DynamicResource OnPrimaryContainer}">
                                <Run Text="{Binding SelectedLinks, Mode=OneWay}"/>
                                <Run Text=" 个链接"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <!-- 多选态只提供「删除所选」：重命名只对单个条目有意义，多选不出现该按钮 -->
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ctrl+点击 可增减选择" FontSize="11" Opacity="0.45" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OnSurfaceVariant}"/>
                        <Button Grid.Column="1" Tag="删除所选"
                                Width="32" Height="32" Margin="6,0,0,0" Command="{Binding DeleteCommand}">
                            <!-- 只读详情栏（回收站）不提供任何动作入口：多选的「删除所选」同样隐藏
                                 （永久删除仍由页面工具栏 WarnPill 与右键菜单负责，见 BEHAVIOR-CONTRACT §5） -->
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavIconButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <m3:M3Icon Kind="delete-outline" Width="15" Height="15"
                                       Foreground="{StaticResource WarnBg}"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
