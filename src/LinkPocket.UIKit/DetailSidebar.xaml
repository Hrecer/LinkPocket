<UserControl x:Class="LinkPocket.Views.DetailSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
             xmlns:views="clr-namespace:LinkPocket.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="286">

    <!-- 可复用详情栏（数据驱动，与 SortableDataTable 同思路）：
         DataContext = ViewModels.DetailSidebarModel（或其子类）。
         信息卡内容按 Rows 集合渲染 —— 行由使用方按选中对象构建，
         控件不含任何「链接/文件夹」字段硬编码。样式自带（SideCard/SideLabel/SideChip），
         放进任何页面都成立，不依赖宿主资源。 -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 详情栏卡片：M3 圆角容器（Expressive 大圆角 20），TintCard 浮起在 TintPanel 面板上 -->
        <Style x:Key="SideCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource App.Surface.TintCard}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <!-- 详情栏小节标签 -->
        <Style x:Key="SideLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
            <Setter Property="Margin" Value="4,0,0,4"/>
        </Style>
        <!-- 类型 / 统计小药丸 -->
        <Style x:Key="SideChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PrimaryContainer}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 纯图标按钮：自带 ControlTemplate，绝对不能 BasedOn TextButton
             （TextButton 硬编码 Padding="14,0" + MinHeight=40 → 小按钮内容被裁切）。
             与 BrowserView 同一套规格；控件自包含，宿主页面无需提供该资源。 -->
        <Style x:Key="NavIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ToolTip" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
            <Setter Property="ToolTipService.Placement" Value="Top"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="16" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="StateLayer" Background="{DynamicResource Primary}"
                                        Opacity="0" CornerRadius="16" Margin="-4"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.12"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceMuted}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 动作卡的**按钮定义（各只有一份）**：排布由能力位 StackedActions 决定（见下方两个宿主）=====
             这样"回收站右栏排两行 / 浏览页右栏排一行"只是排布差异，按钮本身与命令仍是同一份，
             不存在第二套详情栏（用户令 2026-09-19）。 -->

        <!-- 药丸组：文件夹=「打开」跨两列占满整行；链接=「详情」+「打开」两列等宽 -->
        <DataTemplate x:Key="SidebarActionPills">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Height="32"
                        VerticalAlignment="Center" Padding="12,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Style="{StaticResource PrimaryPillButton}"
                        Grid.ColumnSpan="{Binding OpenColumnSpan}"
                        Command="{Binding OpenCommand}"
                        ToolTip="{Binding OpenToolTip}"
                        Visibility="{Binding ShowOpenAction, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <m3:M3Icon Kind="eye-outline" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding OpenLabel}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- 打开：仅链接（系统默认浏览器打开并记录一次访问） -->
                <Button Grid.Column="1" Style="{StaticResource TonalButton}" Height="32" Padding="12,0" Margin="6,0,0,0"
                        VerticalAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch"
                        Command="{Binding OpenWebsiteCommand}"
                        ToolTip="在浏览器中打开"
                        Visibility="{Binding ShowOpenWebsiteButton, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <m3:M3Icon Kind="open-in-new" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="打开" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </DataTemplate>

        <!-- 图标钮组：顺序只有一套（按能力位显隐）= **跳转** → 还原 → 还原到根目录 → 重命名 → 编辑 → 删除。
             取色由色调位 / 语义驱动：跳转 = AccentBtn 深紫（与工具栏主按钮填充同源）、编辑 = 图标钮缺省 Primary、
             合并「深紫」= AccentBtn，永久删除 = WarnBg。 -->
        <DataTemplate x:Key="SidebarActionIcons">
            <StackPanel Orientation="Horizontal">
                <!-- 跳转（进浏览页对应目录并选中该行；经 IContentLocator）——结果页 / 搜索页 / 浏览页 / 回收站的单一目标动作，
                     多选时由能力位关掉（跳转只对单个目标有意义）。图标 = 地图图钉 `map-marker`（"在哪儿"语义）；
                     取色 = `AccentBtn` **深紫**（与工具栏主按钮填充同源；⚠️ 不要用图标钮缺省的 `Primary` 亮紫——
                     用户报障"跳转按钮是亮紫色、太显眼"，与「重命名」那枚同色规则一致）。 -->
                <Button Style="{StaticResource NavIconButton}"
                        Tag="{Binding JumpToolTip}"
                        Width="32" Height="32" Margin="0,0,0,0" VerticalAlignment="Center"
                        Foreground="{DynamicResource App.Accent.Fill}"
                        Command="{Binding JumpCommand}"
                        Visibility="{Binding ShowJumpAction, Converter={StaticResource BoolToVis}}">
                    <m3:M3Icon Kind="{Binding JumpIconKind}" Width="15" Height="15"/>
                </Button>
                <Button Style="{StaticResource NavIconButton}"
                        Width="32" Height="32" Margin="6,0,0,0" VerticalAlignment="Center"
                        Tag="{Binding RestoreLabel}"
                        Foreground="{Binding RestoreTone, Converter={StaticResource PillToneBrush}}"
                        Command="{Binding RestoreCommand}"
                        Visibility="{Binding ShowRestoreAction, Converter={StaticResource BoolToVis}}">
                    <m3:M3Icon Kind="{Binding RestoreIconKind}" Width="15" Height="15"/>
                </Button>
                <Button Style="{StaticResource NavIconButton}"
                        Width="32" Height="32" Margin="6,0,0,0" VerticalAlignment="Center"
                        Tag="{Binding RestoreToRootLabel}"
                        Foreground="{Binding RestoreToRootTone, Converter={StaticResource PillToneBrush}}"
                        Command="{Binding RestoreToRootCommand}"
                        Visibility="{Binding ShowRestoreToRootAction, Converter={StaticResource BoolToVis}}">
                    <m3:M3Icon Kind="{Binding RestoreToRootIconKind}" Width="15" Height="15"/>
                </Button>
                <!-- 链接：「重命名」（就地改标题，位置 = 药丸右侧 / 编辑键左侧；用户定稿 2026-09-20）。
                     ⚠️ T3 起**两枚铅笔同色**：新体系只有一支强调色（`App.Accent.Fill` = 库 `Primary` = #6A567C），
                     旧的"深紫 vs 亮紫"两色区分随"两套强调色并存"缺陷（D1）一起消失。
                     UI-SPEC 对此情形的既定口径 = 「宁可同色 + 靠字形与提示区分」→ 故这里给**提示文案**，
                     探针也改断言"工具提示可区分"而不是"颜色不同"。 -->
                <Button Style="{StaticResource NavIconButton}"
                        Tag="{Binding RenameActionLabel}"
                        ToolTip="{Binding RenameActionLabel}"
                        Width="32" Height="32" Margin="6,0,0,0" VerticalAlignment="Center"
                        Foreground="{DynamicResource App.Accent.Fill}"
                        Command="{Binding RenameActionCommand}"
                        Visibility="{Binding ShowRenameAction, Converter={StaticResource BoolToVis}}">
                    <m3:M3Icon Kind="pencil-outline" Width="15" Height="15"/>
                </Button>
                <!-- 链接：编辑（整页编辑器）；文件夹：重命名（同一枚铅笔，取色随语义切换——
                     重命名 = 强调色（与上面那枚独立「重命名」同色）；编辑 = 图标钮缺省的 Primary。
                     取色由模型的能力位 EditActionAccent 声明，界面不按行类型猜） -->
                <Button Tag="{Binding EditLabel}"
                        ToolTip="{Binding EditLabel}"
                        Width="32" Height="32" Margin="6,0,0,0" VerticalAlignment="Center"
                        Command="{Binding RenameCommand}"
                        Visibility="{Binding ShowEditAction, Converter={StaticResource BoolToVis}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavIconButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EditActionAccent}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource App.Accent.Fill}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <m3:M3Icon Kind="pencil-outline" Width="15" Height="15"/>
                </Button>
                <Button Style="{StaticResource NavIconButton}" Tag="{Binding DeleteActionLabel}"
                        Width="32" Height="32" VerticalAlignment="Center"
                        Command="{Binding DeleteCommand}"
                        Visibility="{Binding ShowDeleteAction, Converter={StaticResource BoolToVis}}">
                    <!-- 删除/警告提醒色规范：图标本身 = WarnBg 奶油黄，无底圈，与编辑按钮同构 -->
                    <m3:M3Icon Kind="delete-outline" Width="15" Height="15"
                               Foreground="{DynamicResource App.Support.OnContainer}"/>
                </Button>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!-- ⚠️ 聚焦禁描边（硬性口径，逐类容器核对 —— 文档/WARNINGS 43）：框架默认模板给
         ScrollViewer / ItemsControl / ContentControl 都带非空 FocusVisualStyle，一旦它们通过 Tab 或
         代码 Focus 拿到键盘焦点就会画出**原生焦点虚线框**（用户报障 2026-09-20：去重明细页 F5 后黑虚线）。
         本控件内部的这几类容器一律显式置空（共享控件，一处修全部页面受益）。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  FocusVisualStyle="{x:Null}">
        <StackPanel Margin="12,12,12,16">

            <!-- 空态占位（MD3E）：圆角色块徽章 + 引导文案 -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,110,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Width="72" Height="72" CornerRadius="24" HorizontalAlignment="Center"
                        Background="{DynamicResource App.Surface.TintCard}">
                    <m3:M3Icon Kind="eye-outline" Width="30" Height="30"
                               Foreground="{DynamicResource OnSurfaceVariant}" Opacity="0.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="选中项目查看详情" FontSize="13" Foreground="{DynamicResource OnSurfaceVariant}" Opacity="0.8"
                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
                <TextBlock Text="链接或文件夹均可" FontSize="11" Foreground="{DynamicResource OnSurfaceVariant}" Opacity="0.55"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- ===== 单选：头部卡片（图标 + 名称） ===== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SideCard}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSingle}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="44" Height="44" VerticalAlignment="Center">
                        <!-- 书签 favicon（无图时回退 earth 占位） -->
                        <Border CornerRadius="10" Background="White" ClipToBounds="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Image Source="{Binding Favicon}" Stretch="Uniform" Margin="6"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasFavicon}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <m3:M3Icon Kind="earth" Width="22" Height="22"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5">
                                    <m3:M3Icon.Style>
                                        <Style TargetType="m3:M3Icon">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasFavicon}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </m3:M3Icon.Style>
                                </m3:M3Icon>
                            </Grid>
                        </Border>
                        <!-- 文件夹大图标 -->
                        <m3:M3Icon Kind="folder" Width="40" Height="40" Foreground="{DynamicResource App.Type.Folder}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <m3:M3Icon.Style>
                                <Style TargetType="m3:M3Icon">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </m3:M3Icon.Style>
                        </m3:M3Icon>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Foreground="{DynamicResource OnSurface}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 单选书签：URL 卡片 ===== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SideCard}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLink}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 网址 = 可拖选的展示型文本（唯一实现 Views.SelectableText） -->
                    <views:SelectableText Grid.Column="0" Text="{Binding UrlText, Mode=OneWay}" FontSize="12"
                                          FontFamily="{DynamicResource App.Font.Mono}" TextWrapping="Wrap" VerticalAlignment="Center"
                                          Foreground="{DynamicResource OnSurfaceVariant}"/>
                    <Button Grid.Column="1" Style="{StaticResource NavIconButton}" Tag="复制链接"
                            Width="26" Height="24" Padding="4" Margin="6,0,0,0" VerticalAlignment="Center"
                            Command="{Binding CopyUrlCommand}">
                        <m3:M3Icon Kind="content-copy" Width="13" Height="13"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== 单选：信息卡片（行 = Rows 集合，数据驱动） ===== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SideCard}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSingle}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="信息" Style="{StaticResource SideLabel}"/>
                    <!-- 行模板 = UIKit 共享资源（与详情页同一份视觉，绝不复制） -->
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource InfoRowTemplate}"
                                  FocusVisualStyle="{x:Null}"/>
                </StackPanel>
            </Border>

            <!-- ===== 单选书签：描述卡片（置于信息卡之后） ===== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SideCard}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDescription}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="描述" Style="{StaticResource SideLabel}"/>
                    <!-- 描述 = 可拖选的展示型文本（TextBox 无 LineHeight，行距按字体默认，比原 TextBlock 略紧） -->
                    <views:SelectableText Text="{Binding DescriptionText, Mode=OneWay}" FontSize="12.5"
                                          TextWrapping="Wrap" Foreground="{DynamicResource OnSurface}"/>
                </StackPanel>
            </Border>

            <!-- ===== 单选：快捷操作 =====
                 动作面 = 模型**显式能力位**（ShowOpenAction / ShowOpenWebsite / ShowEditAction / ShowDeleteAction）：
                 各页在共享框架内声明"有哪些动作"（浏览页全开；回收站只开 打开/详情 + 永久删除），
                 界面与命令都复用本控件，绝不另写第二套详情栏 -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SideCard}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSingle}" Value="True"/>
                                    <Condition Binding="{Binding HasActions}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="操作" Style="{StaticResource SideLabel}"/>
                    <!-- 排布一（缺省：浏览页 / 搜索页）= 一行：药丸填满余宽，图标钮靠右 -->
                    <DockPanel Margin="0,2,0,0"
                               Visibility="{Binding StackedActions, Converter={StaticResource InvBoolToVis}}">
                        <ContentControl DockPanel.Dock="Right" Content="{Binding}" FocusVisualStyle="{x:Null}"
                                        ContentTemplate="{StaticResource SidebarActionIcons}"/>
                        <ContentControl Content="{Binding}" FocusVisualStyle="{x:Null}"
                                        ContentTemplate="{StaticResource SidebarActionPills}"/>
                    </DockPanel>
                    <!-- 排布二（回收站右栏）= 两行：药丸一行、图标钮一行靠右 ——
                         286 宽放不下"两枚药丸 + 三枚 32 图标钮"（同排会把药丸压到裁字，用户定稿两行） -->
                    <StackPanel Margin="0,2,0,0"
                                Visibility="{Binding StackedActions, Converter={StaticResource BoolToVis}}">
                        <ContentControl Content="{Binding}" FocusVisualStyle="{x:Null}"
                                        ContentTemplate="{StaticResource SidebarActionPills}"/>
                        <ContentControl Content="{Binding}" HorizontalAlignment="Right" Margin="0,8,0,0"
                                        FocusVisualStyle="{x:Null}"
                                        ContentTemplate="{StaticResource SidebarActionIcons}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== 多选：统计卡片 ===== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SideCard}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMulti}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <m3:M3Icon Kind="content-duplicate" Width="26" Height="26"
                                   Foreground="{DynamicResource Primary}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedTotal}" FontSize="22" FontWeight="SemiBold"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OnSurface}"/>
                        <TextBlock Text="项已选中" FontSize="14" Margin="8,0,0,0" Opacity="0.7" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OnSurfaceVariant}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Style="{StaticResource SideChip}">
                            <TextBlock FontSize="11" Foreground="{DynamicResource OnPrimaryContainer}">
                                <Run Text="{Binding SelectedFolders, Mode=OneWay}"/>
                                <Run Text=" 个文件夹"/>
                            </TextBlock>
                        </Border>
                        <Border Style="{StaticResource SideChip}">
                            <TextBlock FontSize="11" Foreground="{DynamicResource OnPrimaryContainer}">
                                <Run Text="{Binding SelectedLinks, Mode=OneWay}"/>
                                <Run Text=" 个链接"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <!-- 多选态只提供「删除所选」：重命名只对单个条目有意义，多选不出现该按钮 -->
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ctrl+点击 可增减选择" FontSize="11" Opacity="0.45" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OnSurfaceVariant}"/>
                        <Button Grid.Column="1" Style="{StaticResource NavIconButton}"
                                Tag="{Binding DeleteSelectionLabel}"
                                Width="32" Height="32" Margin="6,0,0,0" Command="{Binding DeleteCommand}"
                                Visibility="{Binding ShowDeleteAction, Converter={StaticResource BoolToVis}}">
                            <!-- 与浏览页同一枚按钮/样式；文案按页定制（回收站 = 「永久删除所选」） -->
                            <m3:M3Icon Kind="delete-outline" Width="15" Height="15"
                                       Foreground="{DynamicResource App.Support.OnContainer}"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
