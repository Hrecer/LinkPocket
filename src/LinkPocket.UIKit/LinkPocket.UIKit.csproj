<Project Sdk="Microsoft.NET.Sdk">

  <!-- UIKit：共享控件/样式/转换器/图标/图像服务/定位组件/UI 端口契约。
       依赖只有 Contracts（引擎/内核/数据实现程序集禁引，架构测试强制）。
       UI 支撑类型（LinkItem/SelectionManager/ClipboardManager/FaviconStore）自 A1 起归属本层；
       日志自 S1 起统一走 Contracts 的 LpLog 门面（实现 = LinkPocket.Diagnostics，UI 层零新增依赖）。 -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>LinkPocket.UIKit</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinkPocket.Contracts\LinkPocket.Contracts.csproj" />
    <ProjectReference Include="..\LinkPocket.Theming\LinkPocket.Theming.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Material3.Wpf" />
    <PackageReference Include="MdXaml" />
  </ItemGroup>

</Project>
