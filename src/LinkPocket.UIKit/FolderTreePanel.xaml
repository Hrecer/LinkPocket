<UserControl x:Class="LinkPocket.Views.FolderTreePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
             x:Name="Root">
    <!-- 可复用文件夹树面板（数据驱动，浏览页/回收站共用）：
         - ItemsSource：节点集合（FolderNode / TrashFolderNode，绑定面一致：Name/Children/LinkCount/IsRoot/IsTrashed/IsExpanded/ShowNodeMenu/Host）
         - NodeSelected：节点选中事件（宿主决定是导航还是忽略）
         - NodeDragOver/NodeDrop：拖放转发（宿主订阅才有拖放能力；回收站不订阅 = 只读树）
         - ShowNodeMenu=false 的节点不显示右键菜单（TrashFolderNode 恒 false）。
         样式自包含：FolderTreeStyle/FolderTreeItemStyle/TreeExpanderToggle/CountPill/LpMenuItem 都在本控件资源里。 -->

    <UserControl.Resources>
        <!-- 列表行计数药丸（与主栏行/侧栏统一的 M3E 胶囊） -->
        <Style x:Key="CountPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SecondaryContainer}"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="MinHeight" Value="18"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 紧凑右键菜单模板（与浏览页同规格：行高 26、字号 12、无分割线） -->
        <Style x:Key="LpMenuItem" TargetType="MenuItem">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="3,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceContainerHighest}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}"/>

        <!-- 树节点右键菜单（提为资源以便按节点类型注入：链接叶子 = 不挂菜单） -->
        <ContextMenu x:Key="TreeContextMenu">
            <ContextMenu.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}"/>
            </ContextMenu.Resources>
            <!-- 根节点/回收站节点（ShowNodeMenu=false）不显示菜单项 -->
            <MenuItem Header="重命名" Command="{Binding Host.RenameNodeCommand}" CommandParameter="{Binding}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ShowNodeMenu}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="{Binding DeleteMenuHeader}" Command="{Binding Host.DeleteNodeCommand}" CommandParameter="{Binding}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ShowNodeMenu}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
        </ContextMenu>

        <Style x:Key="FolderTreeStyle" TargetType="TreeView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <!-- 树展开箭头：chevron 放在圆形 hover 药丸里，IsChecked(=IsExpanded) 时旋转 90° 朝下 -->
        <Style x:Key="TreeExpanderToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <m3:M3Icon x:Name="Chevron" Kind="chevron-right" Width="14" Height="14"
                                       Foreground="{DynamicResource OnSurfaceVariant}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <m3:M3Icon.LayoutTransform>
                                    <RotateTransform Angle="0"/>
                                </m3:M3Icon.LayoutTransform>
                            </m3:M3Icon>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="LayoutTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceContainerHighest}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FolderTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <!-- 自绘 TreeViewItem 模板：MD3E 圆形药丸 chevron，展开旋转 90°；无子项占位隐藏，子级缩进 20 -->
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="Expander" Grid.Column="0"
                                              Style="{StaticResource TreeExpanderToggle}"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                <ContentPresenter x:Name="PART_Header" Grid.Column="1"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Left"/>
                            </Grid>
                            <ItemsPresenter x:Name="ItemsHost"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="DragOver" Handler="FolderTreeItem_DragOver"/>
            <EventSetter Event="Drop" Handler="FolderTreeItem_Drop"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceContainerHigh}"
            CornerRadius="0,24,24,0" Margin="0,0,0,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- 标题带固定 32px（与数据表头带等高，底边严格对齐） -->
            <Border Grid.Row="0" Background="{DynamicResource TintPanel}"
                    CornerRadius="0,24,0,0" Height="32" Padding="10,0">
                <TextBlock Text="{Binding HeaderText, ElementName=Root}" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource OnSurfaceVariant}"/>
            </Border>
            <TreeView Grid.Row="1" x:Name="FolderTreeControl"
                      Style="{StaticResource FolderTreeStyle}"
                      ItemContainerStyle="{StaticResource FolderTreeItemStyle}"
                      ItemsSource="{Binding ItemsSource, ElementName=Root}"
                      SelectedItemChanged="FolderTree_SelectedItemChanged"
                      VirtualizingPanel.IsVirtualizing="True">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <!-- 行级交互反馈（用户 2026-09-18 定稿）：整行可点（手型）+ 悬停浅高亮；
                             选中态药丸 SecondaryContainer 圆角容器（MD3E 形状区分选中，优先级高于悬停） -->
                        <Border CornerRadius="8" Padding="6,3" Margin="0,1" Background="Transparent" Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighest}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SecondaryContainer}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="ContextMenu" Value="{StaticResource TreeContextMenu}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLink}" Value="True">
                                                <Setter Property="ContextMenu" Value="{x:Null}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <!-- 图标：文件夹实心琥珀；根节点书签；根级链接 link 图标紫；回收站节点灰化 -->
                                <m3:M3Icon Width="16" Height="16" VerticalAlignment="Center">
                                    <m3:M3Icon.Style>
                                        <Style TargetType="m3:M3Icon">
                                            <Setter Property="Kind" Value="folder"/>
                                            <Setter Property="Foreground" Value="#FFB300"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                                    <Setter Property="Kind" Value="bookmark"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLink}" Value="True">
                                                    <Setter Property="Kind" Value="link-variant"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsTrashed}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
                                                    <Setter Property="Opacity" Value="0.55"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </m3:M3Icon.Style>
                                </m3:M3Icon>
                                <TextBlock Text="{Binding Name}" FontSize="13" Margin="6,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name}"/>
                                <!-- 链接数药丸：链接叶子（根级直挂链接）不显示计数 -->
                                <Border Padding="7,0" MinHeight="16">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CountPill}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLink}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding LinkCount}" FontSize="10.5" FontWeight="Medium"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource OnSecondaryContainer}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>
    </Border>
</UserControl>
