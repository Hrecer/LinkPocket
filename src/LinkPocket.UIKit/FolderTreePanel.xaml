<UserControl x:Class="LinkPocket.Views.FolderTreePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
             xmlns:local="clr-namespace:LinkPocket.Views"
             xmlns:loc="clr-namespace:LinkPocket.I18n;assembly=LinkPocket.I18n"
             x:Name="Root">
    <!-- 可复用文件夹树面板（数据驱动，浏览页/回收站共用）：
         - ItemsSource：节点集合（FolderNode / TrashFolderNode，绑定面一致：Name/Children/LinkCount/IsRoot/IsTrashed/IsExpanded/ShowNodeMenu/Host）
         - NodeSelected：节点选中事件（宿主决定是导航还是忽略）
         - NodeDragOver/NodeDrop：拖放转发（宿主订阅才有拖放能力；回收站不订阅 = 只读树）
         - ShowNodeMenu=false 的节点不显示右键菜单（TrashFolderNode 恒 false）。
         样式自包含：FolderTreeStyle/FolderTreeItemStyle/TreeExpanderToggle/CountPill/LpMenuItem 都在本控件资源里。 -->

    <UserControl.Resources>
        <!-- 列表行计数药丸（与主栏行/侧栏统一的 M3E 胶囊） -->
        <Style x:Key="CountPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource App.Support.Container}"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="MinHeight" Value="18"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 紧凑右键菜单模板（与浏览页同规格：行高 26、字号 12、无分割线） -->
        <Style x:Key="LpMenuItem" TargetType="MenuItem">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="3,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Surface.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}"/>

        <!-- 树节点右键菜单（提为资源以便按节点类型注入：链接叶子 = 不挂菜单） -->
        <ContextMenu x:Key="TreeContextMenu">
            <ContextMenu.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}"/>
            </ContextMenu.Resources>
            <!-- 根节点/回收站节点（ShowNodeMenu=false）不显示菜单项 -->
            <MenuItem Header="{loc:Loc common.rename}" Command="{Binding Host.RenameNodeCommand}" CommandParameter="{Binding}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ShowNodeMenu}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="{Binding DeleteMenuHeader}" Command="{Binding Host.DeleteNodeCommand}" CommandParameter="{Binding}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ShowNodeMenu}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
        </ContextMenu>

        <Style x:Key="FolderTreeStyle" TargetType="TreeView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <!-- 聚焦禁描边（UI-SPEC）：树本体不带原生焦点视觉（默认模板的虚线框） -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="4"/>
            <!-- 层级缩进后深层内容会伸出视口：水平滚动 Auto（Windows 资源管理器语义），垂直滚动 Auto -->
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <!-- 树展开箭头：chevron 放在圆形 hover 药丸里，IsChecked(=IsExpanded) 时旋转 90° 朝下 -->
        <Style x:Key="TreeExpanderToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <m3:M3Icon x:Name="Chevron" Kind="chevron-right" Width="14" Height="14"
                                       Foreground="{DynamicResource App.Text.Secondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <m3:M3Icon.LayoutTransform>
                                    <RotateTransform Angle="0"/>
                                </m3:M3Icon.LayoutTransform>
                            </m3:M3Icon>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="LayoutTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Surface.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FolderTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <!-- 聚焦禁描边（UI-SPEC）：节点容器不带原生焦点视觉。
                 树节点按下即获键盘焦点（拖拽起点必先按中节点）——默认的黑色虚线框会在拖动期间
                 一直挂在节点上（与落点高亮/浮层打架），故显式置空。 -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <!-- 拖放使能由宿主开关决定（DragEnabled；缺省 true = 浏览页；回收站置 false = 只读树）。
                 用相对源向上找面板：TreeViewItem 容器由生成器创建，不依赖名字作用域。 -->
            <Setter Property="AllowDrop" Value="{Binding DragEnabled, RelativeSource={RelativeSource AncestorType=local:FolderTreePanel}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <!-- 自绘 TreeViewItem 模板：行级悬浮卡片（LpRowCard 共享行皮肤，与中间列表行同源，
                         撑满整行宽——悬停高亮不再只包文字块）；chevron 圆形药丸、展开旋转 90°；
                         子级整体缩进一格（20 = chevron 列宽）→ chevron 对齐父文本，Windows 资源管理器式层级 -->
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="RowCard" Padding="8,3" Cursor="Hand"
                                    PreviewMouseLeftButtonDown="FolderTreeItem_PreviewMouseLeftButtonDown"
                                    PreviewMouseRightButtonDown="FolderTreeItem_PreviewMouseRightButtonDown"
                                    MouseMove="FolderTreeItem_MouseMove"
                                    MouseLeftButtonUp="FolderTreeItem_MouseLeftButtonUp">
                                <Border.Style>
                                    <!-- 选中态数据驱动（FolderNode.IsSelected，VM 唯一事实来源）：数据触发器在派生层，
                                         优先级高于基样式悬停 = 选中行悬停不换色（与主栏 RowSkin 同构；容器重建不影响高亮）。
                                         悬停反馈按命中区互斥——「展开 chevron」与「行主体（选中/进入）」是两个按钮，
                                         chevron 在 RowCard 内部，若只挂悬停两者会同色叠成一块"分不清按哪个"；
                                         故指针落在 chevron 上时行药丸必须熄灭（只留 chevron 圆形高亮），
                                         落在行主体上时才亮整行药丸——两块反馈永不同时出现。 -->
                                    <Style TargetType="Border" BasedOn="{StaticResource LpRowCard}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource App.Accent.Container}"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, ElementName=Expander}" Value="True"/>
                                                    <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="Transparent"/>
                                            </MultiDataTrigger>
                                            <!-- 拖拽悬停落点：与主栏行同一套高亮（同键同色），两栏观感一致。
                                                 落点节点不可能是拖动集合成员（宿主已排除），故不会与"选中"同时成立。 -->
                                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource App.Accent.Container}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Grid.Column="0"
                                                  Style="{StaticResource TreeExpanderToggle}"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                    <ContentPresenter x:Name="PART_Header" Grid.Column="1"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <!-- 子级缩进一格：子内容起点恰好落在父内容起点的下一格 -->
                            <ItemsPresenter x:Name="ItemsHost" Margin="20,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <!-- chevron 只服务展开/收起：链接叶子无子级不显示 chevron；
                                 空文件夹保留 hollow chevron（降透明度）= Windows 资源管理器语义（所有文件夹可展开/收起）。
                                 选中/进入由行主体 MouseLeftButtonUp 显式转发，与 chevron 物理分离 -->
                            <DataTrigger Binding="{Binding IsLink}" Value="True">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </DataTrigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Opacity" Value="0.4"/>
                            </Trigger>
                            <!-- 选中高亮已由数据驱动（见上方 RowCard 派生样式 DataTrigger），此处无需容器 IsSelected 触发器 -->
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="DragOver" Handler="FolderTreeItem_DragOver"/>
            <EventSetter Event="DragLeave" Handler="FolderTreeItem_DragLeave"/>
            <EventSetter Event="Drop" Handler="FolderTreeItem_Drop"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource App.Surface.Card}"
            CornerRadius="0,24,24,0" Margin="0,0,0,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- 标题带固定 32px（与数据表头带等高，底边严格对齐） -->
            <Border Grid.Row="0" Background="{DynamicResource App.Surface.Panel}"
                    CornerRadius="0,24,0,0" Height="32" Padding="10,0">
                <TextBlock Text="{Binding HeaderText, ElementName=Root}" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource App.Text.Secondary}"/>
            </Border>
            <!-- 选中/进入不经容器 SelectedItemChanged（键盘/展开都走同一通道 = 耦合）：
                 行主体单击由模板层 RowCard 的 MouseLeftButtonUp 显式转发（FolderTreeItem_MouseLeftButtonUp），
                 chevron 展开由 ToggleButton 自捕获鼠标、绝不触发行选择 —— 展开 ≠ 选中 ≠ 进入 物理分离 -->
            <TreeView Grid.Row="1" x:Name="FolderTreeControl"
                      Style="{StaticResource FolderTreeStyle}"
                      ItemContainerStyle="{StaticResource FolderTreeItemStyle}"
                      ItemsSource="{Binding ItemsSource, ElementName=Root}"
                      PreviewMouseLeftButtonDown="FolderTree_PreviewMouseLeftButtonDown"
                      MouseLeftButtonUp="FolderTree_MouseLeftButtonUp"
                      VirtualizingPanel.IsVirtualizing="True">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <!-- 行皮肤（悬停 SurfaceContainerHighest / 选中 PrimaryContainer / 圆角 12 / 整行手型）
                             由 FolderTreeItemStyle 模板层的 LpRowCard 统一提供；
                             DataTemplate 只负责行内容：图标 / 名称 / 计数药丸 / 右键菜单。 -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <!-- 节点右键菜单 = 控件级插槽（NodeMenu DP；缺省 = 本控件内置的浏览页菜单）。
                                         回收站传自己的菜单（打开/永久删除）；链接叶子一律无菜单（IsLink 触发器置空）。 -->
                                    <Setter Property="ContextMenu" Value="{Binding NodeMenu, ElementName=Root}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLink}" Value="True">
                                            <Setter Property="ContextMenu" Value="{x:Null}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                                <!-- 图标：文件夹实心琥珀；根节点书签；根级链接 link 图标紫；回收站节点灰化 -->
                                <m3:M3Icon Width="16" Height="16" VerticalAlignment="Center">
                                    <m3:M3Icon.Style>
                                        <Style TargetType="m3:M3Icon">
                                            <Setter Property="Kind" Value="folder"/>
                                            <Setter Property="Foreground" Value="{DynamicResource App.Type.Folder}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                                    <Setter Property="Kind" Value="bookmark"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource App.Accent.Icon}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLink}" Value="True">
                                                    <Setter Property="Kind" Value="link-variant"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource App.Accent.Icon}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsTrashed}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource App.Text.Secondary}"/>
                                                    <Setter Property="Opacity" Value="0.55"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </m3:M3Icon.Style>
                                </m3:M3Icon>
                                <Grid Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="NodeName" Text="{loc:Segment Name}" FontSize="13"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{loc:Segment Name}"/>
                                    <!-- 就地改名编辑框（Windows 口径）：覆盖在名称之上（不透明填充底），
                                         宽度跟随名称实测宽（至少 120）；高度按树行内容高覆盖
                                         （树文本 13 号 → 行内容约 17，负 margin 压掉外框 → 进入编辑不改变行高）；
                                         数据驱动（IsRenaming 投影）+ 自持 Enter/Esc/失焦 -->
                                    <local:InlineNameEditor MinWidth="120" HorizontalAlignment="Left"
                                                            Width="{Binding ActualWidth, ElementName=NodeName}"
                                                            Height="17" Margin="0,-2"
                                                            IsEditing="{Binding IsRenaming}"
                                                            Text="{Binding Host.EditingName, Mode=TwoWay}"
                                                            CommitCommand="{Binding Host.CommitRenameCommand}"
                                                            CancelCommand="{Binding Host.CancelRenameCommand}"/>
                                </Grid>
                                <!-- 链接数药丸：链接叶子（根级直挂链接）不显示计数 -->
                                <Border Padding="7,0" MinHeight="16">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CountPill}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLink}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding LinkCount}" FontSize="10.5" FontWeight="Medium"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource App.Text.OnContainer}"/>
                                </Border>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>
    </Border>
</UserControl>
