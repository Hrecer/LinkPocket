<UserControl x:Class="LinkPocket.Views.NoticeBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Focusable="False"
             IsHitTestVisible="False"
             Unloaded="NoticeBar_Unloaded"
             d:DesignHeight="120" d:DesignWidth="400">

    <!-- 全站共用的 Toast（轻提示）栈：底部居中、每次调用新增一条、各自自动消失。
         · **样式来源**：照搬抹茶泡芙 desktop/src/components/ui/toast.ts 的 toast 规格——
           底部 24px、条间距 8px、全圆角药丸、6px 主色圆点、13px 中等字重、内距 14,8、
           浮层底 + 细边框 + 大阴影；停留 1.8 秒后 200ms 淡出。
         · **药丸**：圆角由 HalfCornerRadiusConverter 按实际高度取一半，内容变高也保持胶囊形。
         · **堆叠**：不合并同文；每调一次 Show 就新增一条，旧条目向上让位、各自计时；
           最多保留 3 条，超出时淘汰最旧的一条。
         · **不挡操作**：IsHitTestVisible=False（纯提示，不吃点击/拖拽）。 -->

    <ItemsControl x:Name="ItemsHost"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  Margin="32,0,32,24"
                  Focusable="False">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border x:Name="Card"
                        Background="{DynamicResource App.Surface.Floating}"
                        BorderBrush="{DynamicResource App.Line.Outline}"
                        BorderThickness="1"
                        CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource HalfRadius}}"
                        Padding="14,8"
                        Margin="0,8,0,0"
                        MaxWidth="620"
                        HorizontalAlignment="Center"
                        Loaded="Card_Loaded"
                        Unloaded="Card_Unloaded">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.18"
                                          Color="{DynamicResource App.Color.Shadow}"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                 Fill="{DynamicResource App.Accent.Fill}"/>
                        <TextBlock Text="{Binding Text}"
                                   Margin="8,0,0,0"
                                   MaxWidth="560"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource App.Text.Primary}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
