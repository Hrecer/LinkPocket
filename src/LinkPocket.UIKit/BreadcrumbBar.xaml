<UserControl x:Class="LinkPocket.Views.BreadcrumbBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LinkPocket.Views"
             xmlns:loc="clr-namespace:LinkPocket.I18n;assembly=LinkPocket.I18n"
             x:Name="Root">
    <!-- 可复用面包屑地址栏（数据驱动，浏览页/回收站共用）：
         - 浏览页：Breadcrumbs = 路径段集合；CrumbClickCommand 点段导航；编辑态（IsPathEditing）= 
           路径输入框 + 候选 Popup（键盘上下选候选经 CandidateMoveRequested 转发宿主 VM）。
         - 回收站：只塞一个「回收站」段，IsPathEditing 恒 false → 纯展示。
         ⚠️ 胶囊基态值必须写在 Style.Setters（本地值优先级高于样式触发器）。 -->

    <UserControl.Resources>
        <!-- 路径编辑框：Windows 11 口径——**胶囊自己就是输入框**（胶囊 DataTrigger 出 Primary 描边），
             文本直接躺在胶囊里：编辑框背景透明、无边框，不内嵌第二个"白框"。高度 32 与面包屑按钮一致。 -->
        <Style x:Key="PathEditField" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource App.Accent.Fill}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource App.Accent.Fill}"/>
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="EditRoot" CornerRadius="16" Background="Transparent"
                                BorderThickness="0" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 路径无效：仅文字区出 2px Error 下划（胶囊描边仍归胶囊的 DataTrigger 管） -->
                            <DataTrigger Binding="{Binding IsPathInvalid, ElementName=Root}" Value="True">
                                <Setter TargetName="EditRoot" Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter TargetName="EditRoot" Property="BorderBrush" Value="{DynamicResource App.Line.Invalid}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPathEditing, ElementName=Root}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- 胶囊外壳：44 高恒定，编辑态只做颜色/描边形变，圆角保持 22（44 的全圆）。
         点空白 = 请求进入路径编辑（Windows 11 口径：无需任何按钮；段点击被 Button 吃掉不会到这）。
         ⚠️ 本地值优先级高于样式触发器 —— 基态值必须写在 Style.Setters。
         ⚠️ **44 这个数是算出来的，不是随手取的**：壳体内容高度 = 44 − 描边 2×2 − 内距 2×4 = 32，
         正好等于段药丸声明的高度（32）。曾用 40：内容区只有 40 − 4 − 8 = 28 < 32 ⇒
         整颗药丸被布局压成 28 高（圆角 14 的胶囊被压扁，悬停底看着"底下被切掉一条"）。
         改这个数之前先跑「仅 i18nvisual 套件」（它逐段量"药丸实得高度 == 声明高度"）。 -->
    <Border x:Name="CapsuleShell" Height="44" BorderThickness="2" VerticalAlignment="Center"
            local:BlankClick.IsInteractive="True"
            MouseLeftButtonDown="CrumbHost_MouseLeftButtonDown">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="CornerRadius" Value="22"/>
                <Setter Property="Background" Value="{DynamicResource App.Surface.Card}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPathEditing, ElementName=Root}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource App.Surface.Hover}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource App.Accent.Fill}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid VerticalAlignment="Center">
            <!-- 面包屑行（Windows 11 口径的溢出折叠）：空间不足时**从左折叠**进 « 按钮、
                 当前段（最右）永远可见；窗口拉宽自动还原。« 点击列出被折叠的祖先层级。
                 ⚠️ ItemsSource 由 code-behind 维护（_visible 投影），折叠算法见 RelayoutCrumbs。 -->
            <DockPanel x:Name="CrumbRow" VerticalAlignment="Center" LastChildFill="True">
                <Button x:Name="OverflowButton" DockPanel.Dock="Left" Visibility="Collapsed"
                        Command="{Binding CrumbClickCommand, ElementName=Root}" FontSize="13"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Padding="8,0" MinHeight="32" Height="32" Click="OverflowButton_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TextButton}">
                            <Setter Property="Foreground" Value="{DynamicResource App.Text.Secondary}"/>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="«" FontSize="14"/>
                </Button>
                <ItemsControl x:Name="CrumbItems" VerticalAlignment="Center">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPathEditing, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding CrumbClickCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0"
                                        FontSize="13" Cursor="Hand"
                                        AllowDrop="{Binding CrumbDropEnabled, ElementName=Root}"
                                        DragOver="Crumb_DragOver" DragLeave="Crumb_DragLeave" Drop="Crumb_Drop">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TextButton}">
                                            <Setter Property="Foreground" Value="{DynamicResource App.Text.Secondary}"/>
                                            <Setter Property="Padding" Value="12,0"/>
                                            <Setter Property="MinHeight" Value="32"/>
                                            <Setter Property="Height" Value="32"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource App.Accent.Container}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource App.Text.OnContainer}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <!-- 根段（`@root`/`@trash`）的宽度 = **冻结几何**（页面给的 RootSegmentWidth，定稿口径
                                                     = 中文基线）。根名随语言换（全部书签 ⇄ Bookmarks）⇒ 不定宽就会把地址栏撑宽、
                                                     把后面的段整排推走（实测 80→97.18）。
                                                     ⚠️ 模式是 `Shrink`（**只缩字号、绝不截断**）：实测 `ShrinkThenEllipsis` 在这枚
                                                     80px 的壳里把 Bookmarks 画成了 `Bookma…` —— 截断的路径名是**错的名字**
                                                     （与"截断的日期是错的日期"同一条产品判断）。 -->
                                                <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                                    <Setter Property="Width" Value="{Binding RootSegmentWidth, ElementName=Root}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock>
                                        <!-- 根段走自适应通道（宽度已冻结 ⇒ 字号是唯一让位的维度）；用户段原样画、绝不缩字号。 -->
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{loc:Segment Name}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                                        <Setter Property="Text"
                                                                Value="{Binding Path=(local:LocFit.Chosen), RelativeSource={RelativeSource Self}}"/>
                                                        <Setter Property="local:LocFit.Text" Value="{loc:Segment Name}"/>
                                                        <Setter Property="local:LocFit.Mode" Value="Shrink"/>
                                                        <!-- ⚠️ `MaxWidth`（不是 `Width`）是**这条通道能不能工作**的前提：
                                                             文字若按内容取宽，`LocFit` 读到的"可用宽"就是它自己需要的宽，
                                                             于是永远判定"放得下"、字号一个都不缩，最后由壳把文字**裁掉**
                                                             （实测屏幕上是 `Bookma`；探针读数 `[Bookmarks] 想占 97.7px、壳只有 80px`）。
                                                             ⚠️ 取的是**本段按钮的内容宽**（`RootSegmentWidth − 段内距 24`），不是写死的 56：
                                                             浏览页根段 80、回收站 67，写死 56 会让回收站那侧（内容宽只有 43）
                                                             把 `Trash` 的第一个字母裁掉（实测英文界面画出 `rash`）。
                                                             用 `MaxWidth` 而不是 `Width`：不写死数字，段宽改了一处就够。 -->
                                                        <Setter Property="MaxWidth"
                                                                Value="{Binding Width, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource ShellContentWidth}, ConverterParameter=24}"/>
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <TextBlock Text="›" VerticalAlignment="Center" Foreground="{DynamicResource App.Text.Muted}" Margin="2,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- « 折叠段清单：点 « 弹出被折叠的祖先层级，点击经 CrumbClickCommand 直达 -->
            <Popup x:Name="OverflowPopup" PlacementTarget="{Binding ElementName=OverflowButton}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                <Border Background="{DynamicResource App.Surface.Card}"
                        BorderBrush="{DynamicResource App.Line.Variant}" BorderThickness="1"
                        CornerRadius="12" MaxHeight="260" MinWidth="140" Padding="0,4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.18" Color="{DynamicResource App.Color.Shadow}"/>
                    </Border.Effect>
                    <ListBox x:Name="OverflowList" Focusable="False" BorderThickness="0" Background="Transparent"
                             ItemsSource="{Binding FoldedCrumbs, ElementName=Root}"
                             PreviewMouseLeftButtonUp="OverflowList_PreviewMouseLeftButtonUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{loc:Segment Name}" FontSize="13" Height="28" Margin="12,0"
                                           VerticalAlignment="Center" Cursor="Hand"
                                           Foreground="{DynamicResource App.Text.Primary}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>

            <!-- 路径编辑态：输入框 + 同级候选 Popup -->
            <TextBox x:Name="PathEditBox" Style="{StaticResource PathEditField}"
                     Text="{Binding PathEditText, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center" HorizontalAlignment="Stretch"
                     PreviewKeyDown="PathEditBox_PreviewKeyDown"
                     LostFocus="PathEditBox_LostFocus">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ConfirmPathCommand, ElementName=Root}"/>
                    <KeyBinding Key="Escape" Command="{Binding CancelPathCommand, ElementName=Root}"/>
                    <KeyBinding Key="Tab" Command="{Binding CompletePathCommand, ElementName=Root}"/>
                </TextBox.InputBindings>
            </TextBox>

            <Popup IsOpen="{Binding HasPathCandidates, ElementName=Root, Mode=OneWay}"
                   PlacementTarget="{Binding ElementName=PathEditBox}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                   Closed="PathCandidatesPopup_Closed">
                <Border Background="{DynamicResource App.Surface.Card}"
                        BorderBrush="{DynamicResource App.Line.Variant}" BorderThickness="1"
                        CornerRadius="12" MaxHeight="220" MinWidth="180" Padding="0,4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.18" Color="{DynamicResource App.Color.Shadow}"/>
                    </Border.Effect>
                    <ListBox x:Name="PathCandidatesList" Focusable="False"
                             ItemsSource="{Binding PathCandidates, ElementName=Root}"
                             SelectedIndex="{Binding SelectedCandidateIndex, ElementName=Root, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent"
                             PreviewMouseLeftButtonUp="PathCandidatesList_PreviewMouseLeftButtonUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" Height="26" Margin="12,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.Text.Primary}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
