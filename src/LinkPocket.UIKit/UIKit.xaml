<ResourceDictionary x:Class="LinkPocket.UiKit"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:LinkPocket.Views"
                    xmlns:browserviews="clr-namespace:LinkPocket.Views.Browser"
                    xmlns:vm="clr-namespace:LinkPocket.ViewModels"
                    xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf">

    <!--
    ============================================================
    UIKit：全应用共享的控件/样式/转换器/色板唯一来源。
    原则：
    · 色板与画刷先行（AppFont/各 Tint/状态色），后定义的样式可 StaticResource 前面的键；
    · 页面专属样式（PathEditField/PageTextField/SegmentToggle/SideIconButton 等）仍留在
      各页资源里，随页面迁往各自 UI.* 项目——本文件只收「两个及以上页面共用」的键；
    · 已知例外：CardField 在 BackupPanel（只读域）与 ToolsPage（可输入域）定义不同，
      属同名不同义，不在此合并，不再合并。
    ============================================================
    -->

    <!-- 字体族不在这里定义 —— 与颜色键同理：值由 LinkPocket.Theming 派生、经 ThemeService 发布
         （`App.Font.Ui` = 回退链「主族, Microsoft YaHei UI, Segoe UI」，见 FontLoader.BuildTokenValue）。
         界面一律 `{DynamicResource App.Font.Ui}` —— **必须动态**：`StaticResource` 在解析时就固化值，
         运行时换字体会毫无反应（换字体的物理前提，方案 §6.1）。 -->

    <!-- 紫色调层（MD3E 色彩即层级的本地化实现）：比中性 Surface 角色带 Accent 染色的分层画刷。
         **值不在这里定义** —— 主题拥有全站每一个颜色键：值由 LinkPocket.Theming 派生，
         经 ThemeService 在 App.OnStartup 里发布（键名 = `App.Surface.*` / `App.Accent.Fill` 等）。
         历史上这里是 6 个写死的 SolidColorBrush（#FAF8FD / #F5F1FB / #E4DCF3 / #EAE4ED / #A18EB0 / #F5E9B8），
         换主题纹丝不动 —— 那是"半主题化"的根因，已清零。 -->

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource App.Font.Ui}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource App.Font.Ui}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource App.Font.Ui}"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource App.Accent.Fill}"/>
    </Style>

    <!-- ===== 可拖选的展示型文本（全站唯一实现，Views.SelectableText）=====
         只读 TextBox 的外观 = 纯文本：透明底 / 无边框 / 无内距 / 无焦点视觉 / 隐藏插入符 / 可换行 /
         失焦仍保留选区高亮；选区高亮 = Primary 25%（与选中行同一色相）。
         用法：<views:SelectableText Text="{Binding X, Mode=OneWay}"/>；要改视觉用 BasedOn 派生样式或局部属性。
         ⚠️ 主栏 / 结果表格的行不用它（行要保持整行选中与拖拽手势，文本拖选会冲突）。 -->
    <Style x:Key="SelectableTextStyle" TargetType="{x:Type views:SelectableText}">
        <Setter Property="FontFamily" Value="{DynamicResource App.Font.Ui}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="IBeam"/>
        <Setter Property="CaretBrush" Value="Transparent"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource App.Accent.Fill}"/>
        <Setter Property="SelectionOpacity" Value="0.25"/>
        <Setter Property="IsInactiveSelectionHighlightEnabled" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AllowDrop" Value="False"/>
    </Style>
    <!-- 隐式样式 = 上面那份（控件处不写 Style 也成立） -->
    <Style TargetType="{x:Type views:SelectableText}" BasedOn="{StaticResource SelectableTextStyle}"/>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource App.Font.Ui}"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}"/>
    </Style>

    <!-- 列宽拖拽手柄（共享样式：浏览页主栏与 SortableDataTable 共用同一份）：
         贴列右缘，hover/拖动显示 2px Primary 竖线 -->
    <Style x:Key="ColumnResizeThumb" TargetType="Thumb">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Margin" Value="0,0,-4,0"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" Padding="2,0">
                        <Border x:Name="Line" Width="2" Background="Transparent" CornerRadius="1"
                                HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Line" Property="Background" Value="{DynamicResource App.Accent.Fill}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Line" Property="Background" Value="{DynamicResource App.Accent.Fill}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 排序表头按钮（可复用组件）：数据驱动 —— Label/Field/Direction 三属性。
         Direction 三态：null=未激活（无指示器）、True=升序▲、False=降序▼。 -->
    <Style TargetType="views:SortableHeaderButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Text.Secondary}"/>
        <!-- ⚠️ 文字在药丸内水平+垂直居中（用户要求）；药丸两侧由使用方留对称空隙，
             分隔线（列边界）恰好落在两个药丸的正中心 -->
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="views:SortableHeaderButton">
                    <!-- 悬停药丸 = Primary 12% 叠加（随旧 TextButton 的 state layer 语义：在 TintPanel 上变深）；
                         MinHeight 24 + 表头带上下 4 = 32px，与侧栏「文件夹」标题带等高 -->
                    <Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="12"
                            MinHeight="24" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter VerticalAlignment="Center"/>
                            <TextBlock x:Name="Indicator" FontSize="10" Margin="4,0,0,0"
                                       Foreground="{DynamicResource App.Accent.Text}" Visibility="Collapsed"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <!-- 表头悬停底：原先写死的是**外来色板** #1F6750A4（M3 官方基线紫 12%），
                                 与我们的定稿强调色不是同一支紫 → 换令牌（跟主题走）。 -->
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource App.State.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="Direction" Value="True">
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Indicator" Property="Text" Value="▲"/>
                        </Trigger>
                        <Trigger Property="Direction" Value="False">
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Indicator" Property="Text" Value="▼"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TonalButton：MD3 色调按钮（SecondaryContainer 底 + OnSecondaryContainer 文）。
         浏览页命令栏浮动胶囊组内使用。注意：模板用 TemplateBinding Padding，
         不落入库 TextButton「Padding 硬编码 14,0」的裁切坑。
         ⚠️ 状态层必须铺满整颗药丸（MD3 规范做法：底色 / 全幅状态层 / 内容 三层 Grid）——
         之前状态层放在带 Padding 的 Border 里只盖住文字区，悬停会出现"只有一小块变灰"的怪相。 -->
    <Style x:Key="TonalButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource App.Font.Ui}"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Text.OnContainer}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <!-- MinHeight 兜底（同上）：药丸不会被垂直 Padding=0 压扁 -->
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{DynamicResource App.Support.Container}"
                                CornerRadius="16"/>
                        <Border x:Name="StateLayer" Background="{DynamicResource App.Support.Container}"
                                Opacity="0" CornerRadius="16"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="0.08"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="0.12"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PrimaryPillButton：主操作按钮 = 药丸（与 TonalButton 同形状，仅颜色不同：AccentBtn #A18EB0 底白字 vs
         SecondaryContainer 底紫字）。不使用库 FilledButton：它自带 MinHeight=40，成对排放会不等高。
         三层结构与 TonalButton 相同：底色 / 全幅状态层 / 内容（状态层必须铺满，不许只盖文字区）。 -->
    <Style x:Key="PrimaryPillButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource App.Font.Ui}"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Text.OnAccent}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <!-- MinHeight 兜底（同上）：主操作药丸不会被垂直 Padding=0 压扁 -->
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{DynamicResource App.Accent.Fill}"
                                CornerRadius="16"/>
                        <Border x:Name="StateLayer" Background="{DynamicResource App.Text.OnAccent}"
                                Opacity="0" CornerRadius="16"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="0.08"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="0.12"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- JumpPillButton：「跳转」药丸（**三页共用一份**：搜索工具行 / 智能列表结果页头 / 查重明细 URL 组）。
         「跳转」= 进浏览页对应目录并选中该行（IContentLocator，与"外部打开"无关）→
         图标用 map-marker（地图图钉 = "它在哪"；早先试过 open-in-new = "外部打开"语义、
         folder-open-outline = 观感差，用户 2026-09-20 定稿地图图钉）。
         ⚠️ 按压态只加深状态层，**绝不改变圆角/尺寸**：原局部样式在 IsPressed 里把圆角 16→10 做"形变"，
         用户令 2026-09-20 明确要求删除该效果（"我们不需要这个改变"）。
         禁用态 = SurfaceContainerHighest + OnSurfaceMuted（MD3 规范禁用色，不用透明度 hack）。 -->
    <Style x:Key="JumpPillButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource App.Accent.Fill}"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Text.OnAccent}"/>
        <Setter Property="FontFamily" Value="{DynamicResource App.Font.Ui}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="15,0"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="StateLayer" Background="{DynamicResource App.Text.OnAccent}"
                                    Opacity="0" CornerRadius="16"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="0.08"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="0.12"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Surface.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource App.Text.Muted}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 侧栏导航列表（可复用组件，工具页/设置页左栏共用）=====
         SideNavList = ListBox 子类，选中高亮是垫在项下的滑动指示器（PrimaryContainer 药丸），
         切换时 240ms CubicEase 滑到选中项实测几何；悬停零底色反馈（滑动方案下色块像阴影）。
         项样式 SideNavItemStyle：无选中/悬停底色，仅选中字色加深 + 加粗。 -->
    <Style x:Key="SideNavListStyle" TargetType="{x:Type views:SideNavList}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:SideNavList}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <!-- 滑动指示器：垫在项下面（先声明 = z 序在下），几何由 SideNavList 代码按选中项实测贴齐 -->
                            <Border x:Name="PART_Indicator" Background="{DynamicResource App.Accent.Container}"
                                    CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    IsHitTestVisible="False" Visibility="Collapsed">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="PART_IndicatorTf"/>
                                </Border.RenderTransform>
                            </Border>
                            <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SideNavItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="8,1"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Text.Secondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="12" Background="Transparent"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 顶部导航药丸条（可复用组件，Shell 标题栏导航）=====
         SlidingNavStrip = ListBox 子类（水平）：胶囊容器 + 滑动指示器（PrimaryContainer 药丸，
         300ms BackEase 弹簧滑到选中项实测几何）。几何/动画全在组件内部，Shell 只做 XAML 装配。
         项样式 SlidingNavStripItemStyle：无选中/悬停底色，仅选中字色加深 + 加粗（与左栏 SideNav 同语言）。 -->
    <Style x:Key="SlidingNavStripStyle" TargetType="{x:Type views:SlidingNavStrip}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <!-- 导航条不参与键盘导航（结构性，不靠关掉项的可聚焦性——那会让点击选中整条链路短路，见项样式注释）：
             Tab 进不来（None）、进条后方向键也不改选中（选中只由「点击」与 VM 的 SelectedNavItem 驱动）。 -->
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="None"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:SlidingNavStrip}">
                    <!-- 胶囊容器 = 分段导航的既有语言（SurfaceContainerHighest 面 + 内距 3 + 圆角 17） -->
                    <Border Background="{DynamicResource App.Surface.Hover}" CornerRadius="17"
                            Padding="3" SnapsToDevicePixels="True">
                        <Grid>
                            <!-- 滑动指示器：垫在项下面（先声明 = z 序在下），几何由组件代码按选中项实测贴齐 -->
                            <Border x:Name="PART_Indicator" Background="{DynamicResource App.Accent.Container}"
                                    CornerRadius="14" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Width="0" IsHitTestVisible="False" Visibility="Collapsed">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="PART_IndicatorTf"/>
                                </Border.RenderTransform>
                            </Border>
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SlidingNavStripItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- ⚠️ 必须可聚焦：WPF 的点击选中链路是 `ListBoxItem.HandleMouseButtonDown`：
             `if (Selector.UiGetIsSelectable(this) && Focus()) parent.NotifyListItemClicked(...)`
             —— `Focusable="False"` 会让 Focus() 静默返回 false，点击**整条链路短路**（不选中、不换页、
             指示器也不动）。「不参与键盘导航」的原意改由控件侧的结构性开关承担（见 SlidingNavStripStyle 的
             KeyboardNavigation.TabNavigation/DirectionalNavigation = None），绝不靠关掉可聚焦性。见 WARNINGS 59。 -->
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Text.Secondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="14" Background="Transparent"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource App.Text.OnContainer}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToolTip：自绘 M3 模板。默认模板自带 SystemDropShadowChrome 投影，
         与右键菜单（无阴影、纯圆角色块）的视觉语言冲突 → 统一改为圆角无阴影色块。 -->
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource App.Surface.Card}"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="{DynamicResource App.Font.Ui}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 多页共用的转换器与控件样式（自各页资源去重上收） ===== -->

    <!-- 布尔可见性转换（浏览页/详情栏/编辑页/智能列表/回收站共用同一键名） -->
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <vm:InvertedBoolToVisibilityConverter x:Key="InvBoolToVis"/>
    <vm:HalfCornerRadiusConverter x:Key="HalfRadius"/>
    <!-- 药丸色调 → 药丸样式 / 图标强调色（唯一映射点；样式仍只在 UIKit 定义一份） -->
    <vm:PillToneToStyleConverter x:Key="PillToneStyle"/>
    <vm:PillToneToBrushConverter x:Key="PillToneBrush"/>
    <!-- 运行时颜色 → 画刷（「外观」面板的身份色圆点 / 派生示意条 / 色槽色块共用）：
         这些是运行时才知道的值，不是资源键，故不能走 DynamicResource，只能绑定 + 转换。 -->
    <vm:ColorToBrushConverter x:Key="ColorToBrush"/>

    <!-- 滚动条沟槽边距换算（链接详情页/编辑页共用） -->
    <browserviews:ScrollGutterMarginConverter x:Key="ScrollGutterMargin"/>

    <!-- 计数药丸（浏览页面包屑 / 文件夹树节点共用） -->
    <Style x:Key="CountPill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.Support.Container}"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="MinHeight" Value="18"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 纯图标按钮（浏览页导航 / 详情栏动作共用）：自带 ControlTemplate，绝对不能 BasedOn TextButton。
         Material3 的 TextButton 模板把 Padding 硬编码成 Padding="14,0"（不响应 Button.Padding，
         也不受本样式 Padding=4 影响），Width=34 的按钮内容区被压到 34-28=6，
         再被布局裁切 → 后退/前进箭头左右两端被切掉。
         这里用 TemplateBinding Padding，内容区 = 34-2*4 = 26 ≥ 图标 20，图标完整显示。
         同时避免继承 TextButton 的 MinHeight=40，Height 才真正等于 32。 -->
    <Style x:Key="NavIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Accent.Icon}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ToolTip" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
        <Setter Property="ToolTipService.Placement" Value="Top"/>
        <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="16" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- hover / pressed 状态层：沿用 TextButton 的 Primary 叠加（8% / 12%） -->
                            <Border x:Name="StateLayer" Background="{DynamicResource App.Accent.Fill}"
                                    Opacity="0" CornerRadius="16" Margin="-4"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="0.08"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="0.12"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource App.Text.Muted}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 行级悬浮卡片（共享行皮肤）：浏览页列表行与文件夹树行的"悬停高亮"唯一来源。
         几何（圆角 12 + 上下 1 外距 + 透明底）与悬停底色（SurfaceContainerHighest）在此定义；
         各方 BasedOn 后只挂自己的选中态（PrimaryContainer）——派生层触发器优先于基样式悬停，
         保证"选中行悬停不换色"在两处语义一致（历史坑：两处各自手写悬停，行为/视觉漂移；
         文件夹树行曾只高亮文字块，未撑满整行）。 -->
    <Style x:Key="LpRowCard" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Surface.Hover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 紧凑右键菜单模板（浏览页 / 文件夹树同规格：行高 26、字号 12、无分割线） -->
    <Style x:Key="LpMenuItem" TargetType="MenuItem">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="3,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Surface.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- M3 菜单不用分组分割线：右键菜单里的 <Separator/> 已全部移除。
         这条样式留着是为了万一以后有人加回分割线时不至于退回库默认的粗线。 -->
    <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}"/>
    <Style TargetType="Separator">
        <Setter Property="Margin" Value="8,3"/>
        <Setter Property="Background" Value="{DynamicResource App.Line.Variant}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="{TemplateBinding Margin}"
                            Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ===== 小图标按钮（详情页 URL 卡 / 操作卡用；28×26 比导航版小一档） ===== -->
    <Style x:Key="SideIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource App.Accent.Icon}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ToolTip" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="13"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Border x:Name="StateLayer" Background="{DynamicResource App.Accent.Fill}" Opacity="0"
                                    CornerRadius="13" Margin="-4"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="0.08"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="0.12"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 详情行模板（侧栏信息卡 / 详情页信息卡**共用同一份视觉**，绝不复制） =====
         DataType = ViewModels.DetailSidebarRow：图标 / 标签 / 值 三列严格对齐（16/62/*）+ 可选复制按钮；
         强调（IsAccent）与等宽（IsMono）由行配置驱动。 -->
    <DataTemplate x:Key="InfoRowTemplate" DataType="{x:Type vm:DetailSidebarRow}">
        <Grid Margin="0,2,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="62"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <m3:M3Icon Kind="{Binding IconKind}" Width="13" Height="13" Opacity="0.55"
                       Foreground="{DynamicResource App.Text.Secondary}" VerticalAlignment="Top"/>
            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" Opacity="0.6"
                       Foreground="{DynamicResource App.Text.Secondary}" VerticalAlignment="Top"/>
            <!-- 值 = 可鼠标拖选的展示型文本（唯一实现 Views.SelectableText）；
                 ⚠️ 基态视觉值必须写在 Style.Setters：本地值优先级高于触发器 -->
            <views:SelectableText Grid.Column="2" Text="{Binding Value, Mode=OneWay}" VerticalAlignment="Top">
                <views:SelectableText.Style>
                    <Style TargetType="{x:Type views:SelectableText}" BasedOn="{StaticResource SelectableTextStyle}">
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}"/>
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAccent}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource App.Accent.Icon}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMono}" Value="True">
                                <Setter Property="FontFamily" Value="{DynamicResource App.Font.Mono}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Opacity" Value="0.6"/>
                                <!-- ⚠️ TextBox 没有 TextTrimming（整行不换行，靠观感与 ID 长度兜住） -->
                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                <Setter Property="Foreground" Value="{DynamicResource App.Text.Secondary}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:SelectableText.Style>
            </views:SelectableText>
            <Button Grid.Column="3" Style="{StaticResource NavIconButton}" Tag="{Binding CopyToolTip}"
                    Width="24" Height="22" Padding="3" Margin="4,0,0,0" VerticalAlignment="Center"
                    Command="{Binding CopyCommand}"
                    Visibility="{Binding HasCopy, Converter={StaticResource BoolToVis}}">
                <m3:M3Icon Kind="content-copy" Width="12" Height="12"/>
            </Button>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
