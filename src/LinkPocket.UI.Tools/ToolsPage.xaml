<UserControl x:Class="LinkPocket.Views.ToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
             xmlns:views="clr-namespace:LinkPocket.Views;assembly=LinkPocket.UIKit"
             Focusable="True" FocusVisualStyle="{x:Null}"
             Loaded="ToolsPage_Loaded">
    <!-- 工具页（v2 完全重写）：与搜索/回收站/智能列表同构的 MD3E 语言。
         结构 = 双面板：主面板（左栏工具列表 + 右主区表格/表单）/ 重复组明细面板（整页）。
         数据表一律复用共享 SortableDataTable；「跳转」一律走 Services 层 IContentLocator 组件
         （本页不直连任何界面方法，跳转语义 = 进入目标目录并选中该行）。 -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 左栏工具项样式已抽为 App.xaml 的 SideNavItemStyle（SideNavList 可复用组件配套，与设置页左栏共用） -->

        <!-- 圆形返回钮：与详情页/智能列表结果页同款（40px 圆、TintCard 底、Primary 状态层） -->
        <Style x:Key="RoundBackButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource App.Surface.TintCard}" CornerRadius="20">
                            <Grid>
                                <Border x:Name="StateLayer" Background="{DynamicResource App.Accent.Fill}"
                                        Opacity="0" CornerRadius="20"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.12"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.16"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入域：M3 形态（圆角 16 填充域，聚焦不加描边——只做底色形变；控件自包含，不依赖别页资源） -->
        <Style x:Key="PillTextField" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource App.Accent.Fill}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="16"
                                Background="{DynamicResource App.Surface.Card}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Surface.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入域（卡片内变体）：卡片底 = SurfaceContainerHigh，域底必须更深一档才看得见。
             Tag 兼作占位提示（空文本时才显示），聚焦只做底色形变（项目规范：聚焦不加描边）。 -->
        <Style x:Key="CardField" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource App.Accent.Fill}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="16"
                                Background="{DynamicResource App.Surface.Hover}">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                                <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}"
                                           Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.Text.Secondary}" Opacity="0.7"
                                           IsHitTestVisible="False" Visibility="Collapsed"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Surface.Panel}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 小图标按钮（行内操作用：跳转/复制） -->
        <Style x:Key="RowIconButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource App.Accent.Icon}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <Grid>
                                <Border x:Name="StateLayer" Background="{DynamicResource App.Accent.Fill}"
                                        Opacity="0" CornerRadius="8"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.10"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.16"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 分段切换（MD3 segmented）：书签工具「导入 / 导出」方向切换。
             圆角口径与浏览页命令栏药丸完全一致：高 32 + CornerRadius 16（正圆端头）。
             选中底色不画在按钮上 —— 由外层 SegGrid 里的滑动指示器承担（切换时有缓动滑动动画）。
             悬停不做任何底色反馈（滑动指示器方案下悬停色块看着像阴影），仅保留手型指针。 -->
        <Style x:Key="SegmentToggle" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="116"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource App.Text.Secondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="16" Background="Transparent"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 规格小芯片（书签格式说明用：NETSCAPE-Bookmark-file-1 / UTF-8 …） -->
        <Style x:Key="SpecChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource App.Surface.Panel}"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource App.Surface.Base}">

        <!-- ============================================================ -->
        <!-- ===== 面板 A：主面板（左栏工具列表 + 右主区） ===== -->
        <!-- ============================================================ -->
        <!-- Background="Transparent"：给"边角空白"一个可命中的面——否则 BlankClick 收不到点击
             （点空白要能清选中/清焦点；命令在 code-behind 挂）。 -->
        <Grid x:Name="MainPanel" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左栏：工具列表 -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="工具" FontSize="17" FontWeight="SemiBold" Margin="20,18,20,10"
                           Foreground="{DynamicResource App.Text.Primary}"/>
                <views:SideNavList x:Name="ToolListbox" Style="{StaticResource SideNavListStyle}"
                                   ItemContainerStyle="{StaticResource SideNavItemStyle}"
                                   SelectionChanged="ToolListbox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <m3:M3Icon Kind="{Binding Icon}" Width="17" Height="17" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </views:SideNavList>
            </StackPanel>

            <!-- 右主区：头部（标题 + 灰描述 + 操作） + 内容（表格 / 表单） -->
            <Grid Grid.Column="1" Margin="0,0,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="4,16,4,10" LastChildFill="True">
                    <StackPanel x:Name="HeaderActions" DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PaneTitle" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Text.Primary}"/>
                        <TextBlock x:Name="PaneSubtitle" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1">
                    <!-- 表格宿主：圆角 24 卡（与回收站/智能列表同款），表头色带边距归零。
                         去重表没有选中概念：点击行 = 进入明细，关掉行选中视觉（否则返回后残留高亮）。 -->
                    <Border x:Name="PaneTableHost" Background="{DynamicResource App.Surface.Card}"
                            CornerRadius="24" ClipToBounds="True">
                        <views:SortableDataTable x:Name="PaneTable" HeaderBandMargin="0" SelectionEnabled="False"/>
                    </Border>

                    <!-- 书签导入 / 导出（合并为一项：同一入口内切换方向） -->
                    <ScrollViewer x:Name="PaneBookmarkHost" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="2,2,2,0" FocusVisualStyle="{x:Null}">
                        <StackPanel MaxWidth="820" HorizontalAlignment="Left">

                            <!-- 方向切换：分段控件（容器 = TintCard 白底大药丸，CornerRadius 19 = 3 内距 + 16 段圆角，
                                 与编辑页右上胶囊组/浏览页命令栏胶囊组同口径）。
                                 选中态 = SegIndicator 滑动指示器（PrimaryContainer），切换时 TranslateTransform.X
                                 用 CubicEase 缓动滑过去（见 ToolsPage.xaml.cs 的 MoveSegIndicator）；两段等宽星号列。 -->
                            <Border Background="{DynamicResource App.Surface.TintCard}" CornerRadius="19"
                                    Padding="3" HorizontalAlignment="Left">
                                <Grid x:Name="SegGrid" SizeChanged="SegGrid_SizeChanged">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 滑动指示器：垫在两个段按钮下面（先声明 = z 序在下） -->
                                    <Border x:Name="SegIndicator" Grid.Column="0"
                                            Background="{DynamicResource App.Accent.Container}" CornerRadius="16">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="SegIndicatorX"/>
                                        </Border.RenderTransform>
                                    </Border>
                                    <ToggleButton x:Name="SegImport" Grid.Column="0" Style="{StaticResource SegmentToggle}"
                                                  Content="导入书签" Click="SegImport_Click" IsChecked="True"/>
                                    <ToggleButton x:Name="SegExport" Grid.Column="1" Style="{StaticResource SegmentToggle}"
                                                  Content="导出书签" Click="SegExport_Click"/>
                                </Grid>
                            </Border>

                            <!-- ================= 导入卡 ================= -->
                            <Border x:Name="BookmarkImportCard" Margin="0,14,0,0" MinWidth="720"
                                    Background="{DynamicResource App.Surface.Card}" CornerRadius="24"
                                    Padding="22,20,22,20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="46" Height="46" CornerRadius="16"
                                                Background="{DynamicResource App.Surface.Panel}">
                                            <m3:M3Icon Kind="import" Width="22" Height="22"
                                                       Foreground="{DynamicResource App.Text.Primary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="从浏览器导入书签" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource App.Text.Primary}"/>
                                            <TextBlock Text="读取 Chrome / Edge / Firefox 导出的 Netscape 书签文件（.html），文件夹层级完整还原"
                                                       FontSize="12" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource App.Text.Secondary}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="书签文件" FontSize="11.5" Margin="4,20,0,6"
                                               Foreground="{DynamicResource App.Text.Secondary}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ImportFileBox" Grid.Column="0"
                                                 Style="{StaticResource CardField}"
                                                 Tag="选择 bookmarks.html 文件…"
                                                 IsReadOnly="True"
                                                 ToolTip="选择浏览器导出的书签 HTML 文件（bookmarks.html）"/>
                                        <Button x:Name="ImportBrowseBtn" Grid.Column="1" Margin="10,0,0,0"
                                                Height="44" Padding="16,0" FontSize="13"
                                                Style="{StaticResource TonalButton}"
                                                Click="ImportBrowse_Click" Content="选择文件"/>
                                    </Grid>

                                    <!-- 预检结果（格式识别 + 条目统计；异常态统一 WarnBg 奶油黄，禁用红色） -->
                                    <Border x:Name="ImportInspectChip" Visibility="Collapsed"
                                            Margin="0,12,0,0" CornerRadius="12" Padding="12,9">
                                        <StackPanel Orientation="Horizontal">
                                            <m3:M3Icon x:Name="ImportInspectIcon" Kind="alert-circle-outline"
                                                       Width="14" Height="14" Margin="0,2,0,0"
                                                       VerticalAlignment="Top"/>
                                            <!-- 成功态的勾：矢量路径（字形表里没有勾形图标，不新增未验证字形） -->
                                            <Path x:Name="ImportInspectCheck" Visibility="Collapsed"
                                                  Width="14" Height="14" Margin="0,2,0,0" Stretch="Uniform"
                                                  Data="M1.5,8 L6,12.5 L12.5,3" StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" VerticalAlignment="Top"/>
                                            <TextBlock x:Name="ImportInspectText" FontSize="12" Margin="7,0,0,0"
                                                       TextWrapping="Wrap" MaxWidth="620" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                        <Button x:Name="ImportRunBtn" Height="40" Padding="22,0" IsEnabled="False"
                                                Style="{StaticResource PrimaryPillButton}" Click="ImportRun_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <m3:M3Icon Kind="import" Width="16" Height="16"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="开始导入" FontSize="13" FontWeight="SemiBold"
                                                           Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock x:Name="ImportHintText"
                                                   Text="导入内容追加到现有数据，顶层条目落在「全部书签」根级"
                                                   FontSize="11.5" Margin="14,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                                    </StackPanel>

                                    <StackPanel x:Name="ImportProgressRow" Visibility="Collapsed" Margin="0,16,0,0">
                                        <TextBlock x:Name="ImportProgressText" FontSize="12"
                                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                                        <ProgressBar x:Name="ImportProgressBar" Height="6" Margin="0,8,0,0"
                                                     IsIndeterminate="True" Foreground="{DynamicResource App.Accent.Fill}"
                                                     Background="{DynamicResource App.Surface.Hover}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ================= 导出卡 ================= -->
                            <Border x:Name="BookmarkExportCard" Margin="0,14,0,0" MinWidth="720" Visibility="Collapsed"
                                    Background="{DynamicResource App.Surface.Card}" CornerRadius="24"
                                    Padding="22,20,22,20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="46" Height="46" CornerRadius="16"
                                                Background="{DynamicResource App.Surface.Panel}">
                                            <m3:M3Icon Kind="export" Width="22" Height="22"
                                                       Foreground="{DynamicResource App.Text.Primary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="导出书签到浏览器" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource App.Text.Primary}"/>
                                            <TextBlock Text="输出为标准 Netscape 书签文件，Chrome / Edge / Firefox 可直接导入该书签栏"
                                                       FontSize="12" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource App.Text.Secondary}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 格式规格：让用户对"导出的是什么"有确定预期 -->
                                    <StackPanel Orientation="Horizontal" Margin="4,18,0,0">
                                        <Border Style="{StaticResource SpecChip}">
                                            <TextBlock Text="NETSCAPE-Bookmark-file-1" FontSize="11"
                                                       Foreground="{DynamicResource App.Text.Secondary}"/>
                                        </Border>
                                        <Border Style="{StaticResource SpecChip}">
                                            <TextBlock Text="UTF-8" FontSize="11"
                                                       Foreground="{DynamicResource App.Text.Secondary}"/>
                                        </Border>
                                        <Border Style="{StaticResource SpecChip}">
                                            <TextBlock Text="保留文件夹层级" FontSize="11"
                                                       Foreground="{DynamicResource App.Text.Secondary}"/>
                                        </Border>
                                        <Border Style="{StaticResource SpecChip}">
                                            <TextBlock Text="含创建时间 / 图标" FontSize="11"
                                                       Foreground="{DynamicResource App.Text.Secondary}"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="导出到" FontSize="11.5" Margin="4,18,0,6"
                                               Foreground="{DynamicResource App.Text.Secondary}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ExportDirBox" Grid.Column="0"
                                                 Style="{StaticResource CardField}"
                                                 Tag="选择导出目录…"
                                                 IsReadOnly="True"
                                                 ToolTip="选择导出目录"/>
                                        <Button x:Name="ExportBrowseBtn" Grid.Column="1" Margin="10,0,0,0"
                                                Height="44" Padding="16,0" FontSize="13"
                                                Style="{StaticResource TonalButton}"
                                                Click="ExportBrowse_Click" Content="浏览目录"/>
                                    </Grid>

                                    <Border x:Name="ExportResultChip" Visibility="Collapsed"
                                            Margin="0,12,0,0" CornerRadius="12" Padding="12,9">
                                        <StackPanel Orientation="Horizontal">
                                            <m3:M3Icon x:Name="ExportResultIcon" Kind="alert-circle-outline"
                                                       Width="14" Height="14" Margin="0,2,0,0"
                                                       VerticalAlignment="Top"/>
                                            <Path x:Name="ExportResultCheck" Visibility="Collapsed"
                                                  Width="14" Height="14" Margin="0,2,0,0" Stretch="Uniform"
                                                  Data="M1.5,8 L6,12.5 L12.5,3" StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" VerticalAlignment="Top"/>
                                            <TextBlock x:Name="ExportResultText" FontSize="12" Margin="7,0,0,0"
                                                       TextWrapping="Wrap" MaxWidth="640"
                                                       VerticalAlignment="Center"/>
                                            <Button x:Name="ExportRevealBtn" Visibility="Collapsed" Height="26"
                                                    Padding="10,0" Margin="10,0,0,0" FontSize="11.5"
                                                    Style="{StaticResource TonalButton}"
                                                    Click="ExportReveal_Click" Content="打开所在文件夹"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                        <Button x:Name="ExportRunBtn" Height="40" Padding="22,0" IsEnabled="False"
                                                Style="{StaticResource PrimaryPillButton}" Click="ExportRun_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <m3:M3Icon Kind="export" Width="16" Height="16"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="开始导出" FontSize="13" FontWeight="SemiBold"
                                                           Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock x:Name="ExportHintText"
                                                   Text="导出后会自动重新解析产物并校验条目数"
                                                   FontSize="11.5" Margin="14,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                                    </StackPanel>

                                    <StackPanel x:Name="ExportProgressRow" Visibility="Collapsed" Margin="0,16,0,0">
                                        <TextBlock x:Name="ExportProgressText" FontSize="12"
                                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                                        <ProgressBar x:Name="ExportProgressBar" Height="6" Margin="0,8,0,0"
                                                     IsIndeterminate="True" Foreground="{DynamicResource App.Accent.Fill}"
                                                     Background="{DynamicResource App.Surface.Hover}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 表单宿主（ID 跳转）：同一位置切换，保持页面骨架统一 -->
                    <ScrollViewer x:Name="PaneFormHost" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="2,2,2,0" FocusVisualStyle="{x:Null}">
                        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="输入要定位的 ID" FontSize="11.5" Margin="4,0,0,6"
                                       Foreground="{DynamicResource App.Text.Secondary}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="IdInput" Grid.Column="0" Style="{StaticResource PillTextField}"
                                         SpellCheck.IsEnabled="False"/>
                                <Button x:Name="JumpBtn" Grid.Column="1" Margin="10,0,0,0" Padding="18,0"
                                        Height="44"
                                        Style="{StaticResource PrimaryPillButton}" Click="Jump_Click"
                                        Content="跳转" FontSize="13" FontWeight="SemiBold"/>
                            </Grid>

                            <!-- 提示：统一走 WarnBg 芯片（项目删除/警告色规范，禁用红色） -->
                            <Border x:Name="JumpHintChip" Visibility="Collapsed" HorizontalAlignment="Left"
                                    Background="{DynamicResource App.Support.Container}" CornerRadius="10"
                                    Padding="12,6" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <m3:M3Icon Kind="alert-circle-outline" Width="14" Height="14"
                                               VerticalAlignment="Center" Foreground="{DynamicResource App.Text.Primary}"/>
                                    <TextBlock x:Name="JumpHintText" FontSize="12.5" Margin="7,0,0,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource App.Text.Primary}"
                                               TextWrapping="Wrap" MaxWidth="560"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="4,16,0,0" FontSize="12" LineHeight="19"
                                       Foreground="{DynamicResource App.Text.Secondary}" TextWrapping="Wrap"
                                       Text="支持链接 ID 与文件夹 ID，自动识别类型。&#x0a;跳转 = 进入该链接所在的目录并选中它；文件夹则进入其上级目录并选中该文件夹。"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============================================================ -->
        <!-- ===== 面板 B：重复组明细（整页） ===== -->
        <!-- ============================================================ -->
        <!-- FocusVisualStyle={x:Null}：面板本身可聚焦（快捷键按焦点路由），但**绝不画原生焦点虚线框**
             ——F5 重进明细时曾因此出现一条原生黑虚线（焦点收进页面根也是同一修法）。
             Background="Transparent"：给"边角空白"（表格卡与右栏之间的缝隙、分隔条周围）一个可命中的面——
             否则点这些缝隙收不到 BlankClick（与 WARNINGS 61 同族）。 -->
        <Grid x:Name="DetailPanel" Visibility="Collapsed" Focusable="True" FocusVisualStyle="{x:Null}"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <!-- 明细表 | 可拖拽分隔 | 右栏（选中行的只读投影；与搜索/智能列表同规格 286） -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="286" MinWidth="230" MaxWidth="400"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Padding="12,0,12,8">
                <DockPanel LastChildFill="True" VerticalAlignment="Center">
                    <Button DockPanel.Dock="Left" Click="DetailBack_Click" ToolTip="返回重复组列表（Esc）"
                            Style="{StaticResource RoundBackButton}">
                        <m3:M3Icon Kind="arrow-left" Width="18" Height="18"/>
                    </Button>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SelectionInfoText" FontSize="12" VerticalAlignment="Center"
                                   Margin="0,0,10,0" Foreground="{DynamicResource App.Text.Secondary}"/>
                        <Button x:Name="DeleteSelectedBtn" Style="{StaticResource TonalButton}"
                                Padding="12,6" IsEnabled="False" Click="DeleteSelected_Click"
                                ToolTip="把勾选的重复项移入回收站（至少保留一条）">
                            <StackPanel Orientation="Horizontal">
                                <m3:M3Icon Kind="delete-outline" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="删除重复项" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock x:Name="DetailUrlText" FontSize="15" FontWeight="SemiBold" MaxWidth="620"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource App.Text.Primary}"/>
                        <TextBlock x:Name="DetailHintText" FontSize="12.5" Margin="12,1,12,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource App.Text.Secondary}"/>
                        <Button Style="{StaticResource RowIconButton}" Tag="复制URL" Click="CopyUrl_Click"
                                VerticalAlignment="Center">
                            <m3:M3Icon Kind="content-copy" Width="14" Height="14"/>
                        </Button>
                        <!-- 跳转（共享药丸样式 JumpPillButton）：进浏览页对应目录并选中该行（定位组件）——
                             放**当前查看的那一条 URL 旁边**（复制钮之后），不与右侧动作簇混排：
                             右侧「已勾选 N 条 / 删除重复项」作用于**勾选集合**（批量处置），
                             跳转作用于**明细选中行**（单个），两个作用域必须分开摆（UI-SPEC §3 位置定稿）。 -->
                        <Button x:Name="DetailJumpBtn" Style="{StaticResource JumpPillButton}"
                                Click="DetailJump_Click" IsEnabled="False" VerticalAlignment="Center"
                                Margin="10,0,0,0"
                                ToolTip="跳转">
                            <StackPanel Orientation="Horizontal">
                                <m3:M3Icon Kind="map-marker" Width="15" Height="15" VerticalAlignment="Center"/>
                                <TextBlock Text="跳转" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 明细对比表（**保留行选中**）+ 取消出口 = 点空白（BlankClick 挂 DetailPanel）/ Esc；
                 ↑/↓/End 移动选中、Enter 打开网站、F5 重查（只读集：可读、可选、不可操作）。
                 SelectionEnabled=False = 外部托管：选中由 ToolsViewModel.DetailSelection（共享 ListSelection）承载。 -->
            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource App.Surface.Card}"
                    CornerRadius="24" Margin="8,0,16,16" ClipToBounds="True">
                <views:SortableDataTable x:Name="DetailTable" HeaderBandMargin="0" SelectionEnabled="False"/>
            </Border>

            <!-- 加载遮罩（唯一实现 = UIKit ListBusyOverlay）：只在 F5 这类**用户发起**的重查时亮；
                 IsBusy 由 code-behind 驱动（本页 DataContext 不是 ToolsViewModel，绑定写不通）。 -->
            <views:ListBusyOverlay x:Name="DetailBusyOverlay" Grid.Row="1" Grid.Column="0"
                                   Margin="8,0,16,16"/>

            <!-- 右栏：选中行的只读投影（共享 DetailSidebar；信息 + 打开网站，与搜索页右栏同一数据契约） -->
            <GridSplitter Grid.RowSpan="2" Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"
                          FocusVisualStyle="{x:Null}"/>
            <!-- ⚠️ 右栏整体声明 IsInteractive：DetailPanel 挂了"点空白清选中"，右栏是**选中集合的投影**
                 （查看面）——点它/拖选文本绝不得反向取消明细选中（与浏览页/回收站同口径）。 -->
            <Border Grid.RowSpan="2" Grid.Column="2" Background="{DynamicResource App.Surface.Panel}"
                    CornerRadius="24,0,0,24" Margin="0,0,16,16"
                    views:BlankClick.IsInteractive="True">
                <views:DetailSidebar x:Name="DetailSidebar"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
