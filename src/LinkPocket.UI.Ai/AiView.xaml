<UserControl x:Class="LinkPocket.Views.AiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LinkPocket.I18n;assembly=LinkPocket.I18n"
             xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
             xmlns:views="clr-namespace:LinkPocket.Views;assembly=LinkPocket.UIKit"
             xmlns:local="clr-namespace:LinkPocket.UI.Ai"
             Background="{DynamicResource App.Surface.Base}">
    <UserControl.Resources>
        <local:AiMentionKindIconConverter x:Key="AiMentionIconConverter"/>
        <!-- 页面内输入域（M3 填充式字段，唯一一份）：圆角 12 + 承载面压深一档的填充 + 聚焦换面板底。
             **方形描边文本框一律不用**（那是"没接样式"）。**不设占位水印**：水印画在模板里、
             拿不到自适应通道（放不下只能被裁成省略号），故一律不设。承载面在卡面/浅带层/强调容器
             上都成立（填充取的是页面底承托面的悬停支，比三者都深）。 -->
        <Style x:Key="AiFieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource App.Accent.Fill}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="12" Background="{DynamicResource App.Surface.Hover}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Surface.Panel}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 时间线上的"行按钮"（回合分隔行 / 工具行共用一份语言）：无底无边、悬停压深一档。
             行铺在**页面底**上 ⇒ 悬停取页面底承托面的那一支（App.Surface.Hover），不借卡面的。 -->
        <Style x:Key="AiRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Surface.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 消息悬停操作行上的小按钮（复制 / 存为技能）：同"行按钮"的底，字号小一档 -->
        <Style x:Key="AiGhostTextButton" TargetType="Button" BasedOn="{StaticResource AiRowButton}">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource App.Text.Secondary}"/>
        </Style>
        <!-- 审批卡的选项行：整行可点（主文案 + 一行说明）；默认焦点落在「拒绝」由视图按 Tag 找。
             底 = 透明 + 1px 弱描边（卡底是强调容器色，选项用状态叠层表达悬停/聚焦，不发明新色）。 -->
        <!-- 发送 / 停止（参照口径）：**28×28 的圆角方形**（圆角 8，不是药丸）。
             发送 = 强调填充 + 反白箭头；停止 = 中性底 + 实心方块（图标填色，不是描边）。
             两者占同一个位置，**互斥切换**：运行中且草稿为空 → 停止，否则发送。 -->
        <Style x:Key="ComposerSendButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="{DynamicResource App.Accent.Fill}" CornerRadius="8"/>
                            <Border x:Name="StateLayer" Background="{DynamicResource App.Text.OnAccent}"
                                    Opacity="0" CornerRadius="8"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.28"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComposerStopButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="{DynamicResource App.Surface.Panel}" CornerRadius="8"/>
                            <Border x:Name="StateLayer" Background="{DynamicResource App.Text.Primary}"
                                    Opacity="0" CornerRadius="8"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.12"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AiApprovalOption" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.Line.Variant}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <!-- 悬停 = 页面底悬停（`App.Surface.Hover`，比通用状态悬停淡——青提实测那支被压得很深）。
                             **键盘焦点不给填充底色**：审批卡弹出时焦点自动落在首项，若焦点也上底色，
                             卡片一出现就有一块"没碰它却亮着"的色块（用户实测："非要我悬停一下才变回正常"）。
                             焦点改用**边框上色**表达：键盘用户仍看得出焦点在哪，鼠标用户看到的永远是安静的描边卡。 -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Surface.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Line.Outline}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 技能 chip 的两个内段：名字（幽灵钮）与删除叉。
             ⚠️ 两段都**不画自己的胶囊底**：整枚 chip 才是一个药丸，内段再套一层就是"药丸套药丸"（旧毛病）。 -->
        <Style x:Key="SkillChipLabelButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.State.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 删除叉：16 圆形幽灵钮（与名字同处一枚药丸内）；悬停给状态叠层，不另起底色块 -->
        <Style x:Key="SkillChipCloseButton" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.State.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ⚠️ 模板必须**先定义后引用**：DataTemplate 内嵌的 StaticResource 引用前向键（键定义在引用之后）
             时解析被推迟到运行期、且找不到同字典的兄弟键 → 首次渲染直接 XamlParseException（审批卡/工具卡
             都会炸掉整个对话流）。P3+-2 探针 ai 套件首渲即红后改为本顺序；新增模板一律放在引用者之前。
             探针的「模板可独立实例化」读数钉住这条不变量（见 WARNINGS 134）。 -->
        <!-- 字段级 diff 的一行：字段名走键；值里字符串 = 用户数据原样（长值截断到一行 + 悬浮看全文）。
             冻结宽度口径（中文基线）：字段名 56 = 4 字 × 11pt（44px）+ 余量；
             值格 74 = 可用宽（286 − 14×2 − 项内距）下"旧 → 新"三段并列的最长可读宽。 -->
        <DataTemplate x:Key="AiFieldRowTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock Text="{loc:Value FieldName}" FontSize="11" Width="56" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource App.Text.Secondary}"/>
                <TextBlock Text="{loc:Value Before}" FontSize="11" Width="74" TextTrimming="CharacterEllipsis"
                           ToolTip="{loc:Value Before}" Foreground="{DynamicResource App.Text.Muted}"/>
                <TextBlock Text="→" FontSize="11" Margin="4,0" Foreground="{DynamicResource App.Text.Muted}"/>
                <TextBlock Text="{loc:Value After}" FontSize="11" Width="74" TextTrimming="CharacterEllipsis"
                           ToolTip="{loc:Value After}" Foreground="{DynamicResource App.Text.Primary}"/>
            </StackPanel>
        </DataTemplate>

        <!-- 台账一行（**对话流内联变更卡**用）：分类 + 实体 + 位置 + 字段级明细 + 撤销口径。
             "仅实体级"与"另有 N 项未列出"如实标注（功能书 §7.8）。 -->
        <DataTemplate x:Key="AiChangeRowTemplate">
            <StackPanel Margin="0,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:LocKey KindKey}" FontSize="12" Foreground="{DynamicResource App.Accent.Text}"/>
                    <TextBlock Text="{Binding EntityLabel}" FontSize="12" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource App.Text.Primary}"/>
                </StackPanel>
                <TextBlock Text="{loc:Value PathValue}" FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource App.Text.Muted}"/>
                <TextBlock Text="{Binding EntitySuffix}" FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource App.Text.Muted}"/>
                <ItemsControl ItemsSource="{Binding VisibleFields}" ItemTemplate="{StaticResource AiFieldRowTemplate}"/>
                <Button Height="24" Padding="8,0" FontSize="11"
                        HorizontalAlignment="Left" Margin="0,2,0,0" Content="{loc:LocKey ExpandKey}"
                        Click="OnToggleChangeExpand">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TonalButton}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanExpand}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:LocKey UndoableKey}" FontSize="11" Foreground="{DynamicResource App.Text.Muted}"/>
                    <TextBlock Text="{loc:LocKey SourceKey}" FontSize="11" Margin="8,0,0,0"
                               Foreground="{DynamicResource App.Accent.Text}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSourceNote}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- 对账与引擎 diff 不一致（功能书 §7.1：只标注不改写事实）——与 SourceKey 同带、独立可见性 -->
                    <TextBlock Text="{loc:LocKey MismatchKey}" FontSize="11" Margin="8,0,0,0"
                               Foreground="{DynamicResource App.Accent.Text}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMismatch}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <TextBlock Text="{loc:Value TruncatedValue}" FontSize="11" Foreground="{DynamicResource App.Accent.Text}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTruncated}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- ================= 对话流模板（按 Kind 选择） =================
             文案一律走键；用户数据 / 模型输出 / 机器面标识符原样显示。 -->

        <!-- 回合分隔行：整行可点（折叠该轮）；行底一条 1px 细线 -->
        <DataTemplate x:Key="AiTurnHeaderTemplate">
            <StackPanel Margin="0,12,0,2">
                <Button Click="OnToggleTurn" ToolTip="{loc:LocKey ToggleKey}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AiRowButton}">
                            <!-- 运行中 / 中断 / 失败 = 锁死展开：**不给可点的提手**（箭头已隐藏，
                                 tooltip 也一并停掉——否则"收起这一轮"的提示指向一个点了不动的动作） -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLockedOpen}" Value="True">
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <m3:M3Icon Kind="chevron-down" Width="13" Height="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.Text.Muted}">
                                <m3:M3Icon.Style>
                                    <Style TargetType="{x:Type m3:M3Icon}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <!-- 运行中 / 中断 / 失败 = 锁死展开：**不画箭头**，点了也不收 -->
                                            <DataTrigger Binding="{Binding IsLockedOpen}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </m3:M3Icon.Style>
                            </m3:M3Icon>
                            <m3:M3Icon Kind="chevron-right" Width="13" Height="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.Text.Muted}">
                                <m3:M3Icon.Style>
                                    <Style TargetType="{x:Type m3:M3Icon}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLockedOpen}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </m3:M3Icon.Style>
                            </m3:M3Icon>
                            <TextBlock Text="{loc:Value HeaderValue}" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.Text.Secondary}"/>
                    </StackPanel>
                </Button>
                <Border Height="1" Background="{DynamicResource App.Line.Variant}"/>
            </StackPanel>
        </DataTemplate>

        <!-- 用户消息：右对齐气泡（右上角缺角）+ 上方提及 chip + 悬停操作行 -->
        <!-- ⚠️ 根元素必须给 `Background="Transparent"`：WPF 里**没有背景的面板在空白处不参与命中测试**，
             于是"鼠标往复制按钮上移"这一步会落到面板的空隙里 → IsMouseOver 转假 → 行立刻透明、按钮再也点不到。
             透明底让整块行区（含操作行那一条）成为悬浮区，与参照的 group-hover 同语义。 -->
        <DataTemplate x:Key="AiUserTemplate">
            <StackPanel x:Name="UserRoot" Margin="0,8,0,8" HorizontalAlignment="Right" MaxWidth="560"
                        Background="Transparent">
                <ItemsControl ItemsSource="{Binding Mentions}" Margin="0,0,0,4" HorizontalAlignment="Right">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMentions}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Right"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource App.Accent.Container}" CornerRadius="12"
                                    Padding="8,2" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <m3:M3Icon Kind="{Binding Kind, Converter={StaticResource AiMentionIconConverter}}"
                                               Width="12" Height="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource App.Text.OnContainer}"/>
                                    <TextBlock Text="@" Margin="4,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource App.Text.OnContainer}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource App.Text.OnContainer}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Background="{DynamicResource App.Surface.Card}" BorderThickness="1"
                        BorderBrush="{DynamicResource App.Line.Variant}"
                        CornerRadius="16,16,4,16" Padding="14,10">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource App.Text.Primary}"/>
                </Border>
                <!-- ⚠️ 操作行**恒占位**，只用不透明度显隐（参照实现同口径：`opacity-0 → group-hover:opacity-100`）。
                     早先用 `Visibility=Collapsed` 是两处缺陷的同一个根因：
                     ① 行一收，整块消息变矮 → 悬停/移开时布局跳一下；
                     ② 行一收就把鼠标所在的那一块从命中区里删掉 → "往复制按钮上一移，按钮就没了"。 -->
                <StackPanel x:Name="UserActions" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,2,0,0" Opacity="0" IsHitTestVisible="False">
                    <Button Style="{StaticResource AiGhostTextButton}" Content="{loc:Loc ai.feed.copy}"
                            Click="OnCopyMessage"/>
                    <!-- 回溯与复制并排，就在用户这条消息底下：回溯作用的对象就是"这条提问带来的那一轮"，
                         挂在用户消息上才指得清是回溯哪一轮（挂在"本轮用时 N 秒"那行会读成"回退整轮的所有思考"）。 -->
                    <Button Style="{StaticResource AiGhostTextButton}" Content="{loc:Loc ai.rewind}"
                            Margin="8,0,0,0" Click="OnRewindTurn"/>
                    <TextBlock Text="{loc:Value TimeValue}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource App.Text.Muted}"/>
                </StackPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <Trigger SourceName="UserRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="UserActions" Property="Opacity" Value="1"/>
                    <Setter TargetName="UserActions" Property="IsHitTestVisible" Value="True"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 助手消息：无气泡，左对齐 Markdown；思考块（有才出现，缺省收起）+ 操作行恒占位、悬停显形 -->
        <DataTemplate x:Key="AiAssistantTemplate">
            <StackPanel x:Name="AssistantRoot" Margin="0,8,0,8" Background="Transparent">
                <!-- 思考块：**有思考才出现**；缺省收起（它是参考材料，不是正文），点标题看完整原文。
                     标题在收起时带字数读数——不点开也知道里面有多少东西。 -->
                <StackPanel Margin="0,0,0,4">
                    <StackPanel.Style>
                        <!-- 思考块属于**工作段**：有思考、且这一轮没被收起时才出现
                             （正文是同一个条目里的另一段，**不随回合折叠**）。 -->
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasReasoning}" Value="True"/>
                                        <Condition Binding="{Binding HideReasoningByTurn}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button HorizontalAlignment="Left" Style="{StaticResource AiRowButton}" Click="OnToggleReasoning">
                        <StackPanel Orientation="Horizontal">
                            <!-- 方向语义（对齐参照设计）：**收起 = ›（点开）、展开 = ⌄（可收）**。
                                 此前两者反挂：收起显示"⌄"、展开显示"›"——指示符与实际状态相反。 -->
                            <m3:M3Icon Kind="chevron-right" Width="12" Height="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.Text.Muted}">
                                <m3:M3Icon.Style>
                                    <Style TargetType="{x:Type m3:M3Icon}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReasoningOpen}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </m3:M3Icon.Style>
                            </m3:M3Icon>
                            <m3:M3Icon Kind="chevron-down" Width="12" Height="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.Text.Muted}">
                                <m3:M3Icon.Style>
                                    <Style TargetType="{x:Type m3:M3Icon}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReasoningOpen}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </m3:M3Icon.Style>
                            </m3:M3Icon>
                            <TextBlock Text="{loc:Loc ai.reasoning.title}" FontSize="12" Margin="4,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource App.Text.Secondary}"/>
                            <TextBlock Text="{loc:Value ReasoningLengthValue}" FontSize="11" Margin="6,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource App.Text.Muted}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReasoningOpen}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <!-- 思考原文（参照口径）：**正文字体、不是等宽**——它是"读的一段话"，不是要复制的技术串；
                         限高 240 可滚；左侧一道细线 + 缩进（读起来是"附在正文旁的一段"，不是一块色底）。 -->
                    <Border Margin="0,4,0,0" MaxHeight="240">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasReasoning}" Value="True"/>
                                            <Condition Binding="{Binding IsReasoningOpen}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Border BorderThickness="1,0,0,0" BorderBrush="{DynamicResource App.Line.Variant}"
                                    Padding="10,0,0,0" Margin="2,0,0,0">
                                <TextBlock Text="{Binding ReasoningText}" TextWrapping="Wrap"
                                           FontSize="12" LineHeight="18"
                                           Foreground="{DynamicResource App.Text.Secondary}"/>
                            </Border>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
                <views:MarkdownText Markdown="{Binding RenderText}" FontSize="13"/>
                <StackPanel x:Name="AssistantActions" Orientation="Horizontal" Margin="0,2,0,0"
                            Opacity="0" IsHitTestVisible="False">
                    <Button Style="{StaticResource AiGhostTextButton}" Content="{loc:Loc ai.feed.copy}"
                            Click="OnCopyMessage"/>
                    <TextBlock Text="{loc:Value TimeValue}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource App.Text.Muted}"/>
                </StackPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <Trigger SourceName="AssistantRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="AssistantActions" Property="Opacity" Value="1"/>
                    <Setter TargetName="AssistantActions" Property="IsHitTestVisible" Value="True"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 工具调用行：单行摘要（域图标 + 动作短语 + 对象 + 状态），点开才是详情（参数 / 结果 / 变更卡） -->
        <DataTemplate x:Key="AiToolTemplate">
            <StackPanel x:Name="ToolRoot" Margin="0,2,0,2">
                <Button Style="{StaticResource AiRowButton}" Click="OnToggleToolRow">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <m3:M3Icon Grid.Column="0" Kind="{Binding IconKind}" Width="15" Height="15"
                                   VerticalAlignment="Center" Foreground="{DynamicResource App.Text.Muted}"/>
                        <TextBlock Grid.Column="1" Text="{loc:LocKey ActionKey}" FontSize="13" Margin="7,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource App.Text.Primary}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Summary}" FontSize="11" Margin="8,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   FontFamily="{DynamicResource App.Font.Mono}"
                                   Foreground="{DynamicResource App.Text.Muted}"/>
                        <TextBlock Grid.Column="3" Text="{loc:LocKey StateKey}" FontSize="11" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource App.Accent.Text}"/>
                        <m3:M3Icon Grid.Column="4" x:Name="ToolChevron" Kind="chevron-right" Width="13" Height="13"
                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.Text.Muted}"/>
                    </Grid>
                </Button>
                <Border x:Name="ToolDetail" Margin="8,2,0,2" Padding="10,0,0,0" Visibility="Collapsed"
                        BorderThickness="1,0,0,0" BorderBrush="{DynamicResource App.Line.Variant}">
                    <StackPanel>
                    <TextBlock Text="{loc:Loc ai.tool.args}" FontSize="11" Margin="0,2,0,2"
                               Foreground="{DynamicResource App.Text.Muted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasArgs}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ArgsText}" FontSize="10.5" TextWrapping="Wrap"
                               FontFamily="{DynamicResource App.Font.Mono}"
                               Foreground="{DynamicResource App.Text.Secondary}"/>
                    <TextBlock Text="{loc:Loc ai.tool.result}" FontSize="11" Margin="0,6,0,2"
                               Foreground="{DynamicResource App.Text.Muted}"/>
                    <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource App.Text.Secondary}"/>
                    <!-- 内联变更卡（功能书 §7.5）：本调用的逐条变更，展开/收起由各行自持 -->
                    <StackPanel Margin="0,6,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasChanges}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{loc:Value ChangeCountValue}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Text.Primary}"/>
                        <ItemsControl ItemsSource="{Binding Changes}" Margin="0,2,0,0"
                                      ItemTemplate="{StaticResource AiChangeRowTemplate}"/>
                    </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="ToolDetail" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ToolChevron" Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="90"/>
                        </Setter.Value>
                    </Setter>
                    <Setter TargetName="ToolChevron" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 批 / 宏审批卡的一行步骤 -->
        <DataTemplate x:Key="AiApprovalStepTemplate">
            <StackPanel Margin="0,2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Value IndexLabel}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Text.OnContainer}"/>
                    <TextBlock Text="{Binding Command}" FontSize="11" Margin="6,0,0,0"
                               Foreground="{DynamicResource App.Text.OnContainer}"/>
                    <TextBlock Text="{loc:Loc ai.approve.destructive}" FontSize="11" Margin="6,0,0,0"
                               Foreground="{DynamicResource App.Text.OnContainer}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Value TargetValue}" FontSize="11"
                               Foreground="{DynamicResource App.Text.OnContainer}"/>
                    <TextBlock Text="{loc:Loc ai.approve.steps.onError}" FontSize="11" Margin="6,0,0,0"
                               Foreground="{DynamicResource App.Text.OnContainer}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOnError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{loc:Value OnErrorValue}" FontSize="11" Margin="4,0,0,0"
                               Foreground="{DynamicResource App.Text.OnContainer}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOnError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- 审批卡（功能书 §8.2）：做什么（本地化动作短语 + 机器面命令名）/ 动哪些对象（名称·数量·路径）/
             影响预览（引擎给的或如实说明无法预览）/ 批的逐步骤影响 / 「会话允许」将记住的作用域 /
             四档**纵向选项**（每档主文案 + 一行说明；顺序固定），**默认焦点落在「拒绝」**（视图侧按 Tag 找按钮）。 -->
        <DataTemplate x:Key="AiApprovalTemplate">
            <Border Background="{DynamicResource App.Accent.Container}" CornerRadius="18" Padding="14,12"
                    Margin="0,6,0,6" MaxWidth="560" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="{loc:Loc ai.approve.title}" FontWeight="SemiBold" Foreground="{DynamicResource App.Text.OnContainer}"/>
                    <!-- 做什么 -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{loc:LocKey ActionKey}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Text.OnContainer}"/>
                        <TextBlock Text="{Binding Command}" FontSize="11" Margin="8,0,0,0"
                                   FontFamily="{DynamicResource App.Font.Mono}"
                                   Foreground="{DynamicResource App.Text.OnContainer}"/>
                    </StackPanel>
                    <!-- 动哪些对象：名称（用户数据原样）/ 数量 / 不可逆徽标 -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{loc:Loc ai.approve.targetLabel}" FontSize="12"
                                   Foreground="{DynamicResource App.Text.OnContainer}"/>
                        <TextBlock Text="{loc:Value TargetValue}" FontSize="12" Margin="6,0,0,0"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource App.Text.OnContainer}"/>
                        <TextBlock Text="{loc:Loc ai.approve.destructive}" FontSize="12" Margin="8,0,0,0"
                                   Foreground="{DynamicResource App.Text.OnContainer}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <!-- 名称列表截断：另有 N 项未列出（如实标注，不假装列全） -->
                    <TextBlock Text="{loc:Value MoreTargetsValue}" FontSize="11"
                               Foreground="{DynamicResource App.Text.OnContainer}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMoreTargets}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- 目标路径（canonical → 当前语言投影） -->
                    <TextBlock Text="{loc:Value TargetPathValue}" FontSize="11"
                               Foreground="{DynamicResource App.Text.OnContainer}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTargetPath}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- 影响预览：引擎随 LP.SEC.003 下发的影响面；没有就如实说"无法预览" -->
                    <TextBlock Text="{loc:Value ImpactValue}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                               Foreground="{DynamicResource App.Text.OnContainer}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasImpact}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{loc:Loc ai.approve.noPreview}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                               Foreground="{DynamicResource App.Text.OnContainer}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPreview}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- 批 / 宏：逐步骤影响 -->
                    <StackPanel Margin="0,6,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasApprovalSteps}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{loc:Value StepsTitleValue}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Text.OnContainer}"/>
                        <ItemsControl ItemsSource="{Binding ApprovalSteps}" Margin="0,2,0,0"
                                      ItemTemplate="{StaticResource AiApprovalStepTemplate}"/>
                        <!-- 超出预览上限的那几步：一行交代清楚（**不静默省略**——条数照实说） -->
                        <TextBlock Text="{loc:Value HiddenStepsValue}" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{DynamicResource App.Text.OnContainer}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasHiddenSteps}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{loc:LocKey StepsNoteKey}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                               Foreground="{DynamicResource App.Text.OnContainer}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasStepsNote}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- 「本次会话总是允许」将记住的作用域（不允许只显示"记住"） -->
                    <TextBlock Text="{loc:Value AllowScopeValue}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                               Foreground="{DynamicResource App.Text.OnContainer}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAllowScope}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- 四档：允许一次 → 会话允许 → 拒绝 → 拒绝并停止（纵向、顺序固定） -->
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsApprovalOpen}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Style="{StaticResource AiApprovalOption}" Tag="AiApprovalAllowOnce" Click="OnApproveOnce">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc ai.approve.allowOnce}" FontSize="13"
                                           Foreground="{DynamicResource App.Text.OnContainer}"/>
                                <TextBlock Text="{loc:Loc ai.approve.opt.once}" FontSize="11"
                                           Foreground="{DynamicResource App.Text.OnContainer}" Opacity="0.75"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AiApprovalOption}" Tag="AiApprovalAllowSession" Click="OnApproveSession">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc ai.approve.allowSession}" FontSize="13"
                                           Foreground="{DynamicResource App.Text.OnContainer}"/>
                                <TextBlock Text="{loc:Loc ai.approve.opt.session}" FontSize="11"
                                           Foreground="{DynamicResource App.Text.OnContainer}" Opacity="0.75"/>
                            </StackPanel>
                        </Button>
                        <!-- 默认焦点落在「拒绝」（视图按 Tag 找它）；不设 IsDefault——否则焦点在别的选项上时
                             按 Enter 会触发「拒绝」，与用户点的那一档对不上 -->
                        <Button Style="{StaticResource AiApprovalOption}" Tag="AiApprovalReject" Click="OnBeginReject">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc ai.approve.reject}" FontSize="13"
                                           Foreground="{DynamicResource App.Text.OnContainer}"/>
                                <TextBlock Text="{loc:Loc ai.approve.opt.reject}" FontSize="11"
                                           Foreground="{DynamicResource App.Text.OnContainer}" Opacity="0.75"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AiApprovalOption}" Tag="AiApprovalRejectStop" Click="OnRejectStop">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc ai.approve.rejectStop}" FontSize="13"
                                           Foreground="{DynamicResource App.Text.OnContainer}"/>
                                <TextBlock Text="{loc:Loc ai.approve.opt.rejectStop}" FontSize="11"
                                           Foreground="{DynamicResource App.Text.OnContainer}" Opacity="0.75"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <!-- 拒绝反馈区（**点「拒绝」才展开**）：说明可选，确认后随决定回灌模型（模型同轮换方案）。
                         不再常驻一个输入框——实测用户把常驻框误读成"必须打字才能执行的确认框"。 -->
                    <StackPanel Margin="0,6,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsApprovalOpen}" Value="True"/>
                                            <Condition Binding="{Binding IsRejectFeedbackOpen}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBox Style="{StaticResource AiFieldBox}" ToolTip="{loc:Loc ai.approve.reasonHint}"
                                 Text="{Binding RejectReason, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Style="{StaticResource TonalButton}" Height="26" Padding="12,0"
                                    Content="{loc:Loc ai.approve.rejectConfirm}" Click="OnConfirmReject"/>
                            <Button Style="{StaticResource TonalButton}" Height="26" Padding="12,0" Margin="6,0,0,0"
                                    Content="{loc:Loc common.cancel}" Click="OnCancelReject"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 提示条（压缩事实 / 限流等待 / 斜杠回话）：居中标记行（两侧 1px 细线） -->
        <DataTemplate x:Key="AiNoticeTemplate">
            <Grid Margin="0,8,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Height="1" VerticalAlignment="Center" Margin="0,0,10,0"
                        Background="{DynamicResource App.Line.Variant}"/>
                <TextBlock Grid.Column="1" Text="{loc:Value NoticeValue}" FontSize="12" TextWrapping="Wrap"
                           MaxWidth="480" TextAlignment="Center"
                           Foreground="{DynamicResource App.Text.Secondary}"/>
                <Border Grid.Column="2" Height="1" VerticalAlignment="Center" Margin="10,0,0,0"
                        Background="{DynamicResource App.Line.Variant}"/>
            </Grid>
        </DataTemplate>

        <!-- 技能 chip：**一个整体圆头药丸**（图标 + 名字 + 删除），不是"药丸套药丸"。
             删除钮与名字同处一枚药丸内，平时透明、悬停 chip 才显形（参照实现的附件药丸口径）；
             左侧图标把"这是技能、不是普通按钮"直接画出来，省得靠猜。 -->
        <DataTemplate x:Key="AiSkillChipTemplate">
            <Border x:Name="SkillPill" Height="28" CornerRadius="14" Margin="0,0,6,6"
                    Background="{DynamicResource App.Surface.TintCard}" Padding="10,0,4,0"
                    ToolTip="{loc:Loc ai.skill.params.run}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource App.Surface.CardHover}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <m3:M3Icon Kind="auto-fix" Width="13" Height="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource App.Text.Secondary}"/>
                    <Button x:Name="SkillRun" Style="{StaticResource SkillChipLabelButton}"
                            Content="{Binding Name}" Click="OnRunSkill"/>
                    <Button x:Name="SkillDelete" Style="{StaticResource SkillChipCloseButton}"
                            Click="OnDeleteSkill" ToolTip="{loc:Loc ai.skill.delete}">
                        <m3:M3Icon Kind="close" Width="12" Height="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                    </Button>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <!-- 删除入口：chip 未悬浮 = 隐（不占视觉噪音），悬浮 = 显形 -->
                <Trigger SourceName="SkillPill" Property="IsMouseOver" Value="False">
                    <Setter TargetName="SkillDelete" Property="Visibility" Value="Hidden"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- 提及候选一行（图标 + 名称 + 位置；点击选入） -->
        <DataTemplate x:Key="AiMentionCandidateTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,3">
                <m3:M3Icon Kind="{Binding Kind, Converter={StaticResource AiMentionIconConverter}}" Width="14" Height="14"
                           VerticalAlignment="Center" Foreground="{DynamicResource App.Text.Secondary}"/>
                <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource App.Text.Primary}"/>
                <TextBlock Text="{loc:Value PathValue}" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource App.Text.Muted}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPath}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <local:AiFeedTemplateSelector x:Key="AiFeedSelector"
                                      TurnHeaderTemplate="{StaticResource AiTurnHeaderTemplate}"
                                      UserTemplate="{StaticResource AiUserTemplate}"
                                      AssistantTemplate="{StaticResource AiAssistantTemplate}"
                                      ToolTemplate="{StaticResource AiToolTemplate}"
                                      ApprovalTemplate="{StaticResource AiApprovalTemplate}"
                                      NoticeTemplate="{StaticResource AiNoticeTemplate}"/>

        <!-- 左栏会话一行：运行状态点 + 标题 + 时间 + 变更数徽标；悬停时**让位**给行内动作
             （重命名 / 导出 / 删除，与右键菜单同一套）。悬停不额外变形（不变高、不换行）：
             行高由 26 的标题行钉死，动作按钮与"时间 + 徽标"同一行，避免鼠标一过整列跳动。 -->
        <DataTemplate x:Key="AiSessionItemTemplate">
            <Grid x:Name="SessionRoot" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 状态槽：运行中转圈 / 空闲小点（两种都占位，切换时不挪标题） -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="{DynamicResource App.Text.Muted}" Opacity="0.5">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <m3:M3Icon Kind="refresh" Width="12" Height="12" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{DynamicResource App.Accent.Text}">
                        <m3:M3Icon.Style>
                            <Style TargetType="{x:Type m3:M3Icon}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </m3:M3Icon.Style>
                    </m3:M3Icon>
                </Grid>
                <StackPanel Grid.Column="1" Margin="0,5,0,5">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13" Height="18"
                               Foreground="{DynamicResource App.Text.Primary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- 就地重命名（Enter 提交 / Esc 取消，不做失焦提交——无归属的失焦是时序炸弹，见 WARNINGS 34） -->
                    <TextBox x:Name="RenameBox" Tag="AiRenameBox" Height="26" FontSize="13"
                             Text="{Binding DataContext.RenameText, RelativeSource={RelativeSource AncestorType=ListBox}, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnRenameKeyDown">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource AiFieldBox}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>
                <!-- 尾行：默认摆读数（时间 + 变更徽标）；悬停换上行内动作（同一格、同一高度 → 不跳动） -->
                <Grid Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Bottom" Height="20">
                    <StackPanel x:Name="SessionMeta" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 时间**定宽**（不是 MaxWidth）：两语言的日期串长度不同，
                             用 MaxWidth 时英文串量出的小数位差会把整列宽度带跑（尺寸门禁逐像素比）。 -->
                        <TextBlock Text="{loc:Value TimeValue}" FontSize="11" Width="72" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource App.Text.Muted}"/>
                        <Border x:Name="ChangeBadge" Background="{DynamicResource App.Support.Container}" CornerRadius="9"
                                Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasChanges}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{loc:Value ChangeCountValue}" FontSize="10.5"
                                       Foreground="{DynamicResource App.Text.Primary}"/>
                        </Border>
                    </StackPanel>
                    <!-- 行内动作只留**删除**一枚。
                         ⚠️ 重命名**不放行内**（用户实测：悬停时动作正好长在鼠标底下，点一下切会话就变成进了重命名，
                         而且编辑框拿不到焦点时 Esc 也救不回来 → "卡在重命名里出不来"）。重命名只走右键菜单。
                         导出无实现（一点即报错，已从本页退场）。动作与读数同一格同一高度换装，不换行不变高。 -->
                    <StackPanel x:Name="SessionActions" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <Button x:Name="SessionDelete" Style="{StaticResource SideIconButton}" Width="22" Height="20"
                                Padding="2" Tag="{loc:Loc ai.sessions.delete}" Click="OnDeleteSession">
                            <m3:M3Icon Kind="delete-outline" Width="13" Height="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.Accent.Text}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <!-- 悬停：读数让位给动作（同一格内换装，不做位移动画） -->
                <Trigger SourceName="SessionRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="SessionMeta" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="SessionActions" Property="Visibility" Value="Visible"/>
                </Trigger>
                <!-- 重命名中不摆动作（正在编辑的行上挂着删除钮，误点就是数据没了） -->
                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                    <Setter TargetName="SessionActions" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 左栏：会话（新建行 + 会话清单） ===== -->
        <Border Grid.Column="0" Background="{DynamicResource App.Surface.Panel}" CornerRadius="24,0,0,24">
            <DockPanel Margin="10,12,10,12">
                <Button DockPanel.Dock="Top" x:Name="NewSessionButton" Style="{StaticResource AiRowButton}"
                        Height="34" Padding="8,0" HorizontalContentAlignment="Stretch" Click="OnNewSession">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <m3:M3Icon Kind="plus" Width="15" Height="15" Foreground="{DynamicResource App.Accent.Text}"/>
                            <TextBlock Text="{loc:Loc ai.sessions.new}" FontSize="13" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource App.Text.Primary}"/>
                        </StackPanel>
                        <!-- 键位提示取自键位总表（页面不写死键位串） -->
                        <TextBlock Text="{Binding NewSessionShortcut}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{DynamicResource App.Text.Muted}"/>
                    </Grid>
                </Button>
                <ListBox x:Name="SessionList" Margin="0,8,0,0" Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding Sessions}" ItemTemplate="{StaticResource AiSessionItemTemplate}"
                         SelectionChanged="OnSessionSelected"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6,0"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <!-- ⚠️ 必须 Stretch：ListBoxItem 的默认值是 Left，行会按内容量宽
                                 （悬停时动作比读数宽 → 行宽忽宽忽窄；只有一条会话时右侧更明显地被缩掉）。
                                 行是"列表里的一张卡"，宽度归列表，不归内容。 -->
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <!-- 一行会话是"浮在面板上的一张卡"：底色比左栏面板亮一档 + 常驻细边 + 阴影，
                                             这样它不会与面板糊成一片。加深靠的是"卡亮一档"，不是把面板压暗——
                                             压暗面板会连带把新建入口、分隔线一起拉下去。 -->
                                        <Border x:Name="Bd" Background="{DynamicResource App.Surface.Card}"
                                                BorderBrush="{DynamicResource App.Line.Variant}" BorderThickness="1"
                                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1"
                                                                  Opacity="0.12" Direction="270"
                                                                  Color="{DynamicResource App.Color.Shadow}"/>
                                            </Border.Effect>
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Surface.CardHover}"/>
                                                <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Surface.Selected}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent.Container}"/>
                                            </Trigger>
                                            <!-- 勾选态已随批量操作一起退场（只留删除 / 重命名两件） -->
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsSelected" Value="True"/>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Surface.Selected}"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <!-- 右键先选中该行（菜单动作作用于选中行） -->
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnSessionRowRightClick"/>
                            <!-- 点在行上就切会话（不依赖"选中项变了"——见 handler 注释里的那个卡死场景） -->
                            <EventSetter Event="MouseLeftButtonUp" Handler="OnSessionRowClicked"/>
                            <!-- 行级 Enter / Esc：编辑框没拿到焦点时的兜底出口（否则整行卡在编辑态） -->
                            <EventSetter Event="PreviewKeyDown" Handler="OnSessionRowKeyDown"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <ContextMenu.Resources>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}"/>
                            </ContextMenu.Resources>
                            <!-- 只有删除与重命名两件（用户口径：只要求这两个，别的一律不加） -->
                            <MenuItem Header="{loc:Loc ai.sessions.rename}" Click="OnRenameSession"/>
                            <MenuItem Header="{loc:Loc ai.sessions.delete}" Click="OnDeleteSession"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== 中栏：导航轨槽 + 状态行 + 对话区（居中内容列）+ 输入区 =====
             ⚠️ 导航轨的槽在**本层**（贴对话栏左缘），不在内容单元里：内容单元是 928 居中列，
             轨一旦放进去就会被一起带到接近窗口中心（用户实测"都快占据中心了"）。
             放到这一层后，状态行 / 对话区 / 输入区同在窄了一槽的那一列里继续对齐。 -->
        <Grid Grid.Column="1" Margin="16,10,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 状态行：运行中才有过程读数（左）；右端常驻**本会话用量**
                 （轮数 / 工具调用 / token 合计）——它原先只在右栏状态条里；右栏删除后挪到这里，
                  功能书 §2「用量可见」是硬要求，不能随栏一起消失。单行 + 截断 + 悬浮看全。 -->
            <Grid Grid.Column="1">
                <TextBlock x:Name="UsageLine" Text="{loc:Value UsageValue}"
                           HorizontalAlignment="Right" VerticalAlignment="Top"
                           MaxWidth="380" Margin="12,0,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                           ToolTip="{loc:Value UsageValue}" Foreground="{DynamicResource App.Text.Muted}"/>
                <StackPanel Margin="0,0,0,6">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProgressVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Value StatusValue}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                        <TextBlock Text="{loc:Value ProgressTextValue}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 对话区：内容单元（时间线）居中；浮层声明在 ScrollViewer 之后（z 序）。
                 宽度 = Stretch + MaxWidth 928（**不用 HorizontalAlignment=Center**：居中 + 内容自适应时，
                 单元宽会跟着文字长度走，英文界面会整体变宽——见 WARNINGS 103）。
                 导航轨**不在这一层**：它在下面单列占一槽、贴对话栏左缘。 -->
            <Grid Grid.Column="1" Grid.Row="1" MaxWidth="928" HorizontalAlignment="Stretch">
                <Grid Margin="8,0,8,0">
                    <ScrollViewer x:Name="FeedScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent" ScrollChanged="OnFeedScrollChanged">
                        <!-- 折叠 = **项容器**的可见性（一处生效，覆盖所有条目模板）：
                             回合状态行的展开/收起改变条目的 HiddenByTurn，这里把它落到界面上。
                             ⚠️ 之前 VM 侧算了这个值、界面却没消费 ⇒ 点了"本轮进行中"毫无反应。
                             助手的**最终回复不参与折叠**（HiddenByTurn 在项上排除了它）。 -->
                        <ItemsControl x:Name="FeedItems" ItemsSource="{Binding Feed}"
                                      ItemTemplateSelector="{StaticResource AiFeedSelector}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HiddenByTurn}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 空对话区不设占位卡：没有会话 / 空会话一律就是空白（引导卡与它的示例提示已退场；
                         未配置由发送钮的可用性与模型下拉的空态文案承担）。 -->

                    <!-- 回到最新（离开底部才出现；点了回底并恢复跟随；显隐由视图按滚动位置投影） -->
                    <Button x:Name="BackToLatestButton" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,10" Height="32" Width="32" Padding="0" Visibility="Collapsed"
                            Style="{StaticResource TonalButton}" Tag="{loc:Loc ai.feed.backToLatest}"
                            Click="OnBackToLatest">
                        <m3:M3Icon Kind="arrow-down" Width="14" Height="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Grid>

            <!-- 轮次导航轨：贴对话栏左缘（槽内左侧 12px，与参照的 left-3 同口径）、垂直居中；
                 每轮一枚圆头短横条，鼠标滑过形成"山峰"。
                 ⚠️ 山峰只有横向在变（2.6 / 1.7 / 1.25 / 1，150ms 推移），不透明度只有两档
                 （指到的那根 1，其余 0.58）；当前视口那一轮无悬浮时走 0.9 的深色，
                 悬浮期间让位给山峰——这几条都照参照实现的口径。
                 悬停弹出预览卡（用户说了什么 + 助手回了什么），点条或点卡都定位到该轮。 -->
            <ItemsControl x:Name="TurnRail" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center"
                          HorizontalAlignment="Left" Margin="12,0,0,0" Panel.ZIndex="5" ItemsSource="{Binding Turns}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="RailButton" Width="36" Height="10" Padding="0"
                                HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" FocusVisualStyle="{x:Null}" Click="OnRailClick"
                                MouseEnter="OnRailEnter" MouseLeave="OnRailLeave"
                                ToolTip="{loc:Value RailTipValue}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <!-- 命中区是 36×10：条只占左侧（静止 12、峰 31.2），
                                         余下的是"好按"的余量，不是可见形状。
                                         IsCurrent 从按钮的数据上下文（该轮的分隔行）直接取，
                                         不靠外层 DataTemplate 触发器——模板内的元素不在 DataTemplate 的
                                         触发器目标命名域里，这是 WARNINGS 里同一类"命名域"坑。 -->
                                    <Border Background="Transparent">
                                        <local:RailBar x:Name="Bar" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                       IsCurrent="{Binding IsActive, Mode=OneWay}"
                                                       BarBrush="{DynamicResource App.Line.Outline}"
                                                       AccentBrush="{DynamicResource App.Text.Primary}"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowRail}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
            </ItemsControl>

                <!-- 导航轨悬停预览卡：只摆两段正文（用户说了什么 / 助手回了什么），不加标题行——
                     参照实现的卡里就是 <p> 用户 + <p> 助手，没有第三行。
                     声明在 ScrollViewer 之后 → z 序在对话流之上，不会被消息盖住。
                     **卡可命中、可点击**：悬停看到预览之后，点一下就跳到那一轮（鼠标进卡要能取消收起定时器）。 -->
                <Popup x:Name="RailPreviewPopup" Placement="Right" AllowsTransparency="True" StaysOpen="True"
                       PopupAnimation="Fade" Grid.ColumnSpan="2">
                    <Border x:Name="RailPreviewCard" Width="288" Margin="8,0,0,0" Padding="10"
                            Cursor="Hand" MouseLeftButtonUp="OnRailPreviewClick"
                            MouseEnter="OnRailPreviewEnter" MouseLeave="OnRailPreviewLeave"
                            Background="{DynamicResource App.Surface.Floating}"
                            BorderBrush="{DynamicResource App.Line.Variant}" BorderThickness="1" CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.2" Direction="270"
                                              Color="{DynamicResource App.Color.Shadow}"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- 第一段：用户说了什么（空 → 回落"用户输入"，不摆空白） -->
                            <TextBlock Text="{loc:Value RailPreviewAsk}" FontSize="12" LineHeight="18"
                                       TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource App.Text.Primary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAskPreview}" Value="False">
                                                <Setter Property="Text" Value="{loc:Loc ai.rail.userFallback}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource App.Text.Muted}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- 第二段：助手回了什么（空 → 在跑说"仍在工作"、收尾说"暂无正文"，与参照同措辞） -->
                            <TextBlock x:Name="RailPreviewReply" FontSize="12" LineHeight="18" Margin="0,6,0,0"
                                       TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource App.Text.Secondary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{loc:Value RailPreviewReplyText}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasReplyPreview}" Value="False">
                                                <Setter Property="Text" Value="{loc:Value RailPreviewReplyFallbackKey}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource App.Text.Muted}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Popup>

            <!-- 输入区：页面底上的一张卡（技能条 / 编辑器 / 提及 / 输入框 / 工具行） -->
            <Border x:Name="ComposerCard" Grid.Column="1" Grid.Row="2" MaxWidth="928" HorizontalAlignment="Stretch"
                    Background="{DynamicResource App.Surface.Card}" BorderThickness="1"
                    BorderBrush="{DynamicResource App.Line.Variant}" CornerRadius="19" Padding="12" Margin="0,8,0,0">
                <StackPanel>
                    <!-- 技能条（有技能才出现；点 chip = 运行/填参数） -->
                    <ItemsControl ItemsSource="{Binding Skills}" Margin="0,0,0,6"
                                  ItemTemplate="{StaticResource AiSkillChipTemplate}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSkills}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- 技能编辑器（新建 / 编辑 / 从助手消息预填） -->
                    <StackPanel Margin="0,2,0,6">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSkillEditorOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{loc:Value SkillEditorTitleValue}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Text.Primary}"/>
                        <TextBlock Text="{loc:Loc ai.skill.editor.name}" FontSize="11" Margin="0,6,0,2"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                        <TextBox x:Name="SkillNameBox" Style="{StaticResource AiFieldBox}"
                                 Text="{Binding SkillName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{loc:Loc ai.skill.editor.description}" FontSize="11" Margin="0,6,0,2"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                        <TextBox Style="{StaticResource AiFieldBox}"
                                 Text="{Binding SkillDescription, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{loc:Loc ai.skill.editor.template}" FontSize="11" Margin="0,6,0,2"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                        <TextBox Style="{StaticResource AiFieldBox}" Height="64" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" Padding="8,5"
                                 Text="{Binding SkillTemplate, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{loc:Loc ai.skill.editor.macro}" FontSize="11" Margin="0,6,0,2"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="SkillMacroBox" Width="220" Height="30" HorizontalAlignment="Left"
                                      ItemsSource="{Binding MacroNames}" SelectedItem="{Binding SkillMacro, Mode=TwoWay}"/>
                            <Button Style="{StaticResource TonalButton}" Height="30" Width="30" Padding="0" Margin="6,0,0,0"
                                    ToolTip="{loc:Loc ai.skill.editor.macro}" Click="OnClearSkillMacro">
                                <m3:M3Icon Kind="close" Width="12" Height="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.Text.Secondary}"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Height="28" Padding="16,0" Content="{loc:Loc ai.skill.editor.save}" Click="OnSaveSkill">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanSaveSkill}" Value="False">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource TonalButton}" Height="28" Padding="14,0" Margin="8,0,0,0"
                                    Content="{loc:Loc ai.skill.editor.cancel}" Click="OnCancelSkillEditor"/>
                        </StackPanel>
                        <TextBlock Text="{loc:LocKey SkillEditorErrorKey}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.Line.Invalid}"/>
                    </StackPanel>

                    <!-- 宏管理面板（清单 + 选中脚本 + 编辑器；与技能编辑器同区同风格） -->
                    <StackPanel Margin="0,2,0,6">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMacroPanelOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid>
                            <TextBlock Text="{loc:Loc ai.macro.title}" FontWeight="SemiBold" HorizontalAlignment="Left"
                                       Foreground="{DynamicResource App.Text.Primary}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource TonalButton}" Height="26" Padding="12,0"
                                        Content="{loc:Loc ai.macro.new}" Click="OnNewMacro"/>
                                <Button Style="{StaticResource TonalButton}" Height="26" Padding="12,0" Margin="6,0,0,0"
                                        ToolTip="{loc:Loc ai.macro.close}" Click="OnCloseMacros">
                                    <m3:M3Icon Kind="close" Width="12" Height="12" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ListBox x:Name="MacroList" Height="110" Margin="0,6,0,0" Background="Transparent"
                                 BorderThickness="0"
                                 ItemsSource="{Binding Macros}"
                                 SelectedValue="{Binding SelectedMacroName, Mode=TwoWay}"
                                 SelectedValuePath="Name"
                                 SelectionChanged="OnMacroSelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding UpdatedAtText}" HorizontalAlignment="Right"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{loc:Loc ai.macro.script}" FontSize="11" Margin="0,6,0,2"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                        <TextBox x:Name="MacroScriptView" Style="{StaticResource AiFieldBox}" Height="96" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="8,5"
                                 FontFamily="Consolas"
                                 Text="{Binding SelectedMacroScript, Mode=OneWay}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Style="{StaticResource TonalButton}" Height="26" Padding="12,0"
                                    Content="{loc:Loc ai.macro.run}" Click="OnRunMacro"/>
                            <Button Style="{StaticResource TonalButton}" Height="26" Padding="12,0" Margin="6,0,0,0"
                                    Content="{loc:Loc ai.macro.edit}" Click="OnEditMacro"/>
                            <Button Style="{StaticResource TonalButton}" Height="26" Padding="12,0" Margin="6,0,0,0"
                                    Content="{loc:Loc ai.macro.delete}" Click="OnDeleteMacro"/>
                        </StackPanel>

                        <!-- 宏编辑器（新建 / 编辑；JSON 文本，引擎校验） -->
                        <StackPanel Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMacroEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{loc:Value MacroEditorTitleValue}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.Text.Primary}"/>
                            <TextBlock Text="{loc:Loc ai.macro.editor.name}" FontSize="11" Margin="0,6,0,2"
                                       Foreground="{DynamicResource App.Text.Secondary}"/>
                            <TextBox Style="{StaticResource AiFieldBox}"
                                     Text="{Binding MacroDraftName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{loc:Loc ai.macro.editor.script}" FontSize="11" Margin="0,6,0,2"
                                       Foreground="{DynamicResource App.Text.Secondary}"/>
                            <TextBox Style="{StaticResource AiFieldBox}" Height="96" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" Padding="8,5" FontFamily="Consolas"
                                     Text="{Binding MacroDraftScript, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Height="28" Padding="16,0" Content="{loc:Loc ai.macro.editor.save}" Click="OnSaveMacro">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanSaveMacro}" Value="False">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Style="{StaticResource TonalButton}" Height="28" Padding="14,0" Margin="8,0,0,0"
                                        Content="{loc:Loc ai.macro.editor.cancel}" Click="OnCancelMacroEditor"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{loc:LocKey MacroErrorKey}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.Line.Invalid}"/>
                    </StackPanel>

                    <!-- 技能参数行（有占位的技能：一占位一输入框，填完点「运行」） -->
                    <StackPanel Margin="0,2,0,6">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSkillRunOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{loc:Loc ai.skill.params.title}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Text.Primary}"/>
                        <ItemsControl ItemsSource="{Binding SkillParameters}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Name}" Width="120" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                                        <TextBox Style="{StaticResource AiFieldBox}" Width="220"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Style="{StaticResource PrimaryPillButton}" Height="28" Padding="16,0"
                                    Content="{loc:Loc ai.skill.params.run}" Click="OnRunSkillWithParams"/>
                            <Button Style="{StaticResource TonalButton}" Height="28" Padding="14,0" Margin="8,0,0,0"
                                    Content="{loc:Loc ai.skill.editor.cancel}" Click="OnCancelSkillRun"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 提及 chip 区（待发集合；点 ✕ 摘除） -->
                    <ItemsControl ItemsSource="{Binding Mentions}" Margin="0,0,0,4">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMentions}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource App.Accent.Container}" CornerRadius="12"
                                        Padding="8,2" Margin="0,0,6,4">
                                    <StackPanel Orientation="Horizontal">
                                        <m3:M3Icon Kind="{Binding Kind, Converter={StaticResource AiMentionIconConverter}}"
                                                   Width="12" Height="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource App.Text.OnContainer}"/>
                                        <TextBlock Text="@" Margin="5,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource App.Text.OnContainer}"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource App.Text.OnContainer}"/>
                                        <Button Style="{StaticResource TonalButton}" Height="18" Width="18" Padding="0"
                                                Margin="6,0,0,0" ToolTip="{loc:Loc ai.mention.remove}"
                                                Click="OnRemoveMention">
                                            <m3:M3Icon Kind="close" Width="10" Height="10"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource App.Text.OnContainer}"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 提及候选面板（@ 触发；↑↓ 移动、Enter/点击选入、Esc 关闭） -->
                    <Border Margin="0,0,0,6" Padding="6,4" MaxHeight="200"
                            Background="{DynamicResource App.Surface.Floating}"
                            BorderBrush="{DynamicResource App.Line.Variant}" BorderThickness="1" CornerRadius="12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMentionPanelOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ListBox x:Name="MentionList" Background="Transparent" BorderThickness="0" MaxHeight="190"
                                 ItemsSource="{Binding MentionCandidates}"
                                 SelectedIndex="{Binding MentionSelectionIndex, Mode=OneWay}"
                                 ItemTemplate="{StaticResource AiMentionCandidateTemplate}"
                                 PreviewMouseLeftButtonUp="OnMentionCandidateClicked"/>
                    </Border>

                    <!-- 输入框：多行无边框。**不摆占位提示**——"给 AI 派个活…（Enter 发送，Shift+Enter 换行）"
                         是把显式约定写进界面噪音里：两条键位在快捷键总表里已有归属，空输入框自己就说明"该打字了"。 -->
                    <Grid>
                        <TextBox x:Name="ComposerBox" MinHeight="56" MaxHeight="200" TextWrapping="Wrap" AcceptsReturn="True"
                                 Text="{Binding ComposerText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Padding="0,4"
                                 Foreground="{DynamicResource App.Text.Primary}"/>
                    </Grid>

                    <!-- 工具行：左 = @提及 / 技能编辑器 / 模式三段；右 = 用量环 / 模型下拉 / 发送·停止 -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="MentionButton" Style="{StaticResource SideIconButton}" Width="30" Height="28"
                                    Tag="{loc:Loc ai.composer.mention}" Click="OnInsertMention">
                                <m3:M3Icon Kind="at" Width="14" Height="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.Text.Secondary}"/>
                            </Button>
                            <Button x:Name="SkillButton" Style="{StaticResource SideIconButton}" Width="30" Height="28"
                                    Tag="{loc:Loc ai.skill.new}" Click="OnNewSkill">
                                <m3:M3Icon Kind="auto-fix" Width="14" Height="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.Text.Secondary}"/>
                            </Button>
                            <!-- 宏管理（清单 / 查看脚本 / 新建 / 编辑 / 运行 / 删除；此前宏只能靠对话让 AI 操作） -->
                            <Button x:Name="MacroButton" Style="{StaticResource SideIconButton}" Width="30" Height="28"
                                    Tag="{loc:Loc ai.macro.title}" Click="OnOpenMacros">
                                <m3:M3Icon Kind="wrench-outline" Width="14" Height="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.Text.Secondary}"/>
                            </Button>
                            <!-- 模式三段（只读 / 每次确认 / 自动应用）：模式可见性是产品口径；
                                 段宽冻结（中文基线，英文只缩字号/走短式），语言切换不改变导航条几何 -->
                            <views:SlidingNavStrip x:Name="ModeStrip" Style="{StaticResource SlidingNavStripStyle}"
                                                   Margin="6,0,0,0" SelectedIndex="{Binding ModeIndex, Mode=TwoWay}">
                                <ListBoxItem ToolTip="{loc:Loc ai.mode.readonly}">
                                    <ListBoxItem.Style>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource SlidingNavStripItemStyle}">
                                            <Setter Property="Height" Value="28"/>
                                            <Setter Property="Width" Value="78"/>
                                            <Setter Property="FontSize" Value="12"/>
                                        </Style>
                                    </ListBoxItem.Style>
                                    <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                                               views:LocFit.Text="{loc:Fit ai.mode.readonly}" views:LocFit.Mode="Shrink"/>
                                </ListBoxItem>
                                <ListBoxItem ToolTip="{loc:Loc ai.mode.confirmEach}">
                                    <ListBoxItem.Style>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource SlidingNavStripItemStyle}">
                                            <Setter Property="Height" Value="28"/>
                                            <Setter Property="Width" Value="78"/>
                                            <Setter Property="FontSize" Value="12"/>
                                        </Style>
                                    </ListBoxItem.Style>
                                    <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                                               views:LocFit.Text="{loc:Fit ai.mode.confirmEach}" views:LocFit.Mode="Shrink"/>
                                </ListBoxItem>
                                <ListBoxItem ToolTip="{loc:Loc ai.mode.autoApply}">
                                    <ListBoxItem.Style>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource SlidingNavStripItemStyle}">
                                            <Setter Property="Height" Value="28"/>
                                            <Setter Property="Width" Value="78"/>
                                            <Setter Property="FontSize" Value="12"/>
                                        </Style>
                                    </ListBoxItem.Style>
                                    <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                                               views:LocFit.Text="{loc:Fit ai.mode.autoApply}" views:LocFit.Mode="Shrink"/>
                                </ListBoxItem>
                            </views:SlidingNavStrip>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 上下文用量环 = 一枚 ghost 图标按钮（28 方形 + 圆角，悬浮给底色），
                                 环本体只占 14（与同排图标同高）。读数来自 AI 运行时的只读读数；没有读数 = 空环。
                                 悬浮（或聚焦）即在环上方弹出**容量面板**：标题 + 已用/窗口摘要 + 分段占用条 + 分项占比。 -->
                            <Border x:Name="ContextRingButton" Width="28" Height="28" Margin="0,0,6,0"
                                    VerticalAlignment="Center" CornerRadius="6" Background="Transparent"
                                    Cursor="Hand" Focusable="True" FocusVisualStyle="{x:Null}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource App.State.Hover}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource App.State.Hover}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <local:UsageRing x:Name="ContextRing" Width="14" Height="14"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Percent="{Binding ContextUsagePercent}"
                                                 IconBrush="{DynamicResource App.Text.Muted}"/>
                            </Border>
                            <Popup x:Name="ContextUsagePopup" PlacementTarget="{Binding ElementName=ContextRingButton}"
                                   Placement="Top" VerticalOffset="-6"
                                   AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade"
                                   IsOpen="{Binding IsContextPanelOpen, Mode=OneWay}">
                                <Border x:Name="ContextUsagePanel" MaxWidth="320" Padding="14,12"
                                        Background="{DynamicResource App.Surface.Dialog}"
                                        BorderBrush="{DynamicResource App.Line.Variant}" BorderThickness="1"
                                        CornerRadius="12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.18"
                                                          Color="{DynamicResource App.Color.Shadow}"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <!-- 标题行：面板名 + 右侧「已用 / 窗口 (百分比)」 -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource App.Text.Primary}"
                                                       Text="{loc:Loc ai.usage.panel.title}"/>
                                            <TextBlock Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" FontSize="11"
                                                       FontFamily="{DynamicResource App.Font.Mono}"
                                                       Foreground="{DynamicResource App.Text.Muted}"
                                                       Text="{loc:Value ContextSummaryValue}"/>
                                        </Grid>
                                        <!-- 分段占用条：各分项按占比分段着色（同一强调色的五档深浅），底色 = 弱轨道 -->
                                        <Border Height="8" CornerRadius="4" ClipToBounds="True"
                                                Background="{DynamicResource App.Surface.Base}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasContextSources}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <local:UsageSegmentStrip Height="8" Segments="{Binding ContextSourceRows}"/>
                                        </Border>
                                        <!-- 一行说明：窗口是共享的（面板底下这块只在有分项时出现） -->
                                        <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource App.Text.Muted}"
                                                   Text="{loc:Loc ai.usage.panel.hint}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasContextSources}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- 分项列表：色块 + 来源名 + 占比 -->
                                        <StackPanel Margin="0,10,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasContextSources}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Margin="0,0,0,6" FontSize="11"
                                                       Foreground="{DynamicResource App.Text.Muted}"
                                                       Text="{loc:Loc ai.usage.panel.sources}"/>
                                            <ItemsControl ItemsSource="{Binding ContextSourceRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <local:UsageSourceSwatch Width="8" Height="8"
                                                                                     VerticalAlignment="Center"
                                                                                     ToneIndex="{Binding ToneIndex}"/>
                                                            <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="11"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource App.Text.Secondary}"
                                                                       Text="{loc:Value Label}"/>
                                                            <TextBlock Grid.Column="2" Margin="12,0,0,0" FontSize="11"
                                                                       VerticalAlignment="Center"
                                                                       FontFamily="{DynamicResource App.Font.Mono}"
                                                                       Foreground="{DynamicResource App.Text.Primary}"
                                                                       Text="{loc:Value PercentValue}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <!-- 没有读数：只摆一行"还没有上下文读数"，不画空条空表 -->
                                        <TextBlock Margin="0,2,0,0" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource App.Text.Muted}"
                                                   Text="{loc:Loc ai.usage.context.none}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasContextSources}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <!-- 模型下拉（标签 = 供应商 / 模型；选择即写助手偏好，与 /model 同一条路径） -->
                            <ComboBox x:Name="ModelBox" Height="32" MaxWidth="220" MinWidth="120" Margin="0,0,6,0"
                                      VerticalAlignment="Center" ToolTip="{loc:Loc ai.composer.model}"
                                      ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxStyle}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasModels}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" FontSize="12"
                                                   FontFamily="{DynamicResource App.Font.Mono}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource App.Text.Primary}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{loc:Value ModelLabelValue}" FontSize="12" Margin="0,0,6,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="200"
                                       FontFamily="{DynamicResource App.Font.Mono}"
                                       Foreground="{DynamicResource App.Text.Muted}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasModels}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- 发送 / 停止：同位置互斥切换（运行中 → 停止；否则发送） -->
                            <Button x:Name="SendButton" Tag="{loc:Loc ai.composer.send}" Click="OnSend">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ComposerSendButton}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTurnRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CanSend}" Value="False">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <m3:M3Icon Kind="arrow-up" Width="15" Height="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="StopButton" Tag="{loc:Loc ai.composer.stop}" Click="OnStop"
                                    ToolTip="{loc:Loc ai.composer.stopAny}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ComposerStopButton}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTurnRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <!-- 实心方块（与参照同款：停止 = 一个填色的方，不是描边图标） -->
                                <Rectangle Width="10" Height="10" RadiusX="1.5" RadiusY="1.5"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{loc:LocKey LastErrorKey}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                               Foreground="{DynamicResource App.Line.Invalid}"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
