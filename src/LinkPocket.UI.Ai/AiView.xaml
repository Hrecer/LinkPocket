<UserControl x:Class="LinkPocket.Views.AiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LinkPocket.I18n;assembly=LinkPocket.I18n"
             xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
             xmlns:views="clr-namespace:LinkPocket.Views;assembly=LinkPocket.UIKit"
             xmlns:local="clr-namespace:LinkPocket.UI.Ai"
             Background="{DynamicResource App.Surface.Base}">
    <UserControl.Resources>
        <local:AiMentionKindIconConverter x:Key="AiMentionIconConverter"/>
        <!-- 页面内输入域（M3 填充式字段，唯一一份）：圆角 12 + 承载面压深一档的填充 + 聚焦换面板底。
             **方形描边文本框一律不用**（那是"没接样式"）。**不设占位水印**：水印画在模板里、
             拿不到自适应通道（放不下只能被裁成省略号），故一律不设。承载面在卡面/浅带层/强调容器
             上都成立（填充取的是页面底承托面的悬停支，比三者都深）。 -->
        <Style x:Key="AiFieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource App.Accent.Fill}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="12" Background="{DynamicResource App.Surface.Hover}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Surface.Panel}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 时间线上的"行按钮"（回合分隔行 / 工具行共用一份语言）：无底无边、悬停压深一档。
             行铺在**页面底**上 ⇒ 悬停取页面底承托面的那一支（App.Surface.Hover），不借卡面的。 -->
        <Style x:Key="AiRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Surface.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 消息悬停操作行上的小按钮（复制 / 存为技能）：同"行按钮"的底，字号小一档 -->
        <Style x:Key="AiGhostTextButton" TargetType="Button" BasedOn="{StaticResource AiRowButton}">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource App.Text.Secondary}"/>
        </Style>
        <!-- 审批卡的选项行：整行可点（主文案 + 一行说明）；默认焦点落在「拒绝」由视图按 Tag 找。
             底 = 透明 + 1px 弱描边（卡底是强调容器色，选项用状态叠层表达悬停/聚焦，不发明新色）。 -->
        <Style x:Key="AiApprovalOption" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.Line.Variant}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.State.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.State.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ⚠️ 模板必须**先定义后引用**：DataTemplate 内嵌的 StaticResource 引用前向键（键定义在引用之后）
             时解析被推迟到运行期、且找不到同字典的兄弟键 → 首次渲染直接 XamlParseException（审批卡/工具卡
             都会炸掉整个对话流）。P3+-2 探针 ai 套件首渲即红后改为本顺序；新增模板一律放在引用者之前。
             探针的「模板可独立实例化」读数钉住这条不变量（见 WARNINGS 134）。 -->
        <!-- 字段级 diff 的一行：字段名走键；值里字符串 = 用户数据原样（长值截断到一行 + 悬浮看全文）。
             冻结宽度口径（中文基线）：字段名 56 = 4 字 × 11pt（44px）+ 余量；
             值格 74 = 可用宽（286 − 14×2 − 项内距）下"旧 → 新"三段并列的最长可读宽。 -->
        <DataTemplate x:Key="AiFieldRowTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock Text="{loc:Value FieldName}" FontSize="11" Width="56" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource App.Text.Secondary}"/>
                <TextBlock Text="{loc:Value Before}" FontSize="11" Width="74" TextTrimming="CharacterEllipsis"
                           ToolTip="{loc:Value Before}" Foreground="{DynamicResource App.Text.Muted}"/>
                <TextBlock Text="→" FontSize="11" Margin="4,0" Foreground="{DynamicResource App.Text.Muted}"/>
                <TextBlock Text="{loc:Value After}" FontSize="11" Width="74" TextTrimming="CharacterEllipsis"
                           ToolTip="{loc:Value After}" Foreground="{DynamicResource App.Text.Primary}"/>
            </StackPanel>
        </DataTemplate>

        <!-- 台账一行（对话流内联变更卡与右栏共用同一份模板）：分类 + 实体 + 位置 + 字段级明细 + 撤销口径。
             "仅实体级"与"另有 N 项未列出"如实标注（功能书 §7.8）。 -->
        <DataTemplate x:Key="AiChangeRowTemplate">
            <StackPanel Margin="0,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:LocKey KindKey}" FontSize="12" Foreground="{DynamicResource App.Accent.Text}"/>
                    <TextBlock Text="{Binding EntityLabel}" FontSize="12" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource App.Text.Primary}"/>
                </StackPanel>
                <TextBlock Text="{loc:Value PathValue}" FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource App.Text.Muted}"/>
                <TextBlock Text="{Binding EntitySuffix}" FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource App.Text.Muted}"/>
                <ItemsControl ItemsSource="{Binding VisibleFields}" ItemTemplate="{StaticResource AiFieldRowTemplate}"/>
                <Button Height="24" Padding="8,0" FontSize="11"
                        HorizontalAlignment="Left" Margin="0,2,0,0" Content="{loc:LocKey ExpandKey}"
                        Click="OnToggleChangeExpand">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TonalButton}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanExpand}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:LocKey UndoableKey}" FontSize="11" Foreground="{DynamicResource App.Text.Muted}"/>
                    <TextBlock Text="{loc:LocKey SourceKey}" FontSize="11" Margin="8,0,0,0"
                               Foreground="{DynamicResource App.Accent.Text}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSourceNote}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- 对账与引擎 diff 不一致（功能书 §7.1：只标注不改写事实）——与 SourceKey 同带、独立可见性 -->
                    <TextBlock Text="{loc:LocKey MismatchKey}" FontSize="11" Margin="8,0,0,0"
                               Foreground="{DynamicResource App.Accent.Text}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMismatch}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <TextBlock Text="{loc:Value TruncatedValue}" FontSize="11" Foreground="{DynamicResource App.Accent.Text}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTruncated}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- ================= 对话流模板（按 Kind 选择） =================
             文案一律走键；用户数据 / 模型输出 / 机器面标识符原样显示。 -->

        <!-- 回合分隔行：整行可点（折叠该轮）；行底一条 1px 细线 -->
        <DataTemplate x:Key="AiTurnHeaderTemplate">
            <StackPanel Margin="0,12,0,2">
                <Button Style="{StaticResource AiRowButton}" Click="OnToggleTurn"
                        ToolTip="{loc:LocKey ToggleKey}">
                    <StackPanel Orientation="Horizontal">
                        <m3:M3Icon Kind="chevron-down" Width="13" Height="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.Text.Muted}">
                            <m3:M3Icon.Style>
                                <Style TargetType="{x:Type m3:M3Icon}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </m3:M3Icon.Style>
                        </m3:M3Icon>
                        <m3:M3Icon Kind="chevron-right" Width="13" Height="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.Text.Muted}">
                            <m3:M3Icon.Style>
                                <Style TargetType="{x:Type m3:M3Icon}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </m3:M3Icon.Style>
                        </m3:M3Icon>
                        <TextBlock Text="{loc:Value HeaderValue}" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                    </StackPanel>
                </Button>
                <Border Height="1" Background="{DynamicResource App.Line.Variant}"/>
            </StackPanel>
        </DataTemplate>

        <!-- 用户消息：右对齐气泡（右上角缺角）+ 上方提及 chip + 悬停操作行 -->
        <DataTemplate x:Key="AiUserTemplate">
            <StackPanel x:Name="UserRoot" Margin="0,8,0,8" HorizontalAlignment="Right" MaxWidth="560">
                <ItemsControl ItemsSource="{Binding Mentions}" Margin="0,0,0,4" HorizontalAlignment="Right">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMentions}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Right"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource App.Accent.Container}" CornerRadius="12"
                                    Padding="8,2" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <m3:M3Icon Kind="{Binding Kind, Converter={StaticResource AiMentionIconConverter}}"
                                               Width="12" Height="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource App.Text.OnContainer}"/>
                                    <TextBlock Text="@" Margin="4,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource App.Text.OnContainer}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource App.Text.OnContainer}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Background="{DynamicResource App.Surface.Card}" BorderThickness="1"
                        BorderBrush="{DynamicResource App.Line.Variant}"
                        CornerRadius="16,16,4,16" Padding="14,10">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource App.Text.Primary}"/>
                </Border>
                <StackPanel x:Name="UserActions" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,2,0,0" Visibility="Collapsed">
                    <Button Style="{StaticResource AiGhostTextButton}" Content="{loc:Loc ai.feed.copy}"
                            Click="OnCopyMessage"/>
                    <TextBlock Text="{loc:Value TimeValue}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource App.Text.Muted}"/>
                </StackPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <Trigger SourceName="UserRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="UserActions" Property="Visibility" Value="Visible"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 助手消息：无气泡，左对齐 Markdown；悬停出现操作行 -->
        <DataTemplate x:Key="AiAssistantTemplate">
            <StackPanel x:Name="AssistantRoot" Margin="0,8,0,8">
                <views:MarkdownText Markdown="{Binding RenderText}" FontSize="13"/>
                <StackPanel x:Name="AssistantActions" Orientation="Horizontal" Margin="0,2,0,0" Visibility="Collapsed">
                    <Button Style="{StaticResource AiGhostTextButton}" Content="{loc:Loc ai.feed.copy}"
                            Click="OnCopyMessage"/>
                    <Button Style="{StaticResource AiGhostTextButton}" Content="{loc:Loc ai.skill.saveFromMessage}"
                            Click="OnSaveMessageAsSkill"/>
                    <TextBlock Text="{loc:Value TimeValue}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource App.Text.Muted}"/>
                </StackPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <Trigger SourceName="AssistantRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="AssistantActions" Property="Visibility" Value="Visible"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 工具调用行：单行摘要（域图标 + 动作短语 + 对象 + 状态），点开才是详情（参数 / 结果 / 变更卡） -->
        <DataTemplate x:Key="AiToolTemplate">
            <StackPanel x:Name="ToolRoot" Margin="0,2,0,2">
                <Button Style="{StaticResource AiRowButton}" Click="OnToggleToolRow">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <m3:M3Icon Grid.Column="0" Kind="{Binding IconKind}" Width="15" Height="15"
                                   VerticalAlignment="Center" Foreground="{DynamicResource App.Text.Muted}"/>
                        <TextBlock Grid.Column="1" Text="{loc:LocKey ActionKey}" FontSize="13" Margin="7,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource App.Text.Primary}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Summary}" FontSize="11" Margin="8,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   FontFamily="{DynamicResource App.Font.Mono}"
                                   Foreground="{DynamicResource App.Text.Muted}"/>
                        <TextBlock Grid.Column="3" Text="{loc:LocKey StateKey}" FontSize="11" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource App.Accent.Text}"/>
                        <m3:M3Icon Grid.Column="4" x:Name="ToolChevron" Kind="chevron-right" Width="13" Height="13"
                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.Text.Muted}"/>
                    </Grid>
                </Button>
                <Border x:Name="ToolDetail" Margin="8,2,0,2" Padding="10,0,0,0" Visibility="Collapsed"
                        BorderThickness="1,0,0,0" BorderBrush="{DynamicResource App.Line.Variant}">
                    <StackPanel>
                    <TextBlock Text="{loc:Loc ai.tool.args}" FontSize="11" Margin="0,2,0,2"
                               Foreground="{DynamicResource App.Text.Muted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasArgs}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ArgsText}" FontSize="10.5" TextWrapping="Wrap"
                               FontFamily="{DynamicResource App.Font.Mono}"
                               Foreground="{DynamicResource App.Text.Secondary}"/>
                    <TextBlock Text="{loc:Loc ai.tool.result}" FontSize="11" Margin="0,6,0,2"
                               Foreground="{DynamicResource App.Text.Muted}"/>
                    <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource App.Text.Secondary}"/>
                    <!-- 内联变更卡（功能书 §7.5）：本调用的逐条变更，展开/收起由各行自持 -->
                    <StackPanel Margin="0,6,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasChanges}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{loc:Value ChangeCountValue}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Text.Primary}"/>
                        <ItemsControl ItemsSource="{Binding Changes}" Margin="0,2,0,0"
                                      ItemTemplate="{StaticResource AiChangeRowTemplate}"/>
                    </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="ToolDetail" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ToolChevron" Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="90"/>
                        </Setter.Value>
                    </Setter>
                    <Setter TargetName="ToolChevron" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 批 / 宏审批卡的一行步骤 -->
        <DataTemplate x:Key="AiApprovalStepTemplate">
            <StackPanel Margin="0,2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Value IndexLabel}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Text.OnContainer}"/>
                    <TextBlock Text="{Binding Command}" FontSize="11" Margin="6,0,0,0"
                               Foreground="{DynamicResource App.Text.OnContainer}"/>
                    <TextBlock Text="{loc:Loc ai.approve.destructive}" FontSize="11" Margin="6,0,0,0"
                               Foreground="{DynamicResource App.Text.OnContainer}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Value TargetValue}" FontSize="11"
                               Foreground="{DynamicResource App.Text.OnContainer}"/>
                    <TextBlock Text="{loc:Loc ai.approve.steps.onError}" FontSize="11" Margin="6,0,0,0"
                               Foreground="{DynamicResource App.Text.OnContainer}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOnError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{loc:Value OnErrorValue}" FontSize="11" Margin="4,0,0,0"
                               Foreground="{DynamicResource App.Text.OnContainer}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOnError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- 审批卡（功能书 §8.2）：做什么（本地化动作短语 + 机器面命令名）/ 动哪些对象（名称·数量·路径）/
             影响预览（引擎给的或如实说明无法预览）/ 批的逐步骤影响 / 「会话允许」将记住的作用域 /
             四档**纵向选项**（每档主文案 + 一行说明；顺序固定），**默认焦点落在「拒绝」**（视图侧按 Tag 找按钮）。 -->
        <DataTemplate x:Key="AiApprovalTemplate">
            <Border Background="{DynamicResource App.Accent.Container}" CornerRadius="18" Padding="14,12"
                    Margin="0,6,0,6" MaxWidth="560" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="{loc:Loc ai.approve.title}" FontWeight="SemiBold" Foreground="{DynamicResource App.Text.OnContainer}"/>
                    <!-- 做什么 -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{loc:LocKey ActionKey}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Text.OnContainer}"/>
                        <TextBlock Text="{Binding Command}" FontSize="11" Margin="8,0,0,0"
                                   FontFamily="{DynamicResource App.Font.Mono}"
                                   Foreground="{DynamicResource App.Text.OnContainer}"/>
                    </StackPanel>
                    <!-- 动哪些对象：名称（用户数据原样）/ 数量 / 不可逆徽标 -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{loc:Loc ai.approve.targetLabel}" FontSize="12"
                                   Foreground="{DynamicResource App.Text.OnContainer}"/>
                        <TextBlock Text="{loc:Value TargetValue}" FontSize="12" Margin="6,0,0,0"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource App.Text.OnContainer}"/>
                        <TextBlock Text="{loc:Loc ai.approve.destructive}" FontSize="12" Margin="8,0,0,0"
                                   Foreground="{DynamicResource App.Text.OnContainer}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <!-- 名称列表截断：另有 N 项未列出（如实标注，不假装列全） -->
                    <TextBlock Text="{loc:Value MoreTargetsValue}" FontSize="11"
                               Foreground="{DynamicResource App.Text.OnContainer}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMoreTargets}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- 目标路径（canonical → 当前语言投影） -->
                    <TextBlock Text="{loc:Value TargetPathValue}" FontSize="11"
                               Foreground="{DynamicResource App.Text.OnContainer}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTargetPath}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- 影响预览：引擎随 LP.SEC.003 下发的影响面；没有就如实说"无法预览" -->
                    <TextBlock Text="{loc:Value ImpactValue}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                               Foreground="{DynamicResource App.Text.OnContainer}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasImpact}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{loc:Loc ai.approve.noPreview}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                               Foreground="{DynamicResource App.Text.OnContainer}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPreview}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- 批 / 宏：逐步骤影响 -->
                    <StackPanel Margin="0,6,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasApprovalSteps}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{loc:Value StepsTitleValue}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Text.OnContainer}"/>
                        <ItemsControl ItemsSource="{Binding ApprovalSteps}" Margin="0,2,0,0"
                                      ItemTemplate="{StaticResource AiApprovalStepTemplate}"/>
                    </StackPanel>
                    <TextBlock Text="{loc:LocKey StepsNoteKey}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                               Foreground="{DynamicResource App.Text.OnContainer}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasStepsNote}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- 「本次会话总是允许」将记住的作用域（不允许只显示"记住"） -->
                    <TextBlock Text="{loc:Value AllowScopeValue}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                               Foreground="{DynamicResource App.Text.OnContainer}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAllowScope}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- 四档：允许一次 → 会话允许 → 拒绝 → 拒绝并停止（纵向、顺序固定） -->
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsApprovalOpen}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Style="{StaticResource AiApprovalOption}" Tag="AiApprovalAllowOnce" Click="OnApproveOnce">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc ai.approve.allowOnce}" FontSize="13"
                                           Foreground="{DynamicResource App.Text.OnContainer}"/>
                                <TextBlock Text="{loc:Loc ai.approve.opt.once}" FontSize="11"
                                           Foreground="{DynamicResource App.Text.OnContainer}" Opacity="0.75"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AiApprovalOption}" Tag="AiApprovalAllowSession" Click="OnApproveSession">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc ai.approve.allowSession}" FontSize="13"
                                           Foreground="{DynamicResource App.Text.OnContainer}"/>
                                <TextBlock Text="{loc:Loc ai.approve.opt.session}" FontSize="11"
                                           Foreground="{DynamicResource App.Text.OnContainer}" Opacity="0.75"/>
                            </StackPanel>
                        </Button>
                        <!-- 默认焦点落在「拒绝」（视图按 Tag 找它）；不设 IsDefault——否则焦点在别的选项上时
                             按 Enter 会触发「拒绝」，与用户点的那一档对不上 -->
                        <Button Style="{StaticResource AiApprovalOption}" Tag="AiApprovalReject" Click="OnReject">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc ai.approve.reject}" FontSize="13"
                                           Foreground="{DynamicResource App.Text.OnContainer}"/>
                                <TextBlock Text="{loc:Loc ai.approve.opt.reject}" FontSize="11"
                                           Foreground="{DynamicResource App.Text.OnContainer}" Opacity="0.75"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AiApprovalOption}" Tag="AiApprovalRejectStop" Click="OnRejectStop">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc ai.approve.rejectStop}" FontSize="13"
                                           Foreground="{DynamicResource App.Text.OnContainer}"/>
                                <TextBlock Text="{loc:Loc ai.approve.opt.rejectStop}" FontSize="11"
                                           Foreground="{DynamicResource App.Text.OnContainer}" Opacity="0.75"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <!-- 理由（可选；拒绝时回灌模型，模型同轮换方案） -->
                    <TextBox Style="{StaticResource AiFieldBox}" Margin="0,2,0,0"
                             Text="{Binding DataContext.ApprovalReason, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding Reason}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource App.Text.OnContainer}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 提示条（压缩事实 / 限流等待 / 斜杠回话）：居中标记行（两侧 1px 细线） -->
        <DataTemplate x:Key="AiNoticeTemplate">
            <Grid Margin="0,8,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Height="1" VerticalAlignment="Center" Margin="0,0,10,0"
                        Background="{DynamicResource App.Line.Variant}"/>
                <TextBlock Grid.Column="1" Text="{loc:Value NoticeValue}" FontSize="12" TextWrapping="Wrap"
                           MaxWidth="480" TextAlignment="Center"
                           Foreground="{DynamicResource App.Text.Secondary}"/>
                <Border Grid.Column="2" Height="1" VerticalAlignment="Center" Margin="10,0,0,0"
                        Background="{DynamicResource App.Line.Variant}"/>
            </Grid>
        </DataTemplate>

        <!-- 技能 chip（点名称 = 运行 / 填参数；✕ = 删除）：技能条与参数行同一份语言 -->
        <DataTemplate x:Key="AiSkillChipTemplate">
            <Border Background="{DynamicResource App.Surface.TintCard}" CornerRadius="14" Padding="3,2" Margin="0,0,6,6">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource TonalButton}" Height="24" Padding="10,0"
                            Content="{Binding Name}" Click="OnRunSkill" ToolTip="{loc:Loc ai.skill.params.run}"/>
                    <Button Style="{StaticResource TonalButton}" Height="24" Width="24" Padding="0" Margin="4,0,0,0"
                            Click="OnDeleteSkill" ToolTip="{loc:Loc ai.skill.delete}">
                        <m3:M3Icon Kind="close" Width="12" Height="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- 提及候选一行（图标 + 名称 + 位置；点击选入） -->
        <DataTemplate x:Key="AiMentionCandidateTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,3">
                <m3:M3Icon Kind="{Binding Kind, Converter={StaticResource AiMentionIconConverter}}" Width="14" Height="14"
                           VerticalAlignment="Center" Foreground="{DynamicResource App.Text.Secondary}"/>
                <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource App.Text.Primary}"/>
                <TextBlock Text="{loc:Value PathValue}" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource App.Text.Muted}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPath}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <local:AiFeedTemplateSelector x:Key="AiFeedSelector"
                                      TurnHeaderTemplate="{StaticResource AiTurnHeaderTemplate}"
                                      UserTemplate="{StaticResource AiUserTemplate}"
                                      AssistantTemplate="{StaticResource AiAssistantTemplate}"
                                      ToolTemplate="{StaticResource AiToolTemplate}"
                                      ApprovalTemplate="{StaticResource AiApprovalTemplate}"
                                      NoticeTemplate="{StaticResource AiNoticeTemplate}"/>

        <!-- 左栏会话一行：状态槽（运行中转圈 / 空闲小点）+ 标题 + 时间 + 变更数徽标；
             悬停出现「更多」（重命名 / 导出 / 删除，与右键菜单同一套）。 -->
        <DataTemplate x:Key="AiSessionItemTemplate">
            <Grid x:Name="SessionRoot" Margin="0,1" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <m3:M3Icon Grid.Column="0" Kind="refresh" Width="12" Height="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource App.Text.Muted}">
                    <m3:M3Icon.Style>
                        <Style TargetType="{x:Type m3:M3Icon}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </m3:M3Icon.Style>
                </m3:M3Icon>
                <StackPanel Grid.Column="1" Margin="0,4">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13"
                               Foreground="{DynamicResource App.Text.Primary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- 就地重命名（Enter 提交 / Esc 取消，不做失焦提交——无归属的失焦是时序炸弹，见 WARNINGS 34） -->
                    <TextBox x:Name="RenameBox" Tag="AiRenameBox" Height="26" FontSize="13"
                             Text="{Binding DataContext.RenameText, RelativeSource={RelativeSource AncestorType=ListBox}, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnRenameKeyDown">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource AiFieldBox}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock Text="{loc:Value TimeValue}" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource App.Text.Muted}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="4,2,0,0">
                    <Border x:Name="ChangeBadge" Background="{DynamicResource App.Support.Container}" CornerRadius="9"
                            Padding="6,1" Margin="0,0,4,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasChanges}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{loc:Value ChangeCountValue}" FontSize="10.5"
                                   Foreground="{DynamicResource App.Text.Primary}"/>
                    </Border>
                    <Button x:Name="SessionMore" Style="{StaticResource SideIconButton}" Width="22" Height="20"
                            Padding="2" Visibility="Collapsed" Tag="{loc:Loc ai.sessions.more}" Click="OnSessionMore">
                        <m3:M3Icon Kind="dots-horizontal" Width="13" Height="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                    </Button>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="SessionRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="SessionMore" Property="Visibility" Value="Visible"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 引擎审计一行：命令/结果/耗时/干跑与嵌套标记是机器面原样；时间走时钟投影。 -->
        <DataTemplate x:Key="AiEngineRowTemplate">
            <StackPanel Margin="0,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Command}" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource App.Text.Primary}"/>
                    <TextBlock Text="{loc:LocKey ResultKey}" FontSize="11" Margin="6,0,0,0"
                               Foreground="{DynamicResource App.Accent.Text}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Value TimeValue}" FontSize="11" Foreground="{DynamicResource App.Text.Muted}"/>
                    <TextBlock Text="{Binding ElapsedText}" FontSize="11" Margin="8,0,0,0"
                               Foreground="{DynamicResource App.Text.Muted}"/>
                    <TextBlock Text="{Binding ErrorCode}" FontSize="11" Margin="8,0,0,0"
                               Foreground="{DynamicResource App.Accent.Text}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Loc ai.audit.flag.dryRun}" FontSize="11" Foreground="{DynamicResource App.Text.Secondary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DryRun}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{loc:Loc ai.audit.flag.nested}" FontSize="11" Margin="8,0,0,0"
                               Foreground="{DynamicResource App.Text.Secondary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNested}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding BatchId}" FontSize="11" Margin="8,0,0,0"
                               Foreground="{DynamicResource App.Text.Muted}"/>
                </StackPanel>
                <Button Height="24" Padding="8,0" FontSize="11"
                        HorizontalAlignment="Left" Margin="0,2,0,0" Content="{loc:LocKey PayloadKey}"
                        Click="OnTogglePayload">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TonalButton}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPayload}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="{Binding PayloadText}" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,0"
                           FontFamily="{DynamicResource App.Font.Mono}" Foreground="{DynamicResource App.Text.Muted}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="SplitterColumn" Width="4"/>
            <ColumnDefinition x:Name="PanelColumn" Width="286" MinWidth="230" MaxWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 左栏：会话（新建行 + 会话清单） ===== -->
        <Border Grid.Column="0" Background="{DynamicResource App.Surface.Panel}" CornerRadius="24,0,0,24">
            <DockPanel Margin="10,12,10,12">
                <Button DockPanel.Dock="Top" x:Name="NewSessionButton" Style="{StaticResource AiRowButton}"
                        Height="34" Padding="8,0" HorizontalContentAlignment="Stretch" Click="OnNewSession">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <m3:M3Icon Kind="plus" Width="15" Height="15" Foreground="{DynamicResource App.Accent.Text}"/>
                            <TextBlock Text="{loc:Loc ai.sessions.new}" FontSize="13" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource App.Text.Primary}"/>
                        </StackPanel>
                        <!-- 键位提示取自键位总表（页面不写死键位串） -->
                        <TextBlock Text="{Binding NewSessionShortcut}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{DynamicResource App.Text.Muted}"/>
                    </Grid>
                </Button>
                <ListBox x:Name="SessionList" Margin="0,8,0,0" Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding Sessions}" ItemTemplate="{StaticResource AiSessionItemTemplate}"
                         SelectionChanged="OnSessionSelected">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,0"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="12"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Surface.BandHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Surface.Selected}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <!-- 右键先选中该行（菜单动作作用于选中行），与「更多」按钮同一入口 -->
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnSessionRowRightClick"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <ContextMenu.Resources>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource LpMenuItem}"/>
                            </ContextMenu.Resources>
                            <MenuItem Header="{loc:Loc ai.sessions.rename}" Click="OnRenameSession"/>
                            <MenuItem Header="{loc:Loc ai.sessions.export}" Click="OnExportSession"/>
                            <MenuItem Header="{loc:Loc ai.sessions.delete}" Click="OnDeleteSession"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== 中栏：状态行 + 对话区（居中内容列）+ 输入区 ===== -->
        <Grid Grid.Column="1" Margin="16,10,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 状态行：运行中才出现（左）；右端常驻右栏开关 -->
            <Grid>
                <StackPanel Margin="0,0,0,6">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProgressVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Value StatusValue}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                        <TextBlock Text="{loc:Value ProgressTextValue}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                    </StackPanel>
                    <!-- 回合进行中 = 进度条（批执行时按 batch.status 轮询给确定进度；不确定态由视图扫值） -->
                    <views:WavyProgressBar x:Name="TurnProgress" Height="18" Margin="0,4,0,0"
                                           Minimum="0" Maximum="{Binding ProgressMaximum}"
                                           ActiveBrush="{DynamicResource App.Accent.Fill}"
                                           TrackBrush="{DynamicResource App.Line.Variant}"/>
                </StackPanel>
                <Button x:Name="PanelToggleButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{StaticResource SideIconButton}" Tag="{loc:LocKey PanelToggleKey}"
                        Click="OnTogglePanel">
                    <Grid>
                        <m3:M3Icon Kind="chevron-right" Width="14" Height="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.Text.Secondary}">
                            <m3:M3Icon.Style>
                                <Style TargetType="{x:Type m3:M3Icon}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPanelCollapsed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </m3:M3Icon.Style>
                        </m3:M3Icon>
                        <m3:M3Icon Kind="chevron-left" Width="14" Height="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.Text.Secondary}">
                            <m3:M3Icon.Style>
                                <Style TargetType="{x:Type m3:M3Icon}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPanelCollapsed}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </m3:M3Icon.Style>
                        </m3:M3Icon>
                    </Grid>
                </Button>
            </Grid>

            <!-- 对话区：内容单元（导航轨 48 + 时间线）居中；浮层声明在 ScrollViewer 之后（z 序）。
                 宽度 = Stretch + MaxWidth 928（**不用 HorizontalAlignment=Center**：居中 + 内容自适应时，
                 单元宽会跟着文字长度走，英文界面会整体变宽——见 WARNINGS 103）。 -->
            <Grid Grid.Row="1" MaxWidth="928" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 轮次导航轨：每轮一枚短横条，当前视口所在轮高亮，点击跳到该轮开头 -->
                <ItemsControl x:Name="TurnRail" Grid.Column="0" VerticalAlignment="Top" Margin="0,14,10,0"
                              ItemsSource="{Binding Turns}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="RailButton" Width="44" Height="14" Padding="0" HorizontalAlignment="Left"
                                    Style="{StaticResource AiRowButton}" ToolTip="{loc:Value RailTipValue}"
                                    Click="OnRailClick">
                                <Border x:Name="Bar" Width="34" Height="3" CornerRadius="1.5" HorizontalAlignment="Left"
                                        Background="{DynamicResource App.Line.Outline}" Opacity="0.6"/>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                    <Setter TargetName="Bar" Property="Opacity" Value="0.55"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="Bar" Property="Width" Value="42"/>
                                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource App.Accent.Fill}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowRail}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>

                <Grid Grid.Column="1" Margin="8,0,8,0">
                    <ScrollViewer x:Name="FeedScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent" ScrollChanged="OnFeedScrollChanged">
                        <ItemsControl x:Name="FeedItems" ItemsSource="{Binding Feed}"
                                      ItemTemplateSelector="{StaticResource AiFeedSelector}"/>
                    </ScrollViewer>

                    <!-- 空态引导卡（未配置服务商时换成配置引导；示例提示可点即发）。
                         宽高**冻结**（中文基线 + 英文换行余量）：语言切换不许改变卡片尺寸（见 WARNINGS 116）。 -->
                    <Border x:Name="GuideCard" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="520" Height="200" Background="{DynamicResource App.Surface.Card}"
                            BorderBrush="{DynamicResource App.Line.Variant}" BorderThickness="1"
                            CornerRadius="19" Padding="22,20">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowGuide}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc ai.empty.title}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.Text.Primary}"/>
                            <!-- 描述固定两行高（中文一行、英文两行——固定高度保证卡片尺寸不随语言变） -->
                            <TextBlock Text="{loc:Loc ai.empty.desc}" FontSize="12" TextWrapping="Wrap" Height="32"
                                       Margin="0,6,0,0" Foreground="{DynamicResource App.Text.Secondary}"/>
                            <!-- 未配置服务商 / 未选模型：如实提示 + 直达设置 -->
                            <StackPanel Margin="0,10,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConfigured}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{loc:LocKey SelectionErrorKey}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource App.Accent.Text}"/>
                                <Button x:Name="OpenSettingsButton" Style="{StaticResource TonalButton}" Height="30"
                                        Width="176" Margin="0,8,0,0" HorizontalAlignment="Left"
                                        Cursor="Hand" ToolTip="{loc:Loc ai.hint.openSettings}" Click="OnOpenSettings">
                                    <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                                               views:LocFit.Text="{loc:Fit ai.hint.openSettings}"
                                               views:LocFit.Mode="Shrink"/>
                                </Button>
                            </StackPanel>
                            <!-- 三条示例提示（可点：填进输入框即发送） -->
                            <StackPanel Margin="0,12,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConfigured}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Style="{StaticResource AiRowButton}" Height="30" Tag="ai.empty.example1"
                                        Content="{loc:Loc ai.empty.example1}" HorizontalContentAlignment="Stretch"
                                        Click="OnExamplePrompt"/>
                                <Button Style="{StaticResource AiRowButton}" Height="30" Tag="ai.empty.example2"
                                        Content="{loc:Loc ai.empty.example2}" HorizontalContentAlignment="Stretch"
                                        Click="OnExamplePrompt"/>
                                <Button Style="{StaticResource AiRowButton}" Height="30" Tag="ai.empty.example3"
                                        Content="{loc:Loc ai.empty.example3}" HorizontalContentAlignment="Stretch"
                                        Click="OnExamplePrompt"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 回到最新（离开底部才出现；点了回底并恢复跟随；显隐由视图按滚动位置投影） -->
                    <Button x:Name="BackToLatestButton" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,10" Height="32" Width="32" Padding="0" Visibility="Collapsed"
                            Style="{StaticResource TonalButton}" Tag="{loc:Loc ai.feed.backToLatest}"
                            Click="OnBackToLatest">
                        <m3:M3Icon Kind="arrow-down" Width="14" Height="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Grid>

            <!-- 输入区：页面底上的一张卡（技能条 / 编辑器 / 提及 / 输入框 / 工具行） -->
            <Border x:Name="ComposerCard" Grid.Row="2" MaxWidth="928" HorizontalAlignment="Stretch"
                    Background="{DynamicResource App.Surface.Card}" BorderThickness="1"
                    BorderBrush="{DynamicResource App.Line.Variant}" CornerRadius="19" Padding="12" Margin="0,8,0,0">
                <StackPanel>
                    <!-- 技能条（有技能才出现；点 chip = 运行/填参数） -->
                    <ItemsControl ItemsSource="{Binding Skills}" Margin="0,0,0,6"
                                  ItemTemplate="{StaticResource AiSkillChipTemplate}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSkills}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- 技能编辑器（新建 / 编辑 / 从助手消息预填） -->
                    <StackPanel Margin="0,2,0,6">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSkillEditorOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{loc:Value SkillEditorTitleValue}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Text.Primary}"/>
                        <TextBlock Text="{loc:Loc ai.skill.editor.name}" FontSize="11" Margin="0,6,0,2"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                        <TextBox x:Name="SkillNameBox" Style="{StaticResource AiFieldBox}"
                                 Text="{Binding SkillName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{loc:Loc ai.skill.editor.description}" FontSize="11" Margin="0,6,0,2"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                        <TextBox Style="{StaticResource AiFieldBox}"
                                 Text="{Binding SkillDescription, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{loc:Loc ai.skill.editor.template}" FontSize="11" Margin="0,6,0,2"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                        <TextBox Style="{StaticResource AiFieldBox}" Height="64" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" Padding="8,5"
                                 Text="{Binding SkillTemplate, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{loc:Loc ai.skill.editor.macro}" FontSize="11" Margin="0,6,0,2"
                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="SkillMacroBox" Width="220" Height="30" HorizontalAlignment="Left"
                                      ItemsSource="{Binding MacroNames}" SelectedItem="{Binding SkillMacro, Mode=TwoWay}"/>
                            <Button Style="{StaticResource TonalButton}" Height="30" Width="30" Padding="0" Margin="6,0,0,0"
                                    ToolTip="{loc:Loc ai.skill.editor.macro}" Click="OnClearSkillMacro">
                                <m3:M3Icon Kind="close" Width="12" Height="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.Text.Secondary}"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Height="28" Padding="16,0" Content="{loc:Loc ai.skill.editor.save}" Click="OnSaveSkill">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanSaveSkill}" Value="False">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource TonalButton}" Height="28" Padding="14,0" Margin="8,0,0,0"
                                    Content="{loc:Loc ai.skill.editor.cancel}" Click="OnCancelSkillEditor"/>
                        </StackPanel>
                        <TextBlock Text="{loc:LocKey SkillEditorErrorKey}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.Line.Invalid}"/>
                    </StackPanel>

                    <!-- 技能参数行（有占位的技能：一占位一输入框，填完点「运行」） -->
                    <StackPanel Margin="0,2,0,6">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSkillRunOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{loc:Loc ai.skill.params.title}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Text.Primary}"/>
                        <ItemsControl ItemsSource="{Binding SkillParameters}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Name}" Width="120" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                                        <TextBox Style="{StaticResource AiFieldBox}" Width="220"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Style="{StaticResource PrimaryPillButton}" Height="28" Padding="16,0"
                                    Content="{loc:Loc ai.skill.params.run}" Click="OnRunSkillWithParams"/>
                            <Button Style="{StaticResource TonalButton}" Height="28" Padding="14,0" Margin="8,0,0,0"
                                    Content="{loc:Loc ai.skill.editor.cancel}" Click="OnCancelSkillRun"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 提及 chip 区（待发集合；点 ✕ 摘除） -->
                    <ItemsControl ItemsSource="{Binding Mentions}" Margin="0,0,0,4">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMentions}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource App.Accent.Container}" CornerRadius="12"
                                        Padding="8,2" Margin="0,0,6,4">
                                    <StackPanel Orientation="Horizontal">
                                        <m3:M3Icon Kind="{Binding Kind, Converter={StaticResource AiMentionIconConverter}}"
                                                   Width="12" Height="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource App.Text.OnContainer}"/>
                                        <TextBlock Text="@" Margin="5,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource App.Text.OnContainer}"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource App.Text.OnContainer}"/>
                                        <Button Style="{StaticResource TonalButton}" Height="18" Width="18" Padding="0"
                                                Margin="6,0,0,0" ToolTip="{loc:Loc ai.mention.remove}"
                                                Click="OnRemoveMention">
                                            <m3:M3Icon Kind="close" Width="10" Height="10"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource App.Text.OnContainer}"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 提及候选面板（@ 触发；↑↓ 移动、Enter/点击选入、Esc 关闭） -->
                    <Border Margin="0,0,0,6" Padding="6,4" MaxHeight="200"
                            Background="{DynamicResource App.Surface.Floating}"
                            BorderBrush="{DynamicResource App.Line.Variant}" BorderThickness="1" CornerRadius="12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMentionPanelOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ListBox x:Name="MentionList" Background="Transparent" BorderThickness="0" MaxHeight="190"
                                 ItemsSource="{Binding MentionCandidates}"
                                 SelectedIndex="{Binding MentionSelectionIndex, Mode=OneWay}"
                                 ItemTemplate="{StaticResource AiMentionCandidateTemplate}"
                                 PreviewMouseLeftButtonUp="OnMentionCandidateClicked"/>
                    </Border>

                    <!-- 输入框（占位提示用键；多行无边框） -->
                    <Grid>
                        <TextBox x:Name="ComposerBox" MinHeight="56" MaxHeight="200" TextWrapping="Wrap" AcceptsReturn="True"
                                 Text="{Binding ComposerText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Padding="0,4"
                                 Foreground="{DynamicResource App.Text.Primary}"/>
                        <TextBlock x:Name="ComposerPlaceholder" Text="{loc:Loc ai.composer.placeholder}" FontSize="13"
                                   Margin="2,8,0,0" VerticalAlignment="Top" IsHitTestVisible="False"
                                   Foreground="{DynamicResource App.Text.Muted}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowComposerPlaceholder}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- 工具行：左 = @提及 / 技能编辑器 / 模式三段；右 = 用量环 / 模型下拉 / 发送·停止 -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="MentionButton" Style="{StaticResource SideIconButton}" Width="30" Height="28"
                                    Tag="{loc:Loc ai.composer.mention}" Click="OnInsertMention">
                                <m3:M3Icon Kind="at" Width="14" Height="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.Text.Secondary}"/>
                            </Button>
                            <Button x:Name="SkillButton" Style="{StaticResource SideIconButton}" Width="30" Height="28"
                                    Tag="{loc:Loc ai.skill.new}" Click="OnNewSkill">
                                <m3:M3Icon Kind="auto-fix" Width="14" Height="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.Text.Secondary}"/>
                            </Button>
                            <!-- 模式三段（只读 / 每次确认 / 自动应用）：模式可见性是产品口径；
                                 段宽冻结（中文基线，英文只缩字号/走短式），语言切换不改变导航条几何 -->
                            <views:SlidingNavStrip x:Name="ModeStrip" Style="{StaticResource SlidingNavStripStyle}"
                                                   Margin="6,0,0,0" SelectedIndex="{Binding ModeIndex, Mode=TwoWay}">
                                <ListBoxItem ToolTip="{loc:Loc ai.mode.readonly}">
                                    <ListBoxItem.Style>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource SlidingNavStripItemStyle}">
                                            <Setter Property="Height" Value="28"/>
                                            <Setter Property="Width" Value="78"/>
                                            <Setter Property="FontSize" Value="12"/>
                                        </Style>
                                    </ListBoxItem.Style>
                                    <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                                               views:LocFit.Text="{loc:Fit ai.mode.readonly}" views:LocFit.Mode="Shrink"/>
                                </ListBoxItem>
                                <ListBoxItem ToolTip="{loc:Loc ai.mode.confirmEach}">
                                    <ListBoxItem.Style>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource SlidingNavStripItemStyle}">
                                            <Setter Property="Height" Value="28"/>
                                            <Setter Property="Width" Value="78"/>
                                            <Setter Property="FontSize" Value="12"/>
                                        </Style>
                                    </ListBoxItem.Style>
                                    <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                                               views:LocFit.Text="{loc:Fit ai.mode.confirmEach}" views:LocFit.Mode="Shrink"/>
                                </ListBoxItem>
                                <ListBoxItem ToolTip="{loc:Loc ai.mode.autoApply}">
                                    <ListBoxItem.Style>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource SlidingNavStripItemStyle}">
                                            <Setter Property="Height" Value="28"/>
                                            <Setter Property="Width" Value="78"/>
                                            <Setter Property="FontSize" Value="12"/>
                                        </Style>
                                    </ListBoxItem.Style>
                                    <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                                               views:LocFit.Text="{loc:Fit ai.mode.autoApply}" views:LocFit.Mode="Shrink"/>
                                </ListBoxItem>
                            </views:SlidingNavStrip>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 上下文用量环（读数来自 AI 运行时的只读读数；没有读数 = 空环） -->
                            <local:UsageRing x:Name="ContextRing" Width="26" Height="26" Margin="0,0,6,0"
                                             VerticalAlignment="Center" Percent="{Binding ContextUsagePercent}"
                                             TrackBrush="{DynamicResource App.Line.Variant}"
                                             FillBrush="{DynamicResource App.Accent.Fill}"
                                             ToolTip="{loc:Value UsageTipValue}"/>
                            <!-- 模型下拉（标签 = 供应商 / 模型；选择即写助手偏好，与 /model 同一条路径） -->
                            <ComboBox x:Name="ModelBox" Height="32" MaxWidth="220" MinWidth="120" Margin="0,0,6,0"
                                      VerticalAlignment="Center" ToolTip="{loc:Loc ai.composer.model}"
                                      ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxStyle}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasModels}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" FontSize="12"
                                                   FontFamily="{DynamicResource App.Font.Mono}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource App.Text.Primary}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{loc:Value ModelLabelValue}" FontSize="12" Margin="0,0,6,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="200"
                                       FontFamily="{DynamicResource App.Font.Mono}"
                                       Foreground="{DynamicResource App.Text.Muted}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasModels}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- 发送 / 停止（图标钮：32 圆 = 药丸圆角的方钮；都带悬浮提示） -->
                            <Button x:Name="SendButton" Width="32" Height="32"
                                    Padding="0" Tag="{loc:Loc ai.composer.send}" Click="OnSend">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTurnRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CanSend}" Value="False">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <m3:M3Icon Kind="arrow-up" Width="15" Height="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="StopButton" Width="32" Height="32"
                                    Padding="0" Tag="{loc:Loc ai.composer.stop}" Click="OnStop">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TonalButton}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTurnRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <m3:M3Icon Kind="stop" Width="13" Height="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{loc:LocKey LastErrorKey}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                               Foreground="{DynamicResource App.Line.Invalid}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 右栏可拖拽分隔线 ===== -->
        <GridSplitter x:Name="PanelSplitter" Grid.Column="2" Width="4" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

        <!-- ===== 右栏：变更与审计（四页签 = 本轮 / 本会话 / 审批 / 引擎审计；功能书 §5.2、§7.6）。
             右栏是**查看面**（选中/过滤的投影）：点它不反向取消任何东西 → BlankClick.IsInteractive。 -->
        <Border Grid.Column="3" x:Name="DetailsPanel" Background="{DynamicResource App.Surface.Panel}"
                CornerRadius="24,0,0,24" Margin="0,0,0,8"
                views:BlankClick.IsInteractive="True">
            <Grid Margin="14,12,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 段宽 = 冻结几何（中文基线）：可用宽 238 ⇒ 4 段 × 58；文字宽 2 字 × 13pt（26px）
                     + 项内距 28 + 描边 2 ⇒ 56，取 58 留余量。完整页签名在 ToolTip 里（窄栏放不下长标签）。
                     文字走自适应通道（英文只缩字号、绝不截断——见 LocFit 定稿口径）。 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <views:SlidingNavStrip x:Name="PanelTabs" Style="{StaticResource SlidingNavStripStyle}"
                                           SelectedIndex="{Binding TabIndex, Mode=TwoWay}">
                        <ListBoxItem ToolTip="{loc:Loc ai.audit.turnChanges}">
                            <ListBoxItem.Style>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SlidingNavStripItemStyle}">
                                    <Setter Property="Height" Value="30"/>
                                    <Setter Property="MinWidth" Value="58"/>
                                    <Setter Property="Width" Value="58"/>
                                </Style>
                            </ListBoxItem.Style>
                            <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                                       views:LocFit.Text="{loc:Fit ai.audit.tab.turn}" views:LocFit.Mode="Shrink"/>
                        </ListBoxItem>
                        <ListBoxItem ToolTip="{loc:Loc ai.audit.sessionChanges}">
                            <ListBoxItem.Style>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SlidingNavStripItemStyle}">
                                    <Setter Property="Height" Value="30"/>
                                    <Setter Property="MinWidth" Value="58"/>
                                    <Setter Property="Width" Value="58"/>
                                </Style>
                            </ListBoxItem.Style>
                            <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                                       views:LocFit.Text="{loc:Fit ai.audit.tab.session}" views:LocFit.Mode="Shrink"/>
                        </ListBoxItem>
                        <ListBoxItem ToolTip="{loc:Loc ai.audit.approvals}">
                            <ListBoxItem.Style>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SlidingNavStripItemStyle}">
                                    <Setter Property="Height" Value="30"/>
                                    <Setter Property="MinWidth" Value="58"/>
                                    <Setter Property="Width" Value="58"/>
                                </Style>
                            </ListBoxItem.Style>
                            <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                                       views:LocFit.Text="{loc:Fit ai.audit.tab.approvals}" views:LocFit.Mode="Shrink"/>
                        </ListBoxItem>
                        <ListBoxItem ToolTip="{loc:Loc ai.audit.engine}">
                            <ListBoxItem.Style>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SlidingNavStripItemStyle}">
                                    <Setter Property="Height" Value="30"/>
                                    <Setter Property="MinWidth" Value="58"/>
                                    <Setter Property="Width" Value="58"/>
                                </Style>
                            </ListBoxItem.Style>
                            <TextBlock Text="{Binding Path=(views:LocFit.Chosen), RelativeSource={RelativeSource Self}}"
                                       views:LocFit.Text="{loc:Fit ai.audit.tab.engine}" views:LocFit.Mode="Shrink"/>
                        </ListBoxItem>
                    </views:SlidingNavStrip>
                </StackPanel>

                <!-- 「撤销本会话 AI 变更」（面板顶部 = 功能书 §2 的入口位置）：
                     **有可撤销批次才给按钮**（不给会失败的按钮），与 Ctrl+Shift+Z 同一条命令、决策前弹确认 -->
                <Button x:Name="UndoSessionButton" Grid.Row="1" HorizontalAlignment="Stretch" Height="30"
                        Content="{loc:Loc ai.sessions.undo}" Click="OnUndoSession">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TonalButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanUndoSession}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 过滤行：搜索（对象名 / 命令名）+ 分类（变更页签）/ 结果（引擎审计页签） -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PanelSearch" Style="{StaticResource AiFieldBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <ComboBox Grid.Column="1" Width="104" Height="30" Margin="8,0,0,0"
                              SelectedIndex="{Binding ChangeFilterIndex, Mode=TwoWay}">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxStyle}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChangesTab}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                        <ComboBoxItem Content="{loc:Loc ai.audit.filter.all}"/>
                        <ComboBoxItem Content="{loc:Loc ai.change.kind.create}"/>
                        <ComboBoxItem Content="{loc:Loc ai.change.kind.update}"/>
                        <ComboBoxItem Content="{loc:Loc ai.change.kind.move}"/>
                        <ComboBoxItem Content="{loc:Loc ai.change.kind.delete}"/>
                        <ComboBoxItem Content="{loc:Loc ai.change.kind.purge}"/>
                        <ComboBoxItem Content="{loc:Loc ai.change.kind.restore}"/>
                        <ComboBoxItem Content="{loc:Loc ai.change.kind.import}"/>
                        <ComboBoxItem Content="{loc:Loc ai.change.kind.export}"/>
                        <ComboBoxItem Content="{loc:Loc ai.change.kind.diagnostic}"/>
                    </ComboBox>
                    <ComboBox Grid.Column="1" Width="104" Height="30" Margin="8,0,0,0"
                              SelectedIndex="{Binding AuditResultIndex, Mode=TwoWay}">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEngineTab}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                        <ComboBoxItem Content="{loc:Loc ai.audit.filter.all}"/>
                        <ComboBoxItem Content="{loc:Loc ai.audit.result.ok}"/>
                        <ComboBoxItem Content="{loc:Loc ai.audit.result.failed}"/>
                    </ComboBox>
                </Grid>

                <!-- 时间范围（引擎审计页签专用一行：窄栏挤不下"搜索 + 结果 + 范围"三个控件，
                     按 WARNINGS 51 换排布而不是缩字/缩内距；过滤走服务端 audit.query {from}） -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEngineTab}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ComboBox x:Name="AuditRangeBox" Width="110" Height="30"
                              SelectedIndex="{Binding AuditRangeIndex, Mode=TwoWay}"
                              ToolTip="{loc:Loc ai.audit.range.tip}">
                        <ComboBoxItem Content="{loc:Loc ai.audit.filter.all}"/>
                        <ComboBoxItem Content="{loc:Loc ai.audit.range.today}"/>
                        <ComboBoxItem Content="{loc:Loc ai.audit.range.d7}"/>
                        <ComboBoxItem Content="{loc:Loc ai.audit.range.d30}"/>
                    </ComboBox>
                </StackPanel>

                <!-- 列表（四个页签各一份；同一份台账行模板与对话流共用） -->
                <ScrollViewer Grid.Row="4" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding TurnChanges}" ItemTemplate="{StaticResource AiChangeRowTemplate}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChangesTab}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding SessionChanges}" ItemTemplate="{StaticResource AiChangeRowTemplate}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsApprovalTab}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEngineTab}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsChangesTab}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Approvals}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsApprovalTab}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <TextBlock Text="{Binding Command}" Foreground="{DynamicResource App.Text.Primary}"/>
                                        <TextBlock Text="{Binding Target}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource App.Text.Muted}"/>
                                        <TextBlock Text="{Binding DecisionText}" FontSize="11" Foreground="{DynamicResource App.Text.Secondary}"/>
                                        <TextBlock Text="{Binding Reason}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource App.Text.Secondary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding EngineAudit}" ItemTemplate="{StaticResource AiEngineRowTemplate}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEngineTab}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                        </ItemsControl>
                        <TextBlock Text="{loc:LocKey AuditHintKey}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{DynamicResource App.Text.Muted}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEngineTab}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <!-- 分页（引擎审计页签）+ 汇总状态条（含变量的整句由 VM 出 LocValue） -->
                <StackPanel Grid.Row="5" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEngineTab}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Height="24" Width="64" Padding="0"
                                Content="{loc:Loc ai.audit.page.prev}" Click="OnAuditPrev">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TonalButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanPrevAuditPage}" Value="False">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Text="{loc:Value AuditPageValue}" FontSize="11" Margin="8,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource App.Text.Secondary}"/>
                        <Button Height="24" Width="64" Padding="0"
                                Content="{loc:Loc ai.audit.page.next}" Click="OnAuditNext">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TonalButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanNextAuditPage}" Value="False">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <!-- 汇总 / 用量行：单行 + 截断（**冻结高度**：换行会让右栏的 * 行随语言变高，
                         偷走审计列表的高度；全量读数在悬浮提示里） -->
                    <TextBlock Text="{loc:Value SummaryValue}" FontSize="11" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" ToolTip="{loc:Value SummaryValue}"
                               Foreground="{DynamicResource App.Text.Secondary}"/>
                    <!-- 用量行（功能书 §2「用量可见」/ §7.6）：本会话轮数 · 工具调用 · token 合计 -->
                    <TextBlock Text="{loc:Value UsageValue}" FontSize="11" Margin="0,2,0,0" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" ToolTip="{loc:Value UsageValue}"
                               Foreground="{DynamicResource App.Text.Muted}"/>
                </StackPanel>

                <!-- 导出（三格式：Markdown 人读 / CSV 台账逐条 / JSON 完整会话）。
                     段宽算式（中文基线实测，WARNINGS 116）：最紧文案「Markdown（人读）」109.6 + 下拉框
                     图标与箭头占位 26 ⇒ 内容区需 ≥135.6 → 取 140（英文 Markdown (readable) 113.1 同宽放下）；
                     118 是六页时代未量 AI 页留下的错格，P3+-2 纳入度量首跑即红。 -->
                <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,8,0,0">
                    <ComboBox x:Name="ExportFormatBox" Width="140" Height="30" SelectedIndex="0">
                        <ComboBoxItem Content="{loc:Loc ai.export.markdown}"/>
                        <ComboBoxItem Content="{loc:Loc ai.export.csv}"/>
                        <ComboBoxItem Content="{loc:Loc ai.export.json}"/>
                    </ComboBox>
                    <Button x:Name="ExportAuditButton" Style="{StaticResource TonalButton}" Height="30"
                            Width="68" Padding="0" Margin="8,0,0,0"
                            Content="{loc:Loc ai.sessions.export}" Click="OnExportSession"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
